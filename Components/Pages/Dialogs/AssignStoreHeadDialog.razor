@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject UserStateService UserState
@inject IDialogService DialogService
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@implements IDisposable

<style>
    /* SHARED GLASS DIALOG STYLES */

    /* Remove default button borders */
    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    /* --- LIGHT MODE (BLUE GLASS) --- */
    /* White Text/Inputs */
    .glass-dialog.light .mud-input-root,
    .glass-dialog.light .mud-input-slot,
    .glass-dialog.light .mud-input-label,
    .glass-dialog.light .mud-icon-root,
    .glass-dialog.light .mud-input-adornment {
        color: #ffffff !important;
    }

    /* White Borders */
    .glass-dialog.light .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.8) !important;
    }

    .glass-dialog.light .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.light .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #ffffff !important;
        border-width: 2px !important;
    }

    /* Placeholder */
    .glass-dialog.light .mud-input-slot::placeholder {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    /* --- LIGHTEST MODE --- */
    /* Ensure inputs are NOT white (default visibility) */
    .glass-dialog.lightest .mud-input-root,
    .glass-dialog.lightest .mud-input-slot,
    .glass-dialog.lightest .mud-input-label {
        color: #0f172a !important;
    }

    .glass-dialog.lightest .mud-icon-root {
        color: #0072cf !important;
    }

    

    .glass-dialog.lightest .mud-input-outlined-border {
        border-color: rgba(0, 114, 207, 0.4) !important;
    }

    .glass-dialog.lightest .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.lightest .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #0072cf !important;
    }

    /* MOBILE RESPONSIVE DIALOG */
    @@media (max-width: 960px) {
        .mud-picker-datepicker-toolbar {
            display: none !important;
        }

        .mud-picker-paper {
            left: 50% !important;
            transform: translateX(-50%) !important;
            right: auto !important;
            max-height: calc(100vh - 100px) !important;
            overflow-y: auto !important;
        }

        .mud-popover {
            left: 50% !important;
            transform: translateX(-50%) !important;
        }

        .glass-dialog .mud-dialog-actions {
            flex-direction: row;
            justify-content: flex-end;
            align-items: center;
            gap: 8px;
            padding: 8px 12px 12px 12px !important;
        }

            .glass-dialog .mud-dialog-actions .mud-button {
                width: auto !important;
                margin: 0 !important;
                padding: 8px 12px !important;
                font-size: 0.75rem !important;
            }

        .glass-dialog .mud-dialog-content {
            padding: 12px 16px !important;
        }
    }

    /* SPECIFIC FOR NARROW MOBILE (iPhone SE 375px) */
    @@media (max-width: 375px) {
        .glass-dialog {
            padding: 8px !important;
        }

            .glass-dialog .mud-dialog-title {
                padding: 12px 40px 4px 12px !important;
            }

            .glass-dialog .mud-typography-h6 {
                font-size: 1.05rem !important;
                line-height: 1.2 !important;
            }

            .glass-dialog .mud-dialog-content {
                padding: 8px 12px !important;
            }

            .glass-dialog .mud-dialog-actions {
                padding: 8px 8px 12px 8px !important;
                gap: 6px;
            }

                .glass-dialog .mud-dialog-actions .mud-button {
                    min-height: 32px !important;
                    font-size: 0.70rem !important;
                    padding: 6px 10px !important;
                }

        /* Shrink datepicker contents to fit 375px screens */
        .mud-picker-paper {
            padding: 0px !important;
            min-width: unset !important;
            width: min(280px, calc(100vw - 20px)) !important;
            max-width: calc(100vw - 20px) !important;
        }

        .mud-picker-calendar-container {
            padding: 0px !important;
            width: 90% !important;
        }

        .mud-day {
            width: 32px !important;
            height: 32px !important;
            font-size: 0.75rem !important;
            margin: 1px !important;
        }

        .mud-picker-calendar-day {
            width: 32px !important;
            height: 32px !important;
            font-size: 0.75rem !important;
            margin: 1px !important;
        }

        .mud-picker-calendar-week-day {
            width: 32px !important;
            height: 32px !important;
            font-size: 0.75rem !important;
            margin: 1px !important;
        }

        .mud-picker-calendar-week {
            justify-content: center !important;
        }

        .mud-picker-calendar-header {
            justify-content: center !important;
        }
    }

    .date-picker-desktop {
        display: block;
    }
    .date-picker-mobile {
        display: none;
        width: 100%;
    }

    @@media (max-width: 960px) {
        .date-picker-desktop {
            display: none !important;
        }
        .date-picker-mobile {
            display: block !important;
            margin-top: 12px;
            margin-bottom: 12px;
        }
    }
</style>

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true" Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">Assign Store Head</MudText>
    </TitleContent>
    <DialogContent>

        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="background: rgba(255,255,255,0.05); border-radius: 12px;">
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">Store Information</MudText>
            <MudDivider Class="mb-3" Style="opacity: 0.2;" />
            <div class="d-flex flex-column gap-1">
                <MudText Typo="Typo.body2" Style="@($"color: {GetTitleColor()}")"><strong>Code:</strong> @Store.StoreCode</MudText>
                <MudText Typo="Typo.body2" Style="@($"color: {GetTitleColor()}")"><strong>Name:</strong> @Store.StoreName</MudText>
                <MudText Typo="Typo.body2" Style="@($"color: {GetTitleColor()}")"><strong>Location:</strong> @Store.Location</MudText>
            </div>
        </MudPaper>

        <MudAutocomplete T="User" Label="Select Store Head" @bind-Value="_selectedUser" SearchFunc="@SearchEmployees"
                         ToStringFunc="@(u => u == null ? null : $"{u.Fullname} ({u.EmployeeNumber})")"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary"
                         Required="true" RequiredError="Please select a store head" />

        @if (Store.StoreHead != null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-2" Dense="true">
                Reassigning will unassign <strong>@Store.StoreHead.Fullname</strong>.
            </MudAlert>
        }

        <div class="date-picker-desktop">
            <MudDatePicker Label="Effective Date" @bind-Date="_effectiveDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
        </div>

        <div class="date-picker-mobile mt-3">
            <MudTextField T="string"
                          Label="Effective Date"
                          Value="@(_effectiveDate?.ToString("M/d/yyyy") ?? "Select Date")"
                          ReadOnly="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                          @onclick="OpenGlassCalendarDialog" />
        </div>

        <MudTextField Label="Remarks (Optional)" @bind-Value="_remarks" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="mt-3" />

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="@GetCancelButtonStyle()">Cancel</MudButton>
        @if (Store.StoreHeadId != null)
        {
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Unassign" Style="text-transform: none; font-weight: 600; border-radius: 4px;">Unassign</MudButton>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(_selectedUser == null)" Style="@GetButtonStyle()">Assign</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Store Store { get; set; } = default!;

    private User? _selectedUser;
    private DateTime? _effectiveDate = DateTime.Today;

    private async Task OpenGlassCalendarDialog()
    {
        var parameters = new DialogParameters<GlassCalendarWrapperDialog>
        {
            { x => x.SelectedDate, _effectiveDate }
        };

        var options = new DialogOptions
        {
            NoHeader = true,
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<GlassCalendarWrapperDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is DateTime selectedDate)
        {
            _effectiveDate = selectedDate;
            StateHasChanged();
        }
    }
    private string? _remarks;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;

        if (Store != null)
        {
            _selectedUser = Store.StoreHead;

            if (Store.StoreHeadId.HasValue)
            {
                using var db = await DbFactory.CreateDbContextAsync();
                var latestLog = await db.StoreAssignmentLogs
                    .AsNoTracking()
                    .Where(l => l.StoreId == Store.Id && l.UserId == Store.StoreHeadId && l.Action == "Assigned")
                    .OrderByDescending(l => l.Timestamp)
                    .FirstOrDefaultAsync();

                if (latestLog != null && !string.IsNullOrEmpty(latestLog.Remarks) && latestLog.Remarks.StartsWith("Effective: "))
                {
                    var parts = latestLog.Remarks.Split('.');
                    var dateStr = parts[0].Replace("Effective: ", "").Trim();
                    if (DateTime.TryParse(dateStr, out var parsedDate))
                    {
                        _effectiveDate = parsedDate;
                    }
                }
            }
        }
    }

    private void OnThemeChanged() => StateHasChanged();

    public void Dispose() => ThemeService.OnThemeChanged -= OnThemeChanged;

    private async Task<IEnumerable<User>> SearchEmployees(string value, CancellationToken token)
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Get all StoreHeadIds already assigned to OTHER stores (not this one)
        var alreadyAssignedIds = await db.Stores
            .AsNoTracking()
            .Where(s => !s.IsDeleted && s.StoreHeadId != null && s.Id != Store.Id)
            .Select(s => s.StoreHeadId!.Value)
            .ToListAsync(token);

        // Strictly filter by Role = "Store Head", exclude those already assigned elsewhere
        var query = db.Users.AsNoTracking()
            .Where(u => u.Status == "Active" && u.Role == "Store Head" && !alreadyAssignedIds.Contains(u.Id));

        if (!string.IsNullOrEmpty(value))
        {
            query = query.Where(u => u.Fullname.Contains(value) || (u.EmployeeNumber != null && u.EmployeeNumber.Contains(value)));
        }

        return await query.ToListAsync(token);
    }

    private async Task Submit()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var store = await db.Stores.FindAsync(Store.Id);
        if (store != null)
        {
            store.StoreHeadId = _selectedUser?.Id;

            // Log Assignment
            db.StoreAssignmentLogs.Add(new StoreAssignmentLog
            {
                StoreId = store.Id,
                UserId = _selectedUser?.Id,
                Role = "Store Head",
                Action = "Assigned",
                Timestamp = DateTime.Now,
                Remarks = $"Effective: {_effectiveDate?.ToShortDateString()}. {_remarks}"
            });

            await db.SaveChangesAsync();
            MudDialog.Close(DialogResult.Ok("Assigned"));
        }
    }

    private async Task Unassign()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var store = await db.Stores.FindAsync(Store.Id);
        if (store != null)
        {
            var previousHeadId = store.StoreHeadId;
            store.StoreHeadId = null;

            // Log Unassignment
            db.StoreAssignmentLogs.Add(new StoreAssignmentLog
            {
                StoreId = store.Id,
                UserId = previousHeadId,
                Role = "Store Head",
                Action = "Unassigned",
                Timestamp = DateTime.Now,
                Remarks = string.IsNullOrEmpty(_remarks) ? "Manual unassignment by admin." : _remarks
            });
            await db.SaveChangesAsync();
            MudDialog.Close(DialogResult.Ok("Unassigned"));
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(15px); min-width: 320px;";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.5);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.2); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleColor()
    {
        if (ThemeService == null) return "#0f172a";
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "text-transform: none; font-weight: 600;";
        var baseStyle = "text-transform: none; font-weight: 600;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? $"{baseStyle} color: #0072cf !important; background-color: #ffffff !important;"
            : baseStyle;
    }

    private string GetCancelButtonStyle()
    {
        return $"color: {GetTitleColor()}; text-transform: none; font-weight: 600;";
    }
}
