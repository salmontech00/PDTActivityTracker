@using MudBlazor
@using PDTActivityTracker.Components.Services
@inject IJSRuntime JSRuntime
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<style>
    /* SHARED GLASS DIALOG STYLES */
    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    /* --- LIGHT MODE (BLUE GLASS) --- */
    .glass-dialog.light .mud-icon-root {
        color: #ffffff !important;
    }

    .glass-dialog.light .save-photobtn .mud-button-icon-start {
        color: #0072cf !important;
    }

    /* --- LIGHTEST MODE --- */
    .glass-dialog.lightest .mud-icon-root {
        color: #0072cf !important;
    }

    /* CAMERA CONTAINER */
    .camera-container {
        position: relative;
        width: 100%;
        max-width: 500px;
        aspect-ratio: 1/1; /* Square for mobile optimization */
        background: #000;
        border-radius: 16px;
        overflow: hidden;
        margin: 0 auto;
    }

    .video-preview {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .captured-preview {
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: #000;
    }

    .camera-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.5);
    }

    .capture-btn {
        background: rgba(var(--mud-palette-primary-rgb), 0.1) !important;
        border: 2px solid var(--mud-palette-primary) !important;
    }

    /* RESPONSIVE */
    @@media (max-width: 600px) {
        .camera-container {
            max-width: 100%;
            border-radius: 12px;
        }

        .glass-dialog .mud-dialog-actions {
            flex-direction: column;
            gap: 0px;
        }

            .glass-dialog .mud-dialog-actions .mud-button {
                width: 100%;
            }

            .glass-dialog .mud-dialog-actions .mud-spacer {
                display: none;
            }
    }

    @@media (max-width: 375px) {
        .camera-container {
            position: relative;
            width: 100%;
            max-height: 205px;
            max-width: 250px;
            background: #000;
            border-radius: 16px;
            overflow: hidden;
            margin: 0 auto;
        }
        /* LOCAL OVERRIDE FOR PULSE.CSS */
        .glass-dialog.mud-dialog {
            margin-left: 12px !important;
            margin-right: 12px !important;
            min-width: unset !important;
            width: calc(100% - 24px) !important;
        }

        .glass-dialog .mud-dialog-actions {
            flex-direction: column;
            gap: 0px;
        }

            .glass-dialog .mud-dialog-actions .mud-button {
                width: 100%;
            }

            .glass-dialog .mud-dialog-actions .mud-spacer {
                display: none;
            }
    }
</style>

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true" Class="@($"rounded-xl glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <TitleContent>
        <div class="d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">Capture Photo</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="camera-container">
            @if (_locationError != null)
            {
                <div class="camera-overlay" style="background: rgba(0,0,0,0.8); flex-direction: column; padding: 20px; text-align: center;">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOff" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Color="Color.Error" GutterBottom="true">Location Required</MudText>
                    <MudText Typo="Typo.body2" Class="text-white mb-6">@_locationError</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FetchLocation">RETRY</MudButton>
                </div>
            }
            else if (_isFetchingLocation)
            {
                <div class="camera-overlay">
                    <div class="d-flex flex-column align-center">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-3" />
                        <MudText Typo="Typo.body2" Class="text-white">Fetching GPS location...</MudText>
                    </div>
                </div>
            }
            else if (!_isCaptured)
            {
                <video id="cameraVideo" autoplay playsinline class="video-preview"></video>
            }
            else
            {
                <img src="@_capturedImageBase64" class="captured-preview" alt="Captured" />
            }
            <canvas id="cameraCanvas" style="display:none;"></canvas>

            @if (!_isCaptured && !_isLoading && !_isFetchingLocation && _locationError == null)
            {
                <div class="camera-controls">
                    @if (_hasFlash)
                    {
                        <MudIconButton Icon="@(_isFlashOn? Icons.Material.Filled.FlashOn : Icons.Material.Filled.FlashOff)"
                                       Color="Color.Inherit"
                                       OnClick="ToggleFlash"
                                       Class="control-btn" />
                    }

                    <MudIconButton Icon="@Icons.Material.Filled.Cameraswitch"
                                   Color="Color.Inherit"
                                   OnClick="SwitchCamera"
                                   Class="control-btn" />
                </div>

                <style>
                    .camera-controls {
                        position: absolute;
                        top: 10px;
                        right: 10px;
                        display: flex;
                        gap: 10px;
                        z-index: 10;
                    }

                    .control-btn {
                        background-color: rgba(0,0,0,0.5) !important;
                        color: white !important;
                    }

                        .control-btn:hover {
                            background-color: rgba(0,0,0,0.7) !important;
                        }
                </style>
            }

            @if (_isLoading)
            {
                <div class="camera-overlay">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudSpacer />
        @if (!_isCaptured)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Camera"
                           Color="Color.Primary"
                           Size="Size.Large"
                           OnClick="Capture"
                           Disabled="@(_isLoading || _isFetchingLocation || _locationError != null)"
                           Class="capture-btn" />
        }
        else
        {
            <MudButton OnClick="Retake"
                       Style="@GetCancelButtonStyle()"
                       Class="rounded-lg">
                RETAKE
            </MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="Confirm"
                       Style="@GetButtonStyle()"
                       Class="@($"rounded-lg px-6 {(GetThemeClass() == "light" ? "save-photobtn" : "")}")">
                SAVE PHOTO
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private bool _isLoading = true;
    private bool _isFetchingLocation = true;
    private string? _locationError;
    private bool _isCaptured = false;
    private string? _capturedImageBase64;
    private string _facingMode = "environment";
    private bool _hasFlash = false;
    private bool _isFlashOn = false;

    private double? _latitude;
    private double? _longitude;
    private DateTime? _captureTimestamp;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged() => StateHasChanged();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FetchLocation();
        }
    }

    private async Task FetchLocation()
    {
        _isFetchingLocation = true;
        _locationError = null;
        StateHasChanged();

        try
        {
            var location = await JSRuntime.InvokeAsync<LocationCoords>("cameraInterop.getCurrentLocation");
            _latitude = location.Latitude;
            _longitude = location.Longitude;
            _isFetchingLocation = false;
            await StartCamera();
        }
        catch (Exception ex)
        {
            _locationError = ex.Message;
            _isFetchingLocation = false;
            _isLoading = false;
            StateHasChanged();
        }
    }

    public class LocationCoords
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }

    private async Task StartCamera()
    {
        _isLoading = true;
        StateHasChanged();

        // Wait a bit for the element to be ready in the DOM
        await Task.Delay(500);

        bool success = await JSRuntime.InvokeAsync<bool>("cameraInterop.startVideo", "cameraVideo", _facingMode);
        if (!success)
        {
            MudDialog.Cancel();
            Snackbar.Add("Failed to start camera.", Severity.Error);
        }
        else
        {
            _hasFlash = await JSRuntime.InvokeAsync<bool>("cameraInterop.hasFlash", "cameraVideo");
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task SwitchCamera()
    {
        _facingMode = _facingMode == "environment" ? "user" : "environment";
        _isFlashOn = false; // Reset flash state
        await StartCamera();
    }

    private async Task ToggleFlash()
    {
        _isFlashOn = !_isFlashOn;
        bool success = await JSRuntime.InvokeAsync<bool>("cameraInterop.toggleFlash", "cameraVideo", _isFlashOn);
        if (!success)
        {
            // Revert if failed
            _isFlashOn = !_isFlashOn;
            Snackbar.Add("Failed to toggle flash.", Severity.Warning);
        }
    }

    private async Task Capture()
    {
        try
        {
            _captureTimestamp = DateTime.Now;
            var watermarkText = $"GPS: {_latitude:F6}, {_longitude:F6} | Time: {_captureTimestamp:yyyy-MM-dd HH:mm:ss}";

            _capturedImageBase64 = await JSRuntime.InvokeAsync<string>("cameraInterop.capturePhoto", "cameraVideo", "cameraCanvas", watermarkText);
            if (!string.IsNullOrEmpty(_capturedImageBase64))
            {
                await JSRuntime.InvokeVoidAsync("cameraInterop.stopVideo", "cameraVideo");
                _isCaptured = true;
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Could not capture image. Please try again.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Capture error: {ex.Message}");
            Snackbar.Add("Error capturing photo. Please try again.", Severity.Error);
        }
    }

    private async Task Retake()
    {
        _isCaptured = false;
        _capturedImageBase64 = null;
        _isFlashOn = false;
        StateHasChanged();
        await StartCamera();
    }

    private void Confirm()
    {
        if (!string.IsNullOrEmpty(_capturedImageBase64))
        {
            // Remove the data area if present
            var base64Data = _capturedImageBase64;
            if (base64Data.Contains(","))
            {
                base64Data = base64Data.Split(",")[1];
            }

            var bytes = Convert.FromBase64String(base64Data);
            MudDialog.Close(DialogResult.Ok((bytes, "image/jpeg", _latitude, _longitude, _captureTimestamp)));
        }
    }

    private void Cancel() => MudDialog.Cancel();

    public async ValueTask DisposeAsync()
    {
        try
        {
            ThemeService.OnThemeChanged -= OnThemeChanged;
            await JSRuntime.InvokeVoidAsync("cameraInterop.stopVideo", "cameraVideo");
        }
        catch { }
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(15px);";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleColor()
    {
        if (ThemeService == null)
            return "#0f172a";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "text-transform: none; font-weight: 600;";
        var baseStyle = "text-transform: none; font-weight: 600;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? $"{baseStyle} color: #0072cf !important; background-color: #ffffff !important;"
            : baseStyle;
    }

    private string GetRetakeButtonStyle()
    {
        if (ThemeService == null) return "text-transform: none; font-weight: 600;";
        var baseStyle = "text-transform: none; font-weight: 600;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? $"{baseStyle} color: #ffffff !important; border-color: #ffffff !important;"
            : baseStyle;
    }

    private string GetCancelButtonStyle()
    {
        return $"color: {GetTitleColor()}; text-transform: none; font-weight: 600;";
    }
}