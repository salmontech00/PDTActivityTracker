@using PDTActivityTracker.Components.Services
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<style>
    /* SHARED GLASS DIALOG STYLES */

    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    /* --- LIGHT MODE (BLUE GLASS) --- */
    /* Primary (or specific Color) Button: White BG, Color Text */
    .glass-dialog.light .mud-button-filled {
        background-color: #ffffff !important;
    }

        /* Force specific overrides for common filled buttons in Light Mode */
        .glass-dialog.light .mud-button-filled.mud-button-primary {
            color: #0072cf !important;
        }

        /* Improved specificity for the red delete button */
        .glass-dialog.light .mud-button-filled.mud-button-filled-error,
        .glass-dialog.light .mud-button-filled.mud-error {
            background-color: #f44336 !important;
            color: #ffffff !important;
        }

        .glass-dialog.light .mud-button-filled:hover {
            background-color: rgba(255, 255, 255, 0.9) !important;
        }

        .glass-dialog.light .mud-button-filled.mud-button-filled-error:hover,
        .glass-dialog.light .mud-button-filled.mud-error:hover {
            background-color: #d32f2f !important;
        }

    /* Cancel/Text Button: White Text */
    .glass-dialog.light .mud-button-text,
    .glass-dialog.light .mud-button-text.mud-text-secondary {
        color: #ffffff !important;
    }
</style>

<MudDialog Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <DialogContent>
        <MudText Typo="Typo.body1" Style="@GetTextStyle()">@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Inherit" Class="mud-text-secondary" Style="@GetCancelButtonStyle()">Cancel</MudButton>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="Submit" Class="px-6 rounded-lg" Style="@GetButtonStyle()">@ButtonText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string ContentText { get; set; } = "Are you sure?";
    [Parameter] public string ButtonText { get; set; } = "Delete";
    [Parameter] public Color Color { get; set; } = Color.Error;

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(15px); min-width: 300px;";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.5);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.2); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTextStyle()
    {
        if (ThemeService == null) return "color: #0f172a;";
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "color: #475569;" : "color: #ffffff;";
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetTitleColor()
    {
        if (ThemeService == null)
            return "#0f172a";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "text-transform: none; font-weight: 600;";
        var baseStyle = "text-transform: none; font-weight: 600;";

        // For ConfirmDialog, we ensure white background in Light mode UNLESS it's an Error/Delete button
        return (ThemeService.CurrentTheme == ThemeMode.Light && Color != Color.Error)
            ? $"{baseStyle} background-color: #ffffff !important;"
            : baseStyle;
    }

    private string GetCancelButtonStyle()
    {
        return $"color: {GetTitleColor()}; text-transform: none; font-weight: 600;";
    }

    void Submit() => MudDialog.Close(DialogResult.Ok(true));
    void Cancel() => MudDialog.Cancel();
}
