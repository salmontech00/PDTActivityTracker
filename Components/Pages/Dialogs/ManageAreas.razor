@using PDTActivityTracker.Components.Model
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Services
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<style>
    /* SHARED GLASS DIALOG STYLES */

    /* Remove default button borders */
    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    /* --- LIGHT MODE (BLUE GLASS) --- */
    /* White Text/Inputs */
    .glass-dialog.light .mud-input-root,
    .glass-dialog.light .mud-input-slot,
    .glass-dialog.light .mud-input-label,
    .glass-dialog.light .mud-icon-root,
    .glass-dialog.light .mud-input-adornment {
        color: #ffffff !important;
    }

    /* White Borders */
    .glass-dialog.light .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.8) !important;
    }

    .glass-dialog.light .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.light .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #ffffff !important;
        border-width: 2px !important;
    }

    /* Placeholder */
    .glass-dialog.light .mud-input-slot::placeholder {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    /* --- LIGHTEST MODE --- */
    /* Ensure inputs are NOT white (default visibility) */
    .glass-dialog.lightest .mud-input-root,
    .glass-dialog.lightest .mud-input-slot,
    .glass-dialog.lightest .mud-input-label {
        color: #0f172a !important;
    }

    .glass-dialog.lightest .mud-icon-root {
        color: #0072cf !important;
    }

    .glass-dialog.lightest .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 1) !important;
    }

    .glass-dialog.lightest .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.lightest .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #0072cf !important;
    }

    /* Table styling for glass */
    .glass-dialog .mud-table-root,
    .glass-dialog .mud-table {
        background-color: transparent !important;
        color: inherit;
    }

    .glass-dialog .mud-table-hover .mud-table-body .mud-table-row:hover {
        background-color: rgba(255, 255, 255, 0.1) !important;
    }
</style>

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true" Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">MANAGE AREAS</MudText>
    </TitleContent>
    <DialogContent>
        <div>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="7">
                    <MudTextField T="string" @bind-Value="_newAreaName" Label="Area Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudSelect T="string" @bind-Value="_newAreaType" Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("Municipality")">Municipality</MudSelectItem>
                        <MudSelectItem Value="@("Barangay")">Barangay</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudButton OnClick="AddArea" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="rounded-lg" Style="@GetButtonStyle()">Add Area</MudButton>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <div style="max-height: 400px; overflow-y: auto;">
                <MudTable Items="_areas" Dense="true" Hover="true" Elevation="0" Style="background-color: transparent;">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Type">@context.Type</MudTd>
                        <MudTd DataLabel="Action" Style="text-align:right">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteArea(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Default" Style="@GetCancelButtonStyle()">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private List<Area> _areas = new();
    private string _newAreaName = "";
    private string _newAreaType = "Barangay";

    protected override async Task OnInitializedAsync()
    {
        await LoadAreas();
    }

    private async Task LoadAreas()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        _areas = await db.Areas.OrderBy(a => a.Type).ThenBy(a => a.Name).ToListAsync();
    }

    private async Task AddArea()
    {
        if (string.IsNullOrWhiteSpace(_newAreaName)) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var area = new Area { Name = _newAreaName, Type = _newAreaType };
        db.Areas.Add(area);
        await db.SaveChangesAsync();

        _newAreaName = "";
        await LoadAreas();
        Snackbar.Add("Area added!", Severity.Success);
    }

    private async Task DeleteArea(Area area)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        db.Areas.Remove(area);
        await db.SaveChangesAsync();
        await LoadAreas();
        Snackbar.Add("Area removed!", Severity.Info);
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(10px); min-width: 320px;";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleColor()
    {
        if (ThemeService == null)
            return "#0f172a";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "text-transform: none; font-weight: 600;";
        var baseStyle = "text-transform: none; font-weight: 600;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? $"{baseStyle} color: #0072cf !important; background-color: #ffffff !important;"
            : baseStyle;
    }

    private string GetCancelButtonStyle()
    {
        return $"color: {GetTitleColor()}; text-transform: none; font-weight: 600;";
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }
}
