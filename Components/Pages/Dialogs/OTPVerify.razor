@using MudBlazor
@using PDTActivityTracker.Model
@using PDTActivityTracker.Components.Services
@using Microsoft.EntityFrameworkCore
@using System.Text.RegularExpressions
@using System.Security.Cryptography
@using System.Text

@inject AppDbContext Db
@inject ISnackbar Snackbar
@inject IEmailService EmailService
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@implements IDisposable

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true" Class="rounded-xl pa-2" Style="@GetDialogStyle()">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">
            @if (_step == DialogStep.EnterCredentials)
            {
                <text>VERIFY OTP</text>
            }
            else if (_step == DialogStep.EnterOtp)
            {
                <text>VERIFY OTP</text>
            }
            else
            {
                <text>CHANGE PASSWORD</text>
            }
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (_step == DialogStep.EnterCredentials)
        {
            <MudForm @ref="_credentialsForm">
                <MudStack Spacing="4">
                    <MudText Typo="Typo.body2" Style="@GetTextStyle()">
                        Enter your username and email to receive a 4-digit verification code.
                    </MudText>

                    <MudTextField T="string"
                                  Label="Username"
                                  @bind-Value="_username"
                                  Required="true"
                                  RequiredError="Username is required"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person"
                                  AdornmentColor="Color.Primary" />

                    <MudTextField T="string"
                                  Label="Email"
                                  @bind-Value="_email"
                                  Required="true"
                                  RequiredError="Email is required"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  AdornmentColor="Color.Primary"
                                  Validation="@(new Func<string, string?>(ValidateEmail))" />
                </MudStack>
            </MudForm>
        }
        else if (_step == DialogStep.EnterOtp)
        {
            <MudForm @ref="_otpForm">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.body2" Style="@GetTextStyle()">
                        A 4-digit code has been sent to <strong>@_maskedEmail</strong>
                    </MudText>
                    <MudText Typo="Typo.body2" Style="@GetTextStyle()" Class="fw-bold">
                        Please enter the code below:
                    </MudText>

                    <div class="d-flex justify-space-between gap-2 py-4 w-100">
                        @for (int i = 0; i < 4; i++)
                        {
                            int index = i;
                            <div style="flex: 1; max-width: 80px;">
                                <MudTextField T="string"
                                              @bind-Value="_otpDigits[index]"
                                              MaxLength="1"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Style="font-size: 24px; text-align: center;"
                                              OnKeyUp="@((KeyboardEventArgs e) => HandleKeyUp(e, index))"
                                              @ref="_otpInputs[index]"
                                              AdornmentColor="Color.Primary" />
                            </div>
                        }
                    </div>

                    @if (_remainingSeconds > 0)
                    {
                        <MudText Typo="Typo.body2" Align="Align.Center" Style="@GetTextStyle()">
                            Code expires in: <strong>@FormatTime(_remainingSeconds)</strong>
                        </MudText>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Verification code has expired. Please request a new one.
                        </MudAlert>
                    }

                    <MudText Typo="Typo.caption" Align="Align.Center" Style="@GetTextStyleSecondary()">
                        Didn't receive the code?
                        <MudLink OnClick="ResendOtp" Color="Color.Primary" Disabled="@_isResending" Style="font-weight: 600;">
                            @if (_isResending)
                            {
                                <span>Resending...</span>
                            }
                            else
                            {
                                <span>Resend</span>
                            }
                        </MudLink>
                    </MudText>
                </MudStack>
            </MudForm>
        }
        else if (_step == DialogStep.ChangePassword)
        {
            <MudForm @ref="_passwordForm">
                <MudStack Spacing="4">
                    <MudText Typo="Typo.body2" Color="Color.Success">
                        Verification successful! Please enter your new password.
                    </MudText>

                    <MudTextField T="string"
                                  Label="Password"
                                  Variant="Variant.Outlined"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@TogglePasswordVisibility"
                                  AdornmentColor="Color.Primary"
                                  @bind-Value="_password"
                                  Immediate="true"
                                  Required="true"
                                  RequiredError="Password is required"
                                  Validation="@(new Func<string, string?>(ValidatePassword))" />

                    <MudTextField T="string"
                                  Label="Confirm Password"
                                  Variant="Variant.Outlined"
                                  InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@ToggleConfirmPasswordVisibility"
                                  AdornmentColor="Color.Primary"
                                  @bind-Value="_confirmPassword"
                                  Immediate="true"
                                  Required="true"
                                  RequiredError="Confirm password is required"
                                  Validation="@(new Func<string, string?>(ValidateConfirmPassword))" />
                </MudStack>
            </MudForm>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_errorMessage</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@(_isSending || _isVerifying || _isUpdating)" Style="@($"color: {GetTitleColor()}; text-transform: none;")">Cancel</MudButton>
        @if (_step == DialogStep.EnterCredentials)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SendOtp" Disabled="@_isSending" Class="rounded-lg px-6" Style="@GetButtonStyle()">
                @if (_isSending)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Sending...</span>
                }
                else
                {
                    <span>Send Code</span>
                }
            </MudButton>
        }
        else if (_step == DialogStep.EnterOtp)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="VerifyOtp" Disabled="@(_isVerifying || _remainingSeconds <= 0)" Class="rounded-lg px-6" Style="@GetButtonStyle()">
                @if (_isVerifying)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Verifying...</span>
                }
                else
                {
                    <span>Verify</span>
                }
            </MudButton>
        }
        else if (_step == DialogStep.ChangePassword)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ChangePassword" Disabled="@_isUpdating" Class="rounded-lg px-6" Style="@GetButtonStyle()">
                @if (_isUpdating)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Updating...</span>
                }
                else
                {
                    <span>Change Password</span>
                }
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private enum DialogStep
    {
        EnterCredentials,
        EnterOtp,
        ChangePassword
    }

    private MudForm _credentialsForm = default!;
    private MudForm _otpForm = default!;
    private MudForm _passwordForm = default!;
    private bool _isSending = false;
    private bool _isResending = false;
    private bool _isVerifying = false;
    private bool _isUpdating = false;
    private DialogStep _step = DialogStep.EnterCredentials;

    private string _username = string.Empty;
    private string _email = string.Empty;
    private string _maskedEmail = string.Empty;
    private string _generatedOtp = string.Empty;
    private DateTime _otpGeneratedAt;
    private int _remainingSeconds = 0;
    private System.Threading.Timer? _countdownTimer;
    private int _userId;

    private string[] _otpDigits = new string[4];
    private MudTextField<string>[] _otpInputs = new MudTextField<string>[4];

    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _showPassword = false;
    private bool _showConfirmPassword = false;

    private string _errorMessage = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    protected override void OnInitialized()
    {
        if (ThemeService != null)
        {
            ThemeService.OnThemeChanged += OnThemeChanged;
        }
    }

    private void OnThemeChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        _countdownTimer?.Dispose();
        if (ThemeService != null)
        {
            ThemeService.OnThemeChanged -= OnThemeChanged;
        }
    }

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(10px); min-width: 320px;";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.9); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleColor()
    {
        if (ThemeService == null)
            return "#0f172a";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetTextStyle()
    {
        if (ThemeService == null) return "color: #0f172a;";
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "color: #475569;" : "color: #ffffff;";
    }

    private string GetTextStyleSecondary()
    {
        if (ThemeService == null) return "color: #94a3b8;";
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "color: #64748b;" : "color: rgba(255,255,255,0.7);";
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "text-transform: none;";
        var baseStyle = "text-transform: none;";
        return ThemeService.CurrentTheme == ThemeMode.Light ? $"{baseStyle} color: #0072cf !important;" : baseStyle;
    }

    private string? ValidateEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "Email is required";

        var emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        if (!Regex.IsMatch(email, emailPattern, RegexOptions.IgnoreCase))
            return "Enter a valid email address (e.g., example@mail.com)";

        return null;
    }

    private string? ValidatePassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            return "Password is required";

        if (password.Length < 6)
            return "Password must be at least 6 characters";

        return null;
    }

    private string? ValidateConfirmPassword(string confirmPassword)
    {
        if (string.IsNullOrWhiteSpace(confirmPassword))
            return "Confirm password is required";

        if (confirmPassword != _password)
            return "Passwords do not match";

        return null;
    }

    private static string HashPassword(string password)
    {
        using var sha256 = SHA256.Create();
        var bytes = Encoding.UTF8.GetBytes(password);
        var hash = sha256.ComputeHash(bytes);
        return Convert.ToBase64String(hash);
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;
    private void ToggleConfirmPasswordVisibility() => _showConfirmPassword = !_showConfirmPassword;

    private string MaskEmail(string email)
    {
        var parts = email.Split('@');
        if (parts.Length != 2) return email;

        var username = parts[0];
        var domain = parts[1];

        if (username.Length <= 2)
            return $"{username[0]}***@{domain}";

        return $"{username.Substring(0, 2)}***@{domain}";
    }

    private string FormatTime(int totalSeconds)
    {
        var minutes = totalSeconds / 60;
        var seconds = totalSeconds % 60;
        return $"{minutes:D2}:{seconds:D2}";
    }

    private void StartCountdown()
    {
        _remainingSeconds = 300;
        _countdownTimer?.Dispose();
        _countdownTimer = new System.Threading.Timer(_ =>
        {
            _remainingSeconds--;
            if (_remainingSeconds <= 0)
            {
                _countdownTimer?.Dispose();
                _countdownTimer = null;
            }
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task SendOtp()
    {
        await _credentialsForm.Validate();
        if (!_credentialsForm.IsValid) return;

        _isSending = true;
        _errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var user = await Db.Users.FirstOrDefaultAsync(u => u.Username == _username && u.Email == _email);
            if (user == null)
            {
                _errorMessage = "No account found with this username and email combination.";
                _isSending = false;
                return;
            }

            var duplicateEmailCount = await Db.Users.CountAsync(u => u.Email == _email);
            if (duplicateEmailCount > 1)
            {
                _errorMessage = "Multiple accounts detected. Please contact support.";
                _isSending = false;
                return;
            }

            var random = new Random();
            _generatedOtp = random.Next(1000, 9999).ToString();
            _otpGeneratedAt = DateTime.UtcNow;
            _userId = user.Id;

            await EmailService.SendOtpEmailAsync(_email, _generatedOtp);
            _maskedEmail = MaskEmail(_email);
            _step = DialogStep.EnterOtp;
            StartCountdown();
            Snackbar.Add($"Verification code sent to {_maskedEmail}", Severity.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error sending code: {ex.Message}";
        }
        finally
        {
            _isSending = false;
            StateHasChanged();
        }
    }

    private async Task ResendOtp()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_email))
        {
            _errorMessage = "Session expired. Please start over.";
            _step = DialogStep.EnterCredentials;
            return;
        }

        _errorMessage = string.Empty;
        _otpDigits = new string[4];
        _isResending = true;
        StateHasChanged();

        try
        {
            var user = await Db.Users.FirstOrDefaultAsync(u => u.Username == _username && u.Email == _email);
            if (user == null)
            {
                _errorMessage = "Account verification failed. Please start over.";
                _step = DialogStep.EnterCredentials;
                _isResending = false;
                return;
            }

            var random = new Random();
            _generatedOtp = random.Next(1000, 9999).ToString();
            _otpGeneratedAt = DateTime.UtcNow;

            await EmailService.SendOtpEmailAsync(_email, _generatedOtp);
            StartCountdown();
            Snackbar.Add("Verification code resent!", Severity.Info);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error resending code: {ex.Message}";
        }
        finally
        {
            _isResending = false;
            StateHasChanged();
        }
    }

    private void VerifyOtp()
    {
        _errorMessage = string.Empty;
        var enteredOtp = string.Join("", _otpDigits);

        if (enteredOtp.Length != 4)
        {
            _errorMessage = "Please enter all 4 digits.";
            return;
        }

        var elapsedTime = DateTime.UtcNow - _otpGeneratedAt;
        if (elapsedTime.TotalMinutes > 5)
        {
            _errorMessage = "Verification code has expired. Please request a new one.";
            _otpDigits = new string[4];
            return;
        }

        _isVerifying = true;
        StateHasChanged();

        try
        {
            if (enteredOtp == _generatedOtp)
            {
                _countdownTimer?.Dispose();
                _countdownTimer = null;
                _step = DialogStep.ChangePassword;
            }
            else
            {
                _errorMessage = "Invalid verification code. Please try again.";
                _otpDigits = new string[4];
            }
        }
        finally
        {
            _isVerifying = false;
            StateHasChanged();
        }
    }

    private async Task ChangePassword()
    {
        await _passwordForm.Validate();
        if (!_passwordForm.IsValid) return;

        _isUpdating = true;
        _errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var userInDb = await Db.Users.FindAsync(_userId);
            if (userInDb == null)
            {
                _errorMessage = "User not found.";
                _isUpdating = false;
                return;
            }

            if (userInDb.Username != _username || userInDb.Email != _email)
            {
                _errorMessage = "Account verification failed. Please start over.";
                _isUpdating = false;
                return;
            }

            userInDb.Password = HashPassword(_password);
            await Db.SaveChangesAsync();

            Snackbar.Add("Password changed successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error changing password: {ex.Message}";
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e, int index)
    {
        if (!string.IsNullOrEmpty(_otpDigits[index]) && index < 3)
        {
            await _otpInputs[index + 1].FocusAsync();
        }
        else if (e.Key == "Backspace" && index > 0 && string.IsNullOrEmpty(_otpDigits[index]))
        {
            await _otpInputs[index - 1].FocusAsync();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
