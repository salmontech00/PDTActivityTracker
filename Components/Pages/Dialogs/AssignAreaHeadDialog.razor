@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@implements IDisposable

<style>
    /* SHARED GLASS DIALOG STYLES */

    /* Remove default button borders */
    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    /* --- LIGHT MODE (BLUE GLASS) --- */
    /* White Text/Inputs */
    .glass-dialog.light .mud-input-root,
    .glass-dialog.light .mud-input-slot,
    .glass-dialog.light .mud-input-label,
    .glass-dialog.light .mud-icon-root,
    .glass-dialog.light .mud-input-adornment {
        color: #ffffff !important;
    }

    /* White Borders */
    .glass-dialog.light .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.8) !important;
    }

    .glass-dialog.light .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.light .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #ffffff !important;
        border-width: 2px !important;
    }

    /* Placeholder */
    .glass-dialog.light .mud-input-slot::placeholder {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    /* --- LIGHTEST MODE --- */
    /* Ensure inputs are NOT white (default visibility) */
    .glass-dialog.lightest .mud-input-root,
    .glass-dialog.lightest .mud-input-slot,
    .glass-dialog.lightest .mud-input-label {
        color: #0f172a !important;
    }

    .glass-dialog.lightest .mud-icon-root {
        color: #0072cf !important;
    }

    .glass-dialog.lightest .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 1) !important;
    }

    .glass-dialog.lightest .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.lightest .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #0072cf !important;
    }

    /* MOBILE RESPONSIVE DIALOG */
    @@media (max-width: 600px) {
        .glass-dialog .mud-dialog-actions {
            flex-direction: row;
            justify-content: flex-end;
            align-items: center;
            gap: 8px;
            padding: 8px 12px 12px 12px !important;
        }

            .glass-dialog .mud-dialog-actions .mud-button {
                width: auto !important;
                margin: 0 !important;
                padding: 8px 12px !important;
                font-size: 0.75rem !important;
            }

        .glass-dialog .mud-dialog-content {
            padding: 12px 16px !important;
        }
    }

    /* SPECIFIC FOR NARROW MOBILE (iPhone SE 375px) */
    @@media (max-width: 375px) {
        .glass-dialog {
            padding: 8px !important;
        }

            .glass-dialog .mud-dialog-title {
                padding: 12px 40px 4px 12px !important;
            }

            .glass-dialog .mud-typography-h6 {
                font-size: 1.05rem !important;
                line-height: 1.2 !important;
            }

            .glass-dialog .mud-dialog-content {
                padding: 8px 12px !important;
            }

            .glass-dialog .mud-dialog-actions {
                padding: 8px 8px 12px 8px !important;
                gap: 6px;
            }

                .glass-dialog .mud-dialog-actions .mud-button {
                    min-height: 32px !important;
                    font-size: 0.70rem !important;
                    padding: 6px 10px !important;
                }
    }
</style>

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">Manage Area Head Assignment</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudAutocomplete T="User" Label="Select Area Head" Value="_selectedUser" SearchFunc="@SearchAreaHeads"
                                 ToStringFunc="@(u => u == null ? null : $"{u.Fullname} ({u.EmployeeNumber})")"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary"
                                 Required="true" ValueChanged="OnAreaHeadSelected" />
            </MudItem>

            @if (_selectedUser != null)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mb-1" Style="@($"color: {GetTitleColor()}")">Current Stores Under @_selectedUser.Fullname:</MudText>
                    <MudPaper Class="pa-2 overflow-y-auto" Style="max-height: 150px; background: rgba(255,255,255,0.05);">
                        @if (_currentStores.Any())
                        {
                            <MudList T="Store" Dense="true" ReadOnly="true">
                                @foreach (var s in _currentStores)
                                {
                                    <MudListItem>
                                        <div class="d-flex justify-space-between width-100 align-center">
                                            <span>@s.StoreCode - @s.StoreName</span>
                                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveStore(s))" Title="Remove Store" />
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="pa-2" Style="opacity: 0.7">No stores currently assigned.</MudText>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mb-1" Style="@($"color: {GetTitleColor()}")">Available Stores to Add (Unassigned to Area Head):</MudText>
                    <MudTextField @bind-Value="_storeSearch" Placeholder="Search stores..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" TextChanged="FilterAvailableStores" />
                    <MudPaper @key="@(_selectedUser?.Id ?? 0)" Class="pa-2 mt-2 overflow-y-auto" Style="max-height: 200px; background: rgba(255,255,255,0.05);">
                        <MudList @key="@(_selectedUser?.Id ?? 0)" T="Store" Dense="true" Clickable="true"
                                 SelectedValues="_selectedStoresToAdd" SelectedValuesChanged="OnSelectedStoresChanged"
                                 SelectionMode="SelectionMode.MultiSelection" CheckBoxColor="Color.Primary">
                            @foreach (var s in _filteredAvailableStores)
                            {
                                <MudListItem Value="@s">
                                    <div class="d-flex justify-space-between width-100 align-center">
                                        <div class="d-flex flex-column">
                                            <span>@s.StoreCode - @s.StoreName</span>
                                            @if (s.AreaHead != null)
                                            {
                                                <span style="color: #ff9800; font-size: 0.75em">Currently: @s.AreaHead.Fullname</span>
                                            }
                                        </div>
                                        <span style="opacity: 0.6; font-size: 0.8em">@s.Location</span>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Remarks (Optional)" @bind-Value="_remarks" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="mt-3" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Style="@($"color: {GetTitleColor()}; opacity: 0.7")">
                        Summary: Current: <strong>@_currentStores.Count</strong> | To Add: <strong>@(_selectedStoresToAdd?.Count ?? 0)</strong> | Total After: <strong>@(_currentStores.Count + (_selectedStoresToAdd?.Count ?? 0))</strong>
                    </MudText>
                </MudItem>
            }

        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="@GetCancelButtonStyle()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(_selectedUser == null)" Style="@GetButtonStyle()">Update</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    // Optional: Pass pre-selected stores if triggered from Bulk Actions
    [Parameter] public List<Store> PreSelectedStores { get; set; } = new();

    private User? _selectedUser;
    private List<Store> _currentStores = new();
    private List<Store> _originalStores = new();
    private List<Store> _allAvailableStores = new();
    private List<Store> _filteredAvailableStores = new();
    private HashSet<Store> _selectedStoresToAdd = new();
    private string? _remarks;

    private string _storeSearch = "";

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged() => StateHasChanged();

    public void Dispose() => ThemeService.OnThemeChanged -= OnThemeChanged;

    private async Task<IEnumerable<User>> SearchAreaHeads(string value, CancellationToken token)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        // Strictly filter by Role = "Area Head"
        var query = db.Users.AsNoTracking().Where(u => u.Status == "Active" && u.Role == "Area Head");

        if (!string.IsNullOrEmpty(value))
        {
            query = query.Where(u => u.Fullname.Contains(value) || (u.EmployeeNumber != null && u.EmployeeNumber.Contains(value)));
        }

        return await query.ToListAsync();
    }

    private async Task OnAreaHeadSelected(User user)
    {
        _selectedUser = user;
        _remarks = null;
        _selectedStoresToAdd = new HashSet<Store>();

        // Clear lists immediately to prevent stale data display while loading
        _currentStores = new List<Store>();
        _originalStores = new List<Store>();
        _allAvailableStores = new List<Store>();
        _filteredAvailableStores = new List<Store>();

        if (_selectedUser != null)
        {
            await LoadStores();
        }
        StateHasChanged();
    }

    private async Task LoadStores()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Load stores currently assigned to this Area Head
        _currentStores = await db.Stores.AsNoTracking()
            .Where(s => s.AreaHeadId == _selectedUser!.Id)
            .OrderBy(s => s.StoreCode)
            .ToListAsync();

        _originalStores = new List<Store>(_currentStores);

        // Load all stores EXCEPT those already assigned to THIS Area Head
        _allAvailableStores = await db.Stores.AsNoTracking()
            .Include(s => s.AreaHead)
            .Where(s => s.AreaHeadId != _selectedUser!.Id)
            .OrderBy(s => s.StoreCode)
            .ToListAsync();

        // Pre-select stores if passed via parameter
        if (PreSelectedStores != null && PreSelectedStores.Any())
        {
            var preSelectedIds = PreSelectedStores.Select(ps => ps.Id).ToHashSet();
            var toSelect = _allAvailableStores.Where(s => preSelectedIds.Contains(s.Id)).ToList();
            _selectedStoresToAdd = new HashSet<Store>(toSelect);
        }

        FilterAvailableStores(_storeSearch);
    }

    private void FilterAvailableStores(string search)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            _filteredAvailableStores = _allAvailableStores;
        }
        else
        {
            _filteredAvailableStores = _allAvailableStores
                .Where(s => s.StoreName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                            s.StoreCode.Contains(search, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void RemoveStore(Store store)
    {
        _currentStores.Remove(store);
        if (!_allAvailableStores.Any(as_ => as_.Id == store.Id))
        {
            _allAvailableStores.Add(store);
            _allAvailableStores = _allAvailableStores.OrderBy(s => s.StoreCode).ToList();
            FilterAvailableStores(_storeSearch);
        }
        StateHasChanged();
    }

    private async Task Submit()
    {
        if (_selectedUser == null) return;

        using var db = await DbFactory.CreateDbContextAsync();

        // 1. Handle Unassignments
        var originalIds = _originalStores.Select(s => s.Id).ToList();
        var currentIds = _currentStores.Select(s => s.Id).ToList();
        var removedStoreIds = originalIds.Except(currentIds).ToList();

        if (removedStoreIds.Any())
        {
            var storesToUnassign = await db.Stores.Where(s => removedStoreIds.Contains(s.Id)).ToListAsync();
            foreach (var store in storesToUnassign)
            {
                var previousHeadId = store.AreaHeadId;
                store.AreaHeadId = null;

                db.StoreAssignmentLogs.Add(new StoreAssignmentLog
                {
                    StoreId = store.Id,
                    UserId = previousHeadId,
                    Role = "Area Head",
                    Action = "Unassigned",
                    Timestamp = DateTime.Now,
                    Remarks = string.IsNullOrEmpty(_remarks) ? "Removed from Area Head assignment in management dialog." : _remarks
                });
            }
        }

        // 2. Handle Additions
        // Important: Filter out stores that are ALREADY in the current list to avoid redundant logs/operations
        // and reconcile with the user's manual selections in the MudList.
        var selectedStores = _selectedStoresToAdd?.ToList() ?? new List<Store>();
        var currentStoreIds = _currentStores.Select(s => s.Id).ToHashSet();

        var newStoresToAdd = selectedStores.Where(s => !currentStoreIds.Contains(s.Id)).ToList();

        if (newStoresToAdd.Any())
        {
            var newIds = newStoresToAdd.Select(s => s.Id).ToList();
            var storesToUpdate = await db.Stores.Where(s => newIds.Contains(s.Id)).ToListAsync();
            foreach (var store in storesToUpdate)
            {
                store.AreaHeadId = _selectedUser.Id;

                db.StoreAssignmentLogs.Add(new StoreAssignmentLog
                {
                    StoreId = store.Id,
                    UserId = _selectedUser.Id,
                    Role = "Area Head",
                    Action = "Assigned",
                    Timestamp = DateTime.Now,
                    Remarks = string.IsNullOrEmpty(_remarks) ? "Bulk Area Head Assignment" : _remarks
                });
            }
        }

        await db.SaveChangesAsync();
        MudDialog.Close(DialogResult.Ok(new AreaHeadAssignmentResult
        {
            HasAssigned = newStoresToAdd.Any(),
            HasUnassigned = removedStoreIds.Any()
        }));
    }

    public class AreaHeadAssignmentResult
    {
        public bool HasAssigned { get; set; }
        public bool HasUnassigned { get; set; }
    }

    private void Cancel() => MudDialog.Cancel();

    private void OnSelectedStoresChanged(IEnumerable<Store> values)
    {
        _selectedStoresToAdd = values?.ToHashSet() ?? new HashSet<Store>();
        StateHasChanged();
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(15px); min-width: 320px;";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleColor()
    {
        if (ThemeService == null) return "#0f172a";
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "text-transform: none; font-weight: 600;";
        var baseStyle = "text-transform: none; font-weight: 600;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? $"{baseStyle} color: #0072cf !important; background-color: #ffffff !important;"
            : baseStyle;
    }

    private string GetCancelButtonStyle()
    {
        return $"color: {GetTitleColor()}; text-transform: none; font-weight: 600;";
    }
}
