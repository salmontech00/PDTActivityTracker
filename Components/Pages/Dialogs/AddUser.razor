@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Model
@using System.Security.Cryptography
@using System.Text
@using System.Text.RegularExpressions
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject AppDbContext Db
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<style>
    /* OTP-style dialog */
    .mud-dialog-card {
        background: #1e3a6f !important;
        border-top: 5px solid #667fb5;
        border-left: 3px solid #667fb5;
        border-radius: 4px;
    }

        .mud-dialog-card.dark {
            background: #0f172a !important;
        }

    .mud-dialog-title {
        color: #ffffff !important;
    }

    /* Form styling matching OTP dialog */
    .add-user-form .mud-input-root {
        margin-bottom: 14px;
    }

    /* Input labels and text */
    .add-user-form .mud-input-label {
        color: #6b7ed8 !important;
        font-weight: 500;
        font-size: 0.85rem;
    }

    .add-user-form .mud-input-outlined .mud-input-slot {
        color: #6b7ed8;
    }

    .add-user-form .mud-input-outlined-border {
        border-color: #667fb5 !important;
        border-width: 2px !important;
    }

    /* Focused state */
    .add-user-form .mud-input-outlined:hover .mud-input-outlined-border {
        border-color: #667fb5 !important;
        border-width: 2px !important;
    }

    .add-user-form .mud-input-outlined.mud-input-focused .mud-input-outlined-border {
        border-color: #667fb5 !important;
        border-width: 2px !important;
    }

    .add-user-form .mud-input-outlined.mud-input-focused .mud-input-label {
        color: #667fb5 !important;
    }

    /* Input text color */
    .add-user-form .mud-input-control {
        font-size: 0.9rem;
        color: #667fb5 !important;
        background-color: transparent !important;
    }

    .add-user-form .mud-input {
        color: #667fb5 !important;
        background-color: transparent !important;
    }

        .add-user-form .mud-input::placeholder {
            color: #667fb5;
            opacity: 0.6;
        }

    /* Adornment icons */
    .add-user-form .mud-input-adornment .mud-icon-root {
        color: #667fb5 !important;
    }

    /* Select dropdowns */
    .add-user-form .mud-select {
        color: #667fb5 !important;
    }

    .add-user-form .mud-select-input {
        color: #667fb5 !important;
    }

    /* Action buttons */
    .add-user-dialog-button {
        height: 40px;
        font-weight: 500;
        text-transform: none;
        font-size: 0.9rem;
        background-color: #2b467f !important;
        border: 2px solid #667fb5 !important;
        color: #ffffff !important;
        box-shadow: none !important;
    }

        .add-user-dialog-button:hover {
            background-color: #1e3161 !important;
            border: 2px solid #667fb5 !important;
        }

        .add-user-dialog-button:disabled {
            background-color: #2b467f !important;
            border: 2px solid #667fb5 !important;
            opacity: 0.7;
        }

    @@media (max-width: 600px) {
        .add-user-form .mud-input-label {
            font-size: 0.8rem;
        }

        .add-user-form .mud-input-control {
            font-size: 0.85rem;
        }
    }
</style>

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" Class="@($"mud-dialog-card {(ThemeService.IsDarkMode ? "dark" : "")}")">
    <TitleContent>
        Add User
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_newUser" Class="add-user-form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Full Name"
                                  @bind-Value="_newUser.Fullname"
                                  Required="true"
                                  RequiredError="Full name is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Username"
                                  @bind-Value="_newUser.Username"
                                  Required="true"
                                  RequiredError="Username is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Email"
                                  @bind-Value="_newUser.Email"
                                  Required="true"
                                  RequiredError="Email is required"
                                  Validation="@(new Func<string, string?>(ValidateEmail))"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="Role"
                               @bind-Value="_newUser.Role"
                               Required="true"
                               RequiredError="Role is required"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                        <MudSelectItem Value="@("Cashier")">Cashier</MudSelectItem>
                        <MudSelectItem Value="@("Faculty")">Faculty</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Password"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  @bind-Value="_newUser.Password"
                                  Required="true"
                                  RequiredError="Password is required"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Confirm Password"
                                  InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                  @bind-Value="_confirmPassword"
                                  Required="true"
                                  RequiredError="Confirm Password is required"
                                  Immediate="true"
                                  Validation="@(new Func<string, string?>(ValidateConfirmPassword))"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="ToggleConfirmPasswordVisibility"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Style="color: #ffffff;">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@_isSaving" Class="add-user-dialog-button">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Adding...</span>
            }
            else
            {
                <span>Add</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm _form = default!;
    private bool _isSaving = false;
    private User _newUser = new();
    private string _confirmPassword = string.Empty;
    private bool _showPassword = false;
    private bool _showConfirmPassword = false;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public bool IsDarkMode { get; set; }

    private string? ValidateConfirmPassword(string confirmPassword)
    {
        if (confirmPassword != _newUser.Password)
            return "Passwords do not match";
        return null;
    }

    private string? ValidateEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "Email is required";

        var emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        if (!Regex.IsMatch(email, emailPattern, RegexOptions.IgnoreCase))
            return "Enter a valid email address";

        return null;
    }

    private static string HashPassword(string password)
    {
        using var sha256 = SHA256.Create();
        var bytes = Encoding.UTF8.GetBytes(password);
        var hash = sha256.ComputeHash(bytes);
        return Convert.ToBase64String(hash);
    }

    private async Task Submit()
    {
        await _form.Validate();

        if (!_form.IsValid)
            return;

        _isSaving = true;

        try
        {
            var existingUsername = Db.Users
                .FirstOrDefault(u => u.Username != null && u.Username.ToLower() == _newUser.Username.ToLower());

            if (existingUsername != null)
            {
                Snackbar.Add("Username already exists.", Severity.Warning);
                _isSaving = false;
                return;
            }

            var existingEmail = Db.Users
                .FirstOrDefault(u => u.Email != null && u.Email.ToLower() == (_newUser.Email ?? "").ToLower());

            if (existingEmail != null)
            {
                Snackbar.Add("Email already exists.", Severity.Warning);
                _isSaving = false;
                return;
            }

            _newUser.Password = HashPassword(_newUser.Password);

            Db.Users.Add(_newUser);
            await Db.SaveChangesAsync();

            Snackbar.Add("User added successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            _isSaving = false;
        }
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;
    private void ToggleConfirmPasswordVisibility() => _showConfirmPassword = !_showConfirmPassword;
    private void Cancel() => MudDialog.Cancel();
}
