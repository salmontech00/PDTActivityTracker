@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Model
@using PDTActivityTracker.Components.Services
@using System.Security.Cryptography
@using System.Text
@using System.Text.RegularExpressions
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject AppDbContext Db
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" Style="@GetDialogStyle()">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 700;">ADD NEW USER</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_newUser">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Full Name"
                                  @bind-Value="_newUser.Fullname"
                                  Required="true"
                                  RequiredError="Full name is required"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Username"
                                  @bind-Value="_newUser.Username"
                                  Required="true"
                                  RequiredError="Username is required"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Email"
                                  @bind-Value="_newUser.Email"
                                  Required="true"
                                  RequiredError="Email is required"
                                  Validation="@(new Func<string, string?>(ValidateEmail))"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="Role"
                               @bind-Value="_newUser.Role"
                               Required="true"
                               RequiredError="Role is required"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                        <MudSelectItem Value="@("AVP")">AVP</MudSelectItem>
                        <MudSelectItem Value="@("Area Head")">Area Head</MudSelectItem>
                        <MudSelectItem Value="@("Store Head")">Store Head</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Position"
                                  @bind-Value="_newUser.Position"
                                  Required="true"
                                  RequiredError="Position is required"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Area"
                                  @bind-Value="_newUser.Area"
                                  Required="true"
                                  RequiredError="Area is required"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudSelect T="string"
                               Label="Access Tags"
                               MultiSelection="true"
                               @bind-Value="_dummyTag"
                               @bind-SelectedValues="_selectedTags"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var tag in _availableTags)
                        {
                            <MudSelectItem Value="@tag.Name">@tag.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Password"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  @bind-Value="_newUser.Password"
                                  Required="true"
                                  RequiredError="Password is required"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Confirm Password"
                                  InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                  @bind-Value="_confirmPassword"
                                  Required="true"
                                  RequiredError="Confirm Password is required"
                                  Immediate="true"
                                  Validation="@(new Func<string, string?>(ValidateConfirmPassword))"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="ToggleConfirmPasswordVisibility"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@_isSaving" Variant="Variant.Filled" Class="px-6 rounded-lg" Style="@GetButtonStyle()">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Creating...</span>
            }
            else
            {
                <span>Create User</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm _form = default!;
    private bool _isSaving = false;
    private User _newUser = new() { Role = "Store Head" };
    private string _confirmPassword = string.Empty;
    private bool _showPassword = false;
    private bool _showConfirmPassword = false;

    private List<AccessTag> _availableTags = new();
    private IEnumerable<string> _selectedTags = new List<string>();
    private string _dummyTag = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadTags();
    }

    private async Task LoadTags()
    {
        _availableTags = await Db.AccessTags.OrderBy(t => t.Name).ToListAsync();
    }

    private string GetDialogStyle()
    {
        var baseStyle = "border-top: 5px solid #0072cf; border-radius: 12px;";
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Light => $"{baseStyle} background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);",
            ThemeMode.Dark => $"{baseStyle} background: rgba(30, 41, 59, 0.95); backdrop-filter: blur(10px);",
            _ => baseStyle
        };
    }

    private string GetButtonStyle()
    {
        return ThemeService.CurrentTheme == ThemeMode.Light ? "color: #0072cf !important; background-color: white !important; font-weight: 600;" : "font-weight: 600;";
    }

    private string? ValidateConfirmPassword(string confirmPassword)
    {
        if (confirmPassword != _newUser.Password)
            return "Passwords do not match";
        return null;
    }

    private string? ValidateEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "Email is required";

        var emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        if (!Regex.IsMatch(email, emailPattern, RegexOptions.IgnoreCase))
            return "Enter a valid email address";

        return null;
    }

    private static string HashPassword(string password)
    {
        using var sha256 = SHA256.Create();
        var bytes = Encoding.UTF8.GetBytes(password);
        var hash = sha256.ComputeHash(bytes);
        return Convert.ToBase64String(hash);
    }

    private async Task Submit()
    {
        await _form.Validate();

        if (!_form.IsValid)
            return;

        _isSaving = true;

        try
        {
            var existingUsername = Db.Users
                .FirstOrDefault(u => u.Username != null && u.Username.ToLower() == _newUser.Username.ToLower());

            if (existingUsername != null)
            {
                Snackbar.Add("Username already exists.", Severity.Warning);
                _isSaving = false;
                return;
            }

            var existingEmail = Db.Users
                .FirstOrDefault(u => u.Email != null && u.Email.ToLower() == (_newUser.Email ?? "").ToLower());

            if (existingEmail != null)
            {
                Snackbar.Add("Email already exists.", Severity.Warning);
                _isSaving = false;
                return;
            }

            _newUser.Tags = string.Join(",", _selectedTags);
            _newUser.Password = HashPassword(_newUser.Password);

            Db.Users.Add(_newUser);
            await Db.SaveChangesAsync();

            Snackbar.Add("User added successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            _isSaving = false;
        }
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;
    private void ToggleConfirmPasswordVisibility() => _showConfirmPassword = !_showConfirmPassword;
    private void Cancel() => MudDialog.Cancel();
}
