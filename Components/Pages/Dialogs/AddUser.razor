@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Model
@using PDTActivityTracker.Components.Services
@using System.Security.Cryptography
@using System.Text
@using System.Text.RegularExpressions
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject AppDbContext Db
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<style>
    /* SHARED GLASS DIALOG STYLES */

    /* Remove default button borders */
    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    /* --- LIGHT MODE (BLUE GLASS) --- */
    /* White Text/Inputs */
    .glass-dialog.light .mud-input-root,
    .glass-dialog.light .mud-input-slot,
    .glass-dialog.light .mud-input-label,
    .glass-dialog.light .mud-icon-root,
    .glass-dialog.light .mud-input-adornment {
        color: #ffffff !important;
    }

    /* White Borders */
    .glass-dialog.light .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.8) !important;
    }

    .glass-dialog.light .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.light .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #ffffff !important;
        border-width: 2px !important;
    }

    /* Placeholder */
    .glass-dialog.light .mud-input-slot::placeholder {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    /* --- LIGHTEST MODE --- */
    /* Ensure inputs are NOT white (default visibility) */
    .glass-dialog.lightest .mud-input-root,
    .glass-dialog.lightest .mud-input-slot,
    .glass-dialog.lightest .mud-input-label {
        color: #0f172a !important;
    }

    .glass-dialog.lightest .mud-icon-root {
        color: #0072cf !important;
    }

    .glass-dialog.lightest .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 1) !important;
    }

    .glass-dialog.lightest .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.lightest .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #0072cf !important;
    }
</style>

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">Add User</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_newUser" Class="@GetFormClass()">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Full Name"
                                  @bind-Value="_newUser.Fullname"
                                  Required="true"
                                  RequiredError="Full name is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Employee Number"
                                  @bind-Value="_newUser.EmployeeNumber"
                                  Required="true"
                                  RequiredError="Employee number is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Designation"
                                  @bind-Value="_newUser.Designation"
                                  Required="true"
                                  RequiredError="Designation is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Email"
                                  @bind-Value="_newUser.Email"
                                  Required="true"
                                  RequiredError="Email is required"
                                  Validation="@(new Func<string, string?>(ValidateEmail))"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Username"
                                  @bind-Value="_newUser.Username"
                                  Required="true"
                                  RequiredError="Username is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudSelect T="string"
                               Label="Access Level"
                               @bind-Value="_newUser.Role"
                               Required="true"
                               RequiredError="Access level is required"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                        <MudSelectItem Value="@("AVP")">AVP</MudSelectItem>
                        <MudSelectItem Value="@("Area Head")">Area Head</MudSelectItem>
                        <MudSelectItem Value="@("Store Head")">Store Head</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudSelect T="string"
                               Label="Status"
                               @bind-Value="_newUser.Status"
                               Required="true"
                               RequiredError="Status is required"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                        <MudSelectItem Value="@("Inactive")">Inactive</MudSelectItem>
                    </MudSelect>
                </MudItem>


                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Password"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  @bind-Value="_newUser.Password"
                                  Required="true"
                                  RequiredError="Password is required"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  AdornmentColor="@GetAdornmentColor()"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Confirm Password"
                                  InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                  @bind-Value="_confirmPassword"
                                  Required="true"
                                  RequiredError="Confirm Password is required"
                                  Immediate="true"
                                  Validation="@(new Func<string, string?>(ValidateConfirmPassword))"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="ToggleConfirmPasswordVisibility"
                                  AdornmentColor="@GetAdornmentColor()"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Style="@GetCancelButtonStyle()">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@_isSaving" Class="rounded-lg px-6" Style="@GetButtonStyle()">
            @if (_isSaving)
            {
                <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Adding...</span>
            }
            else
            {
                <span>Add</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm _form = default!;
    private bool _isSaving = false;
    private User _newUser = new() { Role = "Store Head" };
    private string _confirmPassword = string.Empty;
    private bool _showPassword = false;
    private bool _showConfirmPassword = false;


    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetFormClass()
    {
        // No specific form classes needed yet, but keeping for consistency if required later
        return "";
    }

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(10px); min-width: 320px;";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleColor()
    {
        if (ThemeService == null)
            return "#0f172a";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "text-transform: none; font-weight: 600;";
        var baseStyle = "text-transform: none; font-weight: 600;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? $"{baseStyle} color: #0072cf !important; background-color: #ffffff !important;"
            : baseStyle;
    }

    private string GetCancelButtonStyle()
    {
        return $"color: {GetTitleColor()}; text-transform: none; font-weight: 600;";
    }

    private Color GetAdornmentColor()
    {
        if (ThemeService == null) return Color.Primary;
        return ThemeService.CurrentTheme == ThemeMode.Light ? Color.Surface : Color.Primary;
    }


    private string? ValidateConfirmPassword(string confirmPassword)
    {
        if (confirmPassword != _newUser.Password)
            return "Passwords do not match";
        return null;
    }

    private string? ValidateEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "Email is required";

        var emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        if (!Regex.IsMatch(email, emailPattern, RegexOptions.IgnoreCase))
            return "Enter a valid email address";

        return null;
    }

    private static string HashPassword(string password)
    {
        using var sha256 = SHA256.Create();
        var bytes = Encoding.UTF8.GetBytes(password);
        var hash = sha256.ComputeHash(bytes);
        return Convert.ToBase64String(hash);
    }

    private async Task Submit()
    {
        await _form.Validate();

        if (!_form.IsValid)
            return;

        _isSaving = true;

        try
        {
            var existingUsername = Db.Users
                .FirstOrDefault(u => u.Username != null && u.Username.ToLower() == _newUser.Username.ToLower());

            if (existingUsername != null)
            {
                Snackbar.Add("Username already exists.", Severity.Warning);
                _isSaving = false;
                return;
            }

            var existingEmail = Db.Users
                .FirstOrDefault(u => u.Email != null && u.Email.ToLower() == (_newUser.Email ?? "").ToLower());

            if (existingEmail != null)
            {
                Snackbar.Add("Email already exists.", Severity.Warning);
                _isSaving = false;
                return;
            }

            _newUser.Password = HashPassword(_newUser.Password);

            Db.Users.Add(_newUser);
            await Db.SaveChangesAsync();

            Snackbar.Add("User added successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            _isSaving = false;
        }
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;
    private void ToggleConfirmPasswordVisibility() => _showConfirmPassword = !_showConfirmPassword;
    private void Cancel() => MudDialog.Cancel();
}