@using MudBlazor
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<style>
    /* SHARED GLASS DIALOG STYLES */

    /* Remove default button borders */
    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    /* --- LIGHT MODE (BLUE GLASS) --- */
    .glass-dialog.light .info-label {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    .glass-dialog.light .info-value {
        color: #ffffff !important;
    }

    /* --- LIGHTEST MODE --- */
    .glass-dialog.lightest .info-label {
        color: #64748b !important;
    }

    .glass-dialog.lightest .info-value {
        color: #0f172a !important;
    }

    .profile-section {
        text-align: center;
        padding: 20px 0;
        margin-bottom: 20px;
    }

    .profile-image {
        max-width: 150px;
        max-height: 150px;
        border-radius: 16px;
        object-fit: contain;
        margin-bottom: 12px;
    }

    .placeholder-container {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(0, 114, 207, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        color: #0072cf;
    }

    .glass-dialog.dark .placeholder-container,
    .glass-dialog.light .placeholder-container {
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
    }

    .info-item {
        padding: 12px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
    }

    .glass-dialog.lightest .info-item {
        background: rgba(0, 114, 207, 0.05);
        border: 1px solid rgba(0, 114, 207, 0.1);
    }

    .info-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .info-value {
        font-size: 0.95rem;
        font-weight: 600;
        word-break: break-all;
    }

    .status-chip {
        font-weight: 700 !important;
        border-radius: 12px !important;
    }
</style>

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">User Details</MudText>
    </TitleContent>

    <DialogContent>
        <div class="profile-section">
            @if (UserToView.ImageData != null)
            {
                <img src="@GetUserImagePath()"
                     alt="User Profile"
                     class="profile-image" />
            }
            else
            {
                <div class="placeholder-container">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 64px;" />
                </div>
            }
            <MudText Typo="Typo.h5" Style="@($"color: {GetTitleColor()}; font-weight: 800;")">@UserToView.Fullname</MudText>
            <MudText Typo="Typo.subtitle1" Style="@($"color: {GetTitleColor()}; opacity: 0.8; font-weight: 600;")">@@@UserToView.Username</MudText>
        </div>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="4">
                <div class="info-item">
                    <div class="info-label">Employee Number</div>
                    <div class="info-value">@(string.IsNullOrEmpty(UserToView.EmployeeNumber) ? "N/A" : UserToView.EmployeeNumber)</div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="info-item">
                    <div class="info-label">Designation</div>
                    <div class="info-value">@(string.IsNullOrEmpty(UserToView.Designation) ? "N/A" : UserToView.Designation)</div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="info-item">
                    <div class="info-label">Access Level</div>
                    <div class="info-value">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Text"
                                 Class="@($"status-chip {GetRoleChipClass(UserToView.Role)}")">
                            @UserToView.Role
                        </MudChip>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="8">
                <div class="info-item">
                    <div class="info-label">Email Address</div>
                    <div class="info-value">@UserToView.Email</div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="info-item">
                    <div class="info-label">Status</div>
                    <div class="info-value">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Text"
                                 Class="@($"status-chip {GetStatusChipClass(UserToView.Status ?? "Active")}")">
                            @UserToView.Status
                        </MudChip>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled" Class="rounded-lg px-6" Style="@GetButtonStyle()">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public User UserToView { get; set; } = default!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(10px); min-width: 320px;";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleColor()
    {
        if (ThemeService == null)
            return "#0f172a";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "text-transform: none; font-weight: 600;";
        var baseStyle = "text-transform: none; font-weight: 600;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? $"{baseStyle} color: #0072cf !important; background-color: #ffffff !important;"
            : baseStyle;
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetUserImagePath()
    {
        if (UserToView.ImageData != null && !string.IsNullOrEmpty(UserToView.ImageMimeType))
        {
            return $"data:{UserToView.ImageMimeType};base64,{Convert.ToBase64String(UserToView.ImageData)}";
        }
        return "/Uploads/UserImg.png";
    }

    private string GetRoleChipClass(string role) => role switch
    {
        "Admin" => "role-chip-success",
        "AVP" => "role-chip-secondary",
        "Area Head" => "role-chip-info",
        "Store Head" => "role-chip-success",
        _ => "role-chip-success"
    };

    private string GetStatusChipClass(string status) => status switch
    {
        "Active" => "status-chip-active",
        "Inactive" => "status-chip-inactive",
        _ => "status-chip-active"
    };

    private void Close() => MudDialog.Close();
}
