@using MudBlazor
@using PDTActivityTracker.Components.Services
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@implements IDisposable

<style>
    /* Dialog styling with theme support */
    .profile-preview-dialog {
        width: 50%;
        max-width: 500px;
        min-width: 320px;
        box-shadow: none;
        text-align: center;
        margin: auto;
        border-radius: 16px;
        overflow: hidden;
    }

        .profile-preview-dialog.lightest {
            /* Removed background/border to use inline style */
        }

        .profile-preview-dialog.light {
            /* Removed background/border to use inline style */
        }

        .profile-preview-dialog.dark {
            /* Removed background/border to use inline style */
        }

    .profile-preview-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 40px 30px;
    }

    .profile-preview-image {
        width: 400px;
        height: 400px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 8px 32px rgba(0, 114, 207, 0.3);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .profile-preview-image:hover {
            transform: scale(1.02);
            box-shadow: 0 12px 40px rgba(0, 114, 207, 0.4);
        }

    .profile-preview-username {
        font-weight: 600;
        margin-top: 16px;
    }

        .profile-preview-username.lightest {
            color: #0072cf;
        }

        .profile-preview-username.light {
            color: #ffffff;
        }

        .profile-preview-username.dark {
            color: #0072cf;
        }

    .profile-preview-role {
        font-size: 0.875rem;
        opacity: 0.8;
        margin-top: 4px;
    }

        .profile-preview-role.lightest {
            color: #475569;
        }

        .profile-preview-role.light {
            color: #cbd5e1;
        }

        .profile-preview-role.dark {
            color: #cbd5e1;
        }

    /* Tablet screens */
    @@media (max-width: 768px) {
        .profile-preview-dialog {
            width: 70%;
            max-width: 400px;
            min-width: 280px;
        }

        .profile-preview-content {
            padding: 30px 20px;
        }

        .profile-preview-image {
            width: 350px;
            height: 350px;
            border-width: 3px;
        }

        .profile-preview-username {
            margin-top: 14px;
            font-size: 1rem;
        }

        .profile-preview-role {
            font-size: 0.813rem;
        }
    }

    /* Phone screens */
    @@media (max-width: 480px) {
        .profile-preview-dialog {
            width: 85%;
            max-width: 320px;
            min-width: 240px;
        }

        .profile-preview-content {
            padding: 20px 15px;
        }

        .profile-preview-image {
            width: 280px;
            height: 280px;
            border-width: 3px;
            box-shadow: 0 6px 24px rgba(0, 114, 207, 0.25);
        }

            .profile-preview-image:hover {
                transform: scale(1.01);
                box-shadow: 0 8px 28px rgba(0, 114, 207, 0.3);
            }

        .profile-preview-username {
            font-size: 0.938rem;
            margin-top: 12px;
        }

        .profile-preview-role {
            font-size: 0.75rem;
            margin-top: 2px;
        }
    }

    /* Small phone screens */
    @@media (max-width: 360px) {
        .profile-preview-dialog {
            width: 90%;
            max-width: 280px;
            min-width: 200px;
        }

        .profile-preview-content {
            padding: 15px 10px;
        }

        .profile-preview-image {
            width: 240px;
            height: 240px;
            border-width: 2px;
            box-shadow: 0 4px 20px rgba(0, 114, 207, 0.2);
        }

        .profile-preview-username {
            font-size: 0.875rem;
            margin-top: 10px;
        }

        .profile-preview-role {
            font-size: 0.688rem;
        }
    }
</style>

<MudDialog Class="profile-preview-dialog" Style="@GetDialogStyle()">
    <DialogContent>
        <div class="profile-preview-content">
            <img src="@(ImagePath ?? "/Uploads/UserImg.png")"
                 alt="User Profile"
                 class="profile-preview-image" />
            <MudText Typo="Typo.h6" Class="@GetUsernameClass()">
                @(Username ?? "User")
            </MudText>
            @if (!string.IsNullOrEmpty(Role))
            {
                <MudText Typo="Typo.body2" Class="@GetRoleClass()">
                    @Role
                </MudText>
            }
        </div>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public string? ImagePath { get; set; }
    [Parameter] public string? Username { get; set; }
    [Parameter] public string? Role { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "lightest",
            ThemeMode.Light => "light",
            ThemeMode.Dark => "dark",
            _ => "lightest"
        };
    }

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(0px);";
        // Note: min-width and other layout properties are handled by CSS class .profile-preview-dialog

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0); border: 1px solid rgba(255,255,255,0);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0); border: 1px solid rgba(255,255,255,0);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0);"
        };
    }

    private string GetUsernameClass()
    {
        return $"profile-preview-username {GetThemeClass()}";
    }

    private string GetRoleClass()
    {
        return $"profile-preview-role {GetThemeClass()}";
    }
}