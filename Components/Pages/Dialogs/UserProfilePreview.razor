@using MudBlazor
@using PDTActivityTracker.Components.Services
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<MudDialog Style="@GetDialogStyle()" Class="rounded-xl overflow-hidden">
    <DialogContent>
        <div class="d-flex flex-column align-center py-8">
            <MudAvatar Image="@ImagePath" Style="width: 280px; height: 280px; border: 4px solid #0072cf;" Elevation="4" />
            <MudText Typo="Typo.h5" Class="mt-6" Style="@GetTextStyle(true)">@Username</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Role</MudText>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public string? ImagePath { get; set; }
    [Parameter] public string? Username { get; set; }
    [Parameter] public string? Role { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string GetDialogStyle()
    {
        var baseStyle = "border-top: 5px solid #0072cf; border-radius: 24px;";
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Light => $"{baseStyle} background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(15px);",
            ThemeMode.Dark => $"{baseStyle} background: rgba(30, 41, 59, 0.9); backdrop-filter: blur(15px);",
            _ => baseStyle
        };
    }

    private string GetTextStyle(bool isHeader)
    {
        return ThemeService.CurrentTheme == ThemeMode.Light ? "color: #0f172a; font-weight: 700;" : "color: #f8fafc; font-weight: 700;";
    }
}
