@using MudBlazor
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject UserStateService UserState
@inject ISnackbar Snackbar

<style>
    /* SHARED GLASS DIALOG STYLES */
    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    .detail-table {
        background: transparent !important;
    }

        .detail-table .mud-table-head {
            background: rgba(0, 114, 207, 0.1);
        }

    .lightest .detail-table .mud-table-head {
        background: rgba(0, 114, 207, 0.05);
    }

    .detail-table .mud-table-cell {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        padding: 8px 12px !important;
        font-size: 0.85rem;
    }

    .lightest .detail-table .mud-table-cell {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .frequency-chip {
        font-size: 0.7rem !important;
        height: 20px !important;
        border-radius: 8px !important;
        font-weight: 700 !important;
        padding: 8px 8px 8px 8px !important;
    }

    .status-chip {
        font-size: 0.7rem !important;
        height: 20px !important;
        border-radius: 8px !important;
        font-weight: 700 !important;
        padding: 0 8px !important;
    }

    /* PREMIUM ICON BOXES */
    .achievement-icon-box {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* DIALOG HEADER */
    .dialog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        gap: 16px;
    }

    .header-info {
        flex-grow: 1;
    }

    .filter-wrapper {
        min-width: 140px;
        max-width: 200px;
    }

    .compact-select {
        height: 20px !important;
        margin-top: 0 !important;
    }

        .compact-select .mud-input-outlined-text {
            padding: 4px 12px 4px 8px !important;
            border-radius: 8px !important;
        }

        .compact-select .mud-input-label-outlined {
            transform: translate(14px, 8px) scale(0.9) !important;
        }

            .compact-select .mud-input-label-outlined.mud-input-label-inputcontrol {
                transform: translate(14px, -12px) scale(0.75) !important;
            }

        .compact-select .mud-select-input {
            margin-top: 0 !important;
            height: 100% !important;
        }

        .compact-select .mud-input-slot {
            font-size: 0.8rem !important;
            padding-top: 0 !important;
            padding-bottom: 0 !important;
        }

    /* MOBILE DIALOG CARDS */
    .mobile-detail-card {
        margin-bottom: 12px;
        border-radius: 12px !important;
    }

    .mobile-detail-header {
        background: rgba(0, 114, 207, 0.05);
        padding: 8px 12px;
        font-weight: 700;
        font-size: 0.9rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .lightest .mobile-detail-header {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1);
    }

    /* RESPONSIVE */
    @@media (max-width: 600px) {
        .dialog-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
        }

        .filter-wrapper {
            width: 100%;
            display: flex;
            justify-content: flex-end;
        }

        .desktop-view {
            display: none;
        }

        .mobile-view {
            display: block;
        }

        /* Balance icon size with text on mobile */
        .achievement-icon-box {
            width: 20px !important;
            height: 20px !important;
        }

        /* Ensure task name text is readable and balanced with icon */
        .mobile-detail-card .mud-typography-body2 {
            font-size: 0.85rem !important;
            line-height: 1.3 !important;
        }

        .mobile-detail-card .mud-typography-caption {
            font-size: 0.75rem !important;
        }

        .mobile-detail-header {
            font-size: 0.8rem !important;
        }

        .category-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding-top: 8px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .chip-container {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            align-items: center;
        }

        .remarks-container {
            text-align: right;
            opacity: 0.8;
            font-style: italic;
        }

        .time-badge {
            background-color: #10b981 !important;
            color: #ffffff !important;
            font-weight: 800 !important;
        }

        .dark .time-badge {
            background-color: #059669 !important;
        }

        .feedback-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .feedback-meta {
            text-align: right;
            line-height: 1.2;
        }

        @@media (max-width: 400px) {
            .feedback-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 6px;
            }

            .feedback-meta {
                text-align: left;
                width: 100%;
            }
        }
    }

    @@media (min-width: 601px) {
        .desktop-view {
            display: block;
        }

        .mobile-view {
            display: none;
        }
    }

    /* SPECIFIC FOR NARROW MOBILE (iPhone SE 375px) */
    @@media (max-width: 375px) {
        .dialog-header {
            padding-right: 0 !important;
            gap: 6px !important;
        }

        .header-info h6 {
            font-size: 1rem !important;
        }

        .header-info .mud-typography-caption {
            font-size: 0.7rem !important;
        }

        /* Filter wrapper: shrink to fit, don't overflow */
        .filter-wrapper {
            min-width: unset !important;
            max-width: 100% !important;
            width: 100% !important;
            justify-content: flex-start !important;
        }

        .compact-select {
            width: 100% !important;
        }

        .mobile-detail-card {
            padding: 10px !important;
        }

        /* Further tighten icon on 375px to stay proportional */
        .achievement-icon-box {
            width: 18px !important;
            height: 18px !important;
            border-radius: 5px !important;
        }

        .achievement-icon-box .mud-icon-root {
            font-size: 0.9rem !important;
        }

        /* Keep task name at a comfortable readable size */
        .mobile-detail-card .mud-typography-body2 {
            font-size: 0.82rem !important;
        }

        .mobile-detail-card .mud-typography-caption {
            font-size: 0.72rem !important;
        }

        .category-footer {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 4px;
        }

        .chip-container {
            width: 100%;
        }

        .remarks-container {
            width: 100%;
            text-align: left !important;
            margin-top: 2px;
        }

        .frequency-chip, .status-chip {
            max-width: none !important;
            font-size: 0.65rem !important;
        }

        /* Feedback action buttons: stack vertically, full-width */
        .feedback-actions {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 6px !important;
        }

        .feedback-actions .mud-button-root {
            width: 100% !important;
            font-size: 0.72rem !important;
            padding: 6px 10px !important;
            justify-content: center !important;
        }

        /* Feedback section padding */
        .feedback-section {
            padding: 12px !important;
        }
    }
</style>

<MudDialog MaxWidth="MaxWidth.Large" FullWidth="true" Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <TitleContent>
        <div class="dialog-header pr-4">
            <div class="header-info">
                <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">Activity Details</MudText>
                <MudText Typo="Typo.caption" Style="@($"color: {GetTitleColor()}; opacity: 0.7;")">
                    @Activity?.Date.ToString("MMMM dd, yyyy") - @(Activity?.StartedBy?.Fullname ?? "---")
                </MudText>
            </div>
            <div class="filter-wrapper d-flex align-center gap-2">
                @if (Activity?.AreaHeadReviewedAt.HasValue == true)
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Verified">REVIEWED</MudChip>
                }
                <MudSelect T="string" @bind-Value="_frequencyFilter" Label="Frequency" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="rounded-lg compact-select">
                    <MudSelectItem Value="@("All")">All</MudSelectItem>
                    <MudSelectItem Value="@("Daily")">Daily</MudSelectItem>
                    <MudSelectItem Value="@("Weekly")">Weekly</MudSelectItem>
                    <MudSelectItem Value="@("Monthly")">Monthly</MudSelectItem>
                </MudSelect>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center pa-12">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_filteredTasks == null || !_filteredTasks.Any())
        {
            <div class="pa-12 text-center" style="opacity: 0.5;">
                <MudIcon Icon="@Icons.Material.Filled.AssignmentLate" Size="Size.Large" Class="mb-2" />
                <MudText>No tasks completed found for this selection.</MudText>
            </div>
        }
        else
        {
            <div class="desktop-view">
                <MudTable Items="_filteredTasks" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0" Class="detail-table" GroupBy="@_groupDefinition">
                    <ColGroup>
                        <col />
                        <col />
                        <col style="width: 100px;" />
                        <col />
                    </ColGroup>
                    <HeaderContent>
                        <MudTh>Task Details</MudTh>
                        <MudTh>Freq.</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Completed At</MudTh>
                        <MudTh>Remarks</MudTh>
                    </HeaderContent>
                    <GroupHeaderTemplate>
                        <MudTh Class="mud-table-cell-custom-group" colspan="5" Style="background: rgba(0, 114, 207, 0.05); font-weight: 700;">
                            @((context.Key ?? "Uncategorized").ToString())
                        </MudTh>
                    </GroupHeaderTemplate>
                    <RowTemplate>
                        <MudTd DataLabel="Task Details">
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@FormatLongWords(context.ChecklistItem?.TaskName)</MudText>
                            @if (!string.IsNullOrEmpty(context.ChecklistItem?.Description))
                            {
                                <MudText Typo="Typo.caption" Style="font-size: 0.85rem !important; opacity: 0.7; display: block; line-height: 1.2;">@FormatLongWords(context.ChecklistItem.Description)</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Freq.">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@GetFrequencyColor(context.ChecklistItem?.Frequency)" Class="frequency-chip">
                                @context.ChecklistItem?.Frequency
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            @if (context.IsCompleted)
                            {
                                <div class="achievement-icon-box" style="background: #10b981; color: #ffffff;">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                </div>
                            }
                            else
                            {
                                <div class="achievement-icon-box" style="background: rgba(148, 163, 184, 0.1); color: #94a3b8;">
                                    <MudIcon Icon="@Icons.Material.Filled.RadioButtonUnchecked" Size="Size.Small" />
                                </div>
                            }
                        </MudTd>
                        <MudTd DataLabel="Completed At">
                            <MudText Typo="Typo.caption" Style="font-weight: 600; font-family: monospace;">
                                @(context.CompletedAt?.ToString("hh:mm tt") ?? "---")
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Remarks">
                            <MudText Typo="Typo.caption">@(string.IsNullOrEmpty(context.Remarks) ? "---" : context.Remarks)</MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
            <div class="mobile-view">
                @foreach (var group in _filteredTasks.GroupBy(t => _groupDefinition?.Selector?.Invoke(t) ?? "Other"))
                {
                    <div class="mobile-detail-header rounded-lg mb-2" style="word-break: break-word; overflow-wrap: anywhere;">@group.Key</div>
                    @foreach (var task in group)
                    {
                        <MudPaper Class="@($"glass-panel mobile-detail-card pa-3 mb-3 {GetThemeClass()}")" Elevation="0">
                            <div class="d-flex justify-space-between align-start mb-2">
                                <div style="flex-grow: 1;">
                                    <MudText Typo="Typo.body2" Style="font-weight: 700; line-height: 1.2;">@FormatLongWords(task.ChecklistItem?.TaskName)</MudText>
                                    @if (!string.IsNullOrEmpty(task.ChecklistItem?.Description))
                                    {
                                        <MudText Typo="Typo.caption" Style="font-size: 0.85rem !important; opacity: 0.7; display: block; margin-top: 2px;">@FormatLongWords(task.ChecklistItem.Description)</MudText>
                                    }
                                </div>
                                @if (task.IsCompleted)
                                {
                                    <div class="achievement-icon-box ml-2" style="background: #10b981; color: #ffffff;">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                    </div>
                                }
                                else
                                {
                                    <div class="achievement-icon-box ml-2" style="background: rgba(148, 163, 184, 0.1); color: #94a3b8;">
                                        <MudIcon Icon="@Icons.Material.Filled.RadioButtonUnchecked" Size="Size.Small" />
                                    </div>
                                }
                            </div>
                            <div class="d-flex align-center justify-space-between pt-2 category-footer" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                <div class="d-flex gap-1 align-center chip-container">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@GetFrequencyColor(task.ChecklistItem?.Frequency)" Class="frequency-chip">
                                        @task.ChecklistItem?.Frequency
                                    </MudChip>
                                    @if (task.IsCompleted && task.CompletedAt.HasValue)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" Class="status-chip time-badge" Icon="@Icons.Material.Filled.Schedule">
                                            @task.CompletedAt.Value.ToString("hh:mm tt")
                                        </MudChip>
                                    }
                                </div>
                                <div class="remarks-container">
                                    <MudText Typo="Typo.caption" Style="opacity: 0.6; font-style: italic;">@(string.IsNullOrEmpty(task.Remarks) ? "No remarks" : task.Remarks)</MudText>
                                </div>
                            </div>
                        </MudPaper>
                    }
                }
            </div>
        }

        @if (Activity != null)
        {
            <MudDivider Class="my-4" Style="opacity: 0.1;" />
            <div class="pa-4 rounded-lg feedback-section" style="@GetFeedbackContainerStyle()">
                <div class="feedback-header mb-3">
                    <div class="d-flex align-center">
                        <div class="achievement-icon-box mr-2" style="background: var(--mud-palette-primary); color: #ffffff;">
                            <MudIcon Icon="@Icons.Material.Filled.Comment" Size="Size.Small" />
                        </div>
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Area Head Feedback</MudText>
                    </div>
                    @if (Activity.AreaHeadReviewedAt.HasValue)
                    {
                        <div class="feedback-meta">
                            <MudText Typo="Typo.caption" Style="opacity: 0.7;">
                                Reviewed @(Activity.AreaHead != null ? $"by {Activity.AreaHead.Fullname} " : "")on @Activity.AreaHeadReviewedAt.Value.ToString("MMM dd, yyyy hh:mm tt")
                            </MudText>
                        </div>
                    }
                </div>

                @if (IsAreaHead())
                {
                    <MudTextField T="string"
                                  @bind-Value="_feedbackText"
                                  Label="Add/Edit Feedback"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  Placeholder="Enter your feedback here..."
                                  Class="mb-2" />
                    <div class="d-flex justify-end gap-2 flex-wrap feedback-actions">
                        @if (Activity.AreaHeadReviewedAt.HasValue)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="Unapprove"
                                       StartIcon="@Icons.Material.Filled.Undo"
                                       Disabled="_isSubmitting">
                                @(_isSubmitting ? "REVERTING..." : "UNAPPROVE REPORT")
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="SubmitFeedback"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   Disabled="_isSubmitting">
                            @(_isSubmitting ? "SUBMITTING..." : (Activity.AreaHeadReviewedAt.HasValue ? "UPDATE FEEDBACK" : "SUBMIT FEEDBACK & APPROVE"))
                        </MudButton>
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="@($"word-break: break-word; overflow-wrap: anywhere; {(string.IsNullOrEmpty(Activity.AreaHeadRemark) ? "font-style: italic; opacity: 0.5;" : "")}")">
                        @(string.IsNullOrEmpty(Activity.AreaHeadRemark) ? "No feedback provided yet." : Activity.AreaHeadRemark)
                    </MudText>
                }
            </div>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close" Style="@GetCancelButtonStyle()">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public StoreDailyActivity? Activity { get; set; }
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private List<TaskProgress> _allTasks = new();
    private List<TaskProgress> _filteredTasks => _frequencyFilter == "All" ? _allTasks : _allTasks.Where(t => t.ChecklistItem?.Frequency == _frequencyFilter).ToList();
    private string _frequencyFilter = "All";
    private bool _isLoading = true;
    private string? _feedbackText;

    private string FormatLongWords(string? text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        var words = text.Split(' ');
        for (int i = 0; i < words.Length; i++)
        {
            var word = words[i];
            if (word.Length > 12)
            {
                var sb = new System.Text.StringBuilder();
                for (int j = 0; j < word.Length; j++)
                {
                    sb.Append(word[j]);
                    if ((j + 1) % 10 == 0 && j < word.Length - 1)
                    {
                        sb.Append("\u200B");
                    }
                }
                words[i] = sb.ToString();
            }
        }
        return string.Join(" ", words);
    }
    private bool _isSubmitting = false;

    private TableGroupDefinition<TaskProgress> _groupDefinition = new()
    {
        GroupName = "Group",
        Indentation = false,
        Expandable = true,
        IsInitiallyExpanded = true,
        Selector = (e) =>
        {
            var catName = e?.ChecklistItem?.Category?.Name ?? "General";
            var section = e?.ChecklistItem?.Section;
            return string.IsNullOrEmpty(section) ? catName : $"{catName} - {section}";
        }
    };

    protected override async Task OnInitializedAsync()
    {
        if (Activity != null)
        {
            _feedbackText = Activity.AreaHeadRemark;
            await LoadDetails();
        }
        _isLoading = false;
    }

    private async Task LoadDetails()
    {
        if (Activity == null) return;

        using var db = await DbFactory.CreateDbContextAsync();

        // Reload activity to get the navigation properties
        var activity = await db.StoreDailyActivities
            .Include(a => a.StartedBy)
            .Include(a => a.AreaHead)
            .FirstOrDefaultAsync(a => a.Id == Activity.Id);

        if (activity != null)
        {
            Activity.AreaHead = activity.AreaHead;
            Activity.StartedBy = activity.StartedBy;
        }

        _allTasks = await db.TaskProgresses
            .Include(p => p.ChecklistItem)
                .ThenInclude(c => c!.Category)
            .Where(p => p.StoreDailyActivityId == Activity.Id)
            .OrderBy(p => p.ChecklistItem != null && p.ChecklistItem.Category != null ? p.ChecklistItem.Category.SortOrder : 0)
            .ThenBy(p => p.ChecklistItem != null ? p.ChecklistItem.SortOrder : 0)
            .ToListAsync();
    }

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(15px); min-width: 320px;";
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.5);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.2); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.25); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetFeedbackContainerStyle()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "background: rgba(0, 114, 207, 0.05); border: 1px solid rgba(0, 114, 207, 0.1);",
            ThemeMode.Light => "background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.1);",
            ThemeMode.Dark => "background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.05);",
            _ => "background: #f8fafc;"
        };
    }

    private string GetTitleColor() => ThemeService.CurrentTheme == ThemeMode.Lightest ? "#0f172a" : "#ffffff";
    private string GetCancelButtonStyle() => $"color: {GetTitleColor()}; text-transform: none; font-weight: 600;";
    private string GetThemeClass() => ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" : ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";

    private Color GetFrequencyColor(string? freq) => freq switch
    {
        "Daily" => Color.Info,
        "Weekly" => Color.Warning,
        "Monthly" => Color.Secondary,
        _ => Color.Default
    };

    private bool IsAreaHead() => UserState.Role == "Area Head";

    private async Task SubmitFeedback()
    {
        if (Activity == null || _isSubmitting) return;

        var totalTasks = _allTasks.Count;
        var completedTasks = _allTasks.Count(t => t.IsCompleted);
        if (totalTasks == 0 || completedTasks < totalTasks)
        {
            Snackbar.Add("Cannot approve report. Store tasks are still incomplete.", Severity.Warning);
            return;
        }

        _isSubmitting = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var activity = await db.StoreDailyActivities.FindAsync(Activity.Id);
            if (activity != null)
            {
                activity.AreaHeadRemark = _feedbackText;
                activity.AreaHeadId = UserState.UserId;
                activity.IsCompleted = true; // Finalize on review
                if (!activity.CompletedAt.HasValue)
                {
                    activity.CompletedAt = DateTime.Now;
                }
                activity.AreaHeadReviewedAt = DateTime.Now;

                await db.SaveChangesAsync();

                Activity.AreaHeadRemark = _feedbackText;
                Activity.AreaHeadReviewedAt = activity.AreaHeadReviewedAt;
                Activity.AreaHeadId = activity.AreaHeadId;
                Activity.IsCompleted = true;

                // Reload AreaHead name if it has changed or just as a precaution
                var reviewer = await db.Users.FindAsync(UserState.UserId);
                if (reviewer != null)
                {
                    Activity.AreaHead = reviewer;
                }

                Snackbar.Add("Feedback submitted and report finalized.", Severity.Success);
                UserState.NotifyDashboardRefresh();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error submitting feedback: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task Unapprove()
    {
        if (Activity == null || _isSubmitting) return;

        _isSubmitting = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var activity = await db.StoreDailyActivities.FindAsync(Activity.Id);
            if (activity != null)
            {
                activity.AreaHeadReviewedAt = null;
                activity.IsCompleted = false;
                activity.CompletedAt = null;
                // Keep the remark as a draft
                await db.SaveChangesAsync();

                Activity.AreaHeadReviewedAt = null;
                Activity.IsCompleted = false;
                Activity.CompletedAt = null;

                Snackbar.Add("Report unapproved. You can now modify and re-submit feedback.", Severity.Info);
                UserState.NotifyDashboardRefresh();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Close() => MudDialog.Close();
}