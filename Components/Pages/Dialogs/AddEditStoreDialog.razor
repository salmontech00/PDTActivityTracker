@using System.ComponentModel.DataAnnotations
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject IJSRuntime JSRuntime

@implements IDisposable

<style>
    /* SHARED GLASS DIALOG STYLES */

    /* Remove default button borders */
    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    /* --- LIGHT MODE (BLUE GLASS) --- */
    /* White Text/Inputs */
    .glass-dialog.light .mud-input-root,
    .glass-dialog.light .mud-input-slot,
    .glass-dialog.light .mud-input-label,
    .glass-dialog.light .mud-icon-root,
    .glass-dialog.light .mud-input-adornment {
        color: #ffffff !important;
    }

    /* White Borders */
    .glass-dialog.light .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.8) !important;
    }

    .glass-dialog.light .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.light .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #ffffff !important;
        border-width: 2px !important;
    }

    /* Placeholder */
    .glass-dialog.light .mud-input-slot::placeholder {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    /* --- LIGHTEST MODE --- */
    /* Ensure inputs are NOT white (default visibility) */
    .glass-dialog.lightest .mud-input-root,
    .glass-dialog.lightest .mud-input-slot,
    .glass-dialog.lightest .mud-input-label {
        color: #0f172a !important;
    }

    .glass-dialog.lightest .mud-icon-root {
        color: #0072cf !important;
    }

    .glass-dialog.lightest .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 1) !important;
    }

    .glass-dialog.lightest .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.lightest .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #0072cf !important;
    }

    /* Scoped Status Select Popover styles for text wrapping and mobile font-size */
    .status-dropdown-popover {
        max-width: 280px !important;
    }

        .status-dropdown-popover .mud-list-item-text {
            white-space: normal !important;
            word-wrap: break-word !important;
            word-break: break-word !important;
        }
</style>

<MudDialog Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">@(_isEdit ? "Edit Store" : "Add Store")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_storeModel.StoreCode" Label="Store Code" Required="true" RequiredError="Store Code is required" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_storeModel.Status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" PopoverClass="status-dropdown-popover">
                        <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                        <MudSelectItem Value="@("Inactive")">Inactive</MudSelectItem>
                        <MudSelectItem Value="@("Under Renovation")">Under Renovation</MudSelectItem>
                        <MudSelectItem Value="@("Closed")">Closed</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_storeModel.StoreName" Label="Store Name" Required="true" RequiredError="Store Name is required" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_storeModel.Location" Label="Location / Region" Required="true" RequiredError="Location is required" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Style="@($"color: {GetTitleColor()}; opacity: 0.8")" Class="mt-2 text-uppercase">Contact Information (Optional)</MudText>
                    <MudDivider Class="mb-3" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_storeModel.ContactPhone" Label="Phone Number" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_storeModel.ContactEmail" Label="Email Address" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="12" Class="d-flex align-center">
                    <MudTooltip Text="Get Current Location">
                        <div class="d-flex align-center gap-3" style="@(_isFetchingLocation ? "cursor: not-allowed; opacity: 0.7;" : "cursor: pointer;")" @onclick="@(async () => { if (!_isFetchingLocation) await FetchGPSLocation(); })">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                                @if (_isFetchingLocation)
                                {
                                    <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.MyLocation" Size="Size.Medium" />
                                }
                            </MudAvatar>
                            <MudText Typo="Typo.body2" Style="@GetCancelButtonStyle()">
                                @(_isFetchingLocation ? "Fetching Location..." : "Fetch Location")
                            </MudText>
                        </div>
                    </MudTooltip>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_storeModel.GPSLatitude" Label="GPS Latitude" Variant="Variant.Outlined" Margin="Margin.Dense" Step="0.000001" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_storeModel.GPSLongitude" Label="GPS Longitude" Variant="Variant.Outlined" Margin="Margin.Dense" Step="0.000001" />
                </MudItem>

            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="@GetCancelButtonStyle()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Style="@GetButtonStyle()">@(_isEdit ? "Update Store" : "Create Store")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Store Store { get; set; } = new();
    [Parameter] public Func<string, string, int, Task<List<string>>>? ValidateDuplicate { get; set; }

    private Store _storeModel = new();
    private bool success;
    private MudForm form = default!;
    private bool _isEdit;
    private bool _isFetchingLocation;

    private async Task FetchGPSLocation()
    {
        _isFetchingLocation = true;
        StateHasChanged();
        try
        {
            var location = await JSRuntime.InvokeAsync<LocationCoords>("cameraInterop.getCurrentLocation");
            _storeModel.GPSLatitude = location.Latitude;
            _storeModel.GPSLongitude = location.Longitude;
            Snackbar.Add("Location captured", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not get location: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _isFetchingLocation = false;
            StateHasChanged();
        }
    }

    private class LocationCoords
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }


    protected override void OnInitialized()
    {
        _isEdit = Store.Id != 0;

        // Clone properties to keep the form isolated from parent's model reference in real-time
        _storeModel = new Store
        {
            Id = Store.Id,
            StoreCode = Store.StoreCode,
            StoreName = Store.StoreName,
            Location = Store.Location,
            Status = Store.Status,
            GPSLatitude = Store.GPSLatitude,
            GPSLongitude = Store.GPSLongitude,
            ContactPhone = Store.ContactPhone,
            ContactEmail = Store.ContactEmail,
            StoreHeadId = Store.StoreHeadId,
            AreaHeadId = Store.AreaHeadId
        };

        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged() => StateHasChanged();

    public void Dispose() => ThemeService.OnThemeChanged -= OnThemeChanged;

    private bool _isSubmitting = false;

    private async Task Submit()
    {
        if (_isSubmitting) return; // Prevent double-submission
        _isSubmitting = true;

        try
        {
            await form.Validate();

            if (form.IsValid)
            {
                using var db = await DbFactory.CreateDbContextAsync();

                // Trim inputs before saving so we don't save trailing spaces
                _storeModel.StoreCode = _storeModel.StoreCode?.Trim();
                _storeModel.StoreName = _storeModel.StoreName?.Trim();

                var codeToMatch = _storeModel.StoreCode ?? string.Empty;
                var nameToMatch = _storeModel.StoreName ?? string.Empty;

                if (ValidateDuplicate != null)
                {
                    var errors = await ValidateDuplicate(codeToMatch, nameToMatch, Store.Id);
                    if (errors != null && errors.Any())
                    {
                        foreach (var error in errors)
                        {
                            Snackbar.Add(error, Severity.Warning);
                        }
                        return;
                    }
                }

                // Fetch all to memory for foolproof string matching in C# as a secondary local fallback check
                var allStores = await db.Stores.AsNoTracking().ToListAsync();
                var codeDuplicateLocal = allStores.FirstOrDefault(s => s.Id != Store.Id && string.Equals(s.StoreCode?.Trim(), codeToMatch, StringComparison.OrdinalIgnoreCase));
                var nameDuplicateLocal = allStores.FirstOrDefault(s => s.Id != Store.Id && string.Equals(s.StoreName?.Trim(), nameToMatch, StringComparison.OrdinalIgnoreCase));

                if (codeDuplicateLocal != null || nameDuplicateLocal != null)
                {
                    if (codeDuplicateLocal != null)
                    {
                        Snackbar.Add($"Store Code '{codeToMatch}' already exists.", Severity.Warning);
                    }
                    if (nameDuplicateLocal != null)
                    {
                        Snackbar.Add($"Store Name '{nameToMatch}' already exists.", Severity.Warning);
                    }
                    return;
                }

                if (_isEdit)
                {
                    var dbStore = await db.Stores.FindAsync(Store.Id);
                    if (dbStore != null)
                    {
                        dbStore.StoreCode = _storeModel.StoreCode;
                        dbStore.StoreName = _storeModel.StoreName;
                        dbStore.Location = _storeModel.Location;
                        dbStore.Status = _storeModel.Status;
                        dbStore.GPSLatitude = _storeModel.GPSLatitude;
                        dbStore.GPSLongitude = _storeModel.GPSLongitude;
                        dbStore.ContactPhone = _storeModel.ContactPhone;
                        dbStore.ContactEmail = _storeModel.ContactEmail;

                        db.Stores.Update(dbStore);
                    }
                }
                else
                {
                    db.Stores.Add(_storeModel);
                }

                await db.SaveChangesAsync();

                // Sync values back to original parameter reference for caller
                Store.StoreCode = _storeModel.StoreCode;
                Store.StoreName = _storeModel.StoreName;
                Store.Location = _storeModel.Location;
                Store.Status = _storeModel.Status;
                Store.GPSLatitude = _storeModel.GPSLatitude;
                Store.GPSLongitude = _storeModel.GPSLongitude;
                Store.ContactPhone = _storeModel.ContactPhone;
                Store.ContactEmail = _storeModel.ContactEmail;

                if (_isEdit) {
                    Snackbar.Add("Store updated successfully!", Severity.Success);
                } else {
                    Snackbar.Add("Store added successfully!", Severity.Success);
                }

                MudDialog.Close(DialogResult.Ok(Store.Id));
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(15px);";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleColor()
    {
        if (ThemeService == null) return "#0f172a";
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "text-transform: none; font-weight: 600;";
        var baseStyle = "text-transform: none; font-weight: 600;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? $"{baseStyle} color: #0072cf !important; background-color: #ffffff !important;"
            : baseStyle;
    }

    private string GetCancelButtonStyle()
    {
        return $"color: {GetTitleColor()}; text-transform: none; font-weight: 600;";
    }
}
