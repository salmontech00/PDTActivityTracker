@using MudBlazor
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<style>
    /* SHARED GLASS DIALOG STYLES */
    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    /* --- LIGHT MODE (BLUE GLASS) --- */
    .glass-dialog.light .mud-input-root,
    .glass-dialog.light .mud-input-slot,
    .glass-dialog.light .mud-input-label,
    .glass-dialog.light .mud-icon-root,
    .glass-dialog.light .mud-input-adornment {
        color: #ffffff !important;
    }

    /* --- LIGHTEST MODE --- */
    .glass-dialog.lightest .mud-input-root,
    .glass-dialog.lightest .mud-input-slot,
    .glass-dialog.lightest .mud-input-label {
        color: #0f172a !important;
    }

    .glass-dialog.lightest .mud-icon-root {
        color: #0072cf !important;
    }

    .photo-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
    }

    .photo-main {
        max-width: 100%;
        max-height: 500px;
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        cursor: zoom-in;
        transition: transform 0.15s ease, opacity 0.15s ease;
    }

    .photo-main:hover {
        transform: scale(1.01);
        opacity: 0.92;
    }

    /* LIGHTBOX OVERLAY */
    .lightbox-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: rgba(0, 0, 0, 0.93);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: zoom-out;
        animation: lightbox-in 0.18s ease;
    }

    @@keyframes lightbox-in {
        from { opacity: 0; transform: scale(0.97); }
        to   { opacity: 1; transform: scale(1); }
    }

    .lightbox-img {
        max-width: 95vw;
        max-height: 95vh;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.8);
        animation: lightbox-zoom 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes lightbox-zoom {
        from { transform: scale(0.88); opacity: 0; }
        to   { transform: scale(1);    opacity: 1; }
    }

    .lightbox-close {
        position: fixed;
        top: 18px;
        right: 22px;
        color: rgba(255,255,255,0.7);
        font-size: 2rem;
        line-height: 1;
        cursor: pointer;
        z-index: 100000;
        user-select: none;
        transition: color 0.15s;
    }

    .lightbox-close:hover {
        color: #ffffff;
    }

    .zoom-hint {
        position: absolute;
        bottom: 10px;
        right: 12px;
        font-size: 0.62rem;
        opacity: 0.45;
        letter-spacing: 0.05em;
        pointer-events: none;
    }

    .photo-details {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .detail-item {
        padding: 12px 16px;
        border-radius: 12px;
        background: rgba(0, 114, 207, 0.1);
        min-width: 0;
    }

    .detail-label {
        font-size: 0.8rem;
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .detail-value {
        font-weight: 600;
        font-size: 1.05rem;
        word-break: break-word;
        overflow-wrap: anywhere;
    }
</style>

<MudDialog MaxWidth="MaxWidth.Large" FullWidth="true" Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">Photo Details</MudText>
    </TitleContent>

    <DialogContent>
        <div class="photo-container">
            @if (Photo?.ImageData != null && !string.IsNullOrEmpty(Photo.ImageMimeType))
            {
                <div style="position: relative; display: inline-block;">
                    <img src="@($"data:{Photo.ImageMimeType};base64,{Convert.ToBase64String(Photo.ImageData)}")"
                         alt="@(Photo.Description ?? "Photo")"
                         class="photo-main"
                         @onclick="OpenLightbox" />
                    <span class="zoom-hint">click to enlarge</span>
                </div>
            }
            else
            {
                <div style="width: 100%; height: 300px; background: rgba(0,114,207,0.2); border-radius: 16px; display: flex; align-items: center; justify-content: center;">
                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Style="font-size: 5rem; opacity: 0.3;" />
                </div>
            }

            <div class="photo-details">
                <div class="detail-item">
                    <div class="detail-label">Store</div>
                    <div class="detail-value">@(Photo?.Store?.StoreName ?? "Unknown Store")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Captured By</div>
                    <div class="detail-value">@(Photo?.UploadedBy?.Fullname ?? "Unknown User")</div>
                </div>
                @if (Photo?.Issue != null)
                {
                    <div class="detail-item">
                        <div class="detail-label">Issue Category</div>
                        <div class="detail-value">@(Photo.Issue.Title ?? "Uncategorized")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Problem Profile</div>
                        <div class="detail-value">@(Photo.Issue.Description ?? "No Description")</div>
                    </div>
                }
                else
                {
                    <div class="detail-item">
                        <div class="detail-label">Category</div>
                        <div class="detail-value">@(Photo?.Category?.Name ?? "Uncategorized")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Task</div>
                        <div class="detail-value">@(Photo?.ChecklistItem?.TaskName ?? Photo?.ChecklistItem?.Description ?? "No Task")</div>
                    </div>
                }
                <div class="detail-item">
                    <div class="detail-label">Captured At</div>
                    <div class="detail-value">@((Photo?.CaptureTimestamp ?? Photo?.UploadedAt)?.ToString("MMMM dd, yyyy") ?? "-")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Capture Time</div>
                    <div class="detail-value">@((Photo?.CaptureTimestamp ?? Photo?.UploadedAt)?.ToString("HH:mm:ss") ?? "-")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Latitude</div>
                    <div class="detail-value">@(Photo?.Latitude?.ToString("F6") ?? "N/A")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Longitude</div>
                    <div class="detail-value">@(Photo?.Longitude?.ToString("F6") ?? "N/A")</div>
                </div>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Style="@GetCancelButtonStyle()">Close</MudButton>
    </DialogActions>
</MudDialog>

@if (_lightboxOpen && Photo?.ImageData != null)
{
    <div class="lightbox-overlay" @onclick="CloseLightbox" @onkeydown="HandleLightboxKey" tabindex="0">
        <span class="lightbox-close" @onclick:stopPropagation="false">&#x2715;</span>
        <img src="@($"data:{Photo.ImageMimeType};base64,{Convert.ToBase64String(Photo.ImageData)}")"
             alt="@(Photo.Description ?? "Photo")"
             class="lightbox-img"
             @onclick:stopPropagation="true" />
    </div>
}

@code {
    [Parameter] public TaskPhoto? Photo { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(15px); min-width: 320px;";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.5); box-shadow: 0 8px 32px rgba(0,0,0,0.1);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.2); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleColor()
    {
        if (ThemeService == null) return "#0f172a";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetCancelButtonStyle()
    {
        return $"color: {GetTitleColor()}; text-transform: none; font-weight: 600;";
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private bool _lightboxOpen = false;

    private void OpenLightbox() => _lightboxOpen = true;
    private void CloseLightbox() => _lightboxOpen = false;

    private void HandleLightboxKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _lightboxOpen = false;
    }

    private void Cancel() => MudDialog.Cancel();
}
