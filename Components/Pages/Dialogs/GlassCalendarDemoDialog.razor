@using PDTActivityTracker.Components.Services
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<div class="@($"glass-calendar {GetThemeClass()}")">

    @if (_view == ViewMode.Year)
    {
        <!-- YEAR LIST VIEW -->
        <div class="gc-year-list" @ref="_yearListRef">
            @foreach (var year in _yearRange)
            {
                <div class="@($"gc-year-row {(year == _displayMonth.Year ? "selected" : "")}")"
                     @onclick="@(() => SelectYear(year))">
                    @year
                </div>
            }
        </div>
    }
    else if (_view == ViewMode.Month)
    {
        <!-- MONTH GRID VIEW -->
        <div class="gc-header">
            <button type="button" class="gc-nav-btn" @onclick="GoPrevYear" aria-label="Previous year">
                <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z" /></svg>
            </button>

            <div class="gc-header-label gc-header-label-clickable" @onclick="@(() => SetView(ViewMode.Year))">
                @_displayMonth.Year
            </div>

            <button type="button" class="gc-nav-btn-plain" @onclick="GoNextYear" aria-label="Next year">
                <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12z" /></svg>
            </button>
        </div>

        <div class="gc-month-grid">
            @for (int m = 1; m <= 12; m++)
            {
                var month = m;
                <div class="@($"gc-month-cell {(month == _displayMonth.Month ? "selected" : "")}")"
                     @onclick="@(() => SelectMonth(month))">
                    @(new DateTime(2000, month, 1).ToString("MMM"))
                </div>
            }
        </div>
    }
    else
    {
        <!-- DAY VIEW (default) -->
        <div class="gc-header">
            <button type="button" class="gc-nav-btn" @onclick="GoPrevMonth" aria-label="Previous month">
                <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z" /></svg>
            </button>

            <div class="gc-header-label">
                <span class="gc-header-label-clickable" @onclick="@(() => SetView(ViewMode.Month))">@_displayMonth.ToString("MMMM")</span>
                <span class="gc-header-label-clickable" @onclick="@(() => SetView(ViewMode.Year))">@_displayMonth.ToString("yyyy")</span>
            </div>

            <button type="button" class="gc-nav-btn-plain" @onclick="GoNextMonth" aria-label="Next month">
                <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12z" /></svg>
            </button>
        </div>

        <!-- WEEKDAY ROW (Sun start) -->
        <div class="gc-weekday-row">
            @foreach (var wd in _weekDayLabels)
            {
                <div class="gc-weekday-cell">@wd</div>
            }
        </div>

        <!-- DAY GRID -->
        <div class="gc-day-grid">
            @foreach (var cell in GetDayCells())
            {
                if (cell.Date == null)
                {
                    <div class="gc-day-cell empty"></div>
                }
                else
                {
                    var date = cell.Date.Value;
                    <button type="button"
                            class="@GetDayCssClass(date)"
                            disabled="@IsDisabled(date)"
                            @onclick="@(() => OnDayClicked(date))">
                        <span>@date.Day</span>
                    </button>
                }
            }
        </div>
    }
</div>

<style>
    .glass-calendar {
        width: 100%;
        max-width: 340px;
        height: 380px;
        border-radius: 12px;
        padding: 14px 16px 16px 16px;
        font-family: inherit;
        user-select: none;
        box-sizing: border-box;
        overflow: hidden;
        position: relative;
    }

        .glass-calendar.lightest {
            background-color: transparent !important;
            color: #0f172a;
        }

        .glass-calendar.light {
            background-color: transparent !important;
            color: #ffffff;
        }

        .glass-calendar.dark {
            background-color: transparent !important;
            color: #ffffff;
        }

    /* HEADER (shared by day + month views) */
    .gc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .gc-header-label {
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: 0.2px;
        display: flex;
        gap: 0px;
    }

    .gc-header-label-clickable {
        cursor: pointer;
        padding: 2px 4px;
        border-radius: 6px;
        transition: background-color 0.15s ease;
    }

        .gc-header-label-clickable:hover {
            background-color: rgba(0, 114, 207, 0.15);
        }

    .gc-nav-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        background-color: rgba(255, 255, 255, 0.06);
        color: inherit;
        opacity: 0.85;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.15s ease;
        flex-shrink: 0;
    }

        .gc-nav-btn:hover {
            background-color: rgba(0, 114, 207, 0.25);
            opacity: 1;
        }

    /* Plain (non-circle) nav button used for "next" arrows in month/day headers */
    .gc-nav-btn-plain {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        background: transparent;
        color: inherit;
        opacity: 0.7;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.15s ease;
        flex-shrink: 0;
    }

        .gc-nav-btn-plain:hover {
            background-color: rgba(0, 114, 207, 0.15);
            opacity: 1;
        }

    /* WEEKDAY ROW */
    .gc-weekday-row {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        margin-bottom: 6px;
    }

    .gc-weekday-cell {
        text-align: center;
        font-size: 0.72rem;
        font-weight: 600;
        opacity: 0.6;
        padding: 4px 0;
    }

    /* DAY GRID */
    .gc-day-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        row-gap: 6px;
    }

    .gc-day-cell {
        position: relative;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: inherit;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        border-radius: 50%;
        transition: background-color 0.15s ease, color 0.15s ease;
        z-index: 1;
        width: 34px;
        height: 34px;
        margin: 0 auto;
    }

        .gc-day-cell.empty {
            cursor: default;
        }

        .gc-day-cell:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .gc-day-cell:not(:disabled):not(.empty):hover {
            background-color: rgba(0, 114, 207, 0.18);
        }

        .gc-day-cell.today:not(.selected) {
            color: #2196f3;
            font-weight: 700;
        }

        .gc-day-cell.selected {
            background-color: #0072cf !important;
            color: #ffffff !important;
        }

        .gc-day-cell.range-start,
        .gc-day-cell.range-end {
            background-color: #0072cf !important;
            color: #ffffff !important;
        }

        .gc-day-cell.range-mid {
            background-color: rgba(0, 114, 207, 0.18);
            border-radius: 0;
        }

    /* MONTH GRID VIEW */
    .gc-month-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        row-gap: 28px;
        column-gap: 8px;
        padding-top: 16px;
    }

    .gc-month-cell {
        text-align: center;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        padding: 6px 0;
        border-radius: 8px;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

        .gc-month-cell:hover {
            background-color: rgba(0, 114, 207, 0.15);
        }

        .gc-month-cell.selected {
            color: #2196f3;
            font-weight: 700;
            font-size: 1.15rem;
        }

    /* YEAR LIST VIEW */
    .gc-year-list {
        height: 100%;
        overflow-y: auto;
        scroll-snap-type: y proximity;
        padding-right: 4px;
    }

        .gc-year-list::-webkit-scrollbar {
            width: 4px;
        }

        .gc-year-list::-webkit-scrollbar-thumb {
            background-color: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }

    .gc-year-row {
        text-align: center;
        font-size: 1rem;
        font-weight: 500;
        padding: 14px 0;
        cursor: pointer;
        scroll-snap-align: center;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

        .gc-year-row:hover {
            background-color: rgba(0, 114, 207, 0.1);
        }

        .gc-year-row.selected {
            color: #2196f3;
            font-weight: 700;
            font-size: 1.3rem;
        }
</style>

@code {
    public enum CalendarMode { Single, Range }
    private enum ViewMode { Day, Month, Year }

    [Parameter] public CalendarMode Mode { get; set; } = CalendarMode.Single;

    // Single mode
    [Parameter] public DateTime? SelectedDate { get; set; }
    [Parameter] public EventCallback<DateTime?> SelectedDateChanged { get; set; }

    // Range mode
    [Parameter] public DateTime? RangeStart { get; set; }
    [Parameter] public DateTime? RangeEnd { get; set; }
    [Parameter] public EventCallback<(DateTime? Start, DateTime? End)> RangeChanged { get; set; }

    // Constraints
    [Parameter] public DateTime? MinDate { get; set; }
    [Parameter] public DateTime? MaxDate { get; set; }

    private DateTime _displayMonth = DateTime.Today;
    private DateTime? _rangeStart;
    private DateTime? _rangeEnd;
    private ViewMode _view = ViewMode.Day;
    private ElementReference _yearListRef;

    // ±100 years from TODAY (not from the currently displayed year), per requirement
    private List<int> _yearRange = new();

    private readonly string[] _weekDayLabels = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };

    protected override void OnInitialized()
    {
        _rangeStart = RangeStart;
        _rangeEnd = RangeEnd;

        if (Mode == CalendarMode.Single && SelectedDate.HasValue)
            _displayMonth = new DateTime(SelectedDate.Value.Year, SelectedDate.Value.Month, 1);
        else if (Mode == CalendarMode.Range && _rangeStart.HasValue)
            _displayMonth = new DateTime(_rangeStart.Value.Year, _rangeStart.Value.Month, 1);

        var currentYear = DateTime.Today.Year;
        _yearRange = Enumerable.Range(currentYear - 100, 201).ToList();
    }

    protected override void OnParametersSet()
    {
        _rangeStart = RangeStart;
        _rangeEnd = RangeEnd;
    }

    private string GetThemeClass() => ThemeService.CurrentTheme switch
    {
        ThemeMode.Lightest => "lightest",
        ThemeMode.Light => "light",
        _ => "dark"
    };

    // ── View switching ───────────────────────────────────────────────────
    private async Task SetView(ViewMode view)
    {
        _view = view;
        if (view == ViewMode.Year)
        {
            // Let the DOM render the year list first, then scroll to selected year
            await Task.Delay(1);
            await ScrollSelectedYearIntoView();
        }
    }

    private async Task ScrollSelectedYearIntoView()
    {
        // Centers the currently displayed year in the scrollable list.
        // Row height ~52px (14px*2 padding + ~24px line height) — index * rowHeight
        // minus half the visible list height gives a roughly centered scroll position.
        var index = _yearRange.IndexOf(_displayMonth.Year);
        if (index < 0) return;

        const double rowHeight = 52;
        var targetScrollTop = (index * rowHeight) - (380 / 2.0) + (rowHeight / 2.0);

        await JsScrollTo(targetScrollTop);
    }

    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;

    private async Task JsScrollTo(double top)
    {
        try
        {
            await JS.InvokeVoidAsync("eval", $"document.activeElement && document.activeElement.blur();");
            await JS.InvokeVoidAsync("eval",
                $"(function(){{ var el = document.querySelectorAll('.gc-year-list')[document.querySelectorAll('.gc-year-list').length-1]; if(el){{ el.scrollTop = {top.ToString(System.Globalization.CultureInfo.InvariantCulture)}; }} }})();");
        }
        catch { /* no-op if prerendering */ }
    }

    // ── Day-view navigation ──────────────────────────────────────────────
    private void GoPrevMonth() => _displayMonth = _displayMonth.AddMonths(-1);
    private void GoNextMonth() => _displayMonth = _displayMonth.AddMonths(1);

    // ── Month-view navigation (arrows move by YEAR per the screenshot) ──
    private void GoPrevYear() => _displayMonth = _displayMonth.AddYears(-1);
    private void GoNextYear() => _displayMonth = _displayMonth.AddYears(1);

    private void SelectMonth(int month)
    {
        _displayMonth = new DateTime(_displayMonth.Year, month, 1);
        _view = ViewMode.Day;
    }

    private void SelectYear(int year)
    {
        _displayMonth = new DateTime(year, _displayMonth.Month, 1);
        _view = ViewMode.Month;
    }

    // ── Day grid building (Sunday-start) ────────────────────────────────
    private class DayCell
    {
        public DateTime? Date { get; set; }
    }

    private List<DayCell> GetDayCells()
    {
        var cells = new List<DayCell>();
        var firstOfMonth = new DateTime(_displayMonth.Year, _displayMonth.Month, 1);

        int leadingBlanks = (int)firstOfMonth.DayOfWeek; // Sunday = 0
        for (int i = 0; i < leadingBlanks; i++)
            cells.Add(new DayCell { Date = null });

        int daysInMonth = DateTime.DaysInMonth(_displayMonth.Year, _displayMonth.Month);
        for (int d = 1; d <= daysInMonth; d++)
            cells.Add(new DayCell { Date = new DateTime(_displayMonth.Year, _displayMonth.Month, d) });

        while (cells.Count % 7 != 0)
            cells.Add(new DayCell { Date = null });

        return cells;
    }

    private bool IsDisabled(DateTime date)
    {
        if (MinDate.HasValue && date.Date < MinDate.Value.Date) return true;
        if (MaxDate.HasValue && date.Date > MaxDate.Value.Date) return true;
        return false;
    }

    private string GetDayCssClass(DateTime date)
    {
        var classes = new List<string> { "gc-day-cell" };

        if (date.Date == DateTime.Today)
            classes.Add("today");

        if (Mode == CalendarMode.Single)
        {
            if (SelectedDate.HasValue && date.Date == SelectedDate.Value.Date)
                classes.Add("selected");
        }
        else
        {
            if (_rangeStart.HasValue && date.Date == _rangeStart.Value.Date)
                classes.Add(_rangeEnd.HasValue ? "range-start" : "selected");

            if (_rangeEnd.HasValue && date.Date == _rangeEnd.Value.Date)
                classes.Add("range-end");

            if (_rangeStart.HasValue && _rangeEnd.HasValue && date.Date > _rangeStart.Value.Date && date.Date < _rangeEnd.Value.Date)
                classes.Add("range-mid");
        }

        return string.Join(" ", classes);
    }

    // ── Click handling ───────────────────────────────────────────────────
    private async Task OnDayClicked(DateTime date)
    {
        if (IsDisabled(date)) return;

        if (Mode == CalendarMode.Single)
        {
            SelectedDate = date;
            await SelectedDateChanged.InvokeAsync(date);
            return;
        }

        if (!_rangeStart.HasValue || (_rangeStart.HasValue && _rangeEnd.HasValue))
        {
            _rangeStart = date;
            _rangeEnd = null;
            await RangeChanged.InvokeAsync((_rangeStart, _rangeEnd));
            return;
        }

        if (date.Date < _rangeStart.Value.Date)
        {
            _rangeEnd = _rangeStart.Value;
            _rangeStart = date;
        }
        else
        {
            _rangeEnd = date;
        }

        await RangeChanged.InvokeAsync((_rangeStart, _rangeEnd));
    }
}