@using MudBlazor
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Model
@using System.Security.Cryptography
@using System.Text
@using System.Text.RegularExpressions
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Processing
@using SixLabors.ImageSharp.Formats.Jpeg
@using SixLabors.ImageSharp.Formats.Png
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject AppDbContext Db
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<style>
    /* SHARED GLASS DIALOG STYLES */

    /* Remove default button borders */
    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    /* --- LIGHT MODE (BLUE GLASS) --- */
    /* White Text/Inputs */
    .glass-dialog.light .mud-input-root,
    .glass-dialog.light .mud-input-slot,
    .glass-dialog.light .mud-input-label,
    .glass-dialog.light .mud-input-adornment {
        color: #ffffff !important;
    }

    .glass-dialog.light .mud-icon-root{
        color: #ffffff !important;
    }

    /* White Borders */
    .glass-dialog.light .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.8) !important;
    }

    .glass-dialog.light .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.light .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #ffffff !important;
        border-width: 2px !important;
    }

    /* Placeholder */
    .glass-dialog.light .mud-input-slot::placeholder {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    /* --- LIGHTEST MODE --- */
    /* Ensure inputs are NOT white (default visibility) */
    .glass-dialog.lightest .mud-input-root,
    .glass-dialog.lightest .mud-input-slot,
    .glass-dialog.lightest .mud-input-label{
        color: #0f172a !important;
    }

    .glass-dialog.lightest .mud-icon-root {
        color: #0072cf !important;
    }

    

    .glass-dialog.lightest .mud-input-outlined-border {
        border-color: rgba(0, 114, 207, 0.4) !important;
    }

    .glass-dialog.lightest .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.lightest .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #0072cf !important;
    }

    @@media (max-width: 375px) {
        .glass-dialog {
            padding: 0px !important;
        }
    }
</style>

<MudDialog MaxWidth="MaxWidth.Large" FullWidth="true" Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">

    <TitleContent>
        <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">Update Account</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_editingUser">
            <div class="@GetUploadSectionClass()">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Upload Profile Image</MudText>

                <div style="display: flex; flex-direction: column; align-items: center; gap: 12px; position: relative; margin-bottom: 16px;">
                    @if (!string.IsNullOrEmpty(_imagePreviewUrl))
                    {
                        <label for="upload-image" style="position: absolute; top: 10px; z-index: 2; opacity: 0.5; cursor: pointer;">
                            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" />
                        </label>

                        <img src="@_imagePreviewUrl"
                             alt="Preview"
                             style="max-height: 150px; max-width:150px; border-radius: 6px;" />
                    }
                    else
                    {
                        <label for="upload-image" style="cursor: pointer;">
                            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" />
                        </label>
                    }

                    <InputFile id="upload-image"
                               OnChange="OnFileChanged"
                               accept="image/*"
                               style="display: none;" />
                </div>
            </div>

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Full Name"
                                  @bind-Value="_editingUser.Fullname"
                                  Required="true"
                                  RequiredError="Full name is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Username"
                                  @bind-Value="_editingUser.Username"
                                  Required="true"
                                  RequiredError="Username is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Employee Number"
                                  @bind-Value="_editingUser.EmployeeNumber"
                                  Validation="@(new Func<string?, string?>(ValidateEmployeeNumber))"
                                  Immediate="true"
                                  Required="true"
                                  RequiredError="Employee number is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Designation"
                                  @bind-Value="_editingUser.Designation"
                                  Required="true"
                                  RequiredError="Designation is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Email"
                                  @bind-Value="_editingUser.Email"
                                  Required="true"
                                  RequiredError="Email is required"
                                  Validation="@(new Func<string, string?>(ValidateEmail))"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                @if (_editingUser.Password == "LDAP_AUTHENTICATED")
                {
                    <MudItem xs="12">
                        <MudPaper Class="pa-4 rounded-xl" Style="background: rgba(234, 88, 12, 0.12); border: 1px solid rgba(234, 88, 12, 0.5);">
                            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3">
                                <MudIcon Icon="@Icons.Material.Filled.LockPerson" Style="color: #ea580c; margin-top: 2px;" />
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2" Style="color: #ea580c; font-weight: 700;">Company Account – Password Managed by IT</MudText>
                                    <MudText Typo="Typo.body2" Style="color: #f1f5f9; opacity: 0.9;">
                                        Your password is managed by the <strong>Company Directory (LDAP)</strong>. To change your password, please submit a helpdesk ticket.
                                    </MudText>
                                    <a href="https://helpdesk.lccgroup.com/" target="_blank"
                                       style="color: #f1f5f9; font-weight: 600; font-size: 0.85rem; text-decoration: none;">
                                        Submit a Helpdesk Ticket &rarr;
                                    </a>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="Password"
                                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="@TogglePasswordVisibility"
                                      AdornmentColor="@GetAdornmentColor()"
                                      @bind-Value="_password"
                                      Immediate="true"
                                      Validation="@(new Func<string, string?>(ValidatePassword))"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Leave blank to keep current password" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="Confirm Password"
                                      InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="@ToggleConfirmPasswordVisibility"
                                      AdornmentColor="@GetAdornmentColor()"
                                      @bind-Value="_confirmPassword"
                                      Immediate="true"
                                      Validation="@(new Func<string, string?>(ValidateConfirmPassword))"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Style="@GetCancelButtonStyle()">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@_isSaving" Class="rounded-lg px-6" Style="@GetButtonStyle()">
            @if (_isSaving)
            {
                <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Updating...</span>
            }
            else
            {
                <span>Update</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm _form = default!;
    private bool _isSaving = false;

    private User _editingUser = new();
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;

    private bool _showPassword = false;
    private bool _showConfirmPassword = false;

    private string? _imagePreviewUrl;
    private byte[]? _imageBytes;
    private string? _imageMimeType;

    [Parameter]
    public User UserToEdit { get; set; } = default!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;



    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(15px); min-width: 320px;";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.5);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.2); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleColor()
    {
        if (ThemeService == null)
            return "#0f172a";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "text-transform: none; font-weight: 600;";
        var baseStyle = "text-transform: none; font-weight: 600;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? $"{baseStyle} color: #0072cf !important; background-color: #ffffff !important;"
            : baseStyle;
    }

    private string GetCancelButtonStyle()
    {
        return $"color: {GetTitleColor()}; text-transform: none; font-weight: 600;";
    }

    private MudBlazor.Color GetAdornmentColor()
    {
        if (ThemeService == null) return MudBlazor.Color.Primary;
        return ThemeService.CurrentTheme == ThemeMode.Light ? MudBlazor.Color.Surface : MudBlazor.Color.Primary;
    }


    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetUploadSectionClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "upload-section lightest" : "upload-section";
    }

    protected override void OnInitialized()
    {
        _editingUser = new User
        {
            Id = UserToEdit.Id,
            Username = UserToEdit.Username,
            Email = UserToEdit.Email,
            Password = UserToEdit.Password,
            Fullname = UserToEdit.Fullname,
            Role = UserToEdit.Role,
            EmployeeNumber = UserToEdit.EmployeeNumber,
            Designation = UserToEdit.Designation,
            ImageData = UserToEdit.ImageData,
            ImageMimeType = UserToEdit.ImageMimeType
        };

        if (_editingUser.ImageData != null && !string.IsNullOrEmpty(_editingUser.ImageMimeType))
        {
            _imagePreviewUrl = $"data:{_editingUser.ImageMimeType};base64,{Convert.ToBase64String(_editingUser.ImageData)}";
        }
    }

    private string? ValidateEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "Email is required";

        var emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        if (!Regex.IsMatch(email, emailPattern, RegexOptions.IgnoreCase))
            return "Enter a valid email address";

        return null;
    }

    private string? ValidateEmployeeNumber(string? employeeNumber)
    {
        if (!string.IsNullOrEmpty(employeeNumber) && !Regex.IsMatch(employeeNumber, "^[0-9]*$"))
        {
            return "Employee number must contain only numerical values.";
        }
        return null;
    }

    private string? ValidatePassword(string password)
    {
        if (string.IsNullOrEmpty(password))
            return null;

        var errors = new List<string>();
        if (password.Length < 8)
            errors.Add("at least 8 characters");
        if (!Regex.IsMatch(password, @"[A-Z]"))
            errors.Add("an uppercase letter");
        if (!Regex.IsMatch(password, @"[a-z]"))
            errors.Add("a lowercase letter");
        if (!Regex.IsMatch(password, @"[0-9]"))
            errors.Add("a number");
        if (!Regex.IsMatch(password, @"[^a-zA-Z0-9]"))
            errors.Add("a special character");

        if (errors.Any())
        {
            return $"Password requires: {string.Join(", ", errors)}";
        }

        return null;
    }

    private string? ValidateConfirmPassword(string confirmPassword)
    {
        if (!string.IsNullOrEmpty(_password) && confirmPassword != _password)
            return "Passwords do not match";
        return null;
    }

    private static string HashPassword(string password)
    {
        using var sha256 = SHA256.Create();
        var bytes = Encoding.UTF8.GetBytes(password);
        var hash = sha256.ComputeHash(bytes);
        return Convert.ToBase64String(hash);
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        _isSaving = true;

        try
        {
            var existingUsername = Db.Users
                .FirstOrDefault(u => u.Id != _editingUser.Id &&
                                   u.Username != null &&
                                   u.Username.ToLower() == _editingUser.Username.ToLower());

            if (existingUsername != null)
            {
                Snackbar.Add("Username already exists.", Severity.Warning);
                _isSaving = false;
                return;
            }

            if (!string.IsNullOrWhiteSpace(_editingUser.EmployeeNumber))
            {
                var existingEmployeeNumber = Db.Users
                    .FirstOrDefault(u => u.Id != _editingUser.Id &&
                                       u.EmployeeNumber != null &&
                                       u.EmployeeNumber == _editingUser.EmployeeNumber);

                if (existingEmployeeNumber != null)
                {
                    Snackbar.Add("Employee number already exists.", Severity.Warning);
                    _isSaving = false;
                    return;
                }
            }

            var existingEmail = Db.Users
                .FirstOrDefault(u => u.Id != _editingUser.Id &&
                                   u.Email != null &&
                                   u.Email.ToLower() == (_editingUser.Email ?? "").ToLower());

            if (existingEmail != null)
            {
                Snackbar.Add("Email already exists.", Severity.Warning);
                _isSaving = false;
                return;
            }

            if (!string.IsNullOrEmpty(_password))
            {
                _editingUser.Password = HashPassword(_password);
            }

            var userInDb = await Db.Users.FindAsync(_editingUser.Id);
            if (userInDb != null)
            {
                userInDb.Username = _editingUser.Username;
                userInDb.Email = _editingUser.Email;
                userInDb.Password = _editingUser.Password;
                userInDb.Fullname = _editingUser.Fullname;
                userInDb.EmployeeNumber = _editingUser.EmployeeNumber;
                userInDb.Designation = _editingUser.Designation;

                if (_imageBytes != null && !string.IsNullOrEmpty(_imageMimeType))
                {
                    userInDb.ImageData = _imageBytes;
                    userInDb.ImageMimeType = _imageMimeType;
                }

                await Db.SaveChangesAsync();
                Snackbar.Add("Account updated", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            _isSaving = false;
        }
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;
    private void ToggleConfirmPasswordVisibility() => _showConfirmPassword = !_showConfirmPassword;

    private async Task OnFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file.Size > 5 * 1024 * 1024)
        {
            Snackbar.Add("Image size must be less than 5MB", Severity.Warning);
            return;
        }

        try
        {
            using var inputStream = file.OpenReadStream(5 * 1024 * 1024);
            using var image = await Image.LoadAsync(inputStream);

            image.Mutate(x => x.Resize(new SixLabors.ImageSharp.Processing.ResizeOptions
            {
                Size = new SixLabors.ImageSharp.Size(300, 300),
                Mode = SixLabors.ImageSharp.Processing.ResizeMode.Max
            }));

            using var ms = new MemoryStream();

            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            bool isPng = extension == ".png";

            if (isPng)
            {
                var encoder = new PngEncoder { CompressionLevel = PngCompressionLevel.BestCompression };
                await image.SaveAsync(ms, encoder);
                _imageMimeType = "image/png";
                _imagePreviewUrl = $"data:image/png;base64,{Convert.ToBase64String(ms.ToArray())}";
            }
            else
            {
                var encoder = new JpegEncoder { Quality = 70 };
                await image.SaveAsync(ms, encoder);
                _imageMimeType = "image/jpeg";
                _imagePreviewUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}";
            }

            _imageBytes = ms.ToArray();

            Snackbar.Add($"Image uploaded ({_imageBytes.Length / 1024}KB)", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error processing image: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}