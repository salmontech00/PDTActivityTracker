@using MudBlazor
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Model
@using PDTActivityTracker.Components.Services
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject IDbContextFactory<AppDbContext> DbFactory
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject ExportService ExportService
@inject IJSRuntime JSRuntime
@inject UserStateService UserState

<style>
    /* SHARED GLASS DIALOG STYLES */
    .glass-dialog .mud-button {
        border: none !important;
        text-transform: none !important;
        font-weight: 600;
    }

    /* --- LIGHT MODE (BLUE GLASS) --- */
    .glass-dialog.light .mud-input-root,
    .glass-dialog.light .mud-input-slot,
    .glass-dialog.light .mud-input-label,
    .glass-dialog.light .mud-icon-root,
    .glass-dialog.light .mud-input-adornment {
        color: #ffffff !important;
    }

    .glass-dialog.light .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.8) !important;
    }

    .glass-dialog.light .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.light .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #ffffff !important;
        border-width: 2px !important;
    }

    .glass-dialog.light .mud-input-slot::placeholder {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    /* --- LIGHTEST MODE --- */
    .glass-dialog.lightest .mud-input-root,
    .glass-dialog.lightest .mud-input-slot,
    .glass-dialog.lightest .mud-input-label {
        color: #0f172a !important;
    }

    .glass-dialog.lightest .mud-icon-root {
        color: #0072cf !important;
    }

    

    .glass-dialog.lightest .mud-input-outlined-border {
        border-color: rgba(0, 114, 207, 0.4) !important;
    }

    .glass-dialog.lightest .mud-input-root:hover .mud-input-outlined-border,
    .glass-dialog.lightest .mud-input-root.mud-input-focused .mud-input-outlined-border {
        border-color: #0072cf !important;
    }
</style>

<MudDialog Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="@($"color: {GetTitleColor()}; font-weight: 700;")">Export Reports</MudText>
    </TitleContent>

    <DialogContent>
        <MudPaper Class="@($"glass-panel pa-6 {GetThemeClass()}")" Elevation="0" Style="background: transparent !important;">
            <MudSelect T="string" @bind-Value="_reportType" Label="Report Type" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4">
                <MudSelectItem Value="@("All")">Activity Reports</MudSelectItem>
                <MudSelectItem Value="@("ByStore")">Reports By Store</MudSelectItem>
                <MudSelectItem Value="@("ByUser")">Reports By User</MudSelectItem>
                @if (UserState.Role == "AVP" || UserState.Role == "Admin")
                {
                    <MudSelectItem Value="@("ExecutiveSummary")">Executive Summary (PDF)</MudSelectItem>
                }
            </MudSelect>

            @if (_reportType == "ByStore")
            {
                <MudAutocomplete T="Store"
                                 Label="Filter Store"
                                 Value="@(_stores.FirstOrDefault(s => s.Id == _selectedStoreId))"
                                 ValueChanged="@(s => _selectedStoreId = s?.Id)"
                                 SearchFunc="@SearchStores"
                                 ToStringFunc="@(s => s == null ? "Select Store" : $"{s.StoreCode} - {s.StoreName}")"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 CoerceValue="false"
                                 Clearable="true"
                                 Placeholder="Enter store code or name..."
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="mb-4" />
            }

            @if (_reportType == "ByUser")
            {
                <MudAutocomplete T="User"
                                 Label="Filter User"
                                 Value="@(_users.FirstOrDefault(u => u.Id == _selectedUserId))"
                                 ValueChanged="@(u => _selectedUserId = u?.Id)"
                                 SearchFunc="@SearchUsers"
                                 ToStringFunc="@(u => u == null ? "Select User" : u.Fullname)"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 CoerceValue="false"
                                 Clearable="true"
                                 Placeholder="Enter user name..."
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="mb-4" />
            }

            <MudDateRangePicker Label="Date Range"
                                @bind-DateRange="_dateRange"
                                Variant="Variant.Outlined"
                                Margin="Margin.Dense"
                                Class="mb-4" />

            @if (_reportType != "ExecutiveSummary")
            {
                <MudSelect T="string" @bind-Value="_exportFormat" Label="Format" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-6">
                    <MudSelectItem Value="@("Excel")">Excel</MudSelectItem>
                    <MudSelectItem Value="@("PDF")">PDF</MudSelectItem>
                </MudSelect>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mb-6" Dense="true">Executive Summary is optimized for PDF format.</MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="ExportData"
                       Disabled="@_isExporting"
                       Class="rounded-lg"
                       Style="@GetButtonStyle()">
                @if (_isExporting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>EXPORTING...</span>
                }
                else
                {
                    <span>EXPORT DATA</span>
                }
            </MudButton>
        </MudPaper>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private string _reportType = "All";
    private string _exportFormat = "Excel";
    private int? _selectedStoreId;
    private int? _selectedUserId;
    private DateRange _dateRange = new DateRange(DateTime.Today.AddDays(-30), DateTime.Today);
    private bool _isExporting = false;

    private List<Store> _stores = new();
    private List<User> _users = new();

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var query = db.Stores.Where(s => !s.IsDeleted).AsNoTracking();
        if (UserState.Role == "Area Head")
        {
            query = query.Where(s => s.AreaHeadId == UserState.UserId);
        }

        _stores = await query.OrderBy(s => s.StoreName).ToListAsync();
        _users = await db.Users.AsNoTracking().OrderBy(u => u.Fullname).ToListAsync();
    }

    private Task<IEnumerable<Store>> SearchStores(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return Task.FromResult<IEnumerable<Store>>(_stores);
        return Task.FromResult<IEnumerable<Store>>(_stores.Where(s => s.StoreCode.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                                 s.StoreName.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private Task<IEnumerable<User>> SearchUsers(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return Task.FromResult<IEnumerable<User>>(_users);
        return Task.FromResult<IEnumerable<User>>(_users.Where(u => u.Fullname.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task ExportData()
    {
        _isExporting = true;
        StateHasChanged();

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            List<StoreDailyActivity> activities = new();
            if (_reportType != "ExecutiveSummary")
            {
                var query = db.StoreDailyActivities
                    .Include(a => a.Store)
                    .Include(a => a.StartedBy)
                    .AsNoTracking();

                // Apply filters
                if (_dateRange.Start.HasValue)
                    query = query.Where(a => a.Date >= _dateRange.Start.Value.Date);
                if (_dateRange.End.HasValue)
                    query = query.Where(a => a.Date <= _dateRange.End.Value.Date.AddDays(1).AddSeconds(-1));

                if (_reportType == "ByStore" && _selectedStoreId.HasValue)
                    query = query.Where(a => a.StoreId == _selectedStoreId.Value);

                if (_reportType == "ByUser" && _selectedUserId.HasValue)
                    query = query.Where(a => a.StartedById == _selectedUserId.Value);

                if (UserState.Role == "Area Head")
                {
                    var assignedStoreIds = _stores.Select(s => s.Id).ToList();
                    query = query.Where(a => assignedStoreIds.Contains(a.StoreId));
                }

                activities = await query.OrderByDescending(a => a.Date).ToListAsync();

                if (!activities.Any())
                {
                    Snackbar.Add("No reports found for the selected criteria", Severity.Warning);
                    return;
                }
            }

            byte[] fileBytes;
            string fileName;
            string contentType;

            if (_reportType == "ExecutiveSummary")
            {
                fileBytes = await ExportService.ExportExecutiveSummaryAsync();
                fileName = $"Executive_Summary_{DateTime.Now:yyyyMMdd}.pdf";
                contentType = "application/pdf";
            }
            else if (_exportFormat == "Excel")
            {
                fileBytes = await ExportService.ExportReportsToExcelAsync(activities);
                fileName = $"Monitoring_Report_{DateTime.Now:yyyyMMdd}.xlsx";
                contentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            }
            else
            {
                fileBytes = await ExportService.ExportReportsToPdfAsync(activities);
                fileName = $"Monitoring_Report_{DateTime.Now:yyyyMMdd}.pdf";
                contentType = "application/pdf";
            }

            var base64 = Convert.ToBase64String(fileBytes);
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, contentType, base64);

            Snackbar.Add($"{_exportFormat} report exported", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(15px); min-width: 350px; max-width: 500px;";

        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.4);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleColor()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetButtonStyle()
    {
        var baseStyle = "text-transform: none; font-weight: 700; height: 48px;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? $"{baseStyle} color: #0072cf !important; background-color: #ffffff !important;"
            : baseStyle;
    }

    private string GetThemeClass() => ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
                                      ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
}
