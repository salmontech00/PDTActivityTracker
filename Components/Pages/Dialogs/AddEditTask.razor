@using MudBlazor
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<style>
    .glass-dialog .mud-button {
        border-radius: 12px !important;
        text-transform: none !important;
        font-weight: 600;
    }

    .glass-dialog.lightest .mud-input-root,
    .glass-dialog.lightest .mud-input-slot,
    .glass-dialog.lightest .mud-input-label {
        color: #0f172a !important;
    }

    .glass-dialog.lightest .mud-icon-root {
        color: #0072cf !important;
    }

    .glass-dialog.light .mud-input-root,
    .glass-dialog.light .mud-input-slot,
    .glass-dialog.light .mud-input-label,
    .glass-dialog.light .mud-input-adornment,
    .glass-dialog.light .mud-icon-root {
        color: #ffffff !important;
    }

    .glass-dialog.light .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.5) !important;
    }
</style>

<MudDialog Class="@($"rounded-xl pa-2 glass-dialog {GetThemeClass()}")" Style="@GetDialogStyle()">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="@GetTitleStyle()">@(IsEdit ? "Edit Task" : "Add New Task")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField T="string" Label="Task Name (Optional)" @bind-Value="_model.TaskName" Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Description" @bind-Value="_model.Description" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="Category" @bind-Value="_model.CategoryId" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var cat in _categories)
                        {
                            <MudSelectItem Value="@cat.Id">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Frequency" @bind-Value="_model.Frequency" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("Daily")">Daily</MudSelectItem>
                        <MudSelectItem Value="@("Weekly")">Weekly</MudSelectItem>
                        <MudSelectItem Value="@("Monthly")">Monthly</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudAutocomplete T="string"
                                     Label="Section (Optional)"
                                     @bind-Value="_model.Section"
                                     SearchFunc="@SearchSections"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     CoerceText="false"
                                     CoerceValue="false"
                                     Clearable="true"
                                     HelperText="Select existing or type a new section name" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" Label="Mandatory Field?" @bind-Value="_model.IsMandatory" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" Label="Remarks Required?" @bind-Value="_model.IsRemarksRequired" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" Label="Photo Required?" @bind-Value="_model.IsPhotoRequired" Color="Color.Primary" />
                </MudItem>
                @if (_model.IsPhotoRequired)
                {
                    <MudItem xs="12" sm="8">
                        <MudNumericField T="int" Label="Number of Photos" @bind-Value="_model.NumberOfPhotos" Min="0" Max="20"
                                         Disabled="@(_model.NumberOfPhotos == 0)"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         HelperText="@(_model.NumberOfPhotos == 0 ? "Infinite photos allowed" : "")" />
                    </MudItem>
                    <MudItem xs="12" sm="4" class="d-flex align-center">
                        <MudCheckBox T="bool" Label="Limitless"
                                     Value="@(_model.NumberOfPhotos == 0)"
                                     ValueChanged="@((bool val) => _model.NumberOfPhotos = val ? 0 : 1)"
                                     Color="Color.Primary" Dense="true" />
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => Submit())" Style="@GetButtonStyle()">
            @(IsEdit ? "Update Task" : "Add Task")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ChecklistItem? TaskToEdit { get; set; }
    [Parameter] public EventCallback OnTaskSaved { get; set; }

    private ChecklistItem _model = new();
    private MudForm _form = default!;
    private List<string> _existingSections = new();
    private List<Category> _categories = new();
    private bool IsEdit => TaskToEdit != null;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadExistingSections();

        if (IsEdit)
        {
            _model = new ChecklistItem
            {
                Id = TaskToEdit!.Id,
                TaskName = TaskToEdit.TaskName,
                Description = TaskToEdit.Description,
                CategoryId = TaskToEdit.CategoryId,
                IsPhotoRequired = TaskToEdit.IsPhotoRequired,
                NumberOfPhotos = TaskToEdit.NumberOfPhotos,
                IsMandatory = TaskToEdit.IsMandatory,
                Frequency = TaskToEdit.Frequency,
                IsRemarksRequired = TaskToEdit.IsRemarksRequired,
                SortOrder = TaskToEdit.SortOrder,
                Section = TaskToEdit.Section
            };
        }
        else
        {
            _model.CategoryId = _categories.FirstOrDefault()?.Id ?? 0;
            _model.IsMandatory = true;
            _model.IsRemarksRequired = true;
            _model.IsPhotoRequired = true;
            _model.NumberOfPhotos = 1;
        }
    }

    private async Task LoadCategories()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        _categories = await db.Categories.OrderBy(c => c.SortOrder).ToListAsync();
    }

    private async Task LoadExistingSections()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        _existingSections = await db.ChecklistItems
            .Where(c => !string.IsNullOrEmpty(c.Section))
            .Select(c => c.Section!)
            .Distinct()
            .OrderBy(s => s)
            .ToListAsync();
    }

    private Task<IEnumerable<string>> SearchSections(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_existingSections.AsEnumerable());

        var filtered = _existingSections
            .Where(s => s.Contains(value, StringComparison.OrdinalIgnoreCase))
            .ToList();

        // If the typed value is not in the list, allow it as a new option
        if (!filtered.Any(s => s.Equals(value, StringComparison.OrdinalIgnoreCase)))
        {
            filtered.Insert(0, value);
        }

        return Task.FromResult(filtered.AsEnumerable());
    }

    private string GetThemeClass() => ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
                                      ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";

    private string GetDialogStyle()
    {
        var baseStyle = "backdrop-filter: blur(10px); min-width: 320px;";
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15);",
            ThemeMode.Light => $"{baseStyle} background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.2);",
            ThemeMode.Dark => $"{baseStyle} background-color: rgba(30, 41, 59, 0.15); border: 1px solid rgba(255,255,255,0.05);",
            _ => $"{baseStyle} background-color: rgba(255, 255, 255, 0.95);"
        };
    }

    private string GetTitleStyle() => $"color: {(ThemeService.CurrentTheme == ThemeMode.Lightest ? "#0f172a" : "#ffffff")}; font-weight: 700;";
    private string GetButtonStyle() => ThemeService.CurrentTheme == ThemeMode.Light ? "color: #0072cf !important; background-color: #ffffff !important;" : "";

    private async Task Submit()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        using var db = await DbFactory.CreateDbContextAsync();
        if (IsEdit)
        {
            var taskInDb = await db.ChecklistItems.FindAsync(_model.Id);
            if (taskInDb != null)
            {
                db.Entry(taskInDb).CurrentValues.SetValues(_model);
                await db.SaveChangesAsync();
                Snackbar.Add("Task updated", Severity.Success);

                if (OnTaskSaved.HasDelegate)
                {
                    await OnTaskSaved.InvokeAsync();
                }
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        else
        {
            // Set SortOrder as the last item
            _model.SortOrder = await db.ChecklistItems.CountAsync();
            db.ChecklistItems.Add(_model);
            await db.SaveChangesAsync();
            Snackbar.Add("Task added", Severity.Success);

            if (OnTaskSaved.HasDelegate)
            {
                await OnTaskSaved.InvokeAsync();
            }

            // After adding, reset for next task but preserve context
            var currentCategory = _model.CategoryId;
            var currentSection = _model.Section;
            var currentFrequency = _model.Frequency;

            _model = new ChecklistItem
            {
                CategoryId = currentCategory,
                Section = currentSection,
                Frequency = currentFrequency,
                IsMandatory = true,
                IsRemarksRequired = true,
                IsPhotoRequired = true,
                NumberOfPhotos = 1
            };

            _form.ResetValidation();
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}

