                                                <div class="d-flex align-center gap-2 mb-1">
                                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; line-height: 1.3; word-break: break-word; overflow-wrap: anywhere; flex: 1; min-width: 0;">@issue.Title</MudText>
                                                    <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(issue.Priority)" Variant="Variant.Filled" Style="font-weight: 700;">@issue.Priority</MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(issue.Status)" Variant="Variant.Filled" Style="font-weight: 700;">@issue.Status</MudChip>
                                                </div>
                                                <MudText Typo="Typo.body2" Style="opacity: 0.8; white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere;" Class="mb-2">@issue.Description</MudText>
