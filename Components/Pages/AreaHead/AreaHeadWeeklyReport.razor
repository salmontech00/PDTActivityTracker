                                        @* Reporter info *@
                                        <div class="d-flex align-center gap-2 mt-2" style="opacity: 0.6;">
                                            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                                            <MudText Typo="Typo.caption">Reported @issue.ReportedAt.ToString("MMM dd, yyyy • hh:mm tt") by @(issue.ReportedBy?.Fullname ?? "Store Head")</MudText>
