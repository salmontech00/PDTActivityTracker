                                    </div>
                                </MudPaper>
                            }
                        </MudList>
                    }
                </MudPaper>
            </div>
        }
    }
</div>

@code {
    private async Task OpenGlassCalendarDialog()
    {
        var parameters = new DialogParameters<GlassCalendarWrapperDialog>
        {
            { x => x.SelectedDate, _selectedDate }
        };
        var options = new DialogOptions
        {
            NoHeader = true,
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<GlassCalendarWrapperDialog>("", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is DateTime selectedDate)
        {
            await OnDateChanged(selectedDate);
        }
    }

    [Parameter] public int StoreId { get; set; }
    [Parameter][SupplyParameterFromQuery] public string? view { get; set; }

    private bool _initialized = false;
    private bool _isLoadingPeriod = false;
    private Store? _store;
    private List<Category> _categories = new();
    private List<ChecklistItem> _checklistItems = new();
    private StoreDailyActivity? _currentSession;
    private List<TaskProgress> _taskProgresses = new();
    private List<TaskPhoto> _loadedPhotos = new();
    private DateTime? _derivedCheckInTime;
    private int _dailyCompleted = 0;
    private int _dailyTotal = 0;
    private double _dailyCompletionPercentage = 0;

    // Period switcher
    private string _viewMode = "Daily";
    private DateTime? _selectedDate = DateTime.Today;
    private List<DayReportRow> _periodRows = new();
    private List<Issue> _issues = new();
    private bool _isLoadingIssues = false;

    private class DayReportRow
    {
        public DateTime Date { get; set; }
        public string DayLabel => Date.ToString("ddd, MMM dd");
        public DateTime? CheckInTime { get; set; }
        public int CompletedTasks { get; set; }
        public int TotalTasks { get; set; }
        public double CompletionPercentage { get; set; }
        public bool HasSession { get; set; }
        public string StatusText => !HasSession ? "Inactive" : (CompletionPercentage >= 100 ? "Completed" : "In Progress");
        public Color StatusColor => !HasSession ? Color.Default : (CompletionPercentage >= 100 ? Color.Success : Color.Info);
    }

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await UserState.InitializeAsync();

            if (UserState.Role != "Area Head" && UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo(UserState.LastValidPage ?? UserState.GetDashboardRoute(), forceLoad: true);
                return;
            }
            await UserState.SetLastValidPage(NavigationManager.Uri);

            await LoadStoreAndMeta();

            if (!string.IsNullOrEmpty(view))
            {
                _viewMode = view;
            }

            if (_viewMode == "Daily")
            {
                await LoadDailyData(_selectedDate ?? DateTime.Today);
            }
            else if (_viewMode == "Issues")
            {
                await LoadIssues();
            }
            else
            {
                await LoadPeriodData();
            }
        }
    }

    private void OnThemeChanged() => StateHasChanged();

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    // ── Load store metadata (categories, checklist items) ──────────────────
    private async Task LoadStoreAndMeta()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        _store = await db.Stores.FirstOrDefaultAsync(s => s.Id == StoreId);
        if (_store == null)
        {
            NavigationManager.NavigateTo("/area-head/monitoring");
            return;
        }
        _categories = await db.Categories.AsNoTracking().OrderBy(c => c.SortOrder).ToListAsync();
        _checklistItems = await db.ChecklistItems.AsNoTracking().ToListAsync();
    }

    // ── DAILY ──────────────────────────────────────────────────────────────
    private async Task LoadDailyData(DateTime date)
    {
        _initialized = false;
        StateHasChanged();

        using var db = await DbFactory.CreateDbContextAsync();
        bool isMonday = date.DayOfWeek == DayOfWeek.Monday;
        bool isFirstOfMonth = date.Day == 1;

        _currentSession = await db.StoreDailyActivities
            .Include(s => s.CurrentCategory)
            .Include(s => s.AreaHead)
            .OrderByDescending(s => s.Id)
            .FirstOrDefaultAsync(s => s.StoreId == StoreId && s.Date >= date && s.Date < date.AddDays(1));

        _derivedCheckInTime = null;
        _taskProgresses = new();
        _loadedPhotos = new();
        _dailyCompleted = 0;
        _dailyTotal = 0;
        _dailyCompletionPercentage = 0;

        if (_currentSession != null)
        {
            _taskProgresses = await db.TaskProgresses
                .Where(tp => tp.StoreDailyActivityId == _currentSession.Id)
                .ToListAsync();

            _loadedPhotos = await db.TaskPhotos
                .Include(p => p.Store)
                .Include(p => p.UploadedBy)
                .Include(p => p.Category)
                .Include(p => p.ChecklistItem)
                    .ThenInclude(c => c!.Category)
                .Include(p => p.StoreDailyActivity)
                    .ThenInclude(s => s!.Store)
                .Include(p => p.StoreDailyActivity)
                    .ThenInclude(s => s!.StartedBy)
                .Where(p => p.StoreDailyActivityId == _currentSession.Id)
                .ToListAsync();

            var progResult = await PDTActivityTracker.Components.Services.ActivityProgressHelper.CalculateProgressForActivitiesAsync(new[] { _currentSession }, db);
            if (progResult.TryGetValue(_currentSession.Id, out var p))
            {
                _derivedCheckInTime = p.CheckInTime;
                _dailyTotal = p.TotalTasks;
                _dailyCompleted = p.CompletedTasks;
                _dailyCompletionPercentage = p.CompletionPercentage;
            }
        }
        else
        {
            _dailyTotal = _checklistItems.Count(i => IsTaskAssignedToStore(i, StoreId));
        }

        _initialized = true;
        StateHasChanged();
    }

    // ── WEEKLY / MONTHLY ───────────────────────────────────────────────────
    private async Task LoadPeriodData()
    {
        _isLoadingPeriod = true;
        StateHasChanged();

        var (start, end) = GetPeriodRange();
        var rows = new List<DayReportRow>();

        using var db = await DbFactory.CreateDbContextAsync();

        // Fetch all sessions in the date range at once
        var sessions = await db.StoreDailyActivities
            .AsNoTracking()
            .Where(a => a.StoreId == StoreId && a.Date >= start && a.Date < end.AddDays(1))
            .ToListAsync();

        var allPeriodProgress = await PDTActivityTracker.Components.Services.ActivityProgressHelper.CalculateProgressForActivitiesAsync(sessions, db);
        var defaultTotalTasks = _checklistItems.Count(i => IsTaskAssignedToStore(i, StoreId));

        // Build a row for each day in the range (up to today)
        for (var d = start; d <= DateTime.Today && d <= end; d = d.AddDays(1))
        {
            var session = sessions.OrderByDescending(s => s.Id).FirstOrDefault(s => s.Date.Date == d.Date);
            
            DateTime? checkIn = null;
            int completed = 0;
            int total = defaultTotalTasks;
            double percentage = 0;

            if (session != null && allPeriodProgress.TryGetValue(session.Id, out var p))
            {
                checkIn = p.CheckInTime;
                completed = p.CompletedTasks;
                total = p.TotalTasks;
                percentage = p.CompletionPercentage;
            }

            rows.Add(new DayReportRow
            {
                Date = d,
                HasSession = session != null,
                CheckInTime = checkIn,
                CompletedTasks = completed,
                TotalTasks = total,
                CompletionPercentage = percentage
            });
        }

        _periodRows = rows;
        _isLoadingPeriod = false;
        StateHasChanged();
    }

    // ── ISSUES ─────────────────────────────────────────────────────────────
    private async Task LoadIssues()
    {
        _isLoadingIssues = true;
        StateHasChanged();

        using var db = await DbFactory.CreateDbContextAsync();

        // Load issues for the current store, possibly filtered by the selected date range
        // For simplicity, we'll load the last 30 days of issues by default if in Daily,
        // or the period range if in Weekly/Monthly.

        var query = db.Issues.AsNoTracking()
            .Include(i => i.ReportedBy)
            .Include(i => i.Store)
            .Where(i => i.StoreId == StoreId);

        if (_viewMode == "Issues")
        {
            // Use local Today to avoid timezone discrepancies hiding new reports
            var today = DateTime.Today;
            var start = today.AddDays(-30);
            var end = today.AddDays(1);

            query = query.Where(i => i.ReportedAt >= start && i.ReportedAt < end);
        }

        _issues = await query.OrderByDescending(i => i.ReportedAt).ToListAsync();
        _isLoadingIssues = false;
        StateHasChanged();
    }

    // ── Helpers ────────────────────────────────────────────────────────────
    private async Task SwitchView(string mode)
    {
        _viewMode = mode;
        if (mode == "Daily")
        {
            await LoadDailyData(_selectedDate ?? DateTime.Today);
        }
        else if (mode == "Issues")
        {
            await LoadIssues();
        }
        else
        {
            await LoadPeriodData();
        }
    }

    private async Task OnDateChanged(DateTime? date)
    {
        _selectedDate = date ?? DateTime.Today;
        await LoadDailyData(_selectedDate.Value);
    }

    private async Task DrillDownToDay(DateTime date)
    {
        _selectedDate = date;
        _viewMode = "Daily";
        await LoadDailyData(date);
    }

    private (DateTime start, DateTime end) GetPeriodRange()
    {
        var today = DateTime.Today;
        if (_viewMode == "Weekly")
        {
            // ISO week: Monday to Sunday
            int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
            var monday = today.AddDays(-diff);
            return (monday, monday.AddDays(6));
        }
        else // Monthly
        {
            return (new DateTime(today.Year, today.Month, 1), new DateTime(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month)));
        }
    }

    private string GetPeriodLabel()
    {
        var (start, end) = GetPeriodRange();
        if (_viewMode == "Weekly")
            return $"{start:MMM dd} – {end:MMM dd, yyyy}";
        return start.ToString("MMMM yyyy");
    }

    private TaskProgress GetTaskProgress(int taskId)
        => _taskProgresses.FirstOrDefault(p => p.ChecklistItemId == taskId) ?? new TaskProgress();

    private List<TaskPhoto> GetStoredPhotos(int taskId)
        => _loadedPhotos.Where(p => p.ChecklistItemId == taskId).ToList();

    private string GetCategorySummary(int categoryId)
    {
        var tasks = _checklistItems.Where(t => t.CategoryId == categoryId && IsTaskAssignedToStore(t, StoreId)).ToList();
        var completed = _taskProgresses.Count(tp => tasks.Any(t => t.Id == tp.ChecklistItemId) && tp.IsCompleted);
        return $"{completed} / {tasks.Count} Completed";
    }

    private async Task ApproveReport()
    {
        if (_currentSession == null) return;

        if (GetReportProgress() < 100.0)
        {
            Snackbar.Add("Cannot approve report. Store tasks are still incomplete.", Severity.Warning);
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var session = await db.StoreDailyActivities.FindAsync(_currentSession.Id);
        if (session != null)
        {
            session.IsCompleted = true;
            // Only set completed at if it wasn't already set
            if (!session.CompletedAt.HasValue)
            {
                session.CompletedAt = DateTime.Now;
            }
            session.AreaHeadRemark = _currentSession.AreaHeadRemark;
            session.AreaHeadReviewedAt = DateTime.Now;
            session.AreaHeadId = UserState.UserId; // Track reviewer

            await db.SaveChangesAsync();
            _currentSession.IsCompleted = true;
            _currentSession.AreaHeadReviewedAt = session.AreaHeadReviewedAt;
            _currentSession.AreaHeadId = session.AreaHeadId;

            Snackbar.Add("Report approved and finalized with feedback.", Severity.Success);

            // Reload to get reviewer name if needed
            await LoadDailyData(_selectedDate ?? DateTime.Today);
            StateHasChanged();
        }
    }

    private async Task UnapproveReport()
    {
        if (_currentSession == null) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var session = await db.StoreDailyActivities.FindAsync(_currentSession.Id);
        if (session != null)
        {
            session.AreaHeadReviewedAt = null;
            session.IsCompleted = false;
            session.CompletedAt = null;
            // We keep IsCompleted as true if the store head had completed it,
            // but for now let's just clear the review status.
            // If they want to "Unapprove" it means it goes back to "In Progress" for the Area Head review.

            await db.SaveChangesAsync();
            _currentSession.AreaHeadReviewedAt = null;
            _currentSession.IsCompleted = false;
            _currentSession.CompletedAt = null;

            Snackbar.Add("Report unapproved.", Severity.Info);
            StateHasChanged();
        }
    }

    private void GoBack() => NavigationManager.NavigateTo("/area-head/map");

    private async Task OpenPhotoDialog(TaskPhoto photo)
    {
        var parameters = new DialogParameters { ["Photo"] = photo };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<PhotoGalleryDialog>("Photo Details", parameters, options);
    }

    private string GetThemeClass() => (ThemeService?.CurrentTheme ?? ThemeMode.Lightest) switch
    {
        ThemeMode.Lightest => "lightest",
        ThemeMode.Light => "light",
        ThemeMode.Dark => "dark",
        _ => "lightest"
    };

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "border-radius: 12px;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? "color: #0072cf !important; background-color: #ffffff !important; border-radius: 12px; font-weight: bold;"
            : "border-radius: 12px; font-weight: bold;";
    }

    private double GetReportProgress()
    {
        return _dailyCompletionPercentage;
    }

    private Color GetReportStatusColor()
    {
        if (_currentSession == null) return Color.Default;
        return GetReportProgress() >= 100 ? Color.Success : Color.Info;
    }

    private string GetReportStatusText()
    {
        if (_currentSession == null) return "Inactive";
        return GetReportProgress() >= 100 ? "Completed" : "In Progress";
    }

    private Color GetPriorityColor(string priority) => priority switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        _ => Color.Default
    };

    private Color GetStatusColor(string status) => status switch
    {
        "Resolved" => Color.Success,
        "Open" => Color.Error,
        _ => Color.Default
    };

    private string GetIssueCardStyle(Issue issue)
    {
        var isLight = ThemeService.CurrentTheme == ThemeMode.Light || ThemeService.CurrentTheme == ThemeMode.Lightest;
        var opacity = isLight ? "0.05" : "0.1";
        var borderColor = issue.Priority == "Critical" ? "rgba(244, 67, 54, 0.3)" : "rgba(255, 255, 255, 0.1)";
        return $"background: rgba(0, 114, 207, {opacity}); border: 1px solid {borderColor};";
    }

    private string GetIssueImageSource(Issue issue)
    {
        if (issue.ImageData == null) return "";
        return $"data:{issue.ImageMimeType};base64,{Convert.ToBase64String(issue.ImageData)}";
    }

    private async Task OpenIssuePhoto(Issue issue)
    {
        if (issue.ImageData == null) return;

        var photo = new TaskPhoto
        {
            ImageData = issue.ImageData,
            ImageMimeType = issue.ImageMimeType,
            Description = $"Evidence for: {issue.Title}",
            UploadedAt = issue.ReportedAt,
            CaptureTimestamp = issue.CaptureTime ?? issue.ReportedAt,
            Latitude = issue.Latitude,
            Longitude = issue.Longitude,
            Store = issue.Store,
            UploadedBy = issue.ReportedBy,
            Issue = issue
        };

        var parameters = new DialogParameters { ["Photo"] = photo };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<PhotoGalleryDialog>("Issue Evidence", parameters, options);
    }
    private bool IsTaskAssignedToStore(ChecklistItem task, int storeId)
    {
        if (string.IsNullOrWhiteSpace(task.SelectedStores)) return true;
        try
        {
            var ids = JsonSerializer.Deserialize<List<int>>(task.SelectedStores);
            return ids != null && ids.Contains(storeId);
        }
        catch { return true; }
    }

    private List<ManpowerPosition> GetManpowerPositions(ChecklistItem task)
    {
        if (task.TaskType != "Manpower" || string.IsNullOrWhiteSpace(task.Position))
            return new List<ManpowerPosition>();

        try
        {
            return JsonSerializer.Deserialize<List<ManpowerPosition>>(task.Position) ?? new List<ManpowerPosition>();
        }
        catch { return new List<ManpowerPosition>(); }
    }

    private int? GetPositionActualValue(TaskProgress prog, int index)
    {
        if (string.IsNullOrWhiteSpace(prog.PositionActuals)) return null;
        try
        {
            var actuals = JsonSerializer.Deserialize<List<int?>>(prog.PositionActuals);
            if (actuals != null && index >= 0 && index < actuals.Count)
                return actuals[index];
        }
        catch { }
        return null;
    }

    private int? GetPositionExpectedValue(TaskProgress prog, ChecklistItem task, int index)
    {
        if (!string.IsNullOrWhiteSpace(prog.PositionExpected))
        {
            try
            {
                var expecteds = JsonSerializer.Deserialize<List<int?>>(prog.PositionExpected);
                if (expecteds != null && index >= 0 && index < expecteds.Count)
                    return expecteds[index];
            }
            catch { }
        }

        var positions = GetManpowerPositions(task);
        if (index >= 0 && index < positions.Count)
            return positions[index].Count;

        return null;
    }

    private int GetTotalExpectedValue(TaskProgress prog, ChecklistItem task)
    {
        if (!string.IsNullOrWhiteSpace(prog.PositionExpected))
        {
            try
            {
                var expecteds = JsonSerializer.Deserialize<List<int?>>(prog.PositionExpected);
                if (expecteds != null)
                    return expecteds.Sum(a => a ?? 0);
            }
            catch { }
        }
        return task.QuantityExpected ?? 0;
    }
}
