                                <MudPaper Class="pa-4 mb-3 rounded-lg" Elevation="0" Style="@GetIssueCardStyle(issue)">
                                    <!-- DESKTOP VIEW (hidden on mobile via CSS) -->
                                    <div class="issue-card-desktop">
