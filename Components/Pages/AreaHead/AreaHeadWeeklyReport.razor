                                        <div class="d-flex flex-column align-start mb-1">
                                            <div class="d-flex gap-1 mb-1">
                                                <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(issue.Priority)" Variant="Variant.Filled" Style="font-weight: 700; margin: 0;">@issue.Priority</MudChip>
                                                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(issue.Status)" Variant="Variant.Filled" Style="font-weight: 700; margin: 0;">@issue.Status</MudChip>
                                            </div>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; line-height: 1.3; word-break: break-word; overflow-wrap: anywhere;" Class="mb-1">@issue.Title</MudText>
                                        </div>
                                        @* Description *@
                                        <MudText Typo="Typo.body2" Style="opacity: 0.8; white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere;" Class="mb-2">@issue.Description</MudText>
                                        @* Evidence photo attachment style *@
                                        @if (issue.ImageData != null)
                                        {
                                            <div class="mt-2 mb-2 d-flex justify-start">
                                                <div style="cursor: pointer; max-width: 160px; width: 100%; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 4px 8px rgba(0,0,0,0.15); background: rgba(0,0,0,0.2);" @onclick="@(() => OpenIssuePhoto(issue))">
                                                    <img src="@GetIssueImageSource(issue)"
                                                         style="width: 100%; height: 100px; object-fit: cover;"
                                                         alt="Evidence" />
                                                    <div style="padding: 4px; background: rgba(0,0,0,0.5); text-align: center;">
                                                        <MudText Typo="Typo.caption" Style="color: #ffffff; opacity: 0.9; font-size: 0.7rem; font-weight: 600; display: block;">Tap to view photo</MudText>
                                                    </div>
