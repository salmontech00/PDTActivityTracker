    protected override void OnInitialized()
    {
        base.OnInitialized();
        _dateRange = new DateRange(DateTime.Today.AddDays(-30), DateTime.Today);
        _photoDateRange = new DateRange(DateTime.Today.AddDays(-30), DateTime.Today);

        _refreshTimer = new System.Timers.Timer(60000);
        _refreshTimer.Elapsed += (s, e) => InvokeAsync(async () =>
        {
            if (_isLoading) return;
            await LoadData();
            StateHasChanged();
        });
        _refreshTimer.AutoReset = true;
        _refreshTimer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await UserState.InitializeAsync();

            if (UserState.Role != "Area Head" && UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo(UserState.LastValidPage ?? UserState.GetDashboardRoute(), forceLoad: true);
                return;
            }
            await UserState.SetLastValidPage(NavigationManager.Uri);

            ThemeService.OnThemeChanged += OnThemeChanged;
            UserState.DashboardRefreshRequested += HandleDashboardRefresh;
            DashboardRefresh.OnRefreshRequested += OnGlobalRefreshRequested;
            await LoadData();
            _initialized = true;
            StateHasChanged();
        }
    }

    private void OnGlobalRefreshRequested(int? storeId)
    {
        if (storeId == null || _assignedStores.Any(s => s.Id == storeId))
        {
            HandleDashboardRefresh();
        }
    }

    private void HandleDashboardRefresh()
    {
        if (_isLoading) return;
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        UserState.DashboardRefreshRequested -= HandleDashboardRefresh;
        DashboardRefresh.OnRefreshRequested -= OnGlobalRefreshRequested;
        _refreshTimer?.Dispose();
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadData()
    {
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var today = DateTime.Today;

            // Assigned Stores
            _assignedStores = await db.Stores
                .AsNoTracking()
                .Where(s => !s.IsDeleted && s.AreaHeadId == UserState.UserId)
                .Include(s => s.StoreHead)
                .ToListAsync();

            var storeIds = _assignedStores.Select(s => s.Id).ToList();

            // Categories
            _categoriesList = await db.Categories.AsNoTracking().ToListAsync();

            // Check-in category — fetch BEFORE activity logs
            _checkInCategoryId = (await db.Categories.AsNoTracking()
                .FirstOrDefaultAsync(c => c.Name.ToLower() == "check in"))?.Id;

            // Today's Activities
            var todayActivities = await db.StoreDailyActivities
                .AsNoTracking()
                .Where(a => storeIds.Contains(a.StoreId) && a.Date >= today && a.Date < today.AddDays(1))
                .ToListAsync();

            _todayActivities = todayActivities
                .GroupBy(a => a.StoreId)
                .ToDictionary(g => g.Key, g => (StoreDailyActivity?)g.OrderByDescending(a => a.Id).FirstOrDefault());

            _activeHeads = todayActivities
                .Select(a => a.StartedById)
                .Where(id => id.HasValue)
                .Distinct()
                .Count();

            // All Activities
            _activityLogs = await db.StoreDailyActivities
                .AsNoTracking()
                .Include(a => a.Store)
                .Include(a => a.StartedBy)
                .Include(a => a.AreaHead)
                .Where(a => storeIds.Contains(a.StoreId))
                .OrderByDescending(a => a.Date)
                .ToListAsync();

            // Progress cache
            _activityProgressCache = await PDTActivityTracker.Components.Services.ActivityProgressHelper
                .CalculateProgressForActivitiesAsync(_activityLogs, db);

            foreach (var storeId in storeIds)
            {
                var activity = _todayActivities.GetValueOrDefault(storeId);
                if (activity != null && _activityProgressCache.TryGetValue(activity.Id, out var p))
                    _storeProgresses[storeId] = p.CompletionPercentage;
                else
                    _storeProgresses[storeId] = 0;
            }

            _completedToday = _storeProgresses.Values.Count(p => p >= 100);
            _avgProgress = _storeProgresses.Any() ? _storeProgresses.Values.Average() : 0;

            // Category Performance
            _categoryPerformance.Clear();
            var allChecklistItems = await db.ChecklistItems.AsNoTracking().ToListAsync();

            foreach (var category in _categoriesList)
            {
                var tasksInCategory = allChecklistItems.Where(item => item.CategoryId == category.Id).ToList();
                if (!tasksInCategory.Any()) continue;

                var totalPossible = _assignedStores.Sum(s => tasksInCategory.Count(t => IsTaskAssignedToStore(t, s.Id)));
                if (totalPossible == 0) continue;

                var taskIdsInCategory = tasksInCategory.Select(t => t.Id).ToList();
                var activeSessionIds = todayActivities.Select(a => a.Id).ToList();

                var completedCount = activeSessionIds.Any()
                    ? await db.TaskProgresses.AsNoTracking()
                        .Where(tp => activeSessionIds.Contains(tp.StoreDailyActivityId)
                            && taskIdsInCategory.Contains(tp.ChecklistItemId)
                            && tp.IsCompleted)
                        .CountAsync()
                    : 0;

                _categoryPerformance.Add(new CategoryPerformanceModel
                {
                    CategoryName = category.Name,
                    CompletionRate = (completedCount * 100.0) / totalPossible
                });
            }

            // In LoadData(), replace the activity logs query with:
            _logTotalCount = await db.ActivityLogs
                .CountAsync(l => storeIds.Contains(l.StoreId ?? 0));

            _activityLogsList = await db.ActivityLogs
                .AsNoTracking()
                .Include(l => l.User)
                .Include(l => l.Store)
                .Where(l => storeIds.Contains(l.StoreId ?? 0))
                .OrderByDescending(l => l.Timestamp)
                .Take(_logPageSize)
                .ToListAsync();

            // Linked entity lookups — guarded against empty lists
            var photoIds = _activityLogsList
                .Where(a => a.EntityType == "TaskPhoto" && a.EntityId.HasValue)
                .Select(a => a.EntityId!.Value)
                .ToList();

            var progressIds = _activityLogsList
                .Where(a => a.EntityType == "TaskProgress" && a.EntityId.HasValue)
                .Select(a => a.EntityId!.Value)
                .ToList();

            _linkedPhotos = photoIds.Any()
                ? await db.TaskPhotos.AsNoTracking()
                    .Where(p => photoIds.Contains(p.Id))
                    .ToDictionaryAsync(p => p.Id)
                : new();

            _linkedProgresses = progressIds.Any()
                ? await db.TaskProgresses
                    .Include(p => p.ChecklistItem)
                    .AsNoTracking()
                    .Where(p => progressIds.Contains(p.Id))
                    .ToDictionaryAsync(p => p.Id)
                : new();

            ApplyReportFilters();

            // Photos
            _totalPhotosCount = await db.TaskPhotos
                .CountAsync(p => p.StoreDailyActivity != null && storeIds.Contains(p.StoreDailyActivity.StoreId));

            await FilterPhotos();

            // Issues
            _issues = await db.Issues
                .AsNoTracking()
                .Include(i => i.Store)
                .Include(i => i.ReportedBy)
                .Include(i => i.ReviewedBy)
                .Where(i => storeIds.Contains(i.StoreId))
                .OrderByDescending(i => i.ReportedAt)
                .ToListAsync();

            ApplyIssueFilters();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyReportFilters()
    {
        var filtered = _activityLogs.AsQueryable();

        if (_dateRange?.Start != null)
            filtered = filtered.Where(a => a.Date >= _dateRange.Start.Value);

        if (_dateRange?.End != null)
            filtered = filtered.Where(a => a.Date <= _dateRange.End.Value);

        if (_selectedStoreId.HasValue)
            filtered = filtered.Where(a => a.StoreId == _selectedStoreId.Value);

        _activityLogsFiltered = filtered.ToList();
    }

