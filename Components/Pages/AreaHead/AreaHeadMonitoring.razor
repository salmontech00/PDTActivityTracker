    private string GetImageSource(TaskPhoto photo)
    {
        if (photo.ImageData == null) return "images/placeholder.png";
        return $"data:{photo.ImageMimeType};base64,{Convert.ToBase64String(photo.ImageData)}";
    }

    private string GetRelativeTime(DateTime timestamp)
    {
        var diff = DateTime.Now - timestamp;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return timestamp.ToString("MMM dd, yyyy");
    }

    private Color GetPriorityColor(string priority) => priority switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        "Low" => Color.Default,
        _ => Color.Default
    };

    private Color GetStatusColor(string status) => status switch
    {
        "Resolved" => Color.Success,
        "Open" => Color.Error,
        _ => Color.Warning
    };

    private async Task OpenIssueDetail(Issue issue)
    {
        var parameters = new DialogParameters
        {
            ["Issue"] = issue,
            ["IsAreaHead"] = true,
            ["CurrentUserId"] = UserState.UserId
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<IssueDetailDialog>("Issue Review", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task DeleteIssue(Issue issue)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = "Are you sure you want to delete this issue report?",
            ["ButtonText"] = "Delete",
            ["Color"] = Color.Error
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Issue", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            db.Issues.Remove(issue);
            await db.SaveChangesAsync();

            Snackbar.Add("Issue report deleted.", Severity.Success);
            await LoadData();
            StateHasChanged();
        }
    }

    private bool IsTaskAssignedToStore(ChecklistItem task, int storeId)
    {
        if (task.TaskType != "Manpower") return true;
        if (string.IsNullOrWhiteSpace(task.SelectedStores)) return false;

        try
        {
            var ids = JsonSerializer.Deserialize<List<int>>(task.SelectedStores);
            return ids != null && ids.Contains(storeId);
        }
        catch { return false; }
    }
}




