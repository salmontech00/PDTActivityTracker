    private async Task FilterPhotos(bool resetPage = true)
    {
        if (resetPage) _photoCurrentPage = 1;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var storeIds = _assignedStores.Select(s => s.Id).ToList();

            var query = db.TaskPhotos.AsNoTracking()
                .Include(p => p.UploadedBy)
                .Include(p => p.Category)
                .Include(p => p.Store)
                .Include(p => p.StoreDailyActivity).ThenInclude(s => s!.Store)
                .Include(p => p.StoreDailyActivity).ThenInclude(s => s!.StartedBy)
                .Include(p => p.ChecklistItem).ThenInclude(c => c!.Category)
                .Where(p => p.StoreDailyActivity != null && storeIds.Contains(p.StoreDailyActivity.StoreId))
                .AsQueryable();

            if (!string.IsNullOrWhiteSpace(_photoSearchTerm))
            {
                var term = _photoSearchTerm.ToLower();
                query = query.Where(p =>
                    (p.Description != null && p.Description.ToLower().Contains(term)) ||
                    (p.ChecklistItem != null && p.ChecklistItem.TaskName != null && p.ChecklistItem.TaskName.ToLower().Contains(term)) ||
                    (p.ChecklistItem != null && p.ChecklistItem.Description != null && p.ChecklistItem.Description.ToLower().Contains(term)) ||
                    (p.UploadedBy != null && p.UploadedBy.Fullname != null && p.UploadedBy.Fullname.ToLower().Contains(term)) ||
                    (p.Store != null && p.Store.StoreName.ToLower().Contains(term)));
            }

            if (_photoStoreFilter.HasValue)
                query = query.Where(p => p.StoreDailyActivity != null && p.StoreDailyActivity.StoreId == _photoStoreFilter.Value);

            if (_photoCategoryFilter.HasValue)
                query = query.Where(p => p.ChecklistItem != null && p.ChecklistItem.CategoryId == _photoCategoryFilter.Value);

            if (_photoDateRange?.Start != null)
                query = query.Where(p => p.UploadedAt >= _photoDateRange.Start.Value);

            if (_photoDateRange?.End != null)
                query = query.Where(p => p.UploadedAt <= _photoDateRange.End.Value.AddDays(1));

            _photoTotalMatchingCount = await query.CountAsync();

            _filteredPhotos = await query
                .OrderByDescending(p => p.UploadedAt)
                .Skip((_photoCurrentPage - 1) * _photoPageSize)
                .Take(_photoPageSize)
                .ToListAsync();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load photos: {ex.Message}", Severity.Error);
        }
    }

