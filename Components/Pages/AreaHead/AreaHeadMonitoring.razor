    // Add this method
    private async Task LoadMoreLogs()
    {
        if (_loadingMoreLogs) return;
        _loadingMoreLogs = true;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var storeIds = _assignedStores.Select(s => s.Id).ToList();

            _logCurrentPage++;

            var moreLogs = await db.ActivityLogs
                .AsNoTracking()
                .Include(l => l.User)
                .Include(l => l.Store)
                .Where(l => storeIds.Contains(l.StoreId ?? 0))
                .OrderByDescending(l => l.Timestamp)
                .Skip((_logCurrentPage - 1) * _logPageSize)
                .Take(_logPageSize)
                .ToListAsync();

            _activityLogsList.AddRange(moreLogs);

            // Fetch linked entities for new logs
            var photoIds = moreLogs
                .Where(a => a.EntityType == "TaskPhoto" && a.EntityId.HasValue)
                .Select(a => a.EntityId!.Value).ToList();

            var progressIds = moreLogs
                .Where(a => a.EntityType == "TaskProgress" && a.EntityId.HasValue)
                .Select(a => a.EntityId!.Value).ToList();

            if (photoIds.Any())
            {
                var newPhotos = await db.TaskPhotos.AsNoTracking()
                    .Where(p => photoIds.Contains(p.Id))
                    .ToDictionaryAsync(p => p.Id);
                foreach (var kv in newPhotos) _linkedPhotos[kv.Key] = kv.Value;
            }

            if (progressIds.Any())
            {
                var newProgresses = await db.TaskProgresses
                    .Include(p => p.ChecklistItem)
                    .AsNoTracking()
                    .Where(p => progressIds.Contains(p.Id))
                    .ToDictionaryAsync(p => p.Id);
                foreach (var kv in newProgresses) _linkedProgresses[kv.Key] = kv.Value;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load more logs: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingMoreLogs = false;
            StateHasChanged();
        }
    }

