@page "/area-head/monitoring"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Components.Pages.Dialogs
@inject IDialogService DialogService
@implements IDisposable
@inject UserStateService UserState
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject IJSRuntime JSRuntime
@inject DashboardRefreshService DashboardRefresh

<PageTitle>Monitoring - Area Head</PageTitle>

<style>
    .reports-container {
        padding: 1rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 20px !important;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        padding: 0;
    }

    .button-group {
        display: flex;
        gap: 12px;
        padding: 0;
        margin: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* STAT CARDS */
    .stat-card {
        padding: 20px;
        text-align: center;
        position: relative;
        overflow: hidden;
        border-radius: 20px !important;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #0072cf, #00c6ff);
        }

    .stat-value {
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .stat-label {
        font-size: 0.8rem;
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 8px;
    }

    /* MOBILE STAT CARDS GRID */
    .mobile-stats-grid {
        display: none;
    }

    /* PHOTO GALLERY */
    .photo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 16px;
        padding: 16px;
    }

    .photo-item {
        position: relative;
        aspect-ratio: 1;
        border-radius: 12px;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .photo-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        }

        .photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .photo-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 8px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
        color: white;
        font-size: 0.7rem;
    }

    /* MODERN TABLE */
    .mud-table {
        background: transparent !important;
    }

    .mud-table-head {
        background: rgba(0, 114, 207, 0.1);
    }

        .mud-table-head.lightest {
            background: rgba(0, 114, 207, 0.05);
        }

    .mud-table-cell {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        padding: 12px 16px !important;
    }

    .lightest .mud-table-cell {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .mud-table-row:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .lightest .mud-table-row:hover {
        background-color: rgba(0, 114, 207, 0.05) !important;
    }

    .mud-table-pagination {
        background-color: transparent !important;
        border-top: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: inherit !important;
    }

    .lightest .mud-table-pagination {
        border-top: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    /* BUTTONS */
    .modern-button {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
    }

    /* CHIPS */
    .role-chip {
        font-weight: 700 !important;
        border-radius: 12px !important;
    }

    /* Action Icon Buttons white in darker themes */
    .light .mud-icon-button.mud-info-text,
    .dark .mud-icon-button.mud-info-text,
    .light .mud-icon-button.mud-primary-text,
    .dark .mud-icon-button.mud-primary-text {
        color: #ffffff !important;
    }

    /* MOBILE CARDS */
    .mobile-card {
        margin-bottom: 16px;
        overflow: hidden;
    }

    .mobile-card-header {
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .lightest .mobile-card-header {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1);
    }

    .mobile-card-content {
        padding: 16px;
    }

    .mobile-card-actions {
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .lightest .mobile-card-actions {
        background: rgba(0, 114, 207, 0.03);
    }

    /* Filter Toggle Button */
    .filter-toggle-button {
        display: none;
    }

    /* RESPONSIVE */
    @@media (max-width: 960px) {
        .mud-picker-datepicker-toolbar {
            display: none !important;
        }

        .mud-picker-paper {
            left: 50% !important;
            transform: translateX(-50%) !important;
            right: auto !important;
            max-height: calc(100vh - 100px) !important;
            overflow-y: auto !important;
        }

        .mud-popover {
            left: 50% !important;
            transform: translateX(-50%) !important;
        }

        .desktop-view {
            display: none;
        }

        .page-title {
            display: none;
        }

        .page-header-row {
            justify-content: center;
            margin-top: 0px;
            margin-bottom: 6px;
        }
        /* Mobile tab fixes */
        .monitoring-tabs .mud-tabs-toolbar {
            overflow: visible !important;
        }

        .monitoring-tabs .mud-tabs-toolbar-content {
            overflow-x: auto !important;
            overflow-y: hidden !important;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

            .monitoring-tabs .mud-tabs-toolbar-content::-webkit-scrollbar {
                display: none;
            }

        .monitoring-tabs .mud-tab {
            flex: 0 0 auto !important;
            min-width: unset !important;
            max-width: none !important;
            font-size: 0.60rem !important;
            padding: 4px 8px !important;
            white-space: nowrap !important;
        }

        .monitoring-tabs .mud-tabs-scroll-button {
            display: none !important;
        }

        .photo-grid {
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 8px;
        }

        .filter-toggle-button {
            display: inline-flex !important;
            width: 100%;
        }

        .button-group {
            flex-direction: row !important;
            width: 100%;
            justify-content: space-between;
        }

            .button-group .modern-button {
                flex: 1;
                font-size: 0.70rem !important;
            }

        .glass-panel.filter-panel .mud-grid {
            display: none;
        }

        .glass-panel.filter-panel.filters-visible .mud-grid {
            display: flex !important;
        }

        .desktop-stats {
            display: none !important;
        }

        .mobile-stats-grid {
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 16px;
        }

            .mobile-stats-grid .stat-card {
                padding: 10px 8px;
                border-radius: 12px !important;
            }

                .mobile-stats-grid .stat-card::before {
                    height: 3px;
                }

            .mobile-stats-grid .stat-value {
                font-size: 1.4rem;
                line-height: 1.1;
            }

            .mobile-stats-grid .stat-label {
                font-size: 0.6rem;
                letter-spacing: 0.5px;
                margin-top: 4px;
            }
    }

    @@media (min-width: 961px) {
        .desktop-view {
            display: block;
        }

        .mobile-view {
            display: none;
        }
    }

    @@media (max-width: 375px) {
        .mud-main-content {
            padding-bottom: 0px !important;
            padding-left: 0px !important;
            padding-right: 0px !important;
        }

        .mud-picker-paper {
            max-height: calc(100vh - 80px) !important;
            overflow-y: auto !important;
        }

        .monitoring-tabs .mud-tab {
            flex: 0 0 auto !important;
            min-width: unset !important;
            max-width: none !important;
            font-size: 0.55rem !important;
            padding: 4px 8px !important;
            white-space: nowrap !important;
        }

        .pdt-button {
            font-size: 0.60rem !important;
            padding: 4px 8px !important;
        }

            .pdt-button .mud-button-label {
                font-size: 0.60rem !important;
            }
    }

    /* LOGS */
    .activity-item {
        padding: 12px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .lightest .activity-item {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1);
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .activity-content {
        flex: 1;
    }

    .activity-time {
        font-size: 0.75rem;
        opacity: 0.6;
    }
</style>

<div class="reports-container">
    <div class="page-header-row mb-4">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Area Monitoring</MudText>
        <div class="button-group">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="OpenExportDialog"
                       Class="modern-button"
                       Style="@GetHeaderButtonStyle()">
                EXPORT DATA
            </MudButton>
        </div>
    </div>

    @if (!_initialized)
    {
        <div class="d-flex justify-center pa-12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        <!-- Dashboard Stats (Desktop) -->
        <MudGrid Class="mb-6 desktop-stats">
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-primary">@_assignedStores.Count</div>
                    <div class="stat-label">Assigned Stores</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-success">@_completedToday</div>
                    <div class="stat-label">Done Today</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-info">@_activeHeads</div>
                    <div class="stat-label">Active Team</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-secondary">@((int)_avgProgress)%</div>
                    <div class="stat-label">Avg. Progress</div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Dashboard Stats (Mobile) -->
        <div class="mobile-stats-grid">
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-primary">@_assignedStores.Count</div>
                <div class="stat-label">Assigned</div>
            </MudPaper>
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-success">@_completedToday</div>
                <div class="stat-label">Done</div>
            </MudPaper>
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-info">@_activeHeads</div>
                <div class="stat-label">Active</div>
            </MudPaper>
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-secondary">@((int)_avgProgress)%</div>
                <div class="stat-label">Avg. %</div>
            </MudPaper>
        </div>

        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="@($"glass-panel monitoring-tabs {GetThemeClass()}")" PanelClass="pa-4">

            <!-- My Stores -->
            <MudTabPanel Text="My Stores" Icon="@Icons.Material.Filled.Store">
                <MudGrid>
                    @foreach (var store in _assignedStores)
                    {
                        <MudItem xs="12" md="6" lg="4">
                            <MudPaper Class="@($"pa-4 glass-panel d-flex flex-column h-100 {GetThemeClass()}")" Elevation="0" Style="height: 100%;">
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-space-between align-start mb-4">
                                        <div>
                                            <MudText Typo="Typo.h6" Style="font-weight: 800; line-height: 1.2;">@store.StoreName</MudText>
                                            <MudText Typo="Typo.caption" Style="opacity: 0.7;">@store.StoreCode • @store.Location</MudText>
                                        </div>
                                        <MudChip T="string" Color="GetStoreStatusColor(store.Id)" Size="Size.Small" Variant="Variant.Filled">
                                            @GetStoreStatusText(store.Id)
                                        </MudChip>
                                    </div>

                                    <div class="mb-4">
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.caption" Style="font-weight: 700;">DAILY PROGRESS</MudText>
                                            <MudText Typo="Typo.caption" Style="font-weight: 700;">@((int)GetStoreProgress(store.Id))%</MudText>
                                        </div>
                                        <MudProgressLinear Color="Color.Primary" Value="GetStoreProgress(store.Id)" Rounded="true" Class="mud-width-full" />
                                    </div>
                                </div>

                                <div class="d-flex gap-2 mt-auto">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               FullWidth="true"
                                               OnClick="@(() => NavigationManager.NavigateTo($"/area-head/weekly-report/{store.Id}"))"
                                               Class="modern-button pdt-button">
                                        VIEW REPORT
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               FullWidth="true"
                                               OnClick="@(() => OpenGenerateReportDialog(store))"
                                               Class="modern-button pdt-button">
                                        GENERATE
                                    </MudButton>
                                </div>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>

            <!-- Activity Reports -->
            <MudTabPanel Text="Activity Reports" Icon="@Icons.Material.Filled.Assessment">
                <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showFilters ? "filters-visible" : "")}")" Elevation="0">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                               FullWidth="true"
                               OnClick="@(() => _showFilters = !_showFilters)"
                               Class="filter-toggle-button"
                               Style="margin-bottom: 16px;">
                        @(_showFilters ? "Hide Filters" : "Show Filters")
                    </MudButton>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudDateRangePicker Label="Date Range"
                                                @bind-DateRange="_dateRange"
                                                @bind-DateRange:after="ApplyReportFilters"
                                                Variant="Variant.Outlined"
                                                Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="int?"
                                       Label="Store"
                                       Value="_selectedStoreId"
                                       ValueChanged="OnStoreFilterChanged"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Placeholder="All Stores"
                                       Clearable="true">
                                <MudSelectItem Value="@((int?)null)">All Stores</MudSelectItem>
                                @foreach (var store in _assignedStores)
                                {
                                    <MudSelectItem Value="@((int?)store.Id)">@store.StoreCode - @store.StoreName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                    <MudGrid>
                        <MudItem xs="12">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <MudText Typo="Typo.body2" Style="opacity: 0.8;">
                                    Showing @(_activityLogsFiltered.Count) of @(_activityLogs.Count) reports
                                </MudText>
                                @if (HasActiveReportFilters())
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Clear"
                                               OnClick="ClearReportFilters"
                                               Class="clear-filters-button">
                                        Clear Filters
                                    </MudButton>
                                }
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @if (_activityLogsFiltered.Any())
                {
                    <div class="desktop-view">
                        <MudTable Items="_activityLogsFiltered" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Store</MudTh>
                                <MudTh>Started By</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Review Status</MudTh>
                                <MudTh>Progress</MudTh>
                                <MudTh Style="text-align: center;">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Date.ToString("MMM dd, yyyy")</MudTd>
                                <MudTd DataLabel="Store">@(context.Store?.StoreName ?? "---")</MudTd>
                                <MudTd DataLabel="Started By">@(context.StartedBy?.Fullname ?? "---")</MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="@GetActivityStatusColor(context)" Variant="Variant.Text" Class="role-chip">
                                        @GetActivityStatusLabel(context)
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Review Status">
                                    @if (context.AreaHeadReviewedAt.HasValue)
                                    {
                                        <div class="d-flex flex-column">
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Verified">Reviewed</MudChip>
                                            @if (context.AreaHead != null)
                                            {
                                                <MudText Typo="Typo.caption" Style="opacity: 0.7; margin-left: 8px;">by @context.AreaHead.Fullname</MudText>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Text">Pending</MudChip>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Progress">
                                    <div class="d-flex align-center gap-2">
                                        <MudProgressLinear Color="Color.Primary" Value="@GetCompletionProgress(context.Id)" Style="width: 60px;" Rounded="true" />
                                        <MudText Typo="Typo.caption" Style="font-weight: 700;">@((int)GetCompletionProgress(context.Id))%</MudText>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="Action" Style="text-align: center;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenActivityDetail(context))" />
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager />
                            </PagerContent>
                        </MudTable>
                    </div>

                    <div class="mobile-view">
                        @foreach (var activity in _activityLogsFiltered)
                        {
                            <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                                <div class="mobile-card-header">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@activity.Date.ToString("MMM dd, yyyy")</MudText>
                                    <div class="d-flex flex-column align-end">
                                        <MudChip T="string" Size="Size.Small" Color="@GetActivityStatusColor(activity)" Variant="Variant.Text" Class="role-chip">
                                            @GetActivityStatusLabel(activity)
                                        </MudChip>
                                        @if (activity.AreaHeadReviewedAt.HasValue)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 700;">
                                                <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" /> Reviewed
                                            </MudText>
                                        }
                                    </div>
                                </div>
                                <div class="mobile-card-content">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Store</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@(activity.Store?.StoreName ?? "---")</MudText>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Started By</MudText>
                                            <MudText Typo="Typo.body2">@(activity.StartedBy?.Fullname ?? "---")</MudText>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <div class="d-flex align-center justify-space-between mb-1">
                                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Progress</MudText>
                                                <MudText Typo="Typo.caption" Style="font-weight: 700;">@((int)GetCompletionProgress(activity.Id))%</MudText>
                                            </div>
                                            <MudProgressLinear Color="Color.Primary" Value="@GetCompletionProgress(activity.Id)" Rounded="true" Size="Size.Small" />
                                        </MudItem>
                                    </MudGrid>
                                </div>
                                <div class="mobile-card-actions">
                                    <MudButton StartIcon="@Icons.Material.Filled.Visibility" Variant="Variant.Text" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenActivityDetail(activity))" Class="modern-button">
                                        Details
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                    </div>
                }
                else
                {
                    <div class="pa-12 text-center" style="opacity: 0.5;">
                        <MudIcon Icon="@Icons.Material.Filled.ReportOff" Size="Size.Large" Class="mb-2" />
                        <MudText>No activity reports found matching your criteria.</MudText>
                    </div>
                }
            </MudTabPanel>

            <!-- Area Analytics -->
            <MudTabPanel Text="Area Analytics" Icon="@Icons.Material.Filled.BarChart">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudPaper Class="@($"pa-6 glass-panel h-100 {GetThemeClass()}")" Elevation="0" Style="height: 100%;">
                            <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Category Performance</MudText>
                            <div class="d-flex flex-column gap-4">
                                @foreach (var cat in _categoryPerformance.OrderByDescending(c => c.CompletionRate))
                                {
                                    <div>
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@cat.CategoryName</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 800;">@((int)cat.CompletionRate)%</MudText>
                                        </div>
                                        <MudProgressLinear Color="@GetProgressColor(cat.CompletionRate)" Value="@cat.CompletionRate" Rounded="true" Size="Size.Medium" />
                                    </div>
                                }
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Class="@($"pa-6 glass-panel h-100 {GetThemeClass()}")" Elevation="0" Style="height: 100%;">
                            <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Store Comparison</MudText>
                            <div class="d-flex flex-column gap-4">
                                @foreach (var store in _assignedStores.OrderByDescending(s => GetStoreProgress(s.Id)))
                                {
                                    <div>
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@store.StoreName</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 800;">@((int)GetStoreProgress(store.Id))%</MudText>
                                        </div>
                                        <MudProgressLinear Color="@GetProgressColor(GetStoreProgress(store.Id))" Value="@GetStoreProgress(store.Id)" Rounded="true" Size="Size.Medium" />
                                    </div>
                                }
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- Live Activity Log -->
            <MudTabPanel Text="Live Activity Log" Icon="@Icons.Material.Filled.History">
                <MudPaper Class="@($"glass-panel {GetThemeClass()}")" Elevation="0" Style="max-height: 500px; overflow-y: auto;">
                    @if (!_activityLogsList.Any())
                    {
                        <div class="pa-8 text-center" style="opacity: 0.5;">
                            <MudIcon Icon="@Icons.Material.Filled.HistoryToggleOff" Size="Size.Large" Class="mb-2" />
                            <MudText>No activity logs found for your stores.</MudText>
                        </div>
                    }

                    @foreach (var log in _activityLogsList)
                    {
                        <div class="activity-item">
                            <div class="activity-icon" style="@GetActivityIconStyle(log.Action)">
                                <MudIcon Icon="@GetLogIcon(log.Action)" Size="Size.Small" />
                            </div>
                            <div class="activity-content">
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                    @(log.User?.Fullname)
                                    <span style="font-weight: 400;">@log.Action: @log.Details</span>
                                </MudText>
                                <MudText Class="activity-time">
                                    @GetRelativeTime(log.Timestamp) • @(log.Store?.StoreName)
                                </MudText>
                            </div>
                        </div>
                    }
                </MudPaper>
            </MudTabPanel>

            <!-- Photo Gallery -->
            <MudTabPanel Text="Photo Gallery" Icon="@Icons.Material.Filled.PhotoLibrary">
                <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showPhotoFilters ? "filters-visible" : "")}")" Elevation="0">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@(_showPhotoFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                               FullWidth="true"
                               OnClick="@(() => _showPhotoFilters = !_showPhotoFilters)"
                               Class="filter-toggle-button"
                               Style="margin-bottom: 16px;">
                        @(_showPhotoFilters ? "Hide Filters" : "Show Filters")
                    </MudButton>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField T="string"
                                          @bind-Value="_photoSearchTerm"
                                          @bind-Value:after="FilterPhotos"
                                          Label="Search"
                                          Placeholder="Task or user..."
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect T="int?"
                                       Label="Store"
                                       Value="_photoStoreFilter"
                                       ValueChanged="OnPhotoStoreFilterChanged"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true">
                                <MudSelectItem Value="@((int?)null)">All Stores</MudSelectItem>
                                @foreach (var store in _assignedStores)
                                {
                                    <MudSelectItem Value="@((int?)store.Id)">@store.StoreCode - @store.StoreName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect T="int?" @bind-Value="_photoCategoryFilter" @bind-Value:after="FilterPhotos" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                <MudSelectItem Value="@((int?)null)">All Categories</MudSelectItem>
                                @foreach (var cat in _categoriesList)
                                {
                                    <MudSelectItem Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="12" md="3">
                            <MudDateRangePicker Label="Date Range"
                                                @bind-DateRange="_photoDateRange"
                                                @bind-DateRange:after="FilterPhotos"
                                                Variant="Variant.Outlined"
                                                Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                    <MudGrid>
                        <MudItem xs="12">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                    Showing @(_filteredPhotos.Count) of @(_allPhotos.Count) photos
                                </MudText>
                                @if (HasPhotoFilters())
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Clear"
                                               OnClick="ClearPhotoFilters"
                                               Class="clear-filters-button">
                                        Clear Filters
                                    </MudButton>
                                }
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @if (_filteredPhotos.Any())
                {
                    <div class="photo-grid">
                        @foreach (var photo in _filteredPhotos)
                        {
                            <div class="photo-item" @onclick="@(() => OpenPhotoDialog(photo))">
                                <img src="@GetImageSource(photo)" alt="Store Photo" />
                                <div class="photo-overlay">
                                    <div class="font-weight-bold">@(photo.StoreDailyActivity?.Store?.StoreName)</div>
                                    <div style="opacity: 0.8;">@photo.UploadedAt.ToString("MMM dd, HH:mm")</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="pa-12 text-center" style="opacity: 0.5;">
                        <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" Class="mb-2" />
                        <MudText>No photos found.</MudText>
                    </div>
                }
            </MudTabPanel>

            <!-- Operational Issues -->
            <MudTabPanel Text="Operational Issues" Icon="@Icons.Material.Filled.ReportProblem">
                <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showIssueFilters ? "filters-visible" : "")}")" Elevation="0">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@(_showIssueFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                               FullWidth="true"
                               OnClick="@(() => _showIssueFilters = !_showIssueFilters)"
                               Class="filter-toggle-button"
                               Style="margin-bottom: 16px;">
                        @(_showIssueFilters ? "Hide Filters" : "Show Filters")
                    </MudButton>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string"
                                          @bind-Value="_issueSearchTerm"
                                          @bind-Value:after="ApplyIssueFilters"
                                          Label="Search Issues"
                                          Placeholder="Category or description..."
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSelect T="int?"
                                       Label="Store"
                                       Value="_issueStoreFilter"
                                       ValueChanged="OnIssueStoreFilterChanged"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true">
                                <MudSelectItem Value="@((int?)null)">All Stores</MudSelectItem>
                                @foreach (var store in _assignedStores)
                                {
                                    <MudSelectItem Value="@((int?)store.Id)">@store.StoreCode - @store.StoreName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudSelect T="string" @bind-Value="_issueStatusFilter" @bind-Value:after="ApplyIssueFilters" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                <MudSelectItem Value="@(string.Empty)">All Status</MudSelectItem>
                                <MudSelectItem Value="@("Open")">Open</MudSelectItem>
                                <MudSelectItem Value="@("Resolved")">Resolved</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudGrid>
                        <MudItem xs="12">
                            <div class="d-flex justify-space-between align-center px-1">
                                <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                    Showing @(_issuesFiltered.Count) of @(_issues.Count) issues
                                </MudText>
                                @if (HasIssueFilters())
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Clear"
                                               OnClick="ClearIssueFilters"
                                               Class="clear-filters-button">
                                        Clear Filters
                                    </MudButton>
                                }
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @if (_issuesFiltered.Any())
                {
                    <div class="desktop-view">
                        <MudTable Items="_issuesFiltered" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0" Class="glass-panel">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Store</MudTh>
                                <MudTh>Category</MudTh>
                                <MudTh>Priority</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh Style="text-align: center;">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.ReportedAt.ToString("MMM dd, yyyy")</MudTd>
                                <MudTd DataLabel="Store">@(context.Store?.StoreName ?? "---")</MudTd>
                                <MudTd DataLabel="Category">@context.Title</MudTd>
                                <MudTd DataLabel="Priority">
                                    <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(context.Priority)" Variant="Variant.Text">@context.Priority</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">@context.Status</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Action" Style="text-align: center;">
                                    <div class="d-flex justify-center gap-1">
                                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenIssueDetail(context))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteIssue(context))" />
                                    </div>
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager />
                            </PagerContent>
                        </MudTable>
                    </div>

                    <div class="mobile-view">
                        @foreach (var issue in _issuesFiltered)
                        {
                            <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                                <div class="mobile-card-header">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@issue.ReportedAt.ToString("MMM dd")</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(issue.Status)" Variant="Variant.Filled">
                                        @issue.Status
                                    </MudChip>
                                </div>
                                <div class="mobile-card-content">
                                    <div class="d-flex justify-space-between align-start">
                                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@issue.Title</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(issue.Priority)" Variant="Variant.Text">@issue.Priority</MudChip>
                                    </div>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">Store: @(issue.Store?.StoreName)</MudText>
                                    <MudText Typo="Typo.body2" Class="mt-2 truncate-2-lines">@issue.Description</MudText>
                                </div>
                                <div class="mobile-card-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteIssue(issue))" />
                                    <MudButton StartIcon="@Icons.Material.Filled.Visibility" Variant="Variant.Text" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenIssueDetail(issue))">
                                        Review
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                    </div>
                }
                else
                {
                    <div class="pa-12 text-center" style="opacity: 0.5;">
                        <MudIcon Icon="@Icons.Material.Filled.ReportOff" Size="Size.Large" Class="mb-2" />
                        <MudText>No operational issues found matching your criteria.</MudText>
                    </div>
                }
            </MudTabPanel>
        </MudTabs>
    }
</div>

@code {
    private bool _initialized = false;
    private List<Store> _assignedStores = new();
    private List<ActivityLog> _activityLogsList = new();
    private List<TaskPhoto> _allPhotos = new();
    private List<TaskPhoto> _filteredPhotos = new();
    private List<Category> _categoriesList = new();
    private List<StoreDailyActivity> _activityLogs = new();
    private List<StoreDailyActivity> _activityLogsFiltered = new();
    private List<Issue> _issues = new();
    private List<Issue> _issuesFiltered = new();
    private Dictionary<int, StoreDailyActivity?> _todayActivities = new();
    private Dictionary<int, double> _storeProgresses = new();

    private int _completedToday = 0;
    private int _activeHeads = 0;
    private double _avgProgress = 0;
    private List<CategoryPerformanceModel> _categoryPerformance = new();

    // Filtering
    private bool _showFilters = false;
    private DateRange? _dateRange;
    private int? _selectedStoreId;

    private bool _showPhotoFilters = false;
    private string _photoSearchTerm = string.Empty;
    private int? _photoStoreFilter;
    private int? _photoCategoryFilter;
    private DateRange? _photoDateRange;

    private bool _showIssueFilters = false;
    private string _issueSearchTerm = string.Empty;
    private int? _issueStoreFilter;
    private string _issueStatusFilter = string.Empty;

    private Dictionary<int, double> _activityProgressCache = new();

    public class CategoryPerformanceModel
    {
        public string CategoryName { get; set; } = "";
        public double CompletionRate { get; set; }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _dateRange = new DateRange(DateTime.Today.AddDays(-30), DateTime.Today);
        _photoDateRange = new DateRange(DateTime.Today.AddDays(-30), DateTime.Today);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await UserState.InitializeAsync();

            if (UserState.Role != "Area Head" && UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo(UserState.LastValidPage ?? UserState.GetDashboardRoute(), forceLoad: true);
                return;
            }
            await UserState.SetLastValidPage(NavigationManager.Uri);

            ThemeService.OnThemeChanged += OnThemeChanged;
            UserState.DashboardRefreshRequested += HandleDashboardRefresh;
            DashboardRefresh.OnRefreshRequested += OnGlobalRefreshRequested;
            await LoadData();
            _initialized = true;
            StateHasChanged();
        }
    }

    private void OnGlobalRefreshRequested(int? storeId)
    {
        if (storeId == null || _assignedStores.Any(s => s.Id == storeId))
        {
            HandleDashboardRefresh();
        }
    }

    private void HandleDashboardRefresh()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        UserState.DashboardRefreshRequested -= HandleDashboardRefresh;
        DashboardRefresh.OnRefreshRequested -= OnGlobalRefreshRequested;
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var today = DateTime.Today;

        // Assigned Stores
        _assignedStores = await db.Stores
            .AsNoTracking()
            .Where(s => s.AreaHeadId == UserState.UserId)
            .Include(s => s.StoreHead)
            .ToListAsync();

        var storeIds = _assignedStores.Select(s => s.Id).ToList();

        // Categories for photo filter
        _categoriesList = await db.Categories.AsNoTracking().ToListAsync();

        // Today's Activities (for dashboard stats)
        var todayActivities = await db.StoreDailyActivities
            .AsNoTracking()
            .Where(a => storeIds.Contains(a.StoreId) && a.Date >= today && a.Date < today.AddDays(1))
            .ToListAsync();

        _todayActivities = todayActivities
            .GroupBy(a => a.StoreId)
            .ToDictionary(g => g.Key, g => (StoreDailyActivity?)g.OrderBy(a => a.Id).FirstOrDefault());

        // Progress Calculations
        _activeHeads = todayActivities.Select(a => a.StartedById).Distinct().Count();

        var checklistItems = await db.ChecklistItems.AsNoTracking().ToListAsync();

        foreach (var storeId in storeIds)
        {
            var activity = _todayActivities.GetValueOrDefault(storeId);
            var storeChecklistCount = checklistItems.Count(t => IsTaskAssignedToStore(t, storeId));

            if (activity != null)
            {
                var completedTasks = await db.TaskProgresses.CountAsync(tp => tp.StoreDailyActivityId == activity.Id && tp.IsCompleted);
                var progress = storeChecklistCount > 0 ? (completedTasks * 100.0 / storeChecklistCount) : 0;
                _storeProgresses[storeId] = progress;
            }
            else
            {
                _storeProgresses[storeId] = 0;
            }
        }

        _completedToday = _storeProgresses.Values.Count(p => p >= 100);
        _avgProgress = _storeProgresses.Any() ? _storeProgresses.Values.Average() : 0;

        // Category Performance Aggregation
        _categoryPerformance.Clear();
        foreach (var category in _categoriesList)
        {
            var tasksInCategory = checklistItems.Where(item => item.CategoryId == category.Id).ToList();
            if (!tasksInCategory.Any()) continue;

            // totalPossible is the sum of tasks in this category that are assigned to each store
            var totalPossible = _assignedStores.Sum(s => tasksInCategory.Count(t => IsTaskAssignedToStore(t, s.Id)));
            if (totalPossible == 0) continue;

            var taskIdsInCategory = tasksInCategory.Select(t => t.Id).ToList();
            var activeSessionIds = todayActivities.Select(a => a.Id).ToList();
            var completedCount = await db.TaskProgresses.AsNoTracking()
                .Where(tp => activeSessionIds.Contains(tp.StoreDailyActivityId) && taskIdsInCategory.Contains(tp.ChecklistItemId) && tp.IsCompleted)
                .CountAsync();

            _categoryPerformance.Add(new CategoryPerformanceModel
            {
                CategoryName = category.Name,
                CompletionRate = (completedCount * 100.0) / totalPossible
            });
        }

        // Logs (Live Activity)
        _activityLogsList = await db.ActivityLogs
            .AsNoTracking()
            .Include(l => l.User)
            .Include(l => l.Store)
            .Where(l => storeIds.Contains(l.StoreId ?? 0))
            .OrderByDescending(l => l.Timestamp)
            .Take(50)
            .ToListAsync();

        // All Activities (for Reports tab)
        _activityLogs = await db.StoreDailyActivities
            .AsNoTracking()
            .Include(a => a.Store)
            .Include(a => a.StartedBy)
            .Include(a => a.AreaHead)
            .Where(a => storeIds.Contains(a.StoreId))
            .OrderByDescending(a => a.Date)
            .ToListAsync();

        // Cache progress for all activities
        _activityProgressCache.Clear();
        _activityProgressCache.Clear();
        foreach (var activity in _activityLogs)
        {
            var completedCount = await db.TaskProgresses.CountAsync(tp => tp.StoreDailyActivityId == activity.Id && tp.IsCompleted);
            var activityChecklistCount = checklistItems.Count(t => IsTaskAssignedToStore(t, activity.StoreId));
            _activityProgressCache[activity.Id] = activityChecklistCount > 0 ? (completedCount * 100.0 / activityChecklistCount) : 0;
        }

        ApplyReportFilters();

        // Photos
        _allPhotos = await db.TaskPhotos
            .AsNoTracking()
            .Include(p => p.UploadedBy)
            .Include(p => p.Category)
            .Include(p => p.Store)
            .Include(p => p.StoreDailyActivity)
                .ThenInclude(s => s!.Store)
            .Include(p => p.StoreDailyActivity)
                .ThenInclude(s => s!.StartedBy)
            .Include(p => p.ChecklistItem)
                .ThenInclude(c => c!.Category)
            .Where(p => p.StoreDailyActivity != null && storeIds.Contains(p.StoreDailyActivity.StoreId))
            .OrderByDescending(p => p.UploadedAt)
            .ToListAsync();

        FilterPhotos();

        // Issues
        _issues = await db.Issues
            .AsNoTracking()
            .Include(i => i.Store)
            .Include(i => i.ReportedBy)
            .Include(i => i.ReviewedBy)
            .Where(i => storeIds.Contains(i.StoreId))
            .OrderByDescending(i => i.ReportedAt)
            .ToListAsync();

        ApplyIssueFilters();
    }

    private void ApplyReportFilters()
    {
        var filtered = _activityLogs.AsQueryable();

        if (_dateRange?.Start != null)
            filtered = filtered.Where(a => a.Date >= _dateRange.Start.Value);

        if (_dateRange?.End != null)
            filtered = filtered.Where(a => a.Date <= _dateRange.End.Value);

        if (_selectedStoreId.HasValue)
            filtered = filtered.Where(a => a.StoreId == _selectedStoreId.Value);

        _activityLogsFiltered = filtered.ToList();
    }

    private void OnStoreFilterChanged(int? storeId)
    {
        _selectedStoreId = storeId;
        ApplyReportFilters();
    }

    private void ClearReportFilters()
    {
        _selectedStoreId = null;
        _dateRange = null;
        ApplyReportFilters();
    }

    private bool HasActiveReportFilters() => _selectedStoreId.HasValue || (_dateRange?.Start != null);

    private void FilterPhotos()
    {
        var filtered = _allPhotos.AsQueryable();

        if (!string.IsNullOrWhiteSpace(_photoSearchTerm))
        {
            var term = _photoSearchTerm.ToLower();
            filtered = filtered.Where(p =>
                (p.ChecklistItem != null && p.ChecklistItem.TaskName != null && p.ChecklistItem.TaskName.ToLower().Contains(term)) ||
                (p.StoreDailyActivity != null && p.StoreDailyActivity.StartedBy != null && p.StoreDailyActivity.StartedBy.Fullname != null && p.StoreDailyActivity.StartedBy.Fullname.ToLower().Contains(term)));
        }

        if (_photoStoreFilter.HasValue)
            filtered = filtered.Where(p => p.StoreDailyActivity != null && p.StoreDailyActivity.StoreId == _photoStoreFilter.Value);

        if (_photoCategoryFilter.HasValue)
            filtered = filtered.Where(p => p.ChecklistItem != null && p.ChecklistItem.CategoryId == _photoCategoryFilter.Value);

        if (_photoDateRange?.Start != null)
            filtered = filtered.Where(p => p.UploadedAt.Date >= _photoDateRange.Start.Value.Date);

        if (_photoDateRange?.End != null)
            filtered = filtered.Where(p => p.UploadedAt.Date <= _photoDateRange.End.Value.Date);

        _filteredPhotos = filtered.ToList();
    }

    private void OnPhotoStoreFilterChanged(int? storeId)
    {
        _photoStoreFilter = storeId;
        FilterPhotos();
    }

    private void ClearPhotoFilters()
    {
        _photoSearchTerm = string.Empty;
        _photoStoreFilter = null;
        _photoCategoryFilter = null;
        _photoDateRange = null;
        FilterPhotos();
    }

    private bool HasPhotoFilters() => !string.IsNullOrEmpty(_photoSearchTerm) || _photoStoreFilter.HasValue || _photoCategoryFilter.HasValue || (_photoDateRange?.Start != null);

    private void ApplyIssueFilters()
    {
        var filtered = _issues.AsQueryable();

        if (!string.IsNullOrWhiteSpace(_issueSearchTerm))
        {
            var term = _issueSearchTerm.ToLower();
            filtered = filtered.Where(i =>
                (i.Title != null && i.Title.ToLower().Contains(term)) ||
                (i.Description != null && i.Description.ToLower().Contains(term)));
        }

        if (_issueStoreFilter.HasValue)
            filtered = filtered.Where(i => i.StoreId == _issueStoreFilter.Value);

        if (!string.IsNullOrWhiteSpace(_issueStatusFilter))
            filtered = filtered.Where(i => i.Status == _issueStatusFilter);

        _issuesFiltered = filtered.ToList();
    }

    private void ClearIssueFilters()
    {
        _issueSearchTerm = string.Empty;
        _issueStoreFilter = null;
        _issueStatusFilter = string.Empty;
        ApplyIssueFilters();
    }

    private bool HasIssueFilters() => !string.IsNullOrEmpty(_issueSearchTerm) || _issueStoreFilter.HasValue || !string.IsNullOrEmpty(_issueStatusFilter);

    private void OnIssueStoreFilterChanged(int? storeId)
    {
        _issueStoreFilter = storeId;
        ApplyIssueFilters();
    }



