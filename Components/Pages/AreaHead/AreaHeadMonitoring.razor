@page "/area-head/monitoring"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Components.Pages.Dialogs
@inject IDialogService DialogService
@implements IDisposable
@inject UserStateService UserState
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject IJSRuntime JSRuntime
@inject DashboardRefreshService DashboardRefresh

<PageTitle>Monitoring - Area Head</PageTitle>

<style>
    .reports-container {
        padding: 1rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 20px !important;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        padding: 0;
    }

    .button-group {
        display: flex;
        gap: 12px;
        padding: 0;
        margin: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* STAT CARDS */
    .stat-card {
        padding: 20px;
        text-align: center;
        position: relative;
        overflow: hidden;
        border-radius: 20px !important;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #0072cf, #00c6ff);
        }

    .stat-value {
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.7;
    }

    /* TABS */
    .mud-tabs .mud-tabs-tab {
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 1px !important;
    }

    .mud-tab-slider {
        height: 3px !important;
        border-radius: 3px 3px 0 0 !important;
    }

    /* LOGS */
    .log-item {
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        padding: 12px 16px;
        transition: background-color 0.2s ease;
    }

        .log-item:hover {
            background-color: rgba(0, 114, 207, 0.03);
        }

    .dark .log-item {
        border-bottom-color: rgba(255, 255, 255, 0.05);
    }

    /* RESPONSIVE */
    @@media (max-width: 600px) {
        .page-header-row {
            flex-direction: column;
            gap: 12px;
            align-items: stretch;
            text-align: center;
        }

        .button-group {
            flex-direction: column;
            gap: 8px;
        }
    }
</style>

<div class="reports-container">
    <div class="page-header-row">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Area Monitoring</MudText>
        <div class="button-group">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="OpenExportDialog"
                       Class="rounded-lg px-6"
                       Style="@GetButtonStyle()">
                EXPORT DATA
            </MudButton>
        </div>
    </div>

    <!-- MAIN STATS -->
    <MudGrid Class="mb-6 mt-2">
        <MudItem xs="6" sm="3">
            <MudPaper Class="@($"stat-card glass-panel {GetThemeClass()}")" Elevation="0">
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="stat-value">@_assignedStores.Count</MudText>
                <MudText Typo="Typo.caption" Class="stat-label">Assigned Stores</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="@($"stat-card glass-panel {GetThemeClass()}")" Elevation="0">
                <MudText Typo="Typo.h3" Color="Color.Success" Class="stat-value">@_completedToday</MudText>
                <MudText Typo="Typo.caption" Class="stat-label">Completed Today</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="@($"stat-card glass-panel {GetThemeClass()}")" Elevation="0">
                <MudText Typo="Typo.h3" Color="Color.Info" Class="stat-value">@_activeHeads</MudText>
                <MudText Typo="Typo.caption" Class="stat-label">Active Team</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="@($"stat-card glass-panel {GetThemeClass()}")" Elevation="0">
                <MudText Typo="Typo.h3" Color="Color.Secondary" Class="stat-value">@((int)_avgProgress)%</MudText>
                <MudText Typo="Typo.caption" Class="stat-label">Avg. Progress</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="mt-6" Color="Color.Primary">
        <MudTabPanel Text="Performance & Reports" Icon="@Icons.Material.Outlined.Assessment">
            <MudGrid>
                @foreach (var store in _assignedStores)
                {
                    <MudItem xs="12" md="6" lg="4">
                        <MudPaper Class="@($"pa-4 glass-panel {GetThemeClass()}")" Elevation="0">
                            <div class="d-flex justify-space-between align-start mb-4">
                                <div>
                                    <MudText Typo="Typo.h6" Style="font-weight: 800;">@store.StoreName</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.7;">@store.StoreCode • @store.Location</MudText>
                                </div>
                                <MudChip T="string" Color="GetStoreStatusColor(store.Id)" Size="Size.Small" Variant="Variant.Filled">
                                    @GetStoreStatusText(store.Id)
                                </MudChip>
                            </div>

                            <div class="mb-4">
                                <div class="d-flex justify-space-between mb-1">
                                    <MudText Typo="Typo.caption" Style="font-weight: 700;">DAILY PROGRESS</MudText>
                                    <MudText Typo="Typo.caption" Style="font-weight: 700;">@((int)GetStoreProgress(store.Id))%</MudText>
                                </div>
                                <MudProgressLinear Color="Color.Primary" Value="GetStoreProgress(store.Id)" Rounded="true" Class="mud-width-full" />
                            </div>

                            <div class="d-flex gap-2">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           FullWidth="true"
                                           OnClick="@(() => NavigationManager.NavigateTo($"/area-head/weekly-report/{store.Id}"))"
                                           Class="rounded-lg">
                                    VIEW REPORT
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           FullWidth="true"
                                           OnClick="@(() => OpenGenerateReportDialog(store))"
                                           Class="rounded-lg">
                                    GENERATE
                                </MudButton>
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Area Analytics" Icon="@Icons.Material.Outlined.BarChart">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Class="@($"pa-6 glass-panel {GetThemeClass()}")" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Category Performance (All Stores)</MudText>
                        <div class="d-flex flex-column gap-6">
                            @if (!_categoryPerformance.Any())
                            {
                                <div class="d-flex flex-column align-center justify-center py-10" style="opacity: 0.5;">
                                    <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Large" Class="mb-2" />
                                    <MudText>No performance data available.</MudText>
                                </div>
                            }
                            else
                            {
                                @foreach (var cat in _categoryPerformance.OrderByDescending(c => c.CompletionRate))
                                {
                                    <div>
                                        <div class="d-flex justify-space-between mb-2">
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@cat.CategoryName</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 800;">@((int)cat.CompletionRate)%</MudText>
                                        </div>
                                        <MudProgressLinear Color="@GetProgressColor(cat.CompletionRate)" Value="@cat.CompletionRate" Rounded="true" Size="Size.Medium" />
                                    </div>
                                }
                            }
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="@($"pa-6 glass-panel {GetThemeClass()}")" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Store Comparison</MudText>
                        <div class="d-flex flex-column gap-6">
                            @foreach (var store in _assignedStores.OrderByDescending(s => GetStoreProgress(s.Id)))
                            {
                                <div>
                                    <div class="d-flex justify-space-between mb-2">
                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@store.StoreName</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight: 800;">@((int)GetStoreProgress(store.Id))%</MudText>
                                    </div>
                                    <MudProgressLinear Color="@GetProgressColor(GetStoreProgress(store.Id))" Value="@GetStoreProgress(store.Id)" Rounded="true" Size="Size.Medium" />
                                </div>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Live Activity Log" Icon="@Icons.Material.Outlined.History">
            <MudPaper Class="@($"glass-panel {GetThemeClass()}")" Elevation="0">
                <MudList T="string" Dense="true" Clickable="true">
                    @if (!_activityLogs.Any())
                    {
                        <div class="pa-8 text-center" style="opacity: 0.5;">
                            <MudIcon Icon="@Icons.Material.Filled.HistoryToggleOff" Size="Size.Large" Class="mb-2" />
                            <MudText>No activity logs found for your stores.</MudText>
                        </div>
                    }

                    @foreach (var log in _activityLogs)
                    {
                        <div class="log-item">
                            <div class="d-flex align-center gap-4">
                                <MudAvatar Size="Size.Small" Color="GetLogColor(log.Action)">
                                    <MudIcon Icon="@GetLogIcon(log.Action)" Size="Size.Small" />
                                </MudAvatar>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@log.User?.Fullname</MudText>
                                        <MudText Typo="Typo.caption" Style="opacity: 0.6;">@GetRelativeTime(log.Timestamp)</MudText>
                                    </div>
                                    <MudText Typo="Typo.body2" Style="opacity: 0.8;">
                                        @log.Store?.StoreName: @log.Action: @log.Details
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    }
                </MudList>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Photo Gallery" Icon="@Icons.Material.Outlined.PhotoLibrary">
            <MudGrid>
                @if (!_recentPhotos.Any())
                {
                    <MudItem xs="12">
                        <div class="pa-8 text-center" style="opacity: 0.5;">
                            <MudIcon Icon="@Icons.Material.Filled.NoPhotography" Size="Size.Large" Class="mb-2" />
                            <MudText>No photos uploaded from your stores yet.</MudText>
                        </div>
                    </MudItem>
                }
                @foreach (var photo in _recentPhotos)
                {
                    <MudItem xs="6" sm="4" md="3">
                        <MudCard Class="@($"glass-panel {GetThemeClass()}")" Elevation="0">
                            <MudCardMedia Image="@GetImageSource(photo)" Height="200" @onclick="@(() => OpenPhotoDialog(photo))" style="cursor: pointer;" />
                            <MudCardContent Class="pa-2">
                                <MudText Typo="Typo.caption" Style="font-weight: 700; display: block;">@photo.StoreDailyActivity?.Store?.StoreName</MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.7;">@photo.UploadedAt.ToString("MMM dd, hh:mm tt")</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private List<Store> _assignedStores = new();
    private List<ActivityLog> _activityLogs = new();
    private List<TaskPhoto> _recentPhotos = new();
    private Dictionary<int, StoreDailyActivity?> _todayActivities = new();
    private Dictionary<int, double> _storeProgresses = new();

    private int _completedToday = 0;
    private int _activeHeads = 0;
    private double _avgProgress = 0;
    private List<CategoryPerformanceModel> _categoryPerformance = new();

    public class CategoryPerformanceModel
    {
        public string CategoryName { get; set; } = "";
        public double CompletionRate { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserState.InitializeAsync();
            ThemeService.OnThemeChanged += OnThemeChanged;
            UserState.DashboardRefreshRequested += HandleDashboardRefresh;
            DashboardRefresh.OnRefreshRequested += OnGlobalRefreshRequested;
            await LoadData();
            StateHasChanged();
        }
    }

    private void OnGlobalRefreshRequested(int? storeId)
    {
        // For Area Head, we refresh if any store assigned to them is updated
        if (storeId == null || _assignedStores.Any(s => s.Id == storeId))
        {
            HandleDashboardRefresh();
        }
    }

    private void HandleDashboardRefresh()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        UserState.DashboardRefreshRequested -= HandleDashboardRefresh;
        DashboardRefresh.OnRefreshRequested -= OnGlobalRefreshRequested;
    }

    private void OnThemeChanged() => StateHasChanged();

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var today = DateTime.Today;

        // Assigned Stores
        _assignedStores = await db.Stores
            .AsNoTracking()
            .Where(s => s.AreaHeadId == UserState.UserId)
            .Include(s => s.StoreHead)
            .ToListAsync();

        var storeIds = _assignedStores.Select(s => s.Id).ToList();

        // Today's Activities
        var activities = await db.StoreDailyActivities
            .AsNoTracking()
            .Where(a => storeIds.Contains(a.StoreId) && a.Date >= today && a.Date < today.AddDays(1))
            .ToListAsync();

        _todayActivities = activities
            .GroupBy(a => a.StoreId)
            .ToDictionary(g => g.Key, g => (StoreDailyActivity?)g.OrderBy(a => a.Id).FirstOrDefault());

        // Progress Calculations
        _activeHeads = activities.Select(a => a.StartedById).Distinct().Count();

        var checklistCount = await db.ChecklistItems.CountAsync();

        foreach (var storeId in storeIds)
        {
            var activity = _todayActivities.GetValueOrDefault(storeId);
            if (activity != null)
            {
                var completedTasks = await db.TaskProgresses.CountAsync(tp => tp.StoreDailyActivityId == activity.Id && tp.IsCompleted);
                var progress = checklistCount > 0 ? (completedTasks * 100.0 / checklistCount) : 0;
                _storeProgresses[storeId] = progress;
            }
            else
            {
                _storeProgresses[storeId] = 0;
            }
        }

        _completedToday = _storeProgresses.Values.Count(p => p >= 100);
        _avgProgress = _storeProgresses.Any() ? _storeProgresses.Values.Average() : 0;

        // Category Performance Aggregation
        var categories = await db.Categories.AsNoTracking().ToListAsync();
        _categoryPerformance.Clear();

        foreach (var category in categories)
        {
            var tasksInCategory = await db.ChecklistItems.AsNoTracking().Where(item => item.CategoryId == category.Id).Select(item => item.Id).ToListAsync();
            if (!tasksInCategory.Any()) continue;

            var totalPossible = tasksInCategory.Count * _assignedStores.Count;
            if (totalPossible == 0) continue;

            var activeSessionIds = activities.Select(a => a.Id).ToList();
            var completedCount = await db.TaskProgresses.AsNoTracking()
                .Where(tp => activeSessionIds.Contains(tp.StoreDailyActivityId) && tasksInCategory.Contains(tp.ChecklistItemId) && tp.IsCompleted)
                .CountAsync();

            _categoryPerformance.Add(new CategoryPerformanceModel
            {
                CategoryName = category.Name,
                CompletionRate = (completedCount * 100.0) / totalPossible
            });
        }

        // Logs
        _activityLogs = await db.ActivityLogs
            .AsNoTracking()
            .Include(l => l.User)
            .Include(l => l.Store)
            .Where(l => storeIds.Contains(l.StoreId ?? 0))
            .OrderByDescending(l => l.Timestamp)
            .Take(50)
            .ToListAsync();

        // Photos
        _recentPhotos = await db.TaskPhotos
            .AsNoTracking()
            .Include(p => p.StoreDailyActivity)
                .ThenInclude(s => s!.Store)
            .Where(p => p.StoreDailyActivity != null && storeIds.Contains(p.StoreDailyActivity.StoreId))
            .OrderByDescending(p => p.UploadedAt)
            .Take(12)
            .ToListAsync();
    }



    private string GetThemeClass() => ThemeService.CurrentTheme switch
    {
        ThemeMode.Lightest => "lightest",
        ThemeMode.Light => "light",
        ThemeMode.Dark => "dark",
        _ => "lightest"
    };

    private string GetButtonStyle() => ThemeService.CurrentTheme == ThemeMode.Light ? "background-color: #ffffff !important; color: #0072cf !important;" : "";

    private string GetRelativeTime(DateTime dateTime)
    {
        var timespan = DateTime.Now - dateTime;
        if (timespan.TotalMinutes < 1) return "just now";
        if (timespan.TotalMinutes < 60) return $"{(int)timespan.TotalMinutes}m ago";
        if (timespan.TotalHours < 24) return $"{(int)timespan.TotalHours}h ago";
        return dateTime.ToString("MMM dd");
    }

    private Color GetLogColor(string action) => action switch
    {
        "SessionStarted" => Color.Success,
        "CategoryCompleted" => Color.Info,
        "IssueReported" => Color.Error,
        "PhotoUploaded" => Color.Primary,
        "TaskCompleted" => Color.Success,
        _ => Color.Default
    };

    private string GetLogIcon(string action) => action switch
    {
        "SessionStarted" => Icons.Material.Filled.Login,
        "CategoryCompleted" => Icons.Material.Filled.CheckCircle,
        "IssueReported" => Icons.Material.Filled.Report,
        "PhotoUploaded" => Icons.Material.Filled.CameraAlt,
        "TaskCompleted" => Icons.Material.Filled.TaskAlt,
        _ => Icons.Material.Filled.Info
    };

    private Color GetStoreStatusColor(int storeId)
    {
        var activity = _todayActivities.GetValueOrDefault(storeId);
        if (activity == null) return Color.Default;
        var progress = GetStoreProgress(storeId);
        if (progress >= 100) return Color.Success;
        return Color.Info;
    }

    private string GetStoreStatusText(int storeId)
    {
        var activity = _todayActivities.GetValueOrDefault(storeId);
        if (activity == null) return "Inactive";
        var progress = GetStoreProgress(storeId);
        if (progress >= 100) return "Completed";
        return "In Progress";
    }

    private double GetStoreProgress(int storeId) => _storeProgresses.GetValueOrDefault(storeId, 0);

    private Color GetProgressColor(double progress)
    {
        if (progress >= 100) return Color.Success;
        if (progress >= 70) return Color.Info;
        if (progress >= 30) return Color.Warning;
        return Color.Default;
    }

    private string GetImageSource(TaskPhoto photo) => photo.ImageData != null && !string.IsNullOrEmpty(photo.ImageMimeType)
        ? $"data:{photo.ImageMimeType};base64,{Convert.ToBase64String(photo.ImageData)}"
        : "";

    private async Task OpenPhotoDialog(TaskPhoto photo)
    {
        var parameters = new DialogParameters { ["Photo"] = photo };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<PhotoGalleryDialog>("Photo Details", parameters, options);
    }

    private async Task OpenGenerateReportDialog(Store store)
    {
        var parameters = new DialogParameters { ["PreselectedStoreId"] = store.Id };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<GenerateReportDialog>("Generate Report", parameters, options);
    }

    private async Task OpenExportDialog()
    {
        await DialogService.ShowAsync<ExportReportsDialog>("Export Reports");
    }

}
