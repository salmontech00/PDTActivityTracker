@page "/admin/checklist"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Components.Pages.Dialogs
@inject IDialogService DialogService
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@implements IDisposable

<PageTitle>Checklist Management</PageTitle>

<style>
    .checklist-container {
        padding: 1rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 16px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding: 0;
    }

    .button-group {
        display: flex;
        gap: 12px;
        padding: 0;
        margin: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* TABLE STYLING */
    .mud-table {
        background: transparent !important;
    }

    .mud-table-head {
        background: rgba(0, 114, 207, 0.1);
    }

        .mud-table-head.lightest {
            background: rgba(0, 114, 207, 0.05);
        }

    .mud-table-cell {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        padding: 12px 16px !important;
    }

    .lightest .mud-table-cell {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .mud-table-row:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .lightest .mud-table-row:hover {
        background-color: rgba(0, 114, 207, 0.05) !important;
    }

    /* Fix for Pager/Footer alignment */
    .mud-table-pagination {
        background-color: transparent !important;
        border-top: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: inherit !important;
    }

    .lightest .mud-table-pagination {
        border-top: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    /* BUTTONS */
    .modern-button {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
    }

    /* CATEGORY CHIPS */
    .category-chip {
        font-weight: 700 !important;
        border-radius: 12px !important;
    }

    .category-opening {
        background-color: rgba(255, 193, 7, 0.15) !important;
        color: #ffc107 !important;
        border: 1px solid rgba(255, 193, 7, 0.3) !important;
    }

    .category-asset {
        background-color: rgba(33, 150, 243, 0.15) !important;
        color: #2196f3 !important;
        border: 1px solid rgba(33, 150, 243, 0.3) !important;
    }

    .category-hr {
        background-color: rgba(156, 39, 176, 0.15) !important;
        color: #9c27b0 !important;
        border: 1px solid rgba(156, 39, 176, 0.3) !important;
    }

    .category-inventory {
        background-color: rgba(76, 175, 80, 0.15) !important;
        color: #4caf50 !important;
        border: 1px solid rgba(76, 175, 80, 0.3) !important;
    }

    .category-marketing {
        background-color: rgba(255, 87, 34, 0.15) !important;
        color: #ff5722 !important;
        border: 1px solid rgba(255, 87, 34, 0.3) !important;
    }

    .category-expenses {
        background-color: rgba(244, 67, 54, 0.15) !important;
        color: #f44336 !important;
        border: 1px solid rgba(244, 67, 54, 0.3) !important;
    }

    .category-closing {
        background-color: rgba(63, 81, 181, 0.15) !important;
        color: #3f51b5 !important;
        border: 1px solid rgba(63, 81, 181, 0.3) !important;
    }

    .lightest .category-opening {
        background-color: rgba(0, 114, 207, 0.5) !important;
    }

    .modern-button.lightest {
        /* Primary color for lightest */
    }

    .button-group .modern-button.light {
        background-color: #ffffff !important;
        color: #0072cf !important;
    }

    /* Action Icon Buttons white in darker themes */
    .light .mud-icon-button.mud-info-text,
    .dark .mud-icon-button.mud-info-text,
    .light .mud-icon-button.mud-primary-text,
    .dark .mud-icon-button.mud-primary-text {
        color: #ffffff !important;
    }

    /* DRAG AND DROP */
    .drop-item {
        cursor: grab;
    }

        .drop-item:active {
            cursor: grabbing;
        }

    /* PREVIEW MODE */
    .preview-mode {
        max-width: 800px;
        margin: 0 auto;
    }

    /* MOBILE CARDS */
    .mobile-card {
        margin-bottom: 16px;
        overflow: hidden;
    }

    .mobile-card-header {
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .lightest .mobile-card-header {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1);
    }

    .mobile-card-content {
        padding: 16px;
    }

    .mobile-card-actions {
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        gap: 8px;
    }

    .lightest .mobile-card-actions {
        background: rgba(0, 114, 207, 0.03);
    }

    /* FILTER SECTION */
    .filter-section {
        padding: 16px;
        margin-bottom: 24px;
    }

        .filter-section .mud-input-root {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
        }

    .lightest .filter-section .mud-input-root {
        background: rgba(255, 255, 255, 0.8) !important;
    }

    .light .filter-section .mud-input-root {
        background: rgba(255, 255, 255, 0.1) !important;
    }

    .light .filter-section .mud-input-label,
    .light .filter-section .mud-input-adornment-start,
    .light .filter-section .mud-select-input,
    .light .filter-section .mud-input-slot {
        color: #ffffff !important;
    }

    .light .filter-section .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.5) !important;
    }

    .light .filter-section .mud-input-root:focus-within .mud-input-outlined-border {
        border-color: #ffffff !important;
    }

    .filter-toggle-button {
        display: none;
    }

    /* RESPONSIVE */
    @@media (max-width: 960px) {
        .filter-toggle-button {
            display: inline-flex !important;
        }

        .filter-section .mud-grid {
            display: none;
        }

        .filter-section.filters-visible .mud-grid {
            display: flex;
        }

        .desktop-view {
            display: none;
        }

        .mobile-view {
            display: block;
        }

        .page-header-row {
            flex-direction: column;
            gap: 16px;
            align-items: stretch;
            text-align: center;
            padding: 0;
            margin-bottom: 20px;
        }

        .page-title {
            display: none;
        }

        .button-group {
            flex-direction: row !important;
            width: 100%;
            justify-content: space-between;
        }

            .button-group .modern-button {
                flex: 1;
                font-size: 0.70rem !important;
            }
    }

    @@media (min-width: 961px) {
        .desktop-view {
            display: block;
        }

        .mobile-view {
            display: none;
        }
    }
</style>

<div class="checklist-container">
    <div class="page-header-row">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Checklist Management</MudText>

        <div class="button-group">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Preview"
                       OnClick="@(() => _isPreviewMode = !_isPreviewMode)"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                @(_isPreviewMode ? "BACK TO EDITOR" : "PREVIEW")
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddTaskDialog"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                ADD TASK
            </MudButton>
        </div>
    </div>

    @if (!_isPreviewMode)
    {
        <!-- Filter Section -->
        <MudPaper Class="@($"glass-panel filter-section {GetThemeClass()} {(_showFilters ? "filters-visible" : "")}")"
                  Elevation="0">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                       FullWidth="true"
                       OnClick="@(() => _showFilters = !_showFilters)"
                       Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                       Style="@GetFilterButtonStyle()">
                @(_showFilters ? "Hide Filters" : "Show Filters")
            </MudButton>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="8" md="10">
                    <MudTextField T="string"
                                  @bind-Value="_searchTerm"
                                  @bind-Value:after="ApplyFilters"
                                  Label="Search Tasks"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Placeholder="Search task name or description..."
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Margin="Margin.Dense"
                                  Class="rounded-lg" />
                </MudItem>
                <MudItem xs="12" sm="4" md="2">
                    <MudSelect T="string"
                               @bind-Value="_categoryFilter"
                               @bind-Value:after="ApplyFilters"
                               Label="Category"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="rounded-lg">
                        <MudSelectItem Value="@("All")">All Categories</MudSelectItem>
                        @foreach (var cat in _categories)
                        {
                            <MudSelectItem Value="@cat">@cat</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.body2" Class="@($"{GetStatusTextColor()} font-weight-bold")" Style="opacity: 0.8;">
                    Showing @_filteredTasks.Count of @_tasks.Count tasks
                </MudText>
                @if (HasActiveFilters())
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ClearFilters"
                               Class="modern-button">
                        Reset Filters
                    </MudButton>
                }
            </div>
        </MudPaper>

        <!-- Desktop Table View -->
        <div class="desktop-view">
            <MudPaper Class="@($"glass-panel {GetThemeClass()}")" Elevation="0">
                <MudDropContainer T="ChecklistItem" Items="_filteredTasks" ItemsSelector="@((item, dropzone) => true)" ItemDropped="ItemDropped" Class="d-flex flex-column">
                    <ChildContent>
                        <MudTable Items="_filteredTasks" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Class="mud-table-glass">
                            <HeaderContent>
                                <MudTh Style="width: 50px;"></MudTh>
                                <MudTh>No.</MudTh>
                                <MudTh>Task Name</MudTh>
                                <MudTh>Category</MudTh>
                                <MudTh>Frequency</MudTh>
                                <MudTh>Mandatory</MudTh>
                                <MudTh>Photo Req.</MudTh>
                                <MudTh Style="text-align: center;">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="">
                                    <MudDropZone T="ChecklistItem" Identifier="@context.Id.ToString()" AllowReorder="true" Class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Class="drop-item" />
                                    </MudDropZone>
                                </MudTd>
                                <MudTd DataLabel="No.">@(_filteredTasks.ToList().IndexOf(context) + 1)</MudTd>
                                <MudTd DataLabel="Task Name">
                                    <MudText Typo="Typo.body1" Style="font-weight: 600;">@context.TaskName</MudText>
                                    @if (!string.IsNullOrEmpty(context.Description))
                                    {
                                        <MudText Typo="Typo.caption" Style="opacity: 0.7;">@context.Description</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Category">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="Variant.Text"
                                             Class="@($"category-chip {GetCategoryClass(context.Category)}")">
                                        @context.Category
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Frequency">@context.Frequency</MudTd>
                                <MudTd DataLabel="Mandatory">
                                    <MudIcon Icon="@(context.IsMandatory? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)"
                                             Color="@(context.IsMandatory ? Color.Success : Color.Default)"
                                             Size="Size.Small" />
                                </MudTd>
                                <MudTd DataLabel="Photo Req.">
                                    @if (context.IsPhotoRequired)
                                    {
                                        <MudText Typo="Typo.body2">@context.NumberOfPhotos Photos</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption">No</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Action" Style="text-align: center;">
                                    <div class="d-flex justify-center gap-2">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => EditTask(context))"
                                                       Title="Edit task" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => DeleteTask(context))"
                                                       Title="Delete task" />
                                    </div>
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                            </PagerContent>
                        </MudTable>
                    </ChildContent>
                    <ItemRenderer>
                        @context.TaskName
                    </ItemRenderer>
                </MudDropContainer>
            </MudPaper>
        </div>

        <!-- Mobile View -->
        <div class="mobile-view">
            <MudDropContainer T="ChecklistItem" Items="_filteredTasks" ItemsSelector="@((item, dropzone) => true)" ItemDropped="ItemDropped" Class="d-flex flex-column gap-2">
                <ChildContent>
                    @if (_filteredTasks.Any())
                    {
                        @foreach (var task in _filteredTasks)
                        {
                            <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                                <div class="mobile-card-header">
                                    <div class="d-flex align-center gap-3">
                                        <MudDropZone T="ChecklistItem" Identifier="@task.Id.ToString()" AllowReorder="true">
                                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Class="drop-item" />
                                        </MudDropZone>
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@task.TaskName</MudText>
                                            <MudText Typo="Typo.caption" Style="opacity: 0.7;">@task.Frequency</MudText>
                                        </div>
                                    </div>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="@($"category-chip {GetCategoryClass(task.Category)}")">
                                        @task.Category
                                    </MudChip>
                                </div>

                                <div class="mobile-card-content">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            @if (!string.IsNullOrEmpty(task.Description))
                                            {
                                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Description</MudText>
                                                <MudText Typo="Typo.body2">@task.Description</MudText>
                                            }
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Mandatory</MudText>
                                            <br />
                                            <MudIcon Icon="@(task.IsMandatory? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)"
                                                     Color="@(task.IsMandatory ? Color.Success : Color.Default)"
                                                     Size="Size.Small" />
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Photo Required</MudText>
                                            <MudText Typo="Typo.body2">
                                                @if (task.IsPhotoRequired)
                                                {
                                                    <text>@task.NumberOfPhotos Photos</text>
                                                }
                                                else
                                                {
                                                    <text>No</text>
                                                }
                                            </MudText>
                                        </MudItem>
                                    </MudGrid>
                                </div>

                                <div class="mobile-card-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => EditTask(task))"
                                                   Title="Edit task" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteTask(task))"
                                                   Title="Delete task" />
                                </div>
                            </MudPaper>
                        }
                    }
                    else
                    {
                        <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                            <div class="mobile-card-content" style="text-align: center; padding: 48px 24px;">
                                <MudIcon Icon="@(HasActiveFilters() ? Icons.Material.Filled.SearchOff : Icons.Material.Filled.Assignment)"
                                         Size="Size.Large"
                                         Style="font-size: 4rem; opacity: 0.3; margin-bottom: 16px;" />

                                <MudText Typo="Typo.h6" Style="font-weight: 700; margin-bottom: 8px;">
                                    @if (HasActiveFilters())
                                    {
                                        <text>No Matching Tasks</text>
                                    }
                                    else
                                    {
                                        <text>No Tasks Yet</text>
                                    }
                                </MudText>

                                <MudText Typo="Typo.body2" Style="opacity: 0.7; margin-bottom: 24px;">
                                    @if (HasActiveFilters())
                                    {
                                        <text>Try adjusting your filters or search terms to find what you're looking for.</text>
                                    }
                                    else
                                    {
                                        <text>Get started by adding your first checklist task.</text>
                                    }
                                </MudText>

                                @if (HasActiveFilters())
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.RestartAlt"
                                               OnClick="ClearFilters"
                                               Class="modern-button">
                                        Clear Filters
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="OpenAddTaskDialog"
                                               Class="@($"modern-button {GetThemeClass()}")"
                                               Style="@GetButtonStyle()">
                                        Add Your First Task
                                    </MudButton>
                                }
                            </div>
                        </MudPaper>
                    }
                </ChildContent>
                <ItemRenderer>
                    @context.TaskName
                </ItemRenderer>
            </MudDropContainer>
        </div>
    }
    else
    {
        <!-- Preview Mode -->
        <div class="preview-mode">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4" Style="@GetTitleStyle()">Checklist Preview</MudText>
            @foreach (var group in _tasks.GroupBy(t => t.Category).OrderBy(g => _categories.IndexOf(g.Key)))
            {
                <MudExpansionPanels MultiExpansion="true" Class="mb-4">
                    <MudExpansionPanel Text="@group.Key" MaxHeight="1000">
                        <TitleContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@GetCategoryIcon(group.Key)" Class="mr-2" />
                                <MudText Typo="Typo.h6">@group.Key</MudText>
                                <MudSpacer />
                                <MudText Typo="Typo.caption">@group.Count() Tasks</MudText>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            @foreach (var task in group.OrderBy(t => t.SortOrder))
                            {
                                <MudPaper Elevation="0" Class="pa-4 mb-2 border rounded-lg">
                                    <div class="d-flex align-center justify-space-between mb-2">
                                        <div class="d-flex align-center">
                                            <MudCheckBox T="bool" Disabled="true" Color="Color.Primary" />
                                            <MudText Typo="Typo.body1" Style="font-weight: 600;">@task.TaskName</MudText>
                                            @if (task.IsMandatory)
                                            {
                                                <MudText Color="Color.Error" Class="ml-1">*</MudText>
                                            }
                                        </div>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">@task.Frequency</MudChip>
                                    </div>
                                    @if (!string.IsNullOrEmpty(task.Description))
                                    {
                                        <MudText Typo="Typo.body2" Class="ml-10 mb-2" Style="opacity: 0.8;">@task.Description</MudText>
                                    }
                                    <div class="ml-10 d-flex flex-wrap gap-4">
                                        @if (task.IsPhotoRequired)
                                        {
                                            <div class="d-flex flex-column">
                                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PhotoCamera" Size="Size.Small">
                                                    Upload Photos (0/@task.NumberOfPhotos)
                                                </MudButton>
                                            </div>
                                        }
                                        @if (task.IsRemarksRequired)
                                        {
                                            <MudTextField T="string" Label="Remarks" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width: 300px;" />
                                        }
                                    </div>
                                </MudPaper>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </div>
    }
</div>

@code {
    private bool _showFilters = false;
    private List<ChecklistItem> _tasks = new();
    private List<ChecklistItem> _filteredTasks = new();
    private bool _initialized = false;
    private bool _isPreviewMode = false;

    // Filter variables
    private string _searchTerm = string.Empty;
    private string _categoryFilter = "All";

    private readonly List<string> _categories = new()
    {
        "Opening", "Asset", "Human Resource", "Inventory", "Marketing", "Expenses & Repair", "Closing"
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "border-radius: 12px;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? "color: #0072cf !important; background-color: #ffffff !important; border-radius: 12px; font-weight: bold;"
            : "border-radius: 12px; font-weight: bold;";
    }

    private string GetFilterButtonStyle()
    {
        if (ThemeService == null) return "";
        return ThemeService.CurrentTheme == ThemeMode.Lightest
            ? "color: #0072cf; border-color: #0072cf; border-radius: 12px;"
            : "color: #ffffff; border-color: #ffffff; border-radius: 12px; background-color: transparent !important;";
    }

    private string GetStatusTextColor()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "text-dark" : "text-white";
    }

    private string GetTitleStyle()
    {
        return $"color: {(ThemeService.CurrentTheme == ThemeMode.Lightest ? "#0f172a" : "#ffffff")}; font-weight: 800;";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await LoadData();
            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Load all tasks
        _tasks = await db.ChecklistItems
            .OrderBy(t => t.SortOrder)
            .AsNoTracking()
            .ToListAsync();

        ApplyFilters();
    }

    // Alias for LoadData to match reference snippet (if called by Dialogs)
    private async Task LoadTasks()
    {
        await LoadData();
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        _filteredTasks = _tasks;

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredTasks = _filteredTasks.Where(t =>
                (t.TaskName?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (t.Description?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }

        if (_categoryFilter != "All")
        {
            _filteredTasks = _filteredTasks.Where(t => t.Category == _categoryFilter).ToList();
        }

        StateHasChanged(); // Used when called from UI events
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _categoryFilter = "All";
        ApplyFilters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(_searchTerm) ||
               _categoryFilter != "All";
    }

    private string GetCategoryClass(string category) => category.ToLower() switch
    {
        "opening" => "category-opening",
        "asset" => "category-asset",
        "human resource" => "category-hr",
        "inventory" => "category-inventory",
        "marketing" => "category-marketing",
        "expenses & repair" => "category-expenses",
        "closing" => "category-closing",
        _ => "category-opening"
    };

    private string GetCategoryIcon(string category) => category.ToLower() switch
    {
        "opening" => Icons.Material.Filled.DoorFront,
        "asset" => Icons.Material.Filled.Devices,
        "human resource" => Icons.Material.Filled.Groups,
        "inventory" => Icons.Material.Filled.Inventory,
        "marketing" => Icons.Material.Filled.Campaign,
        "expenses & repair" => Icons.Material.Filled.Build,
        "closing" => Icons.Material.Filled.DoorBack,
        _ => Icons.Material.Filled.ListAlt
    };

    private async Task OpenAddTaskDialog()
    {
        var parameters = new DialogParameters { { "CategoryOptions", _categories } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddEditTask>("Add New Task", parameters, options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            await LoadTasks();
        }
    }

    private async Task EditTask(ChecklistItem task)
    {
        var parameters = new DialogParameters
        {
            { "TaskToEdit", task },
            { "CategoryOptions", _categories }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddEditTask>("Edit Task", parameters, options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            await LoadTasks();
        }
    }

    private async Task DeleteTask(ChecklistItem task)
    {
        var parameters = new DialogParameters {
            { "ContentText", $"Are you sure you want to delete '{task.TaskName}'?\n\nThis action cannot be undone." },
            { "ButtonText", "Delete" },
            { "Color", Color.Error }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            try
            {
                using var db = await DbFactory.CreateDbContextAsync();
                var taskToDelete = await db.ChecklistItems.FindAsync(task.Id);

                if (taskToDelete != null)
                {
                    db.ChecklistItems.Remove(taskToDelete);
                    await db.SaveChangesAsync();
                    Snackbar.Add("Task deleted successfully!", Severity.Success);
                    await LoadTasks();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting task: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ItemDropped(MudItemDropInfo<ChecklistItem> dropInfo)
    {
        if (dropInfo.Item == null) return;

        _tasks.Remove(dropInfo.Item);

        // Find the index in the full list based on the filtered list position
        var targetItem = _filteredTasks[dropInfo.IndexInZone];
        int targetIndex = _tasks.IndexOf(targetItem);

        _tasks.Insert(targetIndex, dropInfo.Item);

        // Update SortOrder for all items
        for (int i = 0; i < _tasks.Count; i++)
        {
            _tasks[i].SortOrder = i;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        db.ChecklistItems.UpdateRange(_tasks);
        await db.SaveChangesAsync();
        Snackbar.Add("Task reordered successfully!", Severity.Info);

        ApplyFilters();
    }
}