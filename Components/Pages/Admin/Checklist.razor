@page "/admin/checklist"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Components.Pages.Dialogs
@inject IDialogService DialogService
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@implements IDisposable

<PageTitle>Checklist Management</PageTitle>

<style>
    .checklist-container {
        padding: 1rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 16px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding: 0;
    }

    .button-group {
        display: flex;
        gap: 12px;
        padding: 0;
        margin: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* BUTTONS */
    .modern-button {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
    }

    /* CATEGORY CHIPS */
    .category-chip {
        font-weight: 700 !important;
        border-radius: 12px !important;
        background-color: rgba(253, 212, 92, 0.1) !important;
        color: rgb(253, 212, 92) !important;
        border: 1px solid rgba(253, 212, 92, 0.3) !important;
    }

    .lightest .category-chip {
        background-color: rgba(0, 114, 207, 0.5) !important;
        color: rgb(253, 212, 92) !important;
        border: 1px solid rgba(253, 212, 92, 0.3) !important;
    }

    .button-group .modern-button.light {
        background-color: #ffffff !important;
        color: #0072cf !important;
    }

    /* THEME SPECIFIC TEXT & ICON COLORS */

    /* Light & Dark (Blue/Dark backgrounds) */
    .light .page-title, .dark .page-title,
    .light .category-block .mud-typography, .dark .category-block .mud-typography,
    .light .category-icon,
    .light .task-description, .dark .task-description,
    .light .desktop-only .mud-typography, .dark .desktop-only .mud-typography {
        color: #ffffff !important;
    }

    .light .task-name, .dark .task-name,
    .light .task-number, .dark .task-number {
        color: rgb(253, 212, 92) !important;
    }

    .lightest .category-icon, .dark .category-icon {
        color: #0072cf !important;
    }

    /* Lightest (Light background) */
    .lightest .page-title,
    .lightest .category-block .mud-typography,
    .lightest .task-name,
    .lightest .task-number,
    .lightest .task-description {
        color: #0f172a !important;
    }

    /* Action Icon Buttons */
    .light .mud-icon-button, .dark .mud-icon-button {
        color: #ffffff !important;
    }

    .lightest .mud-icon-button {
        color: #0072cf !important;
    }

    /* DRAG AND DROP */
    .drop-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .category-drop-zone {
        min-height: 50px;
        padding: 8px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px dashed rgba(255, 255, 255, 0.1);
        transition: background-color 0.2s ease;
    }

    .lightest .category-drop-zone {
        background: rgba(0, 114, 207, 0.02);
        border: 1px dashed rgba(0, 114, 207, 0.1);
    }

    .category-drop-zone:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .lightest .category-drop-zone:hover {
        background: rgba(0, 114, 207, 0.05);
    }

    .task-drop-item {
        margin-bottom: 8px;
        user-select: none;
    }

    .task-row-card {
        display: grid;
        grid-template-columns: 40px 40px 1fr 150px 100px 80px 80px 100px;
        align-items: center;
        padding: 8px 16px;
        gap: 12px;
        border-radius: 12px;
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: grab;
    }

        .task-row-card:active {
            cursor: grabbing;
        }

        .task-row-card:hover {
            transform: translateX(4px);
            background: rgba(255, 255, 255, 0.05) !important;
        }

    .lightest .task-row-card:hover {
        background: rgba(0, 114, 207, 0.05) !important;
    }

    .task-number-container {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 2px;
    }

    .task-number {
        font-size: 0.8rem;
    }

    @@media (max-width: 960px) {
        .task-number {
            font-size: 0.7rem;
            opacity: 0.6;
        }
    }

    .task-info {
        display: flex;
        flex-direction: column;
    }

    .task-name {
        font-weight: 700;
        color: rgb(253, 212, 92);
    }

    .lightest .task-name {
        color: #0f172a;
    }

    .task-number {
        font-weight: 700;
        opacity: 0.8;
        color: rgb(253, 212, 92);
    }

    .lightest .task-number {
        color: #0f172a;
        opacity: 0.8;
    }

    .task-description {
        font-size: 0.75rem;
        opacity: 0.7;
    }

    /* FILTER SECTION */
    .filter-section {
        padding: 16px;
        margin-bottom: 24px;
    }

        .filter-section .mud-input-root {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
        }

    .lightest .filter-section .mud-input-root {
        background: rgba(255, 255, 255, 0) !important;
    }

    .light .filter-section .mud-input-root {
        background: rgba(255, 255, 255, 0) !important;
    }

    .light .filter-section .mud-input-label,
    .light .filter-section .mud-input-adornment-start,
    .light .filter-section .mud-select-input,
    .light .filter-section .mud-input-slot {
        color: #ffffff !important;
    }

    .light .filter-section .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.5) !important;
    }

    .light .filter-section .mud-input-root:focus-within .mud-input-outlined-border {
        border-color: #ffffff !important;
    }

    .filter-toggle-button {
        display: none;
    }

    /* PREVIEW MODE */
    .preview-mode {
        max-width: 900px;
        margin: 0 auto;
        padding-bottom: 40px;
    }

    .modern-expansion-panels {
        background: transparent !important;
        box-shadow: none !important;
    }

    .modern-expansion-panel {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 16px !important;
        margin-bottom: 16px !important;
        backdrop-filter: blur(10px);
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
    }

        .modern-expansion-panel::before {
            display: none !important;
        }

    .lightest .modern-expansion-panel {
        background: rgba(255, 255, 255, 0.45) !important;
        border: 1px solid rgba(0, 114, 207, 0.2) !important;
    }

    .preview-task-card {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
        transition: all 0.2s ease;
    }

    .lightest .preview-task-card {
        background: rgba(0, 114, 207, 0.03) !important;
        border: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .preview-task-header {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        width: 100%;
    }

    .preview-header-content-group {
        display: flex;
        align-items: flex-start;
        flex-wrap: nowrap;
        gap: 8px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .preview-task-name-container {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding-top: 2px;
        flex: 0 0 auto;
    }

    .preview-description-row {
        display: flex;
        align-items: flex-start;
        gap: 4px;
        flex: 0 1 auto;
        min-width: 0;
    }

    .preview-upload-btn {
        border-radius: 8px !important;
        text-transform: none !important;
        font-weight: 600 !important;
        font-size: 0.75rem !important;
        flex: 0 0 auto;
        margin-left: auto;
    }

    .preview-remarks-container {
        margin-top: 8px;
        padding-left: 32px;
        width: 100%;
        max-width: 600px;
    }

    @@media (max-width: 600px) {
        .preview-task-header {
            flex-wrap: wrap;
        }

        .preview-header-content-group {
            width: 100%;
            flex-wrap: wrap;
        }

        .preview-task-name-container {
            width: 100%;
        }

        .preview-description-row {
            width: 100%;
            padding-left: 0;
            margin-top: 8px;
            flex: 0 0 100%;
        }

        .preview-upload-btn {
            margin-left: 0 !important;
            margin-top: 12px;
            width: 100% !important;
        }

        .preview-remarks-container {
            padding-left: 0;
            margin-top: 12px;
            width: 100%;
        }
    }

    /* RESPONSIVE */
    @@media (max-width: 960px) {
        .filter-toggle-button {
            display: inline-flex !important;
        }

        .filter-section .mud-grid {
            display: none;
        }

        .filter-section.filters-visible .mud-grid {
            display: flex;
        }

        .page-header-row {
            flex-direction: column;
            gap: 16px;
            align-items: stretch;
            text-align: center;
            padding: 0;
            margin-bottom: 20px;
        }

        .page-title {
            display: none;
        }

        .button-group {
            flex-direction: row !important;
            width: 100%;
            justify-content: space-between;
        }

            .button-group .modern-button {
                flex: 1;
                font-size: 0.70rem !important;
            }

        .task-row-card {
            grid-template-columns: 24px 1fr auto;
            grid-template-rows: auto;
            gap: 12px;
            padding: 16px;
        }

        .task-info {
            grid-column: 2 / 3;
        }

        .task-actions {
            grid-column: 3 / 4;
            grid-row: 1;
            display: flex;
            align-items: center;
        }

        .task-details-mobile {
            display: none !important;
        }

        .desktop-only {
            display: none !important;
        }
    }

    @@media (min-width: 961px) {
        .mobile-only {
            display: none !important;
        }
    }
</style>

<div class="checklist-container @GetThemeClass()">
    <div class="page-header-row">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Checklist Management</MudText>

        <div class="button-group">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Preview"
                       OnClick="@(() => _isPreviewMode = !_isPreviewMode)"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                @(_isPreviewMode ? "BACK TO EDITOR" : "PREVIEW")
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddTaskDialog"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                ADD TASK
            </MudButton>
        </div>
    </div>

    @if (_initialized && !_isPreviewMode)
    {
        <!-- Filter Section -->
        <MudPaper Class="@($"glass-panel filter-section {GetThemeClass()} {(_showFilters ? "filters-visible" : "")}")"
                  Elevation="0">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                       FullWidth="true"
                       OnClick="@(() => _showFilters = !_showFilters)"
                       Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                       Style="@GetFilterButtonStyle()">
                @(_showFilters ? "Hide Filters" : "Show Filters")
            </MudButton>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="8" md="10">
                    <MudTextField T="string"
                                  @bind-Value="_searchTerm"
                                  @bind-Value:after="ApplyFilters"
                                  Label="Search Tasks"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Placeholder="Search task name or description..."
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Margin="Margin.Dense"
                                  Class="rounded-lg" />
                </MudItem>
                <MudItem xs="12" sm="4" md="2">
                    <MudSelect T="string"
                               @bind-Value="_categoryFilter"
                               @bind-Value:after="ApplyFilters"
                               Label="Category"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="rounded-lg">
                        <MudSelectItem Value="@("All")">All Categories</MudSelectItem>
                        @foreach (var cat in _categories)
                        {
                            <MudSelectItem Value="@cat">@cat</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.body2" Class="@($"{GetStatusTextColor()} font-weight-bold")" Style="opacity: 0.8;">
                    Showing @_filteredTasks.Count of @_tasks.Count tasks
                </MudText>
                @if (HasActiveFilters())
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ClearFilters"
                               Class="modern-button">
                        Reset Filters
                    </MudButton>
                }
            </div>
        </MudPaper>

        <!-- Draggable List View (Unified) -->
        <MudDropContainer T="ChecklistItem"
                          Items="_filteredTasks"
                          ItemsSelector="@((item, dropzone) => item.Category == dropzone)"
                          ItemDropped="ItemDropped"
                          Class="drop-container">
            <ChildContent>
                @foreach (var category in _categories)
                {
                    @if (_filteredTasks.Any(t => t.Category == category) || _categoryFilter == "All" || _categoryFilter == category)
                    {
                        <div class="category-block">
                            <div class="d-flex align-center mb-2 px-2">
                                <MudIcon Icon="@GetCategoryIcon(category)" Class="mr-2 category-icon" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 800; letter-spacing: 1px; text-transform: uppercase;">@category</MudText>
                                <MudSpacer />
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="@($"category-chip {GetCategoryClass(category)}")">
                                    @_filteredTasks.Count(t => t.Category == category) Tasks
                                </MudChip>
                            </div>

                            <MudDropZone T="ChecklistItem" Identifier="@category" Class="category-drop-zone" />
                        </div>
                    }
                }
            </ChildContent>
            <ItemRenderer>
                <div class="task-drop-item">
                    <MudPaper Class="@($"glass-panel task-row-card {GetThemeClass()}")" Elevation="0">
                        <div class="d-flex align-center desktop-only">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Style="opacity: 0.5;" />
                        </div>

                        <div class="task-number-container">
                            <MudText Typo="Typo.body2" Class="task-number">
                                @(GetItemIndex(context))
                            </MudText>
                        </div>

                        <div class="task-info">
                            @if (!string.IsNullOrEmpty(context.Section))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Primary" Class="desktop-only" Style="font-weight: 600; line-height: 1;">@context.Section</MudText>
                            }
                            <MudText Typo="Typo.body1" Class="task-name">@context.TaskName</MudText>
                            @if (!string.IsNullOrEmpty(context.Description))
                            {
                                <MudText Typo="Typo.caption" Class="task-description">@context.Description</MudText>
                            }
                        </div>

                        <div class="desktop-only">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="@($"category-chip {GetCategoryClass(context.Category)}")">
                                @context.Category
                            </MudChip>
                        </div>

                        <div class="desktop-only text-center">
                            <MudText Typo="Typo.body2">@context.Frequency</MudText>
                        </div>

                        <div class="desktop-only text-center">
                            <MudIcon Icon="@(context.IsMandatory? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)"
                                     Color="@(context.IsMandatory ? Color.Success : Color.Default)"
                                     Size="Size.Small" />
                        </div>

                        <div class="desktop-only text-center">
                            <MudText Typo="Typo.caption">
                                @(context.IsPhotoRequired ? $"{context.NumberOfPhotos} Photos" : "No")
                            </MudText>
                        </div>

                        <div class="task-actions d-flex justify-center gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => EditTask(context))"
                                           Title="Edit task" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteTask(context))"
                                           Title="Delete task" />
                        </div>

                        <div class="mobile-only task-details-mobile">
                            <span>@context.Frequency</span>
                            <span class="d-flex align-center gap-1">
                                <MudIcon Icon="@(context.IsMandatory? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)" Size="Size.Small" Color="@(context.IsMandatory? Color.Success: Color.Default)" /> Mandatory
                            </span>
                            @if (context.IsPhotoRequired)
                            {
                                <span class="d-flex align-center gap-1">
                                    <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Small" /> @context.NumberOfPhotos
                                </span>
                            }
                        </div>
                    </MudPaper>
                </div>
            </ItemRenderer>
        </MudDropContainer>
    }
    else if (!_initialized)
    {
        <div class="d-flex flex-column align-center justify-center py-10" style="opacity: 0.5;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-3" />
            <MudText Typo="Typo.h6">Loading Checklist...</MudText>
        </div>
    }
    else if (_isPreviewMode)
    {
        <!-- Preview Mode -->
        <div class="preview-mode">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-6" Style="@GetTitleStyle()">Checklist Preview</MudText>

            <MudExpansionPanels MultiExpansion="true" Class="modern-expansion-panels">
                @foreach (var group in _tasks.GroupBy(t => t.Category).OrderBy(g => _categories.IndexOf(g.Key)))
                {
                    <MudExpansionPanel Class="modern-expansion-panel" MaxHeight="1000">
                        <TitleContent>
                            <div class="d-flex align-center py-2">
                                <MudIcon Icon="@GetCategoryIcon(group.Key)" Class="mr-3 category-icon" />
                                <MudText Typo="Typo.h6" Style="font-weight: 700;">@group.Key</MudText>
                                <MudSpacer />
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="@($"category-chip {GetCategoryClass(group.Key)}")">
                                    @group.Count() Tasks
                                </MudChip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            @{
                                var lastSection = "";
                                var orderedTasks = group.OrderBy(t => t.SortOrder).ToList();
                            }
                            @for (int i = 0; i < orderedTasks.Count; i++)
                            {
                                var task = orderedTasks[i];
                                var taskNumber = i + 1;

                                if (task.Section != lastSection && !string.IsNullOrEmpty(task.Section))
                                {
                                    <div class="mt-4 mb-2 px-2">
                                        <MudText Typo="Typo.subtitle2" Class="@(GetThemeClass() == "lightest" ? "text-dark" : "text-white")" Style="font-weight: 800; letter-spacing: 1px; text-transform: uppercase; font-size: 0.7rem; opacity: 0.6;">
                                            @task.Section
                                        </MudText>
                                        <MudDivider Class="mt-1" Style="opacity: 0.1;" />
                                    </div>
                                    lastSection = task.Section;
                                }
                                else if (string.IsNullOrEmpty(task.Section))
                                {
                                    lastSection = "";
                                }

                                <div class="preview-task-card">
                                    <div class="preview-task-header">
                                        <div class="preview-header-content-group">
                                            <div class="preview-task-name-container">
                                                <MudText Typo="Typo.body2" Class="opacity-50 mt-1" Style="min-width: 20px; font-weight: 700;">@taskNumber.</MudText>
                                                <MudCheckBox T="bool" Color="Color.Primary" Dense="true" Class="pa-0" />

                                                <div class="d-flex align-center flex-wrap gap-2">
                                                    @if (task.IsMandatory)
                                                    {
                                                        <span style="color: var(--mud-palette-error); font-weight: bold; font-size: 1.2rem; line-height: 1;">*</span>
                                                    }
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="py-0 px-2" Style="height: 18px; font-size: 0.6rem; font-weight: 700;">@task.Frequency</MudChip>
                                                    <MudText Typo="Typo.body1" Class="@(GetThemeClass() == "lightest" ? "text-dark" : "text-white")" Style="font-weight: 600;">
                                                        @task.TaskName
                                                    </MudText>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrEmpty(task.Description))
                                            {
                                                <div class="preview-description-row">
                                                    <MudText Typo="Typo.body1" Style="opacity: 1;">@task.Description</MudText>
                                                </div>
                                            }
                                        </div>

                                        @if (task.IsPhotoRequired)
                                        {
                                            <MudButton Variant="Variant.Filled"
                                                       StartIcon="@Icons.Material.Filled.PhotoCamera"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       Class="preview-upload-btn"
                                                       Style="border-radius: 8px; font-weight: bold;">
                                                UPLOAD (0/@task.NumberOfPhotos)
                                            </MudButton>
                                        }
                                    </div>

                                    @if (task.IsRemarksRequired)
                                    {
                                        <div class="preview-remarks-container">
                                            <MudTextField T="string"
                                                          Label="Remarks"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Dense="true"
                                                          Placeholder="Enter remarks here..."
                                                          Class="rounded-lg" />
                                        </div>
                                    }
                                </div>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </div>
    }
</div>

@code {
    private bool _showFilters = false;
    private List<ChecklistItem> _tasks = new();
    private List<ChecklistItem> _filteredTasks = new();
    private bool _initialized = false;
    private bool _isPreviewMode = false;

    // Filter variables
    private string _searchTerm = string.Empty;
    private string _categoryFilter = "All";

    private readonly List<string> _categories = new()
    {
        "Opening", "Asset", "Human Resource", "Inventory", "Marketing", "Expenses & Repair", "Closing"
    };

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;
        await LoadData();
        _initialized = true;
    }

    private void OnThemeChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "border-radius: 12px;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? "color: #0072cf !important; background-color: #ffffff !important; border-radius: 12px; font-weight: bold;"
            : "border-radius: 12px; font-weight: bold;";
    }

    private string GetFilterButtonStyle()
    {
        if (ThemeService == null) return "";
        return ThemeService.CurrentTheme == ThemeMode.Lightest
            ? "color: #0072cf; border-color: #0072cf; border-radius: 12px;"
            : "color: #ffffff; border-color: #ffffff; border-radius: 12px; background-color: transparent !important;";
    }

    private string GetStatusTextColor()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "text-dark" : "text-white";
    }

    private string GetTitleStyle()
    {
        return $"color: {(ThemeService.CurrentTheme == ThemeMode.Lightest ? "#0f172a" : "#ffffff")}; font-weight: 800;";
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initial load is already handled in OnInitializedAsync,
            // but we call StateHasChanged to ensure the UI is in sync.
            StateHasChanged();
        }
        return base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Load all tasks
        _tasks = await db.ChecklistItems
            .OrderBy(t => t.SortOrder)
            .AsNoTracking()
            .ToListAsync();

        ApplyFilters();
    }

    // Alias for LoadData to match reference snippet (if called by Dialogs)
    private async Task LoadTasks()
    {
        await LoadData();
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        _filteredTasks = _tasks;

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredTasks = _filteredTasks.Where(t =>
                (t.TaskName?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (t.Description?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }

        if (_categoryFilter != "All")
        {
            _filteredTasks = _filteredTasks.Where(t => t.Category == _categoryFilter).ToList();
        }

        StateHasChanged(); // Used when called from UI events
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _categoryFilter = "All";
        ApplyFilters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(_searchTerm) ||
               _categoryFilter != "All";
    }

    private string GetCategoryClass(string category) => category.ToLower() switch
    {
        "opening" => "category-opening",
        "asset" => "category-asset",
        "human resource" => "category-hr",
        "inventory" => "category-inventory",
        "marketing" => "category-marketing",
        "expenses & repair" => "category-expenses",
        "closing" => "category-closing",
        _ => "category-opening"
    };

    private string GetCategoryIcon(string category) => category.ToLower() switch
    {
        "opening" => Icons.Material.Filled.DoorFront,
        "asset" => Icons.Material.Filled.Devices,
        "human resource" => Icons.Material.Filled.Groups,
        "inventory" => Icons.Material.Filled.Inventory,
        "marketing" => Icons.Material.Filled.Campaign,
        "expenses & repair" => Icons.Material.Filled.Build,
        "closing" => Icons.Material.Filled.DoorBack,
        _ => Icons.Material.Filled.ListAlt
    };

    private async Task OpenAddTaskDialog()
    {
        var parameters = new DialogParameters { { "CategoryOptions", _categories } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddEditTask>("Add New Task", parameters, options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            await LoadTasks();
        }
    }

    private async Task EditTask(ChecklistItem task)
    {
        var parameters = new DialogParameters
        {
            { "TaskToEdit", task },
            { "CategoryOptions", _categories }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddEditTask>("Edit Task", parameters, options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            await LoadTasks();
        }
    }

    private async Task DeleteTask(ChecklistItem task)
    {
        var parameters = new DialogParameters {
            { "ContentText", $"Are you sure you want to delete '{task.TaskName}'?\n\nThis action cannot be undone." },
            { "ButtonText", "Delete" },
            { "Color", Color.Error }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            try
            {
                using var db = await DbFactory.CreateDbContextAsync();
                var taskToDelete = await db.ChecklistItems.FindAsync(task.Id);

                if (taskToDelete != null)
                {
                    db.ChecklistItems.Remove(taskToDelete);
                    await db.SaveChangesAsync();
                    Snackbar.Add("Task deleted successfully!", Severity.Success);
                    await LoadTasks();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting task: {ex.Message}", Severity.Error);
            }
        }
    }

    private int GetItemIndex(ChecklistItem item)
    {
        return _filteredTasks.IndexOf(item) + 1;
    }

    private async Task ItemDropped(MudItemDropInfo<ChecklistItem> dropInfo)
    {
        if (dropInfo.Item == null) return;

        // dropInfo.DropzoneIdentifier is the Category
        var droppedItem = dropInfo.Item;
        var newCategory = dropInfo.DropzoneIdentifier;

        // If moved to a different category, update it
        if (droppedItem.Category != newCategory)
        {
            droppedItem.Category = newCategory;
        }

        // Reorder within the absolute list
        _tasks.Remove(droppedItem);

        // Find the index of the item it was dropped ON or near
        var categoryItems = _tasks.Where(x => x.Category == newCategory).ToList();
        if (dropInfo.IndexInZone >= 0 && dropInfo.IndexInZone < categoryItems.Count)
        {
            var targetItem = categoryItems[dropInfo.IndexInZone];
            var targetIdx = _tasks.IndexOf(targetItem);
            _tasks.Insert(targetIdx, droppedItem);
        }
        else
        {
            // If dropped at the end of the zone, find the last item of that category
            var lastOfCategory = _tasks.LastOrDefault(x => x.Category == newCategory);
            if (lastOfCategory != null)
            {
                var targetIdx = _tasks.IndexOf(lastOfCategory) + 1;
                _tasks.Insert(targetIdx, droppedItem);
            }
            else
            {
                // New category or no items, just add to end
                _tasks.Add(droppedItem);
            }
        }

        // Maintain global sort order across everything to preserve category groupings
        for (int i = 0; i < _tasks.Count; i++)
        {
            _tasks[i].SortOrder = i;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        db.ChecklistItems.UpdateRange(_tasks);
        await db.SaveChangesAsync();

        Snackbar.Add("Order updated!", Severity.Success);
        ApplyFilters();
    }
}