@page "/admin/checklist"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Components.Pages.Dialogs
@using System.Text.Json
@inject IDialogService DialogService
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Activity Planner Management</PageTitle>

<style>
    .checklist-container {
        padding: 1rem 1.25rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 16px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding: 0;
    }

    .button-group {
        display: flex;
        gap: 12px;
        padding: 0;
        margin: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* BUTTONS */
    .modern-button {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
    }

    .clear-filters-button.mud-button-root {
        font-weight: 700 !important;
    }

    .clear-filters-button .mud-button-label {
        white-space: nowrap !important;
    }

    /* CATEGORY CHIPS */
    .category-chip {
        font-weight: 800 !important;
        border-radius: 12px !important;
        background-color: #0072cf !important; /* Solid Admin Blue */
        color: #ffffff !important;
        border: none !important;
        text-transform: uppercase !important;
        letter-spacing: 0.5px !important;
    }

    .lightest .category-chip {
        background-color: #0072cf !important;
        color: #ffffff !important;
    }

    .button-group .modern-button.light {
        background-color: #ffffff !important;
        color: #0072cf !important;
    }

    /* THEME SPECIFIC TEXT & ICON COLORS */

    /* Light & Dark (Blue/Dark backgrounds) */
    .light .page-title, .dark .page-title,
    .light .category-block .mud-typography, .dark .category-block .mud-typography,
    .light .category-icon,
    .light .preview-task-card .mud-typography, .dark .preview-task-card .mud-typography,
    .light .desktop-only .mud-typography, .dark .desktop-only .mud-typography {
        color: #ffffff !important;
    }

    .light .task-name, .dark .task-name,
    .light .task-number, .dark .task-number {
        color: rgb(253, 212, 92) !important;
    }

    .lightest .category-icon, .dark .category-icon {
        color: #0072cf !important;
    }

    /* Lightest (Light background) */
    .lightest .page-title,
    .lightest .category-block .mud-typography,
    .lightest .task-name,
    .lightest .task-number,
    .lightest .task-description {
        color: #0f172a !important;
    }

    /* Action Icon Buttons */
    .light .mud-icon-button, .dark .mud-icon-button {
        color: #ffffff !important;
    }

    .lightest .mud-icon-button {
        color: #0072cf !important;
    }

    /* Solid Action Buttons across all themes */
    .action-icon-circle.mud-button-root {
        width: 32px !important;
        height: 32px !important;
        min-width: unset !important;
        border-radius: 50% !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        color: #ffffff !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15) !important;
    }

        .action-icon-circle.mud-button-root:hover {
            transform: scale(1.15) !important;
            filter: brightness(1.1) !important;
        }

    .action-pill-btn.mud-button-root {
        border-radius: 20px !important;
        padding: 4px 14px !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        text-transform: none !important;
        font-size: 0.75rem !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15) !important;
    }

        .action-pill-btn.mud-button-root:hover {
            transform: translateY(-2px) !important;
            filter: brightness(1.1) !important;
        }

    /* Specific Action Button Colors (Consistent in all themes) */
    .action-btn-info {
        background-color: #0072cf !important;
    }

    .action-btn-error {
        background-color: #ef4444 !important;
    }

    .action-btn-default {
        background-color: #94a3b8 !important;
    }

    /* DRAG AND DROP */
    .drop-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .category-drop-zone {
        min-height: 50px;
        padding: 8px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px dashed rgba(255, 255, 255, 0.1);
        transition: background-color 0.2s ease;
    }

    .lightest .category-drop-zone {
        background: rgba(0, 114, 207, 0.02);
        border: 1px dashed rgba(0, 114, 207, 0.1);
    }

    .category-drop-zone:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .lightest .category-drop-zone:hover {
        background: rgba(0, 114, 207, 0.05);
    }

    .task-drop-item {
        margin-bottom: 8px;
        user-select: none;
    }

    .task-row-card {
        display: grid;
        grid-template-columns: 40px 40px 1fr 150px 100px 80px 80px 100px;
        align-items: center;
        padding: 8px 16px;
        gap: 12px;
        border-radius: 12px;
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: grab;
    }

        .task-row-card:active {
            cursor: grabbing;
        }

        .task-row-card:hover {
            transform: translateX(4px);
            background: rgba(255, 255, 255, 0.05) !important;
        }

    .lightest .task-row-card:hover {
        background: rgba(0, 114, 207, 0.05) !important;
    }

    .task-number-container {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 2px;
    }

    .task-number {
        font-size: 0.8rem;
    }

    @@media (max-width: 960px) {
        .task-number {
            font-size: 0.7rem;
            opacity: 0.6;
        }
    }

    .task-info {
        display: flex;
        flex-direction: column;
        min-width: 0; /* Critical: prevents 1fr column from overflowing grid */
        overflow: hidden;
    }

    .task-name {
        font-weight: 700;
        color: rgb(253, 212, 92);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    .lightest .task-name {
        color: #0f172a;
    }

    .task-number {
        font-weight: 700;
        opacity: 0.8;
        color: rgb(253, 212, 92);
    }

    .lightest .task-number {
        color: #0f172a;
        opacity: 0.8;
    }

    .task-description {
        font-size: 0.85rem;
        opacity: 0.7;
    }

    
    /* FILTER SECTION */
    .filter-section {
        padding: 16px;
        margin-bottom: 24px;
    }

        .filter-section .mud-input-root {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
        }

    .filter-toggle-button {
        display: none;
    }

    /* PREVIEW MODE */
    .preview-mode {
        max-width: 900px;
        margin: 0 auto;
        padding-bottom: 40px;
    }

    .modern-expansion-panels {
        background: transparent !important;
        box-shadow: none !important;
    }

    .modern-expansion-panel {
        background: rgba(255, 255, 255, 0.1) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 16px !important;
        margin-bottom: 16px !important;
        backdrop-filter: blur(10px);
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
    }

        .modern-expansion-panel::before {
            display: none !important;
        }

        .modern-expansion-panel.active {
            border-color: #0072cf !important;
            box-shadow: 0 10px 30px rgba(0, 114, 207, 0.15) !important;
        }

        .modern-expansion-panel.locked {
            opacity: 0.6;
            filter: grayscale(0.5);
            pointer-events: none;
        }

    .lightest .modern-expansion-panel {
        background: rgba(255, 255, 255, 0.45) !important;
        border: 1px solid rgba(0, 114, 207, 0.2) !important;
    }

        .lightest .modern-expansion-panel.active {
            border-color: #0072cf !important;
        }

    .preview-task-card {
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
        transition: all 0.2s ease;
    }

    .lightest .preview-task-card {
        background: rgba(0, 114, 207, 0.03) !important;
        border: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .preview-task-header {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        width: 100%;
    }

    .preview-header-content-group {
        display: flex;
        align-items: flex-start;
        flex-wrap: nowrap;
        gap: 8px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .preview-task-name-container {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding-top: 2px;
        flex: 0 0 auto;
    }

    .preview-description-row {
        display: flex;
        align-items: flex-start;
        gap: 4px;
        flex: 0 1 auto;
        min-width: 0;
    }

    .preview-upload-btn {
        border-radius: 8px !important;
        text-transform: none !important;
        font-weight: 600 !important;
        font-size: 0.75rem !important;
        flex: 0 0 auto;
        margin-left: auto;
    }

    .preview-remarks-container {
        margin-top: 8px;
        padding-left: 32px;
        width: 100%;
        max-width: 600px;
    }

    .manpower-input-container {
        margin-top: 8px;
        padding-left: 32px;
        width: 100%;
        max-width: 400px;
    }

    .manpower-input {
        max-width: 150px;
    }

    /* PHOTO GRID */
    .photo-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
        padding-left: 32px;
    }

    .photo-thumb-wrapper {
        position: relative;
        width: 56px;
        height: 56px;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.15);
        background: rgba(0,0,0,0.1);
    }

        .photo-thumb-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .photo-remove-btn {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: rgba(0,0,0,0.65);
        color: #fff;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        line-height: 1;
        padding: 0;
        transition: background 0.2s;
    }

        .photo-remove-btn:hover {
            background: rgba(220, 38, 38, 0.9);
        }

    .lightest .photo-thumb-wrapper {
        border: 1px solid rgba(0, 114, 207, 0.2);
        background: rgba(0,0,0,0.05);
    }

    .info-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .frequency-filter-row {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 12px;
        overflow-x: auto;
        padding: 8px 4px;
        flex-wrap: nowrap;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
    }

    /* RESPONSIVE */
    @@media (max-width: 600px) {
        .sub-title {
            font-size: 0.75rem !important;
            margin: 0px !important;
        }

        .info-row {
            flex-direction: column;
            gap: 0px !important;
            padding: 0px !important;
        }

        .preview-task-header {
            flex-wrap: wrap;
        }

        .preview-header-content-group {
            width: 100%;
            flex-wrap: wrap;
        }

        .preview-task-name-container {
            width: 100%;
        }

        .preview-description-row {
            width: 100%;
            padding-left: 0;
            margin-top: 8px;
            flex: 0 0 100%;
        }

        .preview-upload-btn {
            margin-left: 0 !important;
            margin-top: 12px;
            width: 100% !important;
        }

        .preview-remarks-container,
        .manpower-input-container {
            padding-left: 0;
            margin-top: 12px;
            width: 100%;
        }

        .photo-grid {
            padding-left: 0;
        }
    }

    @@media (max-width: 960px) {
        .filter-toggle-button {
            display: inline-flex !important;
        }

        .filter-section .mud-grid {
            display: none;
        }

        .filter-section.filters-visible .mud-grid {
            display: flex;
        }

        .page-header-row {
            flex-direction: column;
            gap: 16px;
            align-items: stretch;
            text-align: center;
            padding: 0;
            margin-bottom: 20px;
        }

        .page-title {
            display: none;
        }

        .button-group {
            flex-wrap: wrap;
            width: 100%;
            gap: 8px;
        }

            .button-group .modern-button {
                font-size: 0.60rem !important;
                padding: 6px 0px !important;
            }
                /* First button (Preview) takes full width */
                .button-group .modern-button:first-child {
                    flex: 0 0 100%;
                }
                /* Other buttons split the second row */
                .button-group .modern-button:not(:first-child) {
                    flex: 1 1 calc(50% - 4px);
                }

        .task-row-card {
            grid-template-columns: 24px 1fr auto;
            grid-template-rows: auto;
            gap: 12px;
            padding: 16px;
        }

        .task-info {
            grid-column: 2 / 3;
        }

        .task-actions {
            grid-column: 3 / 4;
            grid-row: 1;
            display: flex;
            align-items: center;
        }

        .task-details-mobile {
            display: none !important;
        }

        .desktop-only {
            display: none !important;
        }

        /* Allow task name to wrap on mobile — long words break instead of being clipped */
        .task-name {
            white-space: normal !important;
            overflow: visible !important;
            text-overflow: clip !important;
            word-break: break-word !important;
            overflow-wrap: anywhere !important;
        }
    }

    @@media (min-width: 961px) {
        .mobile-only {
            display: none !important;
        }
    }

    @@media (max-width: 960px) {
        .clear-filters-button.mud-button-root {
            height: 24px !important;
            font-size: 0.6rem !important;
            padding: 0 4px !important;
            min-width: unset !important;
        }

        .clear-filters-button .mud-button-label {
            white-space: nowrap !important;
            line-height: 1 !important;
            font-size: 0.6rem !important;
        }

        .clear-filters-button .mud-button-icon-start {
            font-size: 0.5rem !important;
            margin-inline-end: 2px !important;
            margin-inline-start: -3px !important;
        }

        .filter-info-text {
            font-size: 0.75rem !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            min-width: 0 !important;
            flex: 1 1 0 !important;
        }

            .filters-summary-row > div:first-child {
                min-width: 0 !important;
                flex: 1 1 0 !important;
                overflow: hidden !important;
            }
    }

    @@media (max-width: 375px) {
        .clear-filters-button.mud-button-root {
            height: 20px !important;
            font-size: 0.5rem !important;
            padding: 0 3px !important;
            min-width: unset !important;
        }

        .clear-filters-button .mud-button-label {
            white-space: nowrap !important;
            line-height: 1 !important;
            font-size: 0.5rem !important;
        }

        .clear-filters-button .mud-button-icon-start {
            font-size: 0.4rem !important;
            margin-inline-end: 1px !important;
            margin-inline-start: -3px !important;
        }

        .mud-main-content {
            padding-bottom: 0px !important;
            padding-left: 8px !important;
            padding-right: 8px !important;
        }

        .filter-info-text {
            font-size: 0.65rem !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            min-width: 0 !important;
            flex: 1 1 0 !important;
        }

        .button-group {
            flex-wrap: wrap;
            width: 100%;
            gap: 8px;
        }

            .button-group .modern-button {
                padding: 6px 0px !important;
            }
                /* First button (Preview) takes full width */
                .button-group .modern-button:first-child {
                    font-size: 0.60rem !important;
                    flex: 0 0 100%;
                }
                /* Other buttons split the second row */
                .button-group .modern-button:not(:first-child) {
                    font-size: 0.50rem !important;
                    flex: 1 1 calc(50% - 4px);
                }

        .frequency-filter-row {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 12px;
            overflow-x: auto;
            padding: 0px 0px !important;
            flex-wrap: nowrap;
            white-space: nowrap;
            -webkit-overflow-scrolling: touch;
        }
    }

    @@media (max-width: 480px) {
        .frequency-filter-row {
            justify-content: flex-start;
            padding-left: 12px;
            padding-right: 12px;
        }
    }
    .filters-summary-row {
        align-items: center;
    }

    .action-buttons-container {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }
</style>

<div class="checklist-container @GetThemeClass()">
    <div class="page-header-row">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Activity Planner Management</MudText>

        <div class="button-group">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Preview"
                       OnClick="@(() => _isPreviewMode = !_isPreviewMode)"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                @(_isPreviewMode ? "BACK TO EDITOR" : "PREVIEW")
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Category"
                       OnClick="OpenManageCategoriesDialog"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                MANAGE CATEGORIES
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddTaskDialog"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                ADD TASK
            </MudButton>
        </div>
    </div>

    @if (_initialized && !_isPreviewMode)
    {
        <!-- Filter Section -->
        <MudPaper Class="@($"glass-panel filter-section {GetThemeClass()} {(_showFilters ? "filters-visible" : "")}")"
                  Elevation="0">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                       FullWidth="true"
                       OnClick="@(() => _showFilters = !_showFilters)"
                       Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                       Style="@GetFilterButtonStyle()">
                @(_showFilters ? "Hide Filters" : "Show Filters")
            </MudButton>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="8" md="8">
                    <MudTextField T="string"
                                  @bind-Value="_searchTerm"
                                  @bind-Value:after="ApplyFilters"
                                  Label="Search Tasks"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Placeholder="Search task name or description..."
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Margin="Margin.Dense"
                                  Class="rounded-lg" />
                </MudItem>
                <MudItem xs="12" sm="4" md="2">
                    <MudSelect T="string"
                               @bind-Value="_categoryFilter"
                               @bind-Value:after="ApplyFilters"
                               Label="Category"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="rounded-lg">
                        <MudSelectItem Value="@("All")">All Categories</MudSelectItem>
                        @foreach (var cat in _categories)
                        {
                            <MudSelectItem Value="@cat.Id.ToString()">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4" md="2">
                    <MudSelect T="string"
                               @bind-Value="_frequencyFilter"
                               @bind-Value:after="ApplyFilters"
                               Label="Frequency"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="rounded-lg">
                        <MudSelectItem Value="@("All")">All Frequencies</MudSelectItem>
                        <MudSelectItem Value="@("Daily")">Daily</MudSelectItem>
                        <MudSelectItem Value="@("Weekly")">Weekly</MudSelectItem>
                        <MudSelectItem Value="@("Monthly")">Monthly</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-space-between align-center px-1 filters-summary-row">
                <MudText Typo="Typo.body2" Class="@($"{GetStatusTextColor()} font-weight-bold filter-info-text")" Style="opacity: 0.8;">
                    Showing @_filteredTasks.Count of @_tasks.Count tasks
                </MudText>
                <div class="action-buttons-container">
                    @if (HasActiveFilters())
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="ClearFilters"
                                   Class="clear-filters-button">
                            Clear Filters
                        </MudButton>
                    }
                </div>
            </div>
        </MudPaper>

        <!-- Custom JS-based Drag and Drop List -->
        <div class="drop-container">
            @foreach (var category in _categories)
            {
                @if (_filteredTasks.Any(t => t.CategoryId == category.Id) || _categoryFilter == "All" || _categoryFilter == category.Id.ToString())
                {
                    <div class="category-block">
                        <div class="d-flex align-center mb-2 px-2">
                            <MudIcon Icon="@category.Icon" Class="mr-2 category-icon" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 800; letter-spacing: 1px; text-transform: uppercase;">@category.Name</MudText>
                            <MudSpacer />
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="@($"category-chip {category.ColorClass}")">
                                @_filteredTasks.Count(t => t.CategoryId == category.Id) Tasks
                            </MudChip>
                        </div>

                        <div class="category-drop-zone" data-category-id="@category.Id">
                            @{
                                var itemsInCategory = _filteredTasks
                                .Where(t => t.CategoryId == category.Id)
                                .OrderBy(t => t.SortOrder)
                                .ToList();
                            }
                            @foreach (var context in itemsInCategory)
                            {
                                <div class="task-drop-item" draggable="true" data-id="@context.Id" data-section="@(context.Section ?? "")" @key="context.Id">
                                    <MudPaper Class="@($"glass-panel task-row-card {GetThemeClass()}")" Elevation="0">
                                        <div class="d-flex align-center desktop-only" style="cursor: grab;">
                                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Style="opacity: 0.5;" />
                                        </div>

                                        <div class="task-number-container">
                                            <MudText Typo="Typo.body2" Class="task-number">
                                                @(context.SortOrder + 1)
                                            </MudText>
                                        </div>

                                        <div class="task-info">
                                            @if (!string.IsNullOrEmpty(context.Section))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Primary" Class="desktop-only" Style="font-weight: 600; line-height: 1;">@context.Section</MudText>
                                            }
                                            <MudText Typo="Typo.body1" Class="task-name">@FormatLongWords(context.TaskName)</MudText>
                                            @if (!string.IsNullOrEmpty(context.Description))
                                            {
                                                <MudText Typo="Typo.caption" Class="task-description">@FormatLongWords(context.Description)</MudText>
                                            }
                                        </div>

                                        <div class="desktop-only">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="@($"category-chip {context.Category?.ColorClass}")">
                                                @context.Category?.Name
                                            </MudChip>
                                        </div>

                                        <div class="desktop-only text-center">
                                            <MudText Typo="Typo.body2">@context.Frequency</MudText>
                                        </div>

                                        <div class="desktop-only text-center">
                                            <MudIcon Icon="@(context.IsMandatory? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)"
                                                     Color="@(context.IsMandatory ? Color.Success : Color.Default)"
                                                     Size="Size.Small" />
                                        </div>

                                        <div class="desktop-only text-center">
                                            <MudText Typo="Typo.caption">
                                                @(context.IsPhotoRequired ? (context.NumberOfPhotos == 0 ? "Multiple" : $"{context.NumberOfPhotos} Photos") : "No")
                                            </MudText>
                                        </div>

                                        <div class="task-actions d-flex justify-center gap-1">
                                            <MudTooltip Text="Edit Task">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                               Class="action-icon-circle action-btn-info"
                                                               Size="Size.Small"
                                                               OnClick="@(() => EditTask(context))" />
                                            </MudTooltip>
                                            <MudTooltip Text="Delete Task">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Class="action-icon-circle action-btn-error"
                                                               Size="Size.Small"
                                                               OnClick="@(() => DeleteTask(context))" />
                                            </MudTooltip>
                                        </div>

                                        <div class="mobile-only task-details-mobile">
                                            <span>@context.Frequency</span>
                                            <span class="d-flex align-center gap-1">
                                                <MudIcon Icon="@(context.IsMandatory? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)" Size="Size.Small" Color="@(context.IsMandatory? Color.Success: Color.Default)" /> Mandatory
                                            </span>
                                            @if (context.IsPhotoRequired)
                                            {
                                                <span class="d-flex align-center gap-1">
                                                    <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Small" /> @(context.NumberOfPhotos == 0 ? "∞" : context.NumberOfPhotos)
                                                </span>
                                            }
                                        </div>
                                    </MudPaper>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
    else if (!_initialized)
    {
        <div class="d-flex flex-column align-center justify-center py-10" style="opacity: 0.5;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-3" />
            <MudText Typo="Typo.h6">Loading Tasks...</MudText>
        </div>
    }
    else if (_isPreviewMode)
    {
        <!-- Preview Mode -->
        <div class="preview-mode">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-0 mt-0 pt-0 pb-0" Style="@GetTitleStyle()">Planner Preview</MudText>

            <!-- INFO ROW (Display only) -->
            <div class="info-row mb-2">
                <MudText Typo="Typo.subtitle1" Class="@($"sub-title {GetThemeClass()}")" Style="opacity: 0.7; text-align: center;">
                    Store Name • @(DateTime.Now.ToString("MMMM dd, yyyy"))
                </MudText>
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small" Class="">
                    0/@(_tasks.Count) TASKS
                </MudChip>
            </div>

            <!-- FREQUENCY FILTER (Display only) -->
            <div class="frequency-filter-row">
                <MudChip T="string" Variant="Variant.Filled" Color="Color.Info" Size="Size.Small">ALL</MudChip>
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small">DAILY</MudChip>
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small">WEEKLY</MudChip>
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small">MONTHLY</MudChip>
            </div>
            
            <div class="d-flex justify-end mb-4 px-2">
                <MudSwitch T="bool" @bind-Value="_previewAutoCompletedState" Color="Color.Success" Label="Preview Auto-Completed State (Weekly/Monthly)" />
            </div>

            <MudExpansionPanels MultiExpansion="true" Class="modern-expansion-panels">
                @foreach (var category in _categories.OrderBy(c => c.SortOrder))
                {
                    var itemsInCategory = _tasks.Where(t => t.CategoryId == category.Id).OrderBy(t => t.SortOrder).ToList();
                    if (!itemsInCategory.Any()) continue;
                    
                    var isLocked = false;

                    <MudExpansionPanel Class="@($"modern-expansion-panel {(isLocked ? "locked" : "active")}")"
                                       MaxHeight="600"
                                       IsInitiallyExpanded="@(!isLocked)">
                        <TitleContent>
                            <div class="d-flex align-center py-2">
                                <MudIcon Icon="@category.Icon" Class="mr-3 category-icon" Color="@(isLocked? Color.Default: Color.Primary)" />
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.h6" Style="font-weight: 700;">@category.Name</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">0/@itemsInCategory.Count Completed</MudText>
                                </div>
                                <MudSpacer />
                                @if (isLocked)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="opacity: 0.5;" Class="mr-2" />
                                }
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="@($"category-chip {category.ColorClass}")">
                                    @itemsInCategory.Count() Tasks
                                </MudChip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            @{
                                var lastSection = "";
                                @for (int i = 0; i < itemsInCategory.Count; i++)
                                {
                                    var task = itemsInCategory[i];
                                    var taskNumber = i + 1;

                                    if (task.Section != lastSection && !string.IsNullOrEmpty(task.Section))
                                    {
                                        <div class="mt-4 mb-2 px-2">
                                            <MudText Typo="Typo.subtitle2" Class="@(GetThemeClass() == "lightest" ? "text-dark" : "text-white")" Style="font-weight: 800; letter-spacing: 1px; text-transform: uppercase; font-size: 0.7rem; opacity: 0.6;">
                                                @task.Section
                                            </MudText>
                                            <MudDivider Class="mt-1" Style="opacity: 0.1;" />
                                        </div>
                                        lastSection = task.Section;
                                    }
                                    else if (string.IsNullOrEmpty(task.Section))
                                    {
                                        lastSection = "";
                                    }

                                    <div class="preview-task-card">
                                        <div class="preview-task-header">
                                            <div class="preview-header-content-group">
                                                <div class="preview-task-name-container">
                                                    <MudText Typo="Typo.body2" Class="opacity-50 mt-1" Style="min-width: 20px; font-weight: 700;">@taskNumber.</MudText>
                                                    <MudCheckBox T="bool" Color="Color.Primary" Dense="true" Class="pa-0" Disabled="true" />

                                                    <div class="d-flex align-center flex-wrap gap-2">
                                                        @if (task.IsMandatory)
                                                        {
                                                            <span style="color: var(--mud-palette-error); font-weight: bold; font-size: 1.2rem; line-height: 1;">*</span>
                                                        }
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="py-0 px-2" Style="height: 18px; font-size: 0.6rem; font-weight: 700;">@task.Frequency</MudChip>
                                                        <MudText Typo="Typo.body1" Class="@(GetThemeClass() == "lightest" ? "text-dark" : "text-white")" Style="font-weight: 600;">
                                                            @FormatLongWords(task.TaskName)
                                                        </MudText>
                                                    </div>
                                                </div>

                                                @if (!string.IsNullOrEmpty(task.Description))
                                                {
                                                    <div class="preview-description-row">
                                                        <MudText Typo="Typo.body2" Style="opacity: 0.7;">@FormatLongWords(task.Description)</MudText>
                                                    </div>
                                                }
                                            </div>

                                                @if (task.IsPhotoRequired)
                                                {
                                                    var isAutoCompletedMock = _previewAutoCompletedState && (task.Frequency == "Weekly" || task.Frequency == "Monthly");
                                                    if (isAutoCompletedMock)
                                                    {
                                                        <div class="d-flex align-center gap-1">
                                                            <MudButton Variant="Variant.Filled"
                                                                       Size="Size.Small"
                                                                       Color="Color.Success"
                                                                       Disabled="true"
                                                                       Style="border-radius: 8px; font-weight: bold; opacity: 0.8;">
                                                                Available @DateTime.Today.AddDays(7).ToString("MMM d")
                                                            </MudButton>
                                                            <MudTooltip Text="Force manual completion">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                                                                               Variant="Variant.Filled"
                                                                               Color="Color.Error" 
                                                                               Size="Size.Small" 
                                                                               Disabled="true" />
                                                            </MudTooltip>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <MudButton Variant="Variant.Filled"
                                                                   StartIcon="@Icons.Material.Filled.PhotoCamera"
                                                                   Size="Size.Small"
                                                                   Color="Color.Primary"
                                                                   Class="preview-upload-btn"
                                                                   Style="border-radius: 8px; font-weight: bold;"
                                                                   Disabled="true">
                                                            CAPTURE (0/@(task.NumberOfPhotos == 0 ? "∞" : task.NumberOfPhotos))
                                                        </MudButton>
                                                    }
                                                }
                                        </div>

                                        @if (task.TaskType == "Manpower")
                                        {
                                            <div class="manpower-input-container">
                                                <div class="d-flex flex-column gap-3">
                                                    @{
                                                        var positions = GetManpowerPositions(task);
                                                        if (positions.Any())
                                                        {
                                                            <div class="mb-1">
                                                                <MudText Typo="Typo.body2" Style="font-weight: 700; opacity: 0.9;">Manpower Breakdown:</MudText>
                                                            </div>
                                                            @for (int j = 0; j < positions.Count; j++)
                                                            {
                                                                var pos = positions[j];
                                                                char label = (char)('a' + j);
                                                                <div class="d-flex align-center gap-4 flex-wrap ml-2 mb-1">
                                                                    <div style="min-width: 140px; flex-grow: 1;">
                                                                        <MudText Typo="Typo.caption" Style="font-weight: 600; opacity: 0.8;">
                                                                            @label. @pos.Name
                                                                        </MudText>
                                                                    </div>
                                                                    <div class="d-flex align-center gap-2">
                                                                        <div style="width: 80px;">
                                                                            <MudNumericField T="int?"
                                                                                             Label="Expected"
                                                                                             Value="@pos.Count"
                                                                                             Variant="Variant.Outlined"
                                                                                             Margin="Margin.Dense"
                                                                                             HideSpinButtons="true"
                                                                                             Class="manpower-input center-input"
                                                                                             Disabled="true" />
                                                                        </div>
                                                                        <div style="width: 80px;">
                                                                            <MudNumericField T="int?"
                                                                                             Label="Actual"
                                                                                             Variant="Variant.Outlined"
                                                                                             Margin="Margin.Dense"
                                                                                             HideSpinButtons="true"
                                                                                             Class="manpower-input center-input"
                                                                                             Disabled="true" />
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                            <div class="mt-2 pt-2 d-flex align-center gap-6" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                                                <MudText Typo="Typo.caption" Style="font-weight: 700;">TOTAL EXPECTED: <b style="color: var(--mud-palette-primary);">@task.QuantityExpected</b></MudText>
                                                                <MudText Typo="Typo.caption" Style="font-weight: 700;">TOTAL ACTUAL: <b style="color: var(--mud-palette-success);">@(_previewAutoCompletedState && (task.Frequency == "Weekly" || task.Frequency == "Monthly") ? task.QuantityExpected : 0)</b></MudText>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex align-center gap-4">
                                                                <MudText Typo="Typo.body2">Expected: <b>@task.QuantityExpected</b></MudText>
                                                                <div style="width: 100px;">
                                                                    <MudNumericField T="int?"
                                                                                     Label="Actual"
                                                                                     Variant="Variant.Outlined"
                                                                                     Margin="Margin.Dense"
                                                                                     HideSpinButtons="true"
                                                                                     Class="manpower-input center-input"
                                                                                     Disabled="true" />
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (task.IsRemarksRequired)
                                        {
                                            <div class="preview-remarks-container">
                                                <MudTextField T="string"
                                                              Label="Remarks"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Dense="true"
                                                              Placeholder="Enter remarks here..."
                                                              Class="rounded-lg"
                                                              Disabled="true" />
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </div>
    }
</div>

@code {
    // List variables
    private List<ChecklistItem> _tasks = new();
    private List<ChecklistItem> _filteredTasks = new();
    private List<Category> _categories = new();

    // UI state
    private bool _showFilters = false;
    private bool _initialized = false;
    private bool _isPreviewMode = false;
    private bool _previewAutoCompletedState = false;

    // JS Interop
    @inject IJSRuntime JS
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<Checklist>? _objRef;

    // Filter variables
    private string _searchTerm = string.Empty;
    private string _categoryFilter = "All";
    private string _frequencyFilter = "All";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await UserState.InitializeAsync();
            if (UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo(UserState.LastValidPage ?? UserState.GetDashboardRoute(), forceLoad: true);
                return;
            }
            await UserState.SetLastValidPage(NavigationManager.Uri);
            await LoadData();
            _initialized = true;

            _objRef = DotNetObjectReference.Create(this);
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/checklist-drag.js");
            await _jsModule.InvokeVoidAsync("initializeDragAndDrop", _objRef);

            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private void OnThemeChanged()
    {
        StateHasChanged();
    }

    private List<ManpowerPosition> GetManpowerPositions(ChecklistItem task)
    {
        if (task.TaskType != "Manpower" || string.IsNullOrWhiteSpace(task.Position))
            return new List<ManpowerPosition>();

        try
        {
            return JsonSerializer.Deserialize<List<ManpowerPosition>>(task.Position) ?? new List<ManpowerPosition>();
        }
        catch { return new List<ManpowerPosition>(); }
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        _objRef?.Dispose();
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string FormatLongWords(string? text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        var words = text.Split(' ');
        for (int i = 0; i < words.Length; i++)
        {
            var word = words[i];
            if (word.Length > 12)
            {
                var sb = new System.Text.StringBuilder();
                for (int j = 0; j < word.Length; j++)
                {
                    sb.Append(word[j]);
                    if ((j + 1) % 10 == 0 && j < word.Length - 1)
                    {
                        sb.Append("\u200B");
                    }
                }
                words[i] = sb.ToString();
            }
        }
        return string.Join(" ", words);
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "border-radius: 12px;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? "color: #0072cf !important; background-color: #ffffff !important; border-radius: 12px; font-weight: bold;"
            : "border-radius: 12px; font-weight: bold;";
    }

    private string GetFilterButtonStyle()
    {
        if (ThemeService == null) return "";
        return ThemeService.CurrentTheme == ThemeMode.Lightest
            ? "color: #0072cf; border-color: #0072cf; border-radius: 12px;"
            : "color: #ffffff; border-color: #ffffff; border-radius: 12px; background-color: transparent !important;";
    }

    private string GetStatusTextColor()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "text-dark" : "text-white";
    }

    private string GetTitleStyle()
    {
        return $"color: {(ThemeService.CurrentTheme == ThemeMode.Lightest ? "#0f172a" : "#ffffff")}; font-weight: 800;";
    }

    [JSInvokable]
    public async Task UpdateOrderFromJS(int[] sortedIds)
    {
        if (sortedIds == null || sortedIds.Length == 0) return;

        // Apply new order to memory
        // We only worry about the tasks involved in the specific category update
        var affectedTasks = _tasks.Where(t => sortedIds.Contains(t.Id)).ToList();

        foreach (var task in affectedTasks)
        {
            int newIndex = Array.IndexOf(sortedIds, task.Id);
            if (newIndex != -1)
            {
                task.SortOrder = newIndex;
            }
        }

        // Refresh filter view to match
        ApplyFilters();

        // Save to DB
        using var db = await DbFactory.CreateDbContextAsync();
        foreach (var id in sortedIds)
        {
            var dbTask = await db.ChecklistItems.FindAsync(id);
            if (dbTask != null)
            {
                int newIndex = Array.IndexOf(sortedIds, id);
                dbTask.SortOrder = newIndex;
            }
        }
        await db.SaveChangesAsync();
        Snackbar.Add("Order updated successfully!", Severity.Success);
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Load Categories
        _categories = await db.Categories
            .OrderBy(c => c.SortOrder)
            .AsNoTracking()
            .ToListAsync();

        // Load all tasks
        _tasks = await db.ChecklistItems
            .Where(t => !t.IsDeleted)
            .Include(t => t.Category)
            .OrderBy(t => t.SortOrder)
            .AsNoTracking()
            .ToListAsync();

        ApplyFilters();
    }

    // Alias for LoadData to match reference snippet (if called by Dialogs)
    private async Task LoadTasks()
    {
        await LoadData();
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyFilters()
    {
        var query = _tasks.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            query = query.Where(t =>
                (t.TaskName?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (t.Description?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            );
        }

        if (_categoryFilter != "All")
        {
            query = query.Where(t => t.CategoryId.ToString() == _categoryFilter);
        }

        if (_frequencyFilter != "All")
        {
            query = query.Where(t => t.Frequency == _frequencyFilter);
        }

        // Always create a new list reference to trigger MudDropContainer refresh
        _filteredTasks = query.OrderBy(t => t.SortOrder).ToList();

        StateHasChanged();
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _categoryFilter = "All";
        _frequencyFilter = "All";
        ApplyFilters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(_searchTerm) ||
               _categoryFilter != "All" ||
               _frequencyFilter != "All";
    }

    private string GetCategoryClass(Category category) => category.ColorClass;

    private string GetCategoryIcon(Category category) => category.Icon;

    private async Task OpenManageCategoriesDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ManageCategoriesDialog>("Manage Categories", options);
        var result = await dialog.Result;

        await LoadData();
        StateHasChanged();
    }

    private async Task OpenAddTaskDialog()
    {
        var parameters = new DialogParameters
        {
            { "OnTaskSaved", EventCallback.Factory.Create(this, LoadTasks) }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddEditTask>("Add New Task", parameters, options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            await LoadTasks();
        }
    }

    private async Task EditTask(ChecklistItem task)
    {
        var parameters = new DialogParameters
        {
            { "TaskToEdit", task },
            { "OnTaskSaved", EventCallback.Factory.Create(this, LoadTasks) }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddEditTask>("Edit Task", parameters, options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            await LoadTasks();
        }
    }

    private async Task DeleteTask(ChecklistItem task)
    {
        var parameters = new DialogParameters {
            { "ContentText", "Are you sure you want to delete this task?\n\nThis action cannot be undone." },
            { "ButtonText", "Delete" },
            { "Color", Color.Error }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            try
            {
                using var db = await DbFactory.CreateDbContextAsync();

                // Get the task and any related data manually
                var taskToDelete = await db.ChecklistItems.FindAsync(task.Id);

                if (taskToDelete != null)
                {
                    // Check if there are any associated TaskProgresses
                    var hasProgresses = await db.TaskProgresses.AnyAsync(tp => tp.ChecklistItemId == task.Id);

                    if (hasProgresses)
                    {
                        // Soft delete
                        taskToDelete.IsDeleted = true;
                        await db.SaveChangesAsync();
                        Snackbar.Add("Task removed from active list (soft deleted due to existing history).", Severity.Success);
                    }
                    else
                    {
                        // Hard delete: no historical references exist, safe to delete completely
                        var photos = await db.TaskPhotos
                            .Where(tp => tp.ChecklistItemId == task.Id)
                            .ToListAsync();

                        if (photos.Any())
                        {
                            db.TaskPhotos.RemoveRange(photos);
                        }

                        db.ChecklistItems.Remove(taskToDelete);
                        await db.SaveChangesAsync();
                        Snackbar.Add("Task deleted successfully!", Severity.Success);
                    }

                    await LoadTasks(); // Refresh list
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting task: {ex}");
                Snackbar.Add($"Error deleting task: {ex.Message}", Severity.Error);
            }
        }
    }
}