@page "/admin/users"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Components.Pages.Dialogs
@inject IDialogService DialogService
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@implements IDisposable

<PageTitle>Users Management</PageTitle>

<style>
    .filters-summary-row {
        align-items: center !important;
    }

    .action-buttons-container {
        display: flex;
        align-items: center;
    }
    .users-container {
        padding: 1rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 16px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding: 0;
    }

    .button-group {
        display: flex;
        gap: 12px;
        padding: 0;
        margin: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* TABLE STYLING */
    .mud-table {
        background: transparent !important;
    }

    .mud-table-head {
        background: rgba(0, 114, 207, 0.1);
    }

        .mud-table-head.lightest {
            background: rgba(0, 114, 207, 0.05);
        }

    .mud-table-cell {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        padding: 12px 16px !important;
    }

    .lightest .mud-table-cell {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .mud-table-row:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .lightest .mud-table-row:hover {
        background-color: rgba(0, 114, 207, 0.05) !important;
    }

    /* Fix for Pager/Footer alignment */
    .mud-table-pagination {
        background-color: transparent !important;
        border-top: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: inherit !important;
    }

    .lightest .mud-table-pagination {
        border-top: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    /* BUTTONS */
    .modern-button {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
    }

    .clear-filters-button.mud-button-root {
        font-weight: 700 !important;
    }

    /* ROLE CHIPS */
    .role-chip {
        font-weight: 800 !important;
        border-radius: 12px !important;
        text-transform: uppercase !important;
        letter-spacing: 0.5px !important;
        font-size: 0.7rem !important;
    }

    /* CUSTOM ROLE COLORS (Grip Style) */
    .chip-admin {
        background-color: #f59e0b !important;
        color: #ffffff !important;
        border: none !important;
    }

    .chip-avp {
        background-color: #8b5cf6 !important;
        color: #ffffff !important;
        border: none !important;
    }

    .chip-areahead {
        background-color: #0ea5e9 !important;
        color: #ffffff !important;
        border: none !important;
    }

    .chip-storehead {
        background-color: #10b981 !important;
        color: #ffffff !important;
        border: none !important;
    }

    /* STATUS CHIPS */
    .status-active {
        background-color: #10b981 !important;
        color: #ffffff !important;
        border: none !important;
    }

    .status-inactive {
        background-color: #ef4444 !important;
        color: #ffffff !important;
        border: none !important;
    }

    .lightest .role-chip {
        /* High opacity for lighter theme */
    }


    .modern-button.lightest {
        /* Primary color for lightest */
    }

    .button-group .modern-button.light {
        background-color: #ffffff !important;
        color: #0072cf !important;
    }

    /* Solid Action Buttons across all themes */
    .action-icon-circle.mud-button-root {
        width: 32px !important;
        height: 32px !important;
        min-width: unset !important;
        border-radius: 50% !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        color: #ffffff !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15) !important;
    }

        .action-icon-circle.mud-button-root:hover {
            transform: scale(1.15) !important;
            filter: brightness(1.1) !important;
        }

    /* Specific Action Button Colors (Consistent in all themes) */
    .action-btn-info {
        background-color: #0072cf !important;
    }

    .action-btn-error {
        background-color: #ef4444 !important;
    }

    .action-btn-default {
        background-color: #94a3b8 !important;
    }

    /* MOBILE CARDS */
    /* Action Icon Buttons white in darker themes */
    .light .mud-icon-button.mud-info-text,
    .dark .mud-icon-button.mud-info-text,
    .light .mud-icon-button.mud-primary-text,
    .dark .mud-icon-button.mud-primary-text {
        color: #ffffff !important;
    }

    /* MOBILE CARDS */
    .mobile-card {
        margin-bottom: 16px;
        overflow: hidden;
    }

    .mobile-card-header {
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .lightest .mobile-card-header {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1);
    }

    .mobile-card-content {
        padding: 16px;
    }

    .mobile-card-actions {
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        gap: 8px;
    }

    .lightest .mobile-card-actions {
        background: rgba(0, 114, 207, 0.03);
    }

    
    /* FILTER SECTION */
    .filter-section {
        padding: 16px;
        margin-bottom: 24px;
    }

        .filter-section .mud-input-root {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
        }

    .filter-toggle-button {
        display: none;
    }

    /* RESPONSIVE */
    @@media (max-width: 960px) {
        .filter-toggle-button {
            display: inline-flex !important;
        }

        .filter-section .mud-grid {
            display: none;
        }

        .filter-section.filters-visible .mud-grid {
            display: flex;
        }

        .desktop-view {
            display: none;
        }

        .mobile-view {
            display: block;
        }

        .page-header-row {
            flex-direction: column;
            gap: 16px;
            align-items: stretch;
            text-align: center;
            padding: 0;
            margin-bottom: 20px;
        }

        .page-title {
            display: none;
        }

        .button-group {
            flex-direction: row !important;
            width: 100%;
            justify-content: space-between;
        }

            .button-group .modern-button {
                flex: 1;
                font-size: 0.70rem !important;
            }
    }

    @@media (min-width: 961px) {
        .desktop-view {
            display: block;
        }

        .mobile-view {
            display: none;
        }
    }

    @@media (max-width: 960px) {
        .clear-filters-button.mud-button-root {
            height: 24px !important;
            font-size: 0.6rem !important;
            padding: 0 4px !important;
            min-width: unset !important;
        }

        .clear-filters-button .mud-button-label {
            white-space: nowrap !important;
            line-height: 1 !important;
            font-size: 0.6rem !important;
        }

        .clear-filters-button .mud-button-icon-start {
            font-size: 0.5rem !important;
            margin-inline-end: 2px !important;
            margin-inline-start: -3px !important;
        }

        .filter-info-text {
            font-size: 0.75rem !important;
            white-space: nowrap !important;
        }
    }

    @@media (max-width: 375px) {
        .clear-filters-button.mud-button-root {
            height: 20px !important;
            font-size: 0.5rem !important;
            padding: 0 3px !important;
            min-width: unset !important;
        }

        .clear-filters-button .mud-button-label {
            white-space: nowrap !important;
            line-height: 1 !important;
            font-size: 0.5rem !important;
        }

        .clear-filters-button .mud-button-icon-start {
            font-size: 0.4rem !important;
            margin-inline-end: 1px !important;
            margin-inline-start: -3px !important;
        }

        .filter-info-text {
            font-size: 0.65rem !important;
            white-space: nowrap !important;
        }

        .mud-main-content {
            padding-bottom: 0px !important;
            padding-left: 0px !important;
            padding-right: 0px !important;
        }
    }
</style>

<div class="users-container">
    <div class="page-header-row">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Users Management</MudText>

        <div class="button-group">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="OpenAddUserDialog"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                ADD USER
            </MudButton>
        </div>
    </div>

    @if (!_initialized)
    {
        <div class="d-flex flex-column align-center justify-center py-10" style="opacity: 0.5;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-3" />
            <MudText Typo="Typo.h6">Loading Users...</MudText>
        </div>
    }
    else
    {
        <!-- Filter Section -->
        <MudPaper Class="@($"glass-panel filter-section {GetThemeClass()} {(_showFilters ? "filters-visible" : "")}")"
                  Elevation="0">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                       FullWidth="true"
                       OnClick="@(() => _showFilters = !_showFilters)"
                       Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                       Style="@GetFilterButtonStyle()">
                @(_showFilters ? "Hide Filters" : "Show Filters")
            </MudButton>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="4" md="8">
                    <MudTextField T="string"
                                  @bind-Value="_searchTerm"
                                  @bind-Value:after="ApplyFilters"
                                  Label="Search Users"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Placeholder="Search name, designation..."
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Margin="Margin.Dense"
                                  Class="rounded-lg" />
                </MudItem>
                <MudItem xs="12" sm="4" md="2">
                    <MudSelect T="string"
                               @bind-Value="_roleFilter"
                               @bind-Value:after="ApplyFilters"
                               Label="Access Level"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="rounded-lg">
                        <MudSelectItem Value="@("All")">All Levels</MudSelectItem>
                        <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                        <MudSelectItem Value="@("AVP")">AVP</MudSelectItem>
                        <MudSelectItem Value="@("Area Head")">Area Head</MudSelectItem>
                        <MudSelectItem Value="@("Store Head")">Store Head</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4" md="2">
                    <MudSelect T="string"
                               @bind-Value="_statusFilter"
                               @bind-Value:after="ApplyFilters"
                               Label="Status"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="rounded-lg">
                        <MudSelectItem Value="@("All")">All Status</MudSelectItem>
                        <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                        <MudSelectItem Value="@("Inactive")">Inactive</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-space-between align-center px-1 filters-summary-row">
                <MudText Typo="Typo.body2"
                         Class="@($"{GetStatusTextColor()} font-weight-bold filter-info-text")"
                         Style="opacity: 0.8;">
                    Showing @_filteredUsers.Count of @_allUsers.Count users
                </MudText>
                <div class="action-buttons-container">
                    @if (HasActiveFilters())
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="ClearFilters"
                                   Class="clear-filters-button">
                            Clear Filters
                        </MudButton>
                    }
                </div>
            </div>
        </MudPaper>

        <!-- Desktop Table View -->
        <div class="desktop-view">
            <MudPaper Class="@($"glass-panel {GetThemeClass()}")" Elevation="0">
                <MudTable Items="_filteredUsers" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Class="mud-table-glass">
                    <HeaderContent>
                        <MudTh>No.</MudTh>
                        <MudTh>Profile</MudTh>
                        <MudTh>Emp. No.</MudTh>
                        <MudTh>Full Name</MudTh>
                        <MudTh>Designation</MudTh>
                        <MudTh>Username</MudTh>
                        <MudTh>Access Level</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh Style="text-align: center;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="No.">@(_filteredUsers.ToList().IndexOf(context) + 1)</MudTd>
                        <MudTd DataLabel="Profile">
                            <MudAvatar Size="Size.Small" Color="GetAvatarColor(context)">
                                @if (!string.IsNullOrEmpty(GetUserImagePath(context)))
                                {
                                    <MudImage Src="@GetUserImagePath(context)" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Person" />
                                }
                            </MudAvatar>
                        </MudTd>
                        <MudTd DataLabel="Emp. No.">@context.EmployeeNumber</MudTd>
                        <MudTd DataLabel="Full Name" Style="font-weight: 600;">@context.Fullname</MudTd>
                        <MudTd DataLabel="Designation">@context.Designation</MudTd>
                        <MudTd DataLabel="Username">@context.Username</MudTd>
                        <MudTd DataLabel="Access Level">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Filled"
                                     Color="@GetRoleColor(context.Role)"
                                     Class="@($"role-chip {GetRoleChipClass(context.Role)}")">
                                @context.Role
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Filled"
                                     Color="@GetStatusColor(context.Status ?? "Active")"
                                     Class="@($"role-chip {GetStatusChipClass(context.Status ?? "Active")}")">
                                @(context.Status ?? "Active")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Action" Style="text-align: center;">
                            <div class="d-flex justify-center gap-2">
                                <MudTooltip Text="View Details">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Class="action-icon-circle action-btn-info"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenViewUserDialog(context))" />
                                </MudTooltip>

                                @if (UserState.Role == "Admin" || context.Username == UserState.Username)
                                {
                                    <MudTooltip Text="Edit User">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Class="action-icon-circle action-btn-info"
                                                       Size="Size.Small"
                                                       OnClick="@(() => EditUser(context))" />
                                    </MudTooltip>

                                    @if (UserState.Role == "Admin")
                                    {
                                        <MudTooltip Text="Delete User">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Class="action-icon-circle action-btn-error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => DeleteUser(context))"
                                                           Disabled="@(context.Username == UserState.Username)" />
                                        </MudTooltip>
                                    }
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            </MudPaper>
        </div>

        <!-- Mobile View -->
        <div class="mobile-view">
            @if (_filteredUsers.Any())
            {
                @foreach (var user in GetPagedUsers())
                {
                    <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                        <div class="mobile-card-header">
                            <div class="d-flex align-center gap-3">
                                <MudAvatar Size="Size.Medium" Color="GetAvatarColor(user)">
                                    @if (!string.IsNullOrEmpty(GetUserImagePath(user)))
                                    {
                                        <MudImage Src="@GetUserImagePath(user)" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                                    }
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@user.Fullname</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.7;">@user.Username</MudText>
                                </div>
                            </div>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Filled"
                                     Color="@GetRoleColor(user.Role)"
                                     Class="@($"role-chip {GetRoleChipClass(user.Role)}")">
                                @user.Role
                            </MudChip>
                        </div>

                        <div class="mobile-card-content">
                            <MudGrid Spacing="1">
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">Emp. No.</MudText>
                                    <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(user.EmployeeNumber) ? "N/A" : user.EmployeeNumber)</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">Designation</MudText>
                                    <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(user.Designation) ? "N/A" : user.Designation)</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">Status</MudText>
                                    <br />
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="Variant.Filled"
                                             Color="@GetStatusColor(user.Status ?? "Active")"
                                             Class="@($"role-chip {GetStatusChipClass(user.Status ?? "Active")}")">
                                        @(user.Status ?? "Active")
                                    </MudChip>
                                </MudItem>
                            </MudGrid>
                        </div>

                        <div class="mobile-card-actions">
                            <MudTooltip Text="View Details">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Class="action-icon-circle action-btn-info"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenViewUserDialog(user))" />
                            </MudTooltip>

                            @if (UserState.Role == "Admin" || user.Username == UserState.Username)
                            {
                                <MudTooltip Text="Edit User">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Class="action-icon-circle action-btn-info"
                                                   Size="Size.Small"
                                                   OnClick="@(() => EditUser(user))" />
                                </MudTooltip>

                                @if (UserState.Role == "Admin")
                                {
                                    <MudTooltip Text="Delete User">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Class="action-icon-circle action-btn-error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => DeleteUser(user))"
                                                       Disabled="@(user.Username == UserState.Username)" />
                                    </MudTooltip>
                                }
                            }
                        </div>
                    </MudPaper>
                }
                @if (_filteredUsers.Count > _userPageSize)
                {
                    <div class="d-flex justify-center mt-4">
                        <MudPagination Color="Color.Primary"
                                       Count="@((_filteredUsers.Count + _userPageSize - 1) / _userPageSize)"
                                       Selected="@_userCurrentPage"
                                       SelectedChanged="OnUserPageChanged"
                                       Variant="Variant.Filled" />
                    </div>
                }
            }
            else
            {
                <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                    <div class="mobile-card-content" style="text-align: center; padding: 48px 24px;">
                        <MudIcon Icon="@(HasActiveFilters() ? Icons.Material.Filled.PersonSearch : Icons.Material.Filled.PersonOff)"
                                 Size="Size.Large"
                                 Style="font-size: 4rem; opacity: 0.3; margin-bottom: 16px;" />

                        <MudText Typo="Typo.h6" Style="font-weight: 700; margin-bottom: 8px;">
                            @if (HasActiveFilters())
                            {
                                <text>No Users Found</text>
                            }
                            else
                            {
                                <text>No Users Available</text>
                            }
                        </MudText>

                        <MudText Typo="Typo.body2" Style="opacity: 0.7; margin-bottom: 24px;">
                            @if (HasActiveFilters())
                            {
                                <text>Try adjusting your search terms or filters to find the users you're looking for.</text>
                            }
                            else
                            {
                                <text>Start building your team by adding your first user to the system.</text>
                            }
                        </MudText>

                        @if (HasActiveFilters())
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Clear"
                                       OnClick="ClearFilters"
                                       Class="clear-filters-button">
                                Clear Filters
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="OpenAddUserDialog"
                                       Class="@($"modern-button {GetThemeClass()}")"
                                       Style="@GetButtonStyle()">
                                Add First User
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            }
        </div>
    }
</div>

@code {
    private bool _showFilters = false;
    private List<User> _allUsers = new();
    private List<User> _filteredUsers = new();
    private bool _initialized = false;

    // Filter variables
    private string _searchTerm = string.Empty;
    private string _roleFilter = "All";
    private string _statusFilter = "All";

    private int _userPageSize = 10;
    private int _userCurrentPage = 1;

    private List<User> GetPagedUsers() =>
        _filteredUsers
            .Skip((_userCurrentPage - 1) * _userPageSize)
            .Take(_userPageSize)
            .ToList();

    private void OnUserPageChanged(int page)
    {
        _userCurrentPage = page;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
