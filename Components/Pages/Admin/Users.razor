@page "/"
@page "/admin/users"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Components.Pages.Dialogs
@inject IDialogService DialogService
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@implements IDisposable

<PageTitle>Users Management</PageTitle>

<style>
    /* Apply login-style colors */
    .mud-paper {
        background: rgba(30, 58, 111, 1) !important;
        border: 2px solid #667fb5 !important;
        border-radius: 4px;
    }

        .mud-paper.lightest {
            background: rgba(255, 255, 255, 1) !important;
            border: 2px solid #667fb5 !important;
        }

    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        margin-top: 16px;
    }

    .page-header-title {
        color: #ffffff;
        font-size: 1.75rem;
        font-weight: 600;
        margin: 0;
    }

        .page-header-title.lightest {
            color: #1e3a6f;
        }

    /* Table Styling */
    .mud-table {
        background: transparent !important;
    }

    .mud-table-head {
        background: #5b6ec8;
    }

        .mud-table-head.lightest {
            background: #e2e8f0;
        }

        .mud-table-head .mud-table-cell {
            color: #ffffff !important;
            font-weight: 600;
            border-bottom: 2px solid #667fb5 !important;
        }

        .mud-table-head.lightest .mud-table-cell {
            color: #1e3a6f !important;
            border-bottom: 2px solid #e2e8f0 !important;
        }

    .mud-table-row {
        color: #ffffff !important;
    }

        .mud-table-row:hover {
            background-color: rgba(255, 255, 255, 0.1) !important;
        }

        .mud-table-row.lightest {
            color: #1e3a6f !important;
        }

            .mud-table-row.lightest:hover {
                background-color: rgba(0, 0, 0, 0.05) !important;
            }

    .mud-table-cell {
        color: #ffffff !important;
    }

        .mud-table-cell.lightest {
            color: #1e3a6f !important;
        }

    /* Buttons */
    .add-user-button,
    .action-button {
        background-color: #2b467f !important;
        border: 2px solid #667fb5 !important;
        color: #ffffff !important;
        box-shadow: none !important;
    }

        .add-user-button:hover,
        .action-button:hover {
            background-color: #1e3161 !important;
            border: 2px solid #667fb5 !important;
        }

    /* Filter section */
    .filter-section {
        background: rgba(30, 58, 111, 0.3) !important;
        margin-bottom: 16px;
        padding: 16px;
    }

        .filter-section.lightest {
            background: rgba(255, 255, 255, 1) !important;
            border: 2px solid #667fb5 !important;
        }

        .filter-section .mud-input-outlined-border {
            border-color: #667fb5 !important;
            border-width: 1px !important;
        }

        .filter-section.lightest .mud-input-outlined-border {
            border-color: #667fb5 !important;
        }

        .filter-section .mud-input-label {
            color: #6b7ed8 !important;
        }

        .filter-section.lightest .mud-input-label {
            color: #1e3a6f !important;
        }

        .filter-section .mud-input {
            color: #6b7ed8 !important;
        }

        .filter-section.lightest .mud-input {
            color: #1e3a6f !important;
        }

        .filter-section .mud-select {
            color: #6b7ed8 !important;
        }

        .filter-section.lightest .mud-select {
            color: #1e3a6f !important;
        }

        .filter-section .mud-icon-root {
            color: #667fb5 !important;
        }

    /* Desktop/Mobile display toggles */
    .desktop-table {
        display: block;
    }

    .mobile-cards {
        display: none;
    }

    .user-profile-img {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
    }

    .filter-toggle-button {
        display: none;
        margin-bottom: 8px;
    }

    .button-group {
        display: flex;
        gap: 16px;
    }

    .filter-info-text {
        color: #667fb5;
    }

        .filter-info-text.lightest {
            color: #667fb5;
        }



    /* Mobile Responsive Styles */
    @@media (max-width: 600px) {
        .page-header-title {
            display: none;
        }

        .button-group {
            display: flex;
            gap: 8px;
            flex-wrap: nowrap;
            margin-bottom: 0px;
            margin-top: 12px;
            width: 100%;
            justify-content: space-between;
        }

        .add-user-button {
            flex: 1;
            min-width: 0;
            margin-bottom: 0px;
            margin-top: 0px;
            font-size: 0.6rem;
            padding: 6px 6px;
        }

            .add-user-button .mud-button-label {
                font-size: 0.75rem;
                white-space: nowrap;
            }

        .desktop-table {
            display: none;
        }

        .mobile-cards {
            display: block;
        }

        .user-card {
            background: rgba(30, 58, 111, 0.3) !important;
            border-left: 4px solid #667fb5 !important;
            border: 2px solid #667fb5 !important;
            margin-bottom: 12px;
            padding: 0;
        }

            .user-card.lightest {
                background: rgba(255, 255, 255, 1) !important;
                border: 2px solid #667fb5 !important;
                border-left: 4px solid #3b82f6 !important;
            }

        .user-card-header {
            background-color: #667fb5 !important;
            color: white;
            padding: 10px 12px;
            border-top-right-radius: 4px;
            font-size: 0.9rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .user-card-header.lightest {
                background-color: #3b82f6 !important;
            }

        .user-card-content {
            padding: 12px;
            color: #6b7ed8 !important;
        }

            .user-card-content.lightest {
                color: #1e3a6f !important;
            }

        .user-card-field-label {
            color: #6b7ed8 !important;
            font-weight: 600;
            font-size: 0.75rem;
            margin-bottom: 4px;
        }

            .user-card-field-label.lightest {
                color: #667fb5 !important;
            }

        .user-card-field-value {
            color: #ffffff !important;
            font-size: 0.85rem;
            margin-bottom: 10px;
        }

            .user-card-field-value.lightest {
                color: #1e3a6f !important;
            }

        .user-card-actions {
            border-top: 2px solid #667fb5 !important;
            background: rgba(102, 127, 181, 0.1);
            display: flex;
            gap: 8px;
            flex-wrap: nowrap;
            justify-content: space-between;
            padding: 10px 16px;
        }

            .user-card-actions.lightest {
                border-top: 2px solid #e2e8f0 !important;
                background: rgba(226, 232, 240, 0.3);
            }

            .user-card-actions .mud-button-root {
                background-color: #2b467f !important;
                border: 2px solid #667fb5 !important;
                flex: 1;
                min-width: 0;
                color: white !important;
            }

            .user-card-actions.lightest .mud-button-root {
                background-color: #3b82f6 !important;
                border: 2px solid #667fb5 !important;
            }

        .user-profile-img-mobile {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 12px;
        }

        .filter-toggle-button {
            display: inline-flex !important;
            width: 100%;
        }

        .filter-section .mud-grid {
            display: none;
        }

        .filter-section.filters-visible .mud-grid {
            display: flex;
        }
    }
</style>

<div class="page-header-row">
    <MudText Typo="Typo.h4" Class="@($"page-header-title {GetThemeClass()}")">Manage Users</MudText>

    <div class="button-group">
        <MudButton Class="add-user-button"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Small"
                   OnClick="OpenAddUserDialog">
            USER
        </MudButton>
        <MudButton Class="add-user-button"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.LocationOn"
                   Size="Size.Small"
                   OnClick="OpenManageAreasDialog">
            AREA
        </MudButton>
    </div>
</div>

<!-- Filter Section -->
<MudPaper Class="@($"filter-section {GetThemeClass()} {(_showFilters ? "filters-visible" : "")}")"
          Style="@GetPaperBackground()"
          Elevation="1">
    <MudButton Variant="Variant.Outlined"
               StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
               FullWidth="true"
               OnClick="@(() => _showFilters = !_showFilters)"
               Class="filter-toggle-button"
               Style="@GetFilterButtonStyle()">
        @(_showFilters ? "Hide Filters" : "Show Filters")
    </MudButton>

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField T="string"
                          @bind-Value="_searchTerm"
                          @bind-Value:after="ApplyFilters"
                          Label="Search Users"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Placeholder="Name, username, email..."
                          Immediate="true"
                          DebounceInterval="300"
                          Dense="true"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string"
                       @bind-Value="_roleFilter"
                       @bind-Value:after="ApplyFilters"
                       Label="Role"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@("All")" Style="@GetPaperBackground()">All Roles</MudSelectItem>
                <MudSelectItem Value="@("Admin")" Style="@GetPaperBackground()">Admin</MudSelectItem>
                <MudSelectItem Value="@("AVP")" Style="@GetPaperBackground()">AVP</MudSelectItem>
                <MudSelectItem Value="@("Area Head")" Style="@GetPaperBackground()">Area Head</MudSelectItem>
                <MudSelectItem Value="@("Store Head")" Style="@GetPaperBackground()">Store Head</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string"
                       @bind-Value="_areaTypeFilter"
                       Label="Area Type"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       SelectedValuesChanged="OnAreaTypeFilterChanged">
                <MudSelectItem Value="@("All")" Style="@GetPaperBackground()">All Types</MudSelectItem>
                <MudSelectItem Value="@("Municipality")" Style="@GetPaperBackground()">Municipality</MudSelectItem>
                <MudSelectItem Value="@("Barangay")" Style="@GetPaperBackground()">Barangay</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string"
                       @bind-Value="_specificAreaFilter"
                       Label="Specific Area"
                       Variant="Variant.Outlined"
                       Disabled="@(_areaTypeFilter == "All")"
                       Dense="true"
                       Margin="Margin.Dense"
                       SelectedValuesChanged="ApplyFilters">
                <MudSelectItem Value="@("All")" Style="@GetPaperBackground()">All Areas</MudSelectItem>
                @foreach (var area in _availableAreas)
                {
                    <MudSelectItem Value="@area" Style="@GetPaperBackground()">@area</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <MudText Typo="Typo.body2" Class="@($"filter-info-text {GetThemeClass()}")">
                    Showing @_filteredUsers.Count of @_allUsers.Count users
                </MudText>
                @if (HasActiveFilters())
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="ClearFilters">
                        Clear Filters
                    </MudButton>
                }
            </div>
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- Desktop Table View -->
<div class="desktop-table">
    <MudPaper Class="@GetThemeClass()" Style="@GetPaperBackground()" Elevation="1">
        <MudTable Items="_filteredUsers" Hover="true">
            <HeaderContent>
                <MudTh Class="@($"mud-table-column {GetThemeClass()}")">No.</MudTh>
                <MudTh Class="@($"mud-table-column {GetThemeClass()}")">Profile</MudTh>
                <MudTh Class="@($"mud-table-column {GetThemeClass()}")">Full Name</MudTh>
                <MudTh Class="@($"mud-table-column {GetThemeClass()}")">Username</MudTh>
                <MudTh Class="@($"mud-table-column {GetThemeClass()}")">Email</MudTh>
                <MudTh Class="@($"mud-table-column {GetThemeClass()}")">Position</MudTh>
                <MudTh Class="@($"mud-table-column {GetThemeClass()}")">Area</MudTh>
                <MudTh Class="@($"mud-table-column {GetThemeClass()}")">Role</MudTh>
                <MudTh Class="@($"mud-table-column {GetThemeClass()}")">Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="No." Class="@($"mud-table-column {GetThemeClass()}")">@(_filteredUsers.ToList().IndexOf(context) + 1)</MudTd>
                <MudTd DataLabel="Profile" Class="@($"mud-table-column {GetThemeClass()}")">
                    <img src="@GetUserImagePath(context)"
                         alt="Profile"
                         class="user-profile-img" />
                </MudTd>
                <MudTd DataLabel="Full Name" Class="@($"mud-table-column {GetThemeClass()}")" Style="font-weight: 600;">@context.Fullname</MudTd>
                <MudTd DataLabel="Username" Class="@($"mud-table-column {GetThemeClass()}")">@@@context.Username</MudTd>
                <MudTd DataLabel="Email" Class="@($"mud-table-column {GetThemeClass()}")">@context.Email</MudTd>
                <MudTd DataLabel="Position" Class="@($"mud-table-column {GetThemeClass()}")">@context.Position</MudTd>
                <MudTd DataLabel="Area" Class="@($"mud-table-column {GetThemeClass()}")">@context.Area</MudTd>
                <MudTd DataLabel="Role" Class="@($"mud-table-column {GetThemeClass()}")">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@GetRoleColor(context.Role)">
                        @context.Role
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Action" Class="@($"mud-table-column {GetThemeClass()}")">
                    @if (UserState.Role == "Admin" || context.Username == UserState.Username)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditUser(context))"
                                       Title="Edit user" />

                        @if (UserState.Role == "Admin" && context.Username != UserState.Username)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteUser(context))"
                                           Title="Delete user" />
                        }
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudPaper>
</div>

<!-- Mobile Card View -->
<div class="mobile-cards">
    @if (_filteredUsers.Any())
    {
        @for (int i = 0; i < _filteredUsers.Count; i++)
        {
            var user = _filteredUsers[i];
            var index = i + 1;

            <MudCard Class="@($"user-card {GetThemeClass()}")" Elevation="2">
                <div class="@($"user-card-header {GetThemeClass()}")">
                    <span><strong>User #@index</strong></span>
                    <MudChip T="string" Size="Size.Small" Color="@GetRoleColor(user.Role)">@user.Role</MudChip>
                </div>
                <div class="@($"user-card-content {GetThemeClass()}")">
                    <div style="text-align: center;">
                        <img src="@GetUserImagePath(user)"
                             alt="Profile"
                             class="user-profile-img-mobile" />
                    </div>

                    <MudText Typo="Typo.body2" Color="Color.Default" Class="@($"user-card-field-label {GetThemeClass()}")">
                        <strong>Full Name:</strong>
                    </MudText>
                    <MudText Typo="Typo.body1" Class="@($"user-card-field-value {GetThemeClass()}")">
                        @user.Fullname
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Default" Class="@($"user-card-field-label {GetThemeClass()}")">
                        <strong>Username:</strong>
                    </MudText>
                    <MudText Typo="Typo.body1" Class="@($"user-card-field-value {GetThemeClass()}")">
                        @@@user.Username
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Default" Class="@($"user-card-field-label {GetThemeClass()}")">
                        <strong>Email:</strong>
                    </MudText>
                    <MudText Typo="Typo.body1" Class="@($"user-card-field-value {GetThemeClass()}")">
                        @user.Email
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Default" Class="@($"user-card-field-label {GetThemeClass()}")">
                        <strong>Position:</strong>
                    </MudText>
                    <MudText Typo="Typo.body1" Class="@($"user-card-field-value {GetThemeClass()}")">
                        @user.Position
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Default" Class="@($"user-card-field-label {GetThemeClass()}")">
                        <strong>Area:</strong>
                    </MudText>
                    <MudText Typo="Typo.body1" Class="@($"user-card-field-value {GetThemeClass()}")">
                        @user.Area
                    </MudText>
                </div>
                <div class="@($"user-card-actions {GetThemeClass()}")">
                    @if (UserState.Role == "Admin" || user.Username == UserState.Username)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => EditUser(user))">
                            Edit
                        </MudButton>
                        @if (UserState.Role == "Admin" && user.Username != UserState.Username)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteUser(user))">
                                Delete
                            </MudButton>
                        }
                    }
                </div>
            </MudCard>
        }
    }
    else
    {
        <MudCard Elevation="1" Style="padding: 15px; text-align: center;">
            <MudText Typo="Typo.body1">
                @if (HasActiveFilters())
                {
                    <text>No users found matching your filters.</text>
                }
                else
                {
                    <text>No users found</text>
                }
            </MudText>
        </MudCard>
    }
</div>

@code {
    private bool _showFilters = false;
    private List<User> _allUsers = new();
    private List<User> _filteredUsers = new();
    private List<Area> _allAreas = new();
    private List<string> _availableAreas = new();
    private bool _initialized = false;

    // Filter variables
    private string _searchTerm = string.Empty;
    private string _roleFilter = "All";
    private string _areaTypeFilter = "All";
    private string _specificAreaFilter = "All";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "";
    }

    private string GetPaperBackground()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "background: rgba(255, 255, 255, 1) !important;",
            ThemeMode.Light => "background: rgba(30, 58, 111, 1) !important;",
            ThemeMode.Dark => "background: rgba(15, 23, 42, 1) !important;",
            _ => "background: rgba(30, 58, 111, 1) !important;"
        };
    }

    private string GetFilterButtonStyle()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest
            ? "color: #1e3a6f; border-color: #667fb5;"
            : "color: #ffffff; border-color: #667fb5;";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await UserState.InitializeAsync();

            // Check authentication
            if (UserState.Role == null)
            {
                // Optionally handle redirect
                // NavigationManager.NavigateTo("/", forceLoad: true);
                // For now allow render to show empty or adjust logic
            }

            await LoadData();

            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Load all users
        _allUsers = await db.Users
            .OrderBy(u => u.Fullname)
            .AsNoTracking()
            .ToListAsync();

        // Load all areas
        _allAreas = await db.Areas
            .OrderBy(a => a.Type)
            .ThenBy(a => a.Name)
            .AsNoTracking()
            .ToListAsync();

        ApplyFilters();
    }

    // Alias for LoadData to match reference snippet (if called by Dialogs)
    private async Task LoadUsers()
    {
        await LoadData();
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        _filteredUsers = _allUsers;

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredUsers = _filteredUsers.Where(u =>
                (u.Fullname?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Username?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Email?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (u.Position?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Area?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }

        if (_roleFilter != "All")
        {
            _filteredUsers = _filteredUsers.Where(u => u.Role == _roleFilter).ToList();
        }

        // Apply area type filter
        if (_areaTypeFilter != "All" && _specificAreaFilter == "All")
        {
            var areasOfType = _allAreas
                .Where(a => a.Type == _areaTypeFilter)
                .Select(a => a.Name)
                .ToList();

            _filteredUsers = _filteredUsers
                .Where(u => u.Area != null && areasOfType.Contains(u.Area))
                .ToList();
        }

        // Apply specific area filter
        if (_specificAreaFilter != "All")
        {
            _filteredUsers = _filteredUsers
               .Where(u => u.Area == _specificAreaFilter)
               .ToList();
        }

        StateHasChanged(); // Used when called from UI events
    }

    private void OnAreaTypeFilterChanged()
    {
        _specificAreaFilter = "All";
        if (_areaTypeFilter == "All")
        {
            _availableAreas = new List<string>();
        }
        else
        {
            _availableAreas = _allAreas
                .Where(a => a.Type == _areaTypeFilter)
                .Select(a => a.Name)
                .OrderBy(n => n)
                .ToList();
        }
        ApplyFilters();
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _roleFilter = "All";
        _areaTypeFilter = "All";
        _specificAreaFilter = "All";
        _availableAreas = new List<string>();
        ApplyFilters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(_searchTerm) ||
               _roleFilter != "All" ||
               _areaTypeFilter != "All" ||
               _specificAreaFilter != "All";
    }

    private string GetUserImagePath(User user)
    {
        if (user.ImageData != null && !string.IsNullOrEmpty(user.ImageMimeType))
        {
            return $"data:{user.ImageMimeType};base64,{Convert.ToBase64String(user.ImageData)}";
        }
        return "/Uploads/UserImg.png";
    }

    private Color GetRoleColor(string role) => role switch
    {
        "Admin" => Color.Error,
        "Cashier" => Color.Info, // From Reference
        "Faculty" => Color.Success, // From Reference
        // Map other roles if needed
        "AVP" => Color.Secondary,
        "Area Head" => Color.Info,
        "Store Head" => Color.Success,
        _ => Color.Default
    };

    private async Task OpenAddUserDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddUser>("Add User", options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            await LoadUsers();
        }
    }

