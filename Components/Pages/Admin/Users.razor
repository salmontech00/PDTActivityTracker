    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await UserState.InitializeAsync();

            // Check authentication
            if (UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo(UserState.LastValidPage ?? UserState.GetDashboardRoute(), forceLoad: true);
                return;
            }
            await UserState.SetLastValidPage(NavigationManager.Uri);

            await LoadData();

            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Load all users from the database
        var rawUsers = await db.Users.AsNoTracking().ToListAsync();

        // Sort in memory:
        // 1. Users without employee number (null, empty, or whitespace) first (top)
        // 2. Users with employee number sorted numerically ascending by their EmployeeNumber
        // 3. For users with the same employee number (or both empty), sort alphabetically by Fullname
        _allUsers = rawUsers
            .OrderBy(u => string.IsNullOrWhiteSpace(u.EmployeeNumber) ? 0 : 1)
            .ThenBy(u => {
                if (string.IsNullOrWhiteSpace(u.EmployeeNumber))
                    return 0L;
                return long.TryParse(u.EmployeeNumber, out var val) ? val : long.MaxValue;
            })
            .ThenBy(u => u.Fullname)
            .ToList();

        ApplyFilters();
    }

    // Alias for LoadData to match reference snippet (if called by Dialogs)
    private async Task LoadUsers()
    {
        await LoadData();
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        _userCurrentPage = 1;
        _filteredUsers = _allUsers;

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredUsers = _filteredUsers.Where(u =>
                (u.Fullname?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Username?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Email?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Designation?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.EmployeeNumber?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }

        if (_roleFilter != "All")
        {
            _filteredUsers = _filteredUsers.Where(u => u.Role == _roleFilter).ToList();
        }

        if (_statusFilter != "All")
        {
            _filteredUsers = _filteredUsers.Where(u => u.Status == _statusFilter).ToList();
        }

        StateHasChanged(); // Used when called from UI events
    }


    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _roleFilter = "All";
        _statusFilter = "All";
        ApplyFilters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(_searchTerm) ||
               _roleFilter != "All" ||
               _statusFilter != "All";
    }

    private string? GetUserImagePath(User user)
    {
        if (user.ImageData != null && !string.IsNullOrEmpty(user.ImageMimeType))
        {
            return $"data:{user.ImageMimeType};base64,{Convert.ToBase64String(user.ImageData)}";
        }
        return null;
    }

