@page "/admin/settings"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<PageTitle>Settings | SMR Activity Tracker</PageTitle>

<style>
    .v2-card {
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.05);
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
    }

    html.theme-dark .v2-card {
        background: rgba(30, 41, 59, 0.7);
    }
</style>

<div class="mb-6">
    <MudText Typo="Typo.h5" Style="font-weight: 700;">Settings</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">Manage system configurations</MudText>
</div>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="0" Class="pa-6 v2-card">
            <MudText Typo="Typo.body1" Style="font-weight: 500;">General Settings</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">System-wide configurations will appear here.</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await UserState.InitializeAsync();

            if (UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo("/", forceLoad: true);
                return;
            }
        }
    }
}
