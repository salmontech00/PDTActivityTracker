@page "/admin/settings"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService

<PageTitle>Settings | SMR Activity Tracker</PageTitle>

<style>
    .v2-card {
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.05);
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
    }
    
    html.theme-dark .v2-card {
        background: rgba(30, 41, 59, 0.7);
    }
</style>

<div class="mb-6">
    <MudText Typo="Typo.h5" Style="font-weight: 700;">Settings</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">Manage Access Tags and system configurations</MudText>
</div>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="0" Class="pa-6 v2-card">
            <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 600;">Access Tags</MudText>
            
            <div class="d-flex gap-2 mb-4">
                <MudTextField @bind-Value="_newTagName" Label="New Access Tag" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTag" Class="rounded-lg">Add</MudButton>
            </div>

            <MudList T="string">
                @foreach (var tag in _tags)
                {
                    <MudListItem>
                        <div class="d-flex justify-space-between align-center">
                            <MudChip T="string" Color="Color.Info" Size="Size.Small">@tag.Name</MudChip>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteTag(tag))" />
                        </div>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<AccessTag> _tags = new();
    private string _newTagName = string.Empty;
    private bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await UserState.InitializeAsync();
            
            if (UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo("/", forceLoad: true);
                return;
            }
            
            await LoadTags();
        }
    }

    private async Task LoadTags()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        _tags = await db.AccessTags.OrderBy(t => t.Name).ToListAsync();
        StateHasChanged();
    }

    private async Task AddTag()
    {
        if (string.IsNullOrWhiteSpace(_newTagName)) return;
        
        using var db = await DbFactory.CreateDbContextAsync();
        if (await db.AccessTags.AnyAsync(t => t.Name == _newTagName))
        {
            Snackbar.Add("Tag already exists", Severity.Warning);
            return;
        }

        db.AccessTags.Add(new AccessTag { Name = _newTagName });
        await db.SaveChangesAsync();
        _newTagName = string.Empty;
        await LoadTags();
        Snackbar.Add("Tag added successfully", Severity.Success);
    }

    private async Task DeleteTag(AccessTag tag)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        db.AccessTags.Remove(tag);
        await db.SaveChangesAsync();
        await LoadTags();
        Snackbar.Add("Tag deleted", Severity.Info);
    }
}
