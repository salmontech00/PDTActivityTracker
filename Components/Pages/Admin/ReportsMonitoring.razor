    /// <summary>Returns true when deletion should be blocked. Only today's active sessions are protected; past incomplete records can be deleted.</summary>
    private bool IsActivityProtected(StoreDailyActivity activity)
        => activity.Date.Date == DateTime.Today;

    private async Task DeleteActivity(StoreDailyActivity activity)
    {
        // Safety guard — should never reach here from UI, but defend anyway
        if (IsActivityProtected(activity))
        {
            Snackbar.Add("Cannot delete today's or currently active records.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Are you sure you want to delete this report from {activity.Store?.StoreName} on {activity.Date.ToShortDateString()}? This will also delete all related task progress and photos.",
            ["ButtonText"] = "Delete",
            ["Color"] = Color.Error
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Deletion", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                using var db = await DbFactory.CreateDbContextAsync();

                // 1. Find all related TaskProgress records
                var progressRecords = await db.TaskProgresses.Where(p => p.StoreDailyActivityId == activity.Id).ToListAsync();

                // 2. Find all related TaskPhotos (matched by store and date)
                var startOfDay = activity.Date.Date;
                var endOfDay = startOfDay.AddDays(1).AddSeconds(-1);
                var relatedPhotos = await db.TaskPhotos.Where(p => p.StoreId == activity.StoreId && p.UploadedAt >= startOfDay && p.UploadedAt <= endOfDay).ToListAsync();

                // 3. Delete records
                if (progressRecords.Any()) db.TaskProgresses.RemoveRange(progressRecords);
                if (relatedPhotos.Any()) db.TaskPhotos.RemoveRange(relatedPhotos);

                var existingActivity = await db.StoreDailyActivities.FindAsync(activity.Id);
                if (existingActivity != null) db.StoreDailyActivities.Remove(existingActivity);

                await db.SaveChangesAsync();

                Snackbar.Add("Report and related data deleted successfully", Severity.Success);
                await LoadData(); // Refresh all data and stats
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting record: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ClearActivityLogs()
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = _selectedStoreId.HasValue
                ? $"Are you sure you want to clear the activity log for {_stores.FirstOrDefault(s => s.Id == _selectedStoreId)?.StoreName}? This action cannot be undone."
                : "Are you sure you want to clear all system activity logs? This action cannot be undone.",
            ["ButtonText"] = "Clear All",
            ["Color"] = Color.Error
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Clear Logs", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                using var db = await DbFactory.CreateDbContextAsync();

                var query = db.ActivityLogs.AsQueryable();
                if (_selectedStoreId.HasValue)
                {
                    query = query.Where(a => a.StoreId == _selectedStoreId.Value);
