    private string GetActivityDescription(ActivityLog activity)
    {
        bool isCheckInTask = false;

        if (activity.EntityType == "TaskPhoto" && activity.EntityId.HasValue &&
            _linkedPhotos.TryGetValue(activity.EntityId.Value, out var photo))
            isCheckInTask = photo.CategoryId == _checkInCategoryId;
        else if (activity.EntityType == "TaskProgress" && activity.EntityId.HasValue &&
            _linkedProgresses.TryGetValue(activity.EntityId.Value, out var prog))
            isCheckInTask = prog.ChecklistItem?.CategoryId == _checkInCategoryId;

        var taskName = GetTaskName(activity);

        return activity.Action switch
        {
            "TaskCompleted" => isCheckInTask
                                    ? $" checked in (Task Completed: {taskName})"
                                    : $" completed task: {taskName}",
            "AllTasksCompleted" => " completed all tasks for the day",
            "CategoryCompleted" => $" completed all tasks in: {taskName}",
            "ProgressSubmitted" => " submitted daily progress report",
            "SessionStarted" => " started a new session",
            "PhotoUploaded" => isCheckInTask
                                    ? $" checked in (Photo Uploaded: {taskName})"
                                    : $" uploaded photo for {taskName}",
            "PhotoRemoved" => $" removed photo for {taskName}",
            "TaskReverted" => $" task became incomplete: {taskName}",
            "SessionReverted" => " daily session reverted to In-Progress",
            "Login" => " logged in",
            "Logout" => " logged out",
            "IssueReported" => $" reported an issue: {activity.Details}",
            "LowManpower" => $" reported low manpower: {activity.Details}",
            _ => string.IsNullOrWhiteSpace(activity.Details)
                                    ? $" performed: {activity.Action}"
                                    : $" {activity.Details}"
        };
    }

    private string GetTaskName(ActivityLog activity)
    {
        if (activity.EntityType == "TaskProgress" && activity.EntityId.HasValue &&
            _linkedProgresses.TryGetValue(activity.EntityId.Value, out var prog))
        {
            if (prog.ChecklistItem != null)
                return string.IsNullOrEmpty(prog.ChecklistItem.TaskName)
                    ? prog.ChecklistItem.Description ?? "[No Description]"
                    : prog.ChecklistItem.TaskName;
        }

        if (string.IsNullOrWhiteSpace(activity.Details))
            return "[Task Unknown]";

        var knownPrefixes = new[]
        {
        "Completed task: ",
        "Uploaded photo for task: ",
        "Removed photo for task: ",
        "Task reverted to incomplete: "
    };

        var details = activity.Details;
        foreach (var prefix in knownPrefixes)
        {
            if (details.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            {
                details = details[prefix.Length..].Trim();
                break;
            }
        }

        return string.IsNullOrEmpty(details) ? "[Task Unknown]" : details;
    }

    private string GetLocationInfo(ActivityLog activity)
    {
        double? lat = null, lng = null;

        if (activity.EntityType == "TaskPhoto" && activity.EntityId.HasValue &&
            _linkedPhotos.TryGetValue(activity.EntityId.Value, out var photo))
        { lat = photo.Latitude; lng = photo.Longitude; }
        else if (activity.EntityType == "TaskProgress" && activity.EntityId.HasValue &&
            _linkedProgresses.TryGetValue(activity.EntityId.Value, out var prog))
        { lat = prog.Latitude; lng = prog.Longitude; }

        if (!lat.HasValue || !lng.HasValue) return "";

        string distanceText = "";
        if (activity.Store?.GPSLatitude.HasValue == true && activity.Store?.GPSLongitude.HasValue == true)
        {
            var distance = CalculateDistance(
                lat.Value, lng.Value,
                activity.Store.GPSLatitude!.Value,
                activity.Store.GPSLongitude!.Value);

            if (distance != double.MaxValue)
                distanceText = distance < 1
                    ? $" • {(int)(distance * 1000)}m from store"
                    : $" • {distance:F2}km from store";
        }

        return $" (Location: {lat:F4}, {lng:F4}{distanceText})";
    }

    private double CalculateDistance(double lat1, double lon1, double lat2, double lon2)
    {
        if (lat1 == 0 && lon1 == 0) return double.MaxValue;
        if (lat2 == 0 && lon2 == 0) return double.MaxValue;

        const double R = 6371;
        var dLat = ToRadians(lat2 - lat1);
        var dLon = ToRadians(lon2 - lon1);
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                Math.Cos(ToRadians(lat1)) * Math.Cos(ToRadians(lat2)) *
                Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        return R * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

    private double ToRadians(double deg) => deg * (Math.PI / 180);

    private string GetRelativeTime(DateTime timestamp)
    {
        var diff = DateTime.Now - timestamp;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return timestamp.ToString("MMM dd, yyyy");
    }

    private class CategoryPerformanceModel
    {
        public string CategoryName { get; set; } = "";
        public int CompletionRate { get; set; }
    }
}
