@page "/"
@page "/admin/reports-monitoring"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Components.Pages.Dialogs
@inject IDialogService DialogService
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Reports & Monitoring</PageTitle>

<style>
    .reports-container {
        padding: 1rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 16px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding: 0;
    }

    .button-group {
        display: flex;
        gap: 12px;
        padding: 0;
        margin: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* DASHBOARD CARDS */
    .stat-card {
        padding: 20px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #0072cf, #00c6ff);
        }

    .stat-value {
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .stat-label {
        font-size: 0.85rem;
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 8px;
    }

    .stat-trend {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        margin-top: 8px;
        font-size: 0.8rem;
    }

    .trend-up {
        color: #22c55e;
    }

    .trend-down {
        color: #ef4444;
    }

    /* SECTION TITLE */
    .section-title {
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-icon {
        padding: 8px;
        border-radius: 10px;
        background: rgba(0, 114, 207, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* BUTTONS */
    .modern-button {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
    }

    .button-group .modern-button.light {
        background-color: #ffffff !important;
        color: #0072cf !important;
    }

    /* FILTER SECTION */
    .filter-section {
        padding: 16px;
        margin-bottom: 24px;
    }

        .filter-section .mud-input-root {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
        }

    .lightest .filter-section .mud-input-root {
        background: rgba(255, 255, 255, 0.8) !important;
    }

    .light .filter-section .mud-input-root {
        background: rgba(255, 255, 255, 0.1) !important;
    }

    .light .filter-section .mud-input-label,
    .light .filter-section .mud-input-adornment-start,
    .light .filter-section .mud-select-input,
    .light .filter-section .mud-input-slot {
        color: #ffffff !important;
    }

    .light .filter-section .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.5) !important;
    }

    .filter-toggle-button {
        display: none;
    }

    /* PHOTO GALLERY */
    .photo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 16px;
        padding: 16px;
    }

    .photo-item {
        position: relative;
        aspect-ratio: 1;
        border-radius: 12px;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .photo-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        }

        .photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .photo-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 8px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
        color: white;
        font-size: 0.75rem;
    }

    /* REPORT TABLE */
    .mud-table {
        background: transparent !important;
    }

    .mud-table-head {
        background: rgba(0, 114, 207, 0.1);
    }

        .mud-table-head.lightest {
            background: rgba(0, 114, 207, 0.05);
        }

    .mud-table-cell {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        padding: 12px 16px !important;
    }

    .lightest .mud-table-cell {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .mud-table-row:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .lightest .mud-table-row:hover {
        background-color: rgba(0, 114, 207, 0.05) !important;
    }

    /* Fix for Pager/Footer alignment */
    .mud-table-pagination {
        background-color: transparent !important;
        border-top: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: inherit !important;
    }

    .lightest .mud-table-pagination {
        border-top: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    /* TABS */
    .section-tabs {
        margin-bottom: 24px;
    }

        .section-tabs .mud-tab {
            text-transform: none;
            font-weight: 600;
        }

    /* ACTIVITY LOG */
    .activity-item {
        padding: 12px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .lightest .activity-item {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1);
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .activity-content {
        flex: 1;
    }

    .activity-time {
        font-size: 0.75rem;
        opacity: 0.6;
    }

    /* RESPONSIVE */
    @@media (max-width: 960px) {
        .filter-toggle-button {
            display: inline-flex !important;
        }

        .filter-section .mud-grid {
            display: none;
        }

        .filter-section.filters-visible .mud-grid {
            display: flex;
        }

        .page-header-row {
            flex-direction: column;
            gap: 16px;
            align-items: stretch;
            text-align: center;
            padding: 0;
            margin-bottom: 20px;
        }

        .page-title {
            display: none;
        }

        .button-group {
            flex-direction: row !important;
            width: 100%;
            justify-content: space-between;
        }

            .button-group .modern-button {
                flex: 1;
                font-size: 0.70rem !important;
            }

        .photo-grid {
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 8px;
        }
    }

    @@media (min-width: 961px) {
        .desktop-view {
            display: block;
        }

        .mobile-view {
            display: none;
        }
    }
</style>

<div class="reports-container">
    <div class="page-header-row">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Reports & Monitoring</MudText>

        <div class="button-group">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="OpenGenerateReportDialog"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                GENERATE REPORT
            </MudButton>
        </div>
    </div>

    <!-- Real-time Activity Dashboard -->
    <div class="section-title @GetThemeClass()">
        <span class="section-icon">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" Color="Color.Primary" />
        </span>
        Real-time Activity Dashboard
    </div>

    <MudGrid Class="mb-6">
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-success">@_taskCompletionRate%</div>
                <div class="stat-label">Task Completion Rate</div>
                <div class="stat-trend trend-up">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" />
                    <span>+5% from last week</span>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-info">@_activeStores</div>
                <div class="stat-label">Active Stores</div>
                <div class="stat-trend">
                    <span>of @_totalStores total</span>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-warning">@_activeUsers</div>
                <div class="stat-label">Active Users</div>
                <div class="stat-trend trend-up">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" />
                    <span>Online now</span>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-primary">@_totalPhotos</div>
                <div class="stat-label">Photos Uploaded</div>
                <div class="stat-trend">
                    <span>This month</span>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Tabs Section -->
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="@($"section-tabs glass-panel {GetThemeClass()}")" PanelClass="pa-4">
        <!-- Generate Reports Tab -->
        <MudTabPanel Text="Generate Reports" Icon="@Icons.Material.Filled.Assessment">
            <MudGrid Spacing="3" Class="mb-4">
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string"
                               @bind-Value="_reportType"
                               Label="Report Type"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="rounded-lg">
                        <MudSelectItem Value="@("All")">All Reports</MudSelectItem>
                        <MudSelectItem Value="@("ByStore")">By Store</MudSelectItem>
                        <MudSelectItem Value="@("ByUser")">By User</MudSelectItem>
                        <MudSelectItem Value="@("ByCategory")">By Task Category</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?"
                               @bind-Value="_selectedStoreId"
                               Label="Store"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Disabled="@(_reportType != "ByStore")"
                               Class="rounded-lg">
                        <MudSelectItem Value="@((int?)null)">All Stores</MudSelectItem>
                        @foreach (var store in _stores)
                        {
                            <MudSelectItem Value="@((int?)store.Id)">@store.StoreName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudDateRangePicker @bind-DateRange="_dateRange"
                                        Label="Date Range"
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense"
                                        Class="rounded-lg" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string"
                               @bind-Value="_exportFormat"
                               Label="Export Format"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="rounded-lg">
                        <MudSelectItem Value="@("PDF")">PDF</MudSelectItem>
                        <MudSelectItem Value="@("Excel")">Excel</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <div class="d-flex gap-2 mb-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="GeneratePreview"
                           Class="modern-button">
                    Generate Preview
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportReport"
                           Disabled="@(!_hasPreviewData)"
                           Class="modern-button">
                    Export @_exportFormat
                </MudButton>
            </div>

            @if (_hasPreviewData)
            {
                <MudTable Items="_activityLogs" Hover="true" Breakpoint="Breakpoint.None" Dense="true">
                    <HeaderContent>
                        <MudTh>Date/Time</MudTh>
                        <MudTh>User</MudTh>
                        <MudTh>Store</MudTh>
                        <MudTh>Action</MudTh>
                        <MudTh>Details</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date/Time">@context.Timestamp.ToString("yyyy-MM-dd HH:mm")</MudTd>
                        <MudTd DataLabel="User">@(context.User?.Fullname ?? "N/A")</MudTd>
                        <MudTd DataLabel="Store">@(context.Store?.StoreName ?? "N/A")</MudTd>
                        <MudTd DataLabel="Action">@context.Action</MudTd>
                        <MudTd DataLabel="Details">@(context.Details ?? "-")</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            }
            else
            {
                <MudPaper Class="@($"glass-panel pa-8 text-center {GetThemeClass()}")" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Large" Style="font-size: 4rem; opacity: 0.3; margin-bottom: 16px;" />
                    <MudText Typo="Typo.h6" Style="font-weight: 700; margin-bottom: 8px;">No Report Data</MudText>
                    <MudText Typo="Typo.body2" Style="opacity: 0.7;">Select filters and click "Generate Preview" to view report data.</MudText>
                </MudPaper>
            }
        </MudTabPanel>

        <!-- Photo Gallery Tab -->
        <MudTabPanel Text="Photo Gallery" Icon="@Icons.Material.Filled.PhotoLibrary">
            <MudGrid Spacing="3" Class="mb-4">
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField T="string"
                                  @bind-Value="_photoSearchTerm"
                                  @bind-Value:after="FilterPhotos"
                                  Label="Search Photos"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Placeholder="Search by description..."
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Margin="Margin.Dense"
                                  Class="rounded-lg" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?"
                               @bind-Value="_photoStoreFilter"
                               @bind-Value:after="FilterPhotos"
                               Label="Filter by Store"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="rounded-lg">
                        <MudSelectItem Value="@((int?)null)">All Stores</MudSelectItem>
                        @foreach (var store in _stores)
                        {
                            <MudSelectItem Value="@((int?)store.Id)">@store.StoreName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?"
                               @bind-Value="_photoCategoryFilter"
                               @bind-Value:after="FilterPhotos"
                               Label="Filter by Category"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="rounded-lg">
                        <MudSelectItem Value="@((int?)null)">All Categories</MudSelectItem>
                        @foreach (var category in _categories)
                        {
                            <MudSelectItem Value="@((int?)category.Id)">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudDatePicker @bind-Date="_photoDateFilter"
                                   @bind-Date:after="FilterPhotos"
                                   Label="Date"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="rounded-lg" />
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.body2" Class="@($"{GetStatusTextColor()} font-weight-bold mb-3")" Style="opacity: 0.8;">
                Showing @_filteredPhotos.Count of @_allPhotos.Count photos
            </MudText>

            @if (_filteredPhotos.Any())
            {
                <div class="photo-grid">
                    @foreach (var photo in _filteredPhotos)
                    {
                        <div class="photo-item" @onclick="@(() => OpenPhotoDialog(photo))">
                            @if (photo.ImageData != null && !string.IsNullOrEmpty(photo.ImageMimeType))
                            {
                                <img src="@($"data:{photo.ImageMimeType};base64,{Convert.ToBase64String(photo.ImageData)}")" alt="@(photo.Description ?? "Photo")" />
                            }
                            else
                            {
                                <div style="width: 100%; height: 100%; background: rgba(0,114,207,0.2); display: flex; align-items: center; justify-content: center;">
                                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Style="opacity: 0.5;" />
                                </div>
                            }
                            <div class="photo-overlay">
                                <div>@(photo.Store?.StoreName ?? "Unknown Store")</div>
                                <div style="opacity: 0.7;">@photo.UploadedAt.ToString("MMM dd, yyyy")</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <MudPaper Class="@($"glass-panel pa-8 text-center {GetThemeClass()}")" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Size="Size.Large" Style="font-size: 4rem; opacity: 0.3; margin-bottom: 16px;" />
                    <MudText Typo="Typo.h6" Style="font-weight: 700; margin-bottom: 8px;">No Photos Found</MudText>
                    <MudText Typo="Typo.body2" Style="opacity: 0.7;">
                        @if (HasPhotoFilters())
                        {
                            <text>Try adjusting your filters to find photos.</text>
                        }
                        else
                        {
                            <text>Photos uploaded during task completion will appear here.</text>
                        }
                    </MudText>
                </MudPaper>
            }
        </MudTabPanel>

        <!-- Activity Log Tab -->
        <MudTabPanel Text="Recent Activity" Icon="@Icons.Material.Filled.History">
            @if (_recentActivities.Any())
            {
                @foreach (var activity in _recentActivities.Take(20))
                {
                    <div class="activity-item">
                        <div class="activity-icon" style="@GetActivityIconStyle(activity.Action)">
                            <MudIcon Icon="@GetActivityIcon(activity.Action)" Size="Size.Small" />
                        </div>
                        <div class="activity-content">
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                @(activity.User?.Fullname ?? "System")
                                <span style="font-weight: 400;">@GetActivityDescription(activity)</span>
                            </MudText>
                            <MudText Class="activity-time">
                                @GetRelativeTime(activity.Timestamp)
                                @if (activity.Store != null)
                                {
                                    <span> • @activity.Store.StoreName</span>
                                }
                            </MudText>
                        </div>
                    </div>
                }
            }
            else
            {
                <MudPaper Class="@($"glass-panel pa-8 text-center {GetThemeClass()}")" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Style="font-size: 4rem; opacity: 0.3; margin-bottom: 16px;" />
                    <MudText Typo="Typo.h6" Style="font-weight: 700; margin-bottom: 8px;">No Recent Activity</MudText>
                    <MudText Typo="Typo.body2" Style="opacity: 0.7;">User activities will be logged and displayed here.</MudText>
                </MudPaper>
            }
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private bool _initialized = false;

    // Dashboard Stats
    private int _taskCompletionRate = 0;
    private int _activeStores = 0;
    private int _totalStores = 0;
    private int _activeUsers = 0;
    private int _totalPhotos = 0;

    // Report Filters
    private string _reportType = "All";
    private int? _selectedStoreId;
    private DateRange? _dateRange;
    private string _exportFormat = "Excel";
    private bool _hasPreviewData = false;

    // Photo Gallery Filters
    private string _photoSearchTerm = string.Empty;
    private int? _photoStoreFilter;
    private int? _photoCategoryFilter;
    private DateTime? _photoDateFilter;

    // Data Lists
    private List<Store> _stores = new();
    private List<Category> _categories = new();
    private List<User> _users = new();
    private List<ActivityLog> _activityLogs = new();
    private List<ActivityLog> _recentActivities = new();
    private List<TaskPhoto> _allPhotos = new();
    private List<TaskPhoto> _filteredPhotos = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await UserState.InitializeAsync();
            await LoadData();
            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Load stores
        if (UserState.Role == "Store Head")
        {
            _stores = await db.Stores.AsNoTracking().Where(s => s.StoreHeadId == UserState.UserId).OrderBy(s => s.StoreName).ToListAsync();
        }
        else
        {
            _stores = await db.Stores.AsNoTracking().OrderBy(s => s.StoreName).ToListAsync();
        }
        _totalStores = _stores.Count;
        _activeStores = _stores.Count(s => s.Status == "Active");

        // Load categories
        _categories = await db.Categories.AsNoTracking().OrderBy(c => c.SortOrder).ToListAsync();

        // Load users
        _users = await db.Users.AsNoTracking().ToListAsync();
        _activeUsers = _users.Count(u => u.Status == "Active");

        // Load photos
        var photoQuery = db.TaskPhotos
            .Include(p => p.UploadedBy)
            .Include(p => p.Store)
            .Include(p => p.Category)
            .Include(p => p.ChecklistItem)
            .AsNoTracking();

        if (UserState.Role == "Store Head")
        {
            photoQuery = photoQuery.Where(p => p.Store != null && p.Store.StoreHeadId == UserState.UserId);
        }

        _allPhotos = await photoQuery.OrderByDescending(p => p.UploadedAt).ToListAsync();
        _filteredPhotos = _allPhotos;
        _totalPhotos = _allPhotos.Count;

        // Load recent activities
        var activityQuery = db.ActivityLogs
            .Include(a => a.User)
            .Include(a => a.Store)
            .AsNoTracking();

        if (UserState.Role == "Store Head")
        {
            activityQuery = activityQuery.Where(a => a.Store != null && a.Store.StoreHeadId == UserState.UserId);
        }

        _recentActivities = await activityQuery
            .OrderByDescending(a => a.Timestamp)
            .Take(50)
            .ToListAsync();

        // Calculate task completion rate (placeholder - you can adjust this logic)
        _taskCompletionRate = 85; // Placeholder value

        // Set default date range to last 30 days
        _dateRange = new DateRange(DateTime.Today.AddDays(-30), DateTime.Today);
    }

    private async Task GeneratePreview()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var query = db.ActivityLogs
            .Include(a => a.User)
            .Include(a => a.Store)
            .AsNoTracking();

        if (UserState.Role == "Store Head")
        {
            query = query.Where(a => a.Store != null && a.Store.StoreHeadId == UserState.UserId);
        }

        // Apply date filter
        if (_dateRange?.Start != null)
        {
            query = query.Where(a => a.Timestamp >= _dateRange.Start.Value);
        }
        if (_dateRange?.End != null)
        {
            query = query.Where(a => a.Timestamp <= _dateRange.End.Value.AddDays(1));
        }

        // Apply type filters
        if (_reportType == "ByStore" && _selectedStoreId.HasValue)
        {
            query = query.Where(a => a.StoreId == _selectedStoreId.Value);
        }

        _activityLogs = await query.OrderByDescending(a => a.Timestamp).ToListAsync();
        _hasPreviewData = _activityLogs.Any();

        StateHasChanged();

        if (_hasPreviewData)
        {
            Snackbar.Add($"Found {_activityLogs.Count} records", Severity.Success);
        }
        else
        {
            Snackbar.Add("No data found for the selected filters", Severity.Info);
        }
    }

    private Task ExportReport()
    {
        if (!_hasPreviewData)
        {
            Snackbar.Add("Please generate a preview first", Severity.Warning);
            return Task.CompletedTask;
        }

        // TODO: Implement PDF/Excel export using existing OfficeOpenXml package
        Snackbar.Add($"Export to {_exportFormat} feature coming soon!", Severity.Info);
        return Task.CompletedTask;
    }

    private void FilterPhotos()
    {
        _filteredPhotos = _allPhotos;

        if (!string.IsNullOrWhiteSpace(_photoSearchTerm))
        {
            _filteredPhotos = _filteredPhotos.Where(p =>
                (p.Description?.Contains(_photoSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }

        if (_photoStoreFilter.HasValue)
        {
            _filteredPhotos = _filteredPhotos.Where(p => p.StoreId == _photoStoreFilter.Value).ToList();
        }

        if (_photoCategoryFilter.HasValue)
        {
            _filteredPhotos = _filteredPhotos.Where(p => p.CategoryId == _photoCategoryFilter.Value).ToList();
        }

        if (_photoDateFilter.HasValue)
        {
            _filteredPhotos = _filteredPhotos.Where(p => p.UploadedAt.Date == _photoDateFilter.Value.Date).ToList();
        }

        StateHasChanged();
    }

    private bool HasPhotoFilters()
    {
        return !string.IsNullOrWhiteSpace(_photoSearchTerm) ||
               _photoStoreFilter.HasValue ||
               _photoCategoryFilter.HasValue ||
               _photoDateFilter.HasValue;
    }

