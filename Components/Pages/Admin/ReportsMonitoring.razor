                </div>
                }
                else
                {
                    <div class="pa-12 text-center" style="opacity: 0.5;">
                        <MudIcon Icon="@Icons.Material.Filled.ReportOff" Size="Size.Large" Class="mb-2" />
                        <MudText>No operational issues found matching your criteria.</MudText>
                    </div>
                }
            </MudTabPanel>
        </MudTabs>
    }
</div>

@code {
    private bool _initialized = false;

    // Dashboard Stats
    private int _taskCompletionRate = 0;
    private int _totalReports = 0;
    private int _activeOperations = 0;
    private int _totalPhotosCount = 0;
    private int _highPerformanceStoresCount = 0;
    private int _activeStoresWithDataCount = 0;

    // Report Filters

    private int? _selectedStoreId;
    private DateRange? _dateRange;
    private string _exportFormat = "Excel";

    // Photo Gallery Filters
    private bool _showPhotoFilters = false;
    private string _photoSearchTerm = string.Empty;
    private int? _photoStoreFilter;
    private int? _photoCategoryFilter;
    private DateRange? _photoDateRange;

    // UI state
    private bool _showFilters = false;

    // Issue Filters
    private bool _showIssueFilters = false;
    private string _issueSearchTerm = string.Empty;
    private int? _issueStoreFilter;
    private string _issueStatusFilter = string.Empty;

    // Data Lists
    private List<Store> _stores = new();
    private List<Category> _categories = new();
    private List<User> _users = new();
    private List<StoreDailyActivity> _activityLogs = new();
    private List<StoreDailyActivity> _activityLogsFiltered = new();
    private List<ActivityLog> _recentActivities = new();
    private List<TaskPhoto> _allPhotos = new();
    private List<TaskPhoto> _filteredPhotos = new();
    private List<CategoryPerformanceModel> _categoryPerformance = new();
    private Dictionary<int, double> _activityProgressCache = new();
    private List<Issue> _issues = new();
    private List<Issue> _issuesFiltered = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;

        // Initial date range
        _dateRange = new DateRange(DateTime.Today.AddDays(-30), DateTime.Today);
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await UserState.InitializeAsync();
            if (UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo(UserState.LastValidPage ?? UserState.GetDashboardRoute(), forceLoad: true);
                return;
            }
            await UserState.SetLastValidPage(NavigationManager.Uri);
            await LoadData();
            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task OnStoreChanged()
    {
        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Load stores
        _stores = await db.Stores.AsNoTracking().OrderBy(s => s.StoreName).ToListAsync();

        // Load categories
        _categories = await db.Categories.AsNoTracking().OrderBy(c => c.SortOrder).ToListAsync();

        // Load reports (StoreDailyActivity)
        var reportQuery = db.StoreDailyActivities
            .Include(a => a.StartedBy)
            .Include(a => a.Store)
            .AsNoTracking();

        if (_selectedStoreId.HasValue)
        {
            reportQuery = reportQuery.Where(a => a.StoreId == _selectedStoreId.Value);
        }

        _activityLogs = await reportQuery.OrderByDescending(a => a.Date).ToListAsync();
        ApplyReportFilters();

        // Cache progress for the current filtered list
        _activityProgressCache.Clear();
        foreach (var activity in _activityLogsFiltered)
        {
            _activityProgressCache[activity.Id] = await CalculateActivityProgress(activity.Id, db);
        }

        // Load photos
        var photoQuery = db.TaskPhotos
            .Include(p => p.Category)
            .Include(p => p.Store)
            .Include(p => p.UploadedBy)
            .Include(p => p.ChecklistItem)
                .ThenInclude(c => c!.Category)
            .Include(p => p.StoreDailyActivity)
                .ThenInclude(s => s!.StartedBy)
            .AsNoTracking();

        if (_selectedStoreId.HasValue)
        {
            photoQuery = photoQuery.Where(p => p.StoreId == _selectedStoreId.Value);
        }

        _allPhotos = await photoQuery.OrderByDescending(p => p.UploadedAt).ToListAsync();
        FilterPhotos();

        _checkInCategoryId = (await db.Categories.AsNoTracking().FirstOrDefaultAsync(c => c.Name.ToLower() == "check in"))?.Id;

        // Load recent activity logs
        var activityLogQuery = db.ActivityLogs
            .Include(a => a.User)
            .Include(a => a.Store)
            .AsNoTracking();

        if (_selectedStoreId.HasValue)
        {
            activityLogQuery = activityLogQuery.Where(a => a.StoreId == _selectedStoreId.Value);
        }

        _recentActivities = await activityLogQuery.OrderByDescending(a => a.Timestamp).Take(30).ToListAsync();

        // Fetch related entities for GPS data
        var photoIds = _recentActivities.Where(a => a.EntityType == "TaskPhoto" && a.EntityId.HasValue).Select(a => a.EntityId!.Value).ToList();
        var progressIds = _recentActivities.Where(a => a.EntityType == "TaskProgress" && a.EntityId.HasValue).Select(a => a.EntityId!.Value).ToList();

        _linkedPhotos = await db.TaskPhotos.AsNoTracking().Where(p => photoIds.Contains(p.Id)).ToDictionaryAsync(p => p.Id);
        _linkedProgresses = await db.TaskProgresses.Include(p => p.ChecklistItem).AsNoTracking().Where(p => progressIds.Contains(p.Id)).ToDictionaryAsync(p => p.Id);

        // Issues (all stores - Admin view)
        _issues = await db.Issues
            .AsNoTracking()
            .Include(i => i.Store)
            .Include(i => i.ReportedBy)
            .Include(i => i.ReviewedBy)
            .OrderByDescending(i => i.ReportedAt)
            .ToListAsync();

        ApplyIssueFilters();

        await CalculateStats();
    }

    private async Task CalculateStats()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        _totalReports = _activityLogs.Count;
        _totalPhotosCount = _allPhotos.Count;

        // Active Operations (reports started today)
        var opsQuery = db.StoreDailyActivities.Where(a => a.Date.Date == DateTime.Today);
        if (_selectedStoreId.HasValue)
        {
            opsQuery = opsQuery.Where(a => a.StoreId == _selectedStoreId.Value);
        }
        _activeOperations = await opsQuery.CountAsync();

        // High performance stores (>= 90% today)
        var todayStats = _activityProgressCache.Where(kv =>
        {
            var activity = _activityLogs.FirstOrDefault(a => a.Id == kv.Key);
            return activity?.Date.Date == DateTime.Today;
        }).ToList();

        _highPerformanceStoresCount = todayStats.Count(kv => kv.Value >= 90);
        _activeStoresWithDataCount = todayStats.Count;

        // Avg Completion
        if (_activityProgressCache.Any())
        {
            _taskCompletionRate = (int)_activityProgressCache.Values.Average();
        }
        else
        {
            _taskCompletionRate = 0;
        }

        // Performance Breakdown
        _categoryPerformance.Clear();

        // Optimize: Get all progress for relevant activities
        var relevantActivityIds = _activityLogsFiltered.Select(a => a.Id).ToList();
        var allProgress = await db.TaskProgresses
            .Include(p => p.ChecklistItem)
            .Where(p => relevantActivityIds.Contains(p.StoreDailyActivityId))
            .ToListAsync();

        foreach (var cat in _categories)
        {
            var catTasks = allProgress.Where(p => p.ChecklistItem?.CategoryId == cat.Id).ToList();
            if (catTasks.Any())
            {
                var rate = (double)catTasks.Count(p => p.IsCompleted) / catTasks.Count * 100;
                _categoryPerformance.Add(new CategoryPerformanceModel { CategoryName = cat.Name, CompletionRate = (int)rate });
            }
        }
    }

    private void ApplyReportFilters()
    {
        _activityLogsFiltered = _activityLogs;

        if (_dateRange != null && _dateRange.Start.HasValue && _dateRange.End.HasValue)
        {
            var startDate = _dateRange.Start.Value.Date;
            var endDate = _dateRange.End.Value.Date.AddDays(1).AddSeconds(-1);

            _activityLogsFiltered = _activityLogsFiltered
                .Where(a => a.Date >= startDate && a.Date <= endDate)
                .ToList();
        }
    }

    private void ClearReportFilters()
    {
        _dateRange = null;
        ApplyReportFilters();
    }

    private bool HasActiveReportFilters() => _dateRange != null && _dateRange.Start.HasValue;

    private void FilterPhotos()
    {
        var photos = _allPhotos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_photoSearchTerm))
        {
            photos = photos.Where(p =>
                (p.Description?.Contains(_photoSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.ChecklistItem?.TaskName?.Contains(_photoSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.UploadedBy?.Fullname?.Contains(_photoSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            );
        }

        if (_photoStoreFilter.HasValue)
        {
            photos = photos.Where(p => p.StoreId == _photoStoreFilter.Value);
        }

        if (_photoCategoryFilter.HasValue)
        {
            photos = photos.Where(p => p.CategoryId == _photoCategoryFilter.Value);
        }

        if (_photoDateRange != null && _photoDateRange.Start.HasValue && _photoDateRange.End.HasValue)
        {
            var start = _photoDateRange.Start.Value.Date;
            var end = _photoDateRange.End.Value.Date.AddDays(1).AddSeconds(-1);
            photos = photos.Where(p => p.UploadedAt >= start && p.UploadedAt <= end);
        }

        _filteredPhotos = photos.ToList();
    }

