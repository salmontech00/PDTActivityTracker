@page "/"
@page "/admin/reports-monitoring"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Components.Pages.Dialogs
@inject IDialogService DialogService
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Reports & Monitoring</PageTitle>

<style>
    .reports-container {
        padding: 1rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 20px !important;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        padding: 0;
    }

    .button-group {
        display: flex;
        gap: 12px;
        padding: 0;
        margin: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* STAT CARDS */
    .stat-card {
        padding: 20px;
        text-align: center;
        position: relative;
        overflow: hidden;
        border-radius: 20px !important;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #0072cf, #00c6ff);
        }

    .stat-value {
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .stat-label {
        font-size: 0.8rem;
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 8px;
    }

    /* MOBILE STAT CARDS GRID */
    .mobile-stats-grid {
        display: none;
    }

    /* PHOTO GALLERY */
    .photo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 16px;
        padding: 16px;
    }

    .photo-item {
        position: relative;
        aspect-ratio: 1;
        border-radius: 12px;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .photo-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        }

        .photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .photo-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 8px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
        color: white;
        font-size: 0.7rem;
    }

    /* MODERN TABLE */
    .mud-table {
        background: transparent !important;
    }

    .mud-table-head {
        background: rgba(0, 114, 207, 0.1);
    }

        .mud-table-head.lightest {
            background: rgba(0, 114, 207, 0.05);
        }

    .mud-table-cell {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        padding: 12px 16px !important;
    }

    .lightest .mud-table-cell {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .mud-table-row:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .lightest .mud-table-row:hover {
        background-color: rgba(0, 114, 207, 0.05) !important;
    }

    .mud-table-pagination {
        background-color: transparent !important;
        border-top: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: inherit !important;
    }

    .lightest .mud-table-pagination {
        border-top: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    /* BUTTONS */
    .modern-button {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
    }

    /* CHIPS */
    .role-chip {
        font-weight: 700 !important;
        border-radius: 12px !important;
    }

    /* Action Icon Buttons white in darker themes */
    .light .mud-icon-button.mud-info-text,
    .dark .mud-icon-button.mud-info-text,
    .light .mud-icon-button.mud-primary-text,
    .dark .mud-icon-button.mud-primary-text {
        color: #ffffff !important;
    }

    /* MOBILE CARDS */
    .mobile-card {
        margin-bottom: 16px;
        overflow: hidden;
    }

    .mobile-card-header {
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .lightest .mobile-card-header {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1);
    }

    .mobile-card-content {
        padding: 16px;
    }

    .mobile-card-actions {
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .lightest .mobile-card-actions {
        background: rgba(0, 114, 207, 0.03);
    }

    /* Filter Toggle Button */
    .filter-toggle-button {
        display: none;
    }

    /* RESPONSIVE */
    @@media (max-width: 960px) {
        .mud-picker-datepicker-toolbar {
            display: none !important;
        }

        .mud-picker-paper {
            left: 50% !important;
            transform: translateX(-50%) !important;
            right: auto !important;
            max-height: calc(100vh - 100px) !important;
            overflow-y: auto !important;
        }

        .mud-popover {
            left: 50% !important;
            transform: translateX(-50%) !important;
        }

        .desktop-view {
            display: none;
        }

        .page-title {
            display: none;
        }

        .page-header-row {
            justify-content: center;
            margin-top: 0px;
            margin-bottom: 6px;
        }
        /* Mobile tab fixes */
        .monitoring-tabs .mud-tabs-toolbar {
            overflow: visible !important;
        }

        .monitoring-tabs .mud-tabs-toolbar-content {
            overflow-x: auto !important;
            overflow-y: hidden !important;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

            .monitoring-tabs .mud-tabs-toolbar-content::-webkit-scrollbar {
                display: none;
            }

        .monitoring-tabs .mud-tab {
            flex: 0 0 auto !important;
            min-width: unset !important;
            max-width: none !important;
            font-size: 0.60rem !important;
            padding: 4px 8px !important;
            white-space: nowrap !important;
        }

        .monitoring-tabs .mud-tabs-scroll-button {
            display: none !important;
        }

        .photo-grid {
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 8px;
        }

        .filter-toggle-button {
            display: inline-flex !important;
            width: 100%;
        }

        .button-group {
            flex-direction: row !important;
            width: 100%;
            justify-content: space-between;
        }

            .button-group .modern-button {
                flex: 1;
                font-size: 0.70rem !important;
            }

        .glass-panel.filter-panel .mud-grid {
            display: none;
        }

        .glass-panel.filter-panel.filters-visible .mud-grid {
            display: flex !important;
        }

        .desktop-stats {
            display: none !important;
        }

        .mobile-stats-grid {
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 16px;
        }

            .mobile-stats-grid .stat-card {
                padding: 10px 8px;
                border-radius: 12px !important;
            }

                .mobile-stats-grid .stat-card::before {
                    height: 3px;
                }

            .mobile-stats-grid .stat-value {
                font-size: 1.4rem;
                line-height: 1.1;
            }

            .mobile-stats-grid .stat-label {
                font-size: 0.6rem;
                letter-spacing: 0.5px;
                margin-top: 4px;
            }
    }

    @@media (min-width: 961px) {
        .desktop-view {
            display: block;
        }

        .mobile-view {
            display: none;
        }
    }

    @@media (max-width: 375px) {
        .mud-main-content {
            padding-bottom: 0px !important;
            padding-left: 0px !important;
            padding-right: 0px !important;
        }

        .mud-picker-paper {
            max-height: calc(100vh - 80px) !important;
            overflow-y: auto !important;
        }

        .monitoring-tabs .mud-tab {
            flex: 0 0 auto !important;
            min-width: unset !important;
            max-width: none !important;
            font-size: 0.55rem !important;
            padding: 4px 8px !important;
            white-space: nowrap !important;
        }
    }

    /* ACTIVITY LOG (Specific to Admin) */
    .activity-item {
        padding: 12px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .lightest .activity-item {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1);
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .activity-content {
        flex: 1;
    }

    .activity-time {
        font-size: 0.75rem;
        opacity: 0.6;
    }

    /* Activity Log Header Responsive */
    .activity-log-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    @@media (max-width: 600px) {
        .activity-log-header .mud-typography-h6 {
            font-size: 1.1rem !important;
        }

        .clear-log-btn-text {
            display: none;
        }

        .clear-log-btn {
            min-width: unset !important;
            padding: 8px !important;
        }

        .filter-info-text {
            font-size: 0.75rem !important;
        }

        .clear-filters-button {
            height: 28px !important;
            font-size: 0.7rem !important;
        }

            .clear-filters-button .mud-button-label {
                line-height: 1 !important;
            }
    }
</style>

<div class="reports-container">
    <div class="page-header-row">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Reports & Monitoring</MudText>
        <div class="button-group">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="OpenExportDialog"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetHeaderButtonStyle()">
                EXPORT REPORT
            </MudButton>
        </div>
    </div>

    @if (!_initialized)
    {
        <div class="d-flex justify-center pa-12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        <!-- Dashboard Stats (Desktop) -->
        <MudGrid Class="mb-6 desktop-stats">
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-success">@_taskCompletionRate%</div>
                    <div class="stat-label">Avg. Completion</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-info">@_totalReports</div>
                    <div class="stat-label">Total Reports</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-warning">@_activeOperations</div>
                    <div class="stat-label">Active Ops</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-primary">@_totalPhotosCount</div>
                    <div class="stat-label">Gallery Items</div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Dashboard Stats (Mobile) -->
        <div class="mobile-stats-grid">
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-success">@_taskCompletionRate%</div>
                <div class="stat-label">Avg. Comp</div>
            </MudPaper>
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-info">@_totalReports</div>
                <div class="stat-label">Total Rep</div>
            </MudPaper>
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-warning">@_activeOperations</div>
                <div class="stat-label">Active Ops</div>
            </MudPaper>
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-primary">@_totalPhotosCount</div>
                <div class="stat-label">Items</div>
            </MudPaper>
        </div>

        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="@($"glass-panel monitoring-tabs {GetThemeClass()}")" PanelClass="pa-4">

            <!-- Performance & History -->
            <MudTabPanel Text="Performance & Reports" Icon="@Icons.Material.Filled.Timeline">
                <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showFilters ? "filters-visible" : "")}")" Elevation="0">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                               FullWidth="true"
                               OnClick="@(() => _showFilters = !_showFilters)"
                               Class="filter-toggle-button"
                               Style="margin-bottom: 16px;">
                        @(_showFilters ? "Hide Filters" : "Show Filters")
                    </MudButton>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="12" md="6">
                            <MudDateRangePicker Label="Date Range"
                                                @bind-DateRange="_dateRange"
                                                @bind-DateRange:after="ApplyReportFilters"
                                                Variant="Variant.Outlined"
                                                Dense="true"
                                                Margin="Margin.Dense"
                                                AnchorOrigin="Origin.BottomCenter"
                                                TransformOrigin="Origin.TopCenter" />
                        </MudItem>
                        <MudItem xs="12" sm="12" md="6">
                            <MudAutocomplete T="Store"
                                             Label="Store"
                                             Value="@(_stores.FirstOrDefault(s => s.Id == _selectedStoreId))"
                                             ValueChanged="@(s => { _selectedStoreId = s?.Id; _ = OnStoreChanged(); })"
                                             SearchFunc="@SearchStores"
                                             ToStringFunc="@(s => s == null ? "All Stores" : $"{s.StoreCode} - {s.StoreName}")"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="true"
                                             CoerceValue="false"
                                             Clearable="true"
                                             Placeholder="Search stores..."
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Class="rounded-lg" />
                        </MudItem>
                    </MudGrid>

                    <MudGrid>
                        <MudItem xs="12">
                            <div class="d-flex justify-space-between align-center px-1">
                                <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                    Showing @(_activityLogsFiltered.Count) of @(_activityLogs.Count) reports
                                </MudText>
                                @if (HasActiveReportFilters())
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Clear"
                                               OnClick="ClearReportFilters"
                                               Class="clear-filters-button">
                                        Clear Filters
                                    </MudButton>
                                }
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @if (_activityLogsFiltered.Any())
                {
                    <div class="desktop-view">
                        <MudTable Items="_activityLogsFiltered" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Store</MudTh>
                                <MudTh>Started By</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Completed At</MudTh>
                                <MudTh>Progress</MudTh>
                                <MudTh Style="text-align: center;">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Date.ToString("MMM dd, yyyy")</MudTd>
                                <MudTd DataLabel="Store">@(context.Store?.StoreName ?? "---")</MudTd>
                                <MudTd DataLabel="Started By">@(context.StartedBy?.Fullname ?? "---")</MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="@GetActivityStatusColor(context)" Variant="Variant.Text" Class="role-chip">
                                        @GetActivityStatusLabel(context)
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Completed At">@(context.CompletedAt?.ToString("hh:mm tt") ?? "-")</MudTd>
                                <MudTd DataLabel="Progress">
                                    <div class="d-flex align-center gap-2">
                                        <MudProgressLinear Color="Color.Primary" Value="@GetCompletionProgress(context.Id)" Class="my-2" Style="width: 60px;" Rounded="true" />
                                        <MudText Typo="Typo.caption" Style="font-weight: 700;">@((int)GetCompletionProgress(context.Id))%</MudText>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="Action" Style="text-align: center;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenActivityDetail(context))" Title="View Details" />
                                    @if (IsActivityProtected(context))
                                    {
                                        <MudTooltip Text="Cannot delete today's or active records">
                                            <MudIconButton Icon="@Icons.Material.Filled.Lock" Color="Color.Default" Size="Size.Small" Disabled="true" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteActivity(context))" Title="Delete Record" />
                                    }
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager />
                            </PagerContent>
                        </MudTable>
                    </div>

                    <div class="mobile-view">
                        @foreach (var activity in _activityLogsFiltered)
                        {
                            <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                                <div class="mobile-card-header">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@activity.Date.ToString("MMM dd, yyyy")</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetActivityStatusColor(activity)" Variant="Variant.Text" Class="role-chip">
                                        @GetActivityStatusLabel(activity)
                                    </MudChip>
                                </div>
                                <div class="mobile-card-content">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Store</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@(activity.Store?.StoreName ?? "---")</MudText>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Started By</MudText>
                                            <MudText Typo="Typo.body2">@(activity.StartedBy?.Fullname ?? "---")</MudText>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Completed At</MudText>
                                            <MudText Typo="Typo.body2">@(activity.CompletedAt?.ToString("hh:mm tt") ?? "-")</MudText>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <div class="d-flex align-center justify-space-between mb-1">
                                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Progress</MudText>
                                                <MudText Typo="Typo.caption" Style="font-weight: 700;">@((int)GetCompletionProgress(activity.Id))%</MudText>
                                            </div>
                                            <MudProgressLinear Color="Color.Primary" Value="@GetCompletionProgress(activity.Id)" Rounded="true" Size="Size.Small" />
                                        </MudItem>
                                    </MudGrid>
                                </div>
                                <div class="mobile-card-actions">
                                    <MudButton StartIcon="@Icons.Material.Filled.Visibility" Variant="Variant.Text" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenActivityDetail(activity))" Class="modern-button">
                                        Details
                                    </MudButton>
                                    @if (!IsActivityProtected(activity))
                                    {
                                        <MudButton StartIcon="@Icons.Material.Filled.Delete" Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteActivity(activity))" Class="modern-button">
                                            Delete
                                        </MudButton>
                                    }
                                </div>
                            </MudPaper>
                        }
                    </div>
                }
                else
                {
                    <div class="pa-12 text-center" style="opacity: 0.5;">
                        <MudIcon Icon="@Icons.Material.Filled.ReportOff" Size="Size.Large" Class="mb-2" />
                        <MudText>No activity reports found matching your criteria.</MudText>
                    </div>
                }
            </MudTabPanel>

            <!-- Photo Gallery -->
            <MudTabPanel Text="Photo Gallery" Icon="@Icons.Material.Filled.PhotoLibrary">
                <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showPhotoFilters ? "filters-visible" : "")}")" Elevation="0">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@(_showPhotoFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                               FullWidth="true"
                               OnClick="@(() => _showPhotoFilters = !_showPhotoFilters)"
                               Class="filter-toggle-button"
                               Style="margin-bottom: 16px;">
                        @(_showPhotoFilters ? "Hide Filters" : "Show Filters")
                    </MudButton>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField T="string" @bind-Value="_photoSearchTerm" @bind-Value:after="FilterPhotos" Label="Search" Placeholder="Task or user..." Variant="Variant.Outlined" Margin="Margin.Dense" Class="rounded-lg" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudAutocomplete T="Store"
                                             Label="Store"
                                             Value="@(_stores.FirstOrDefault(s => s.Id == _photoStoreFilter))"
                                             ValueChanged="@(s => { _photoStoreFilter = s?.Id; FilterPhotos(); })"
                                             SearchFunc="@SearchStores"
                                             ToStringFunc="@(s => s == null ? "All Stores" : $"{s.StoreCode} - {s.StoreName}")"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="true"
                                             CoerceValue="false"
                                             Clearable="true"
                                             Placeholder="Search stores..."
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Class="rounded-lg" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="2">
                            <MudSelect T="int?" @bind-Value="_photoCategoryFilter" @bind-Value:after="FilterPhotos" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Class="rounded-lg">
