                                          Margin="Margin.Dense"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudAutocomplete T="Store"
                                             Label="Store"
                                             Value="@(_stores.FirstOrDefault(s => s.Id == _issueStoreFilter))"
                                             ValueChanged="@(s => { _issueStoreFilter = s?.Id; ApplyIssueFilters(); })"
                                             SearchFunc="@SearchStores"
                                             ToStringFunc="@(s => s == null ? "All Stores" : $"{s.StoreCode} - {s.StoreName}")"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="true"
                                             CoerceValue="false"
                                             Clearable="true"
                                             Placeholder="Search stores..."
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Class="rounded-lg" />
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudSelect T="string" @bind-Value="_issueStatusFilter" @bind-Value:after="ApplyIssueFilters" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                <MudSelectItem Value="@(string.Empty)">All Status</MudSelectItem>
                                <MudSelectItem Value="@("Open")">Open</MudSelectItem>
                                <MudSelectItem Value="@("Resolved")">Resolved</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudGrid>
                        <MudItem xs="12">
                            <div class="d-flex justify-space-between align-center px-1">
                                <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                    Showing @(_issuesFiltered.Count) of @(_issues.Count) issues
                                </MudText>
                                @if (HasIssueFilters())
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Clear"
                                               OnClick="ClearIssueFilters"
                                               Class="clear-filters-button">
                                        Clear Filters
                                    </MudButton>
                                }
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @if (_issuesFiltered.Any())
                {
                <div class="desktop-view">
                    <MudTable Items="_issuesFiltered" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0" Class="glass-panel">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh>Store</MudTh>
                            <MudTh>Category</MudTh>
                            <MudTh>Reported By</MudTh>
                            <MudTh>Priority</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh Style="text-align: center;">Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.ReportedAt.ToString("MMM dd, yyyy")</MudTd>
                            <MudTd DataLabel="Store">@(context.Store?.StoreName ?? "---")</MudTd>
                            <MudTd DataLabel="Category">@context.Title</MudTd>
                            <MudTd DataLabel="Reported By">@(context.ReportedBy?.Fullname ?? "---")</MudTd>
                            <MudTd DataLabel="Priority">
                                <MudChip T="string" Size="Size.Small" Color="@GetIssuePriorityColor(context.Priority)" Variant="Variant.Text">@context.Priority</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small" Color="@GetIssueStatusColor(context.Status)" Variant="Variant.Filled">@context.Status</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Action" Style="text-align: center;">
                                <div class="d-flex justify-center gap-1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenIssueDetail(context))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteIssue(context))" />
                                </div>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                </div>

                <div class="mobile-view">
                    @foreach (var issue in _issuesFiltered)
                    {
                        <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                            <div class="mobile-card-header">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@issue.ReportedAt.ToString("MMM dd")</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@GetIssueStatusColor(issue.Status)" Variant="Variant.Filled">
                                    @issue.Status
                                </MudChip>
                            </div>
                            <div class="mobile-card-content">
                                <div class="d-flex justify-space-between align-start">
                                    <MudText Typo="Typo.body2" Style="font-weight: 700;">@issue.Title</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetIssuePriorityColor(issue.Priority)" Variant="Variant.Text">@issue.Priority</MudChip>
                                </div>
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Store: @(issue.Store?.StoreName)</MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">By: @(issue.ReportedBy?.Fullname ?? "---")</MudText>
                                <MudText Typo="Typo.body2" Class="mt-2">@issue.Description</MudText>
