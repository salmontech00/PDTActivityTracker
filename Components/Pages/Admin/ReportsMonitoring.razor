                </MudItem>
            </MudGrid>
        </MudTabPanel>

            <!-- Tools & Logs -->
            <MudTabPanel Text="Tools & Logs" Icon="@Icons.Material.Filled.Settings">
                <MudGrid>
                    <MudItem xs="12">
                        <MudPaper Class="@($"glass-panel {GetThemeClass()}")" Elevation="0" Style="max-height: 500px; overflow-y: auto;">
                            <div class="pa-4 border-b activity-log-header">
                                <MudText Typo="Typo.h6" Style="font-weight: 700;">System Activity Log</MudText>
                                <MudButton Variant="Variant.Text"
