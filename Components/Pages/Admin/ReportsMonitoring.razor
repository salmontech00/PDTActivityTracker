@page "/"
@page "/admin/reports-monitoring"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Components.Pages.Dialogs
@inject IDialogService DialogService
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Reports & Monitoring</PageTitle>

<style>
    .reports-container {
        padding: 1rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 20px !important;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        padding: 0;
    }

    .button-group {
        display: flex;
        gap: 12px;
        padding: 0;
        margin: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* STAT CARDS */
    .stat-card {
        padding: 20px;
        text-align: center;
        position: relative;
        overflow: hidden;
        border-radius: 20px !important;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #0072cf, #00c6ff);
        }

    .stat-value {
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .stat-label {
        font-size: 0.8rem;
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 8px;
    }

    /* MOBILE STAT CARDS GRID */
    .mobile-stats-grid {
        display: none;
    }

    /* PHOTO GALLERY */
    .photo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 16px;
        padding: 16px;
    }

    .photo-item {
        position: relative;
        aspect-ratio: 1;
        border-radius: 12px;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .photo-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        }

        .photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .photo-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 8px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
        color: white;
        font-size: 0.7rem;
    }

    /* MODERN TABLE */
    .mud-table {
        background: transparent !important;
    }

    .mud-table-head {
        background: rgba(0, 114, 207, 0.1);
    }

        .mud-table-head.lightest {
            background: rgba(0, 114, 207, 0.05);
        }

    .mud-table-cell {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        padding: 12px 16px !important;
    }

    .lightest .mud-table-cell {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .mud-table-row:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .lightest .mud-table-row:hover {
        background-color: rgba(0, 114, 207, 0.05) !important;
    }

    .mud-table-pagination {
        background-color: transparent !important;
        border-top: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: inherit !important;
    }

    .lightest .mud-table-pagination {
        border-top: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    /* BUTTONS */
    .modern-button {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
    }

    .clear-filters-button.mud-button-root,
    .clear-log-btn.mud-button-root {
        font-weight: 700 !important;
    }

    /* PREMIUM ICON BOXES */
    .achievement-icon-box {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .activity-item {
        display: flex;
        gap: 12px;
        padding: 8px;
        border-radius: 12px;
        transition: all 0.2s ease;
        align-items: center;
    }

    .activity-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* CHIPS */
    .role-chip {
        font-weight: 700 !important;
        border-radius: 12px !important;
    }

    /* Solid Action Buttons across all themes */
    .action-icon-circle.mud-button-root {
        width: 32px !important;
        height: 32px !important;
        min-width: unset !important;
        border-radius: 50% !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        color: #ffffff !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15) !important;
    }

        .action-icon-circle.mud-button-root:hover {
            transform: scale(1.15) !important;
            filter: brightness(1.1) !important;
        }

    .action-pill-btn.mud-button-root {
        border-radius: 20px !important;
        padding: 4px 14px !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        text-transform: none !important;
        font-size: 0.75rem !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15) !important;
    }

        .action-pill-btn.mud-button-root:hover {
            transform: translateY(-2px) !important;
            filter: brightness(1.1) !important;
        }

    /* Specific Action Button Colors (Consistent in all themes) */
    .action-btn-info {
        background-color: #0072cf !important;
    }

    .action-btn-error {
        background-color: #ef4444 !important;
    }

    .action-btn-default {
        background-color: #94a3b8 !important;
    }

    /* MOBILE CARDS */
    .mobile-card {
        margin-bottom: 16px;
        overflow: hidden;
    }

    .mobile-card-header {
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .lightest .mobile-card-header {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1);
    }

    .mobile-card-content {
        padding: 16px;
    }

    .mobile-card-actions {
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .lightest .mobile-card-actions {
        background: rgba(0, 114, 207, 0.03);
    }

    /* Filter Toggle Button */
    .filter-toggle-button {
        display: none;
        text-transform: none !important;
    }

    /* RESPONSIVE */
    @@media (max-width: 960px) {
        .mud-picker-datepicker-toolbar {
            display: none !important;
        }

        .mud-picker-paper {
            left: 50% !important;
            transform: translateX(-50%) !important;
            right: auto !important;
            max-height: calc(100vh - 100px) !important;
            overflow-y: auto !important;
        }

        .mud-popover {
            left: 50% !important;
            transform: translateX(-50%) !important;
        }

        .desktop-view {
            display: none;
        }

        .page-title {
            display: none;
        }

        .page-header-row {
            justify-content: center;
            margin-top: 0px;
            margin-bottom: 6px;
        }
        /* Mobile tab navigation scroll fix - native swipe */
        .monitoring-tabs .mud-tabs-tabbar {
            overflow: hidden !important;
        }

        .monitoring-tabs .mud-tabs-tab-container {
            overflow-x: auto !important;
            overflow-y: hidden !important;
            display: flex !important;
            flex-wrap: nowrap !important;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            -ms-overflow-style: none;
            cursor: grab;
            scroll-behavior: smooth;
        }

            .monitoring-tabs .mud-tabs-tab-container::-webkit-scrollbar {
                display: none;
            }

        .monitoring-tabs .mud-tab {
            flex: 0 0 auto !important;
            min-width: unset !important;
            min-width: unset !important;
            max-width: none !important;
            font-size: 0.65rem !important;
            padding: 8px 12px !important;
            white-space: nowrap !important;
        }

        .monitoring-tabs .mud-tabs-scroll-button {
            display: none !important;
        }

        .photo-grid {
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 8px;
        }

        .filter-toggle-button {
            display: inline-flex !important;
            width: 100%;
        }

        .button-group {
            flex-direction: row !important;
            width: 100%;
            justify-content: space-between;
        }

            .button-group .modern-button {
                flex: 1;
                font-size: 0.70rem !important;
            }

        .glass-panel.filter-panel .mud-grid {
            display: none;
        }

        .glass-panel.filter-panel.filters-visible .mud-grid {
            display: flex !important;
        }

        .desktop-stats {
            display: none !important;
        }

        .mobile-stats-grid {
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 16px;
        }

            .mobile-stats-grid .stat-card {
                padding: 10px 8px;
                border-radius: 12px !important;
            }

                .mobile-stats-grid .stat-card::before {
                    height: 3px;
                }

            .mobile-stats-grid .stat-value {
                font-size: 1.4rem;
                line-height: 1.1;
            }

            .mobile-stats-grid .stat-label {
                font-size: 0.6rem;
                letter-spacing: 0.5px;
                margin-top: 4px;
            }

        .mobile-nav-grid .mud-button-root {
            white-space: nowrap !important;
            overflow: hidden !important;
            font-size: 0.60rem !important;
            height: 36px !important;
            min-height: 36px !important;
        }

            .mobile-nav-grid .mud-button-root .mud-button-label {
                white-space: nowrap !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                font-size: 0.60rem !important;
            }

            .mobile-nav-grid .mud-button-root .mud-button-icon-start {
                font-size: 0.85rem !important;
                flex-shrink: 0 !important;
            }

        .action-buttons-container {
            flex-direction: column !important;
            align-items: flex-end !important;
            gap: 8px !important;
        }

        .filters-summary-row {
            align-items: center !important;
        }

        .clear-filters-button.mud-button-root {
            height: 24px !important;
            font-size: 0.6rem !important;
            padding: 0 4px !important;
            min-width: unset !important;
        }

        .clear-filters-button .mud-button-label {
            white-space: nowrap !important;
            line-height: 1 !important;
            font-size: 0.6rem !important;
        }

        .clear-filters-button .mud-button-icon-start {
            font-size: 0.5rem !important;
            margin-inline-end: 2px !important;
            margin-inline-start: -3px !important;
        }

        .filter-info-text {
            font-size: 0.75rem !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            min-width: 0 !important;
            flex: 1 1 0 !important;
        }
        .filters-summary-row > div:first-child,
        .filters-summary-row > .mud-text:first-child {
            min-width: 0 !important;
            flex: 1 1 0 !important;
            overflow: hidden !important;
        }
    }

    @@media (min-width: 961px) {
        .desktop-view {
            display: block;
        }

        .mobile-view {
            display: none;
        }
    }

    @@media (max-width: 375px) {
        /* Make CLEAR FILTERS button much more compact */
        .clear-filters-button.mud-button-root {
            height: 20px !important;
            font-size: 0.5rem !important;
            padding: 0 3px !important;
            min-width: unset !important;
        }

        .clear-filters-button .mud-button-label {
            white-space: nowrap !important;
            line-height: 1 !important;
            font-size: 0.5rem !important;
        }

        .clear-filters-button .mud-button-icon-start {
            font-size: 0.4rem !important;
            margin-inline-end: 1px !important;
            margin-inline-start: -3px !important;
        }

        .filter-info-text {
            font-size: 0.60rem !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            min-width: 0 !important;
            flex: 1 1 0 !important;
            max-width: 55% !important;
        }

        /* Reduce side margins like AVP */
        .mud-main-content {
            padding-bottom: 0px !important;
            padding-left: 0px !important;
            padding-right: 0px !important;
        }

        /* Shrink nav tab buttons - denser like AVP */
        .mobile-nav-grid .mud-button-root {
            font-size: 0.62rem !important;
            padding: 4px 6px !important;
            min-height: 32px !important;
            height: 32px !important;
            border-radius: 10px !important;
        }

            .mobile-nav-grid .mud-button-root .mud-button-label {
                font-size: 0.62rem !important;
                line-height: 1 !important;
            }

            .mobile-nav-grid .mud-button-root .mud-button-icon-start {
                font-size: 0.9rem !important;
                margin-inline-end: 3px !important;
                margin-inline-start: -2px !important;
            }

            .mobile-nav-grid .mud-button-root .mud-icon-root {
                font-size: 0.9rem !important;
                width: 0.9rem !important;
                height: 0.9rem !important;
            }
    }

    /* ACTIVITY LOG (Specific to Admin) */
    .activity-item {
        padding: 12px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .lightest .activity-item {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1);
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .activity-content {
        flex: 1;
        min-width: 0;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    .activity-time {
        font-size: 0.75rem;
        opacity: 0.6;
    }

    /* Activity Log Header Responsive */
    .activity-log-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    @@media (max-width: 600px) {
        .activity-log-header .mud-typography-h6 {
            font-size: 1.1rem !important;
        }

        .clear-log-btn-text {
            display: none;
        }

        .clear-log-btn {
            min-width: unset !important;
            padding: 8px !important;
        }
    }
</style>

<div class="reports-container">
    <div class="page-header-row">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Reports & Monitoring</MudText>
        <div class="button-group">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="OpenExportDialog"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetHeaderButtonStyle()">
                EXPORT REPORT
            </MudButton>
        </div>
    </div>

    @if (!_initialized)
    {
        <div class="d-flex flex-column align-center justify-center py-10" style="opacity: 0.5;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-3" />
            <MudText Typo="Typo.h6">Loading Reports...</MudText>
        </div>
    }
    else
    {
        <!-- Dashboard Stats (Desktop) -->
        <MudGrid Class="mb-6 desktop-stats">
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-success">@_taskCompletionRate%</div>
                    <div class="stat-label">Avg. Completion</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-info">@_totalReports</div>
                    <div class="stat-label">Total Reports</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-warning">@_activeOperations</div>
                    <div class="stat-label">Active Ops</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                    <div class="stat-value text-primary">@_totalPhotosCount</div>
                    <div class="stat-label">Gallery Items</div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Dashboard Stats (Mobile) -->
        <div class="mobile-stats-grid">
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-success">@_taskCompletionRate%</div>
                <div class="stat-label">Avg. Comp</div>
            </MudPaper>
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-info">@_totalReports</div>
                <div class="stat-label">Total Rep</div>
            </MudPaper>
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-warning">@_activeOperations</div>
                <div class="stat-label">Active Ops</div>
            </MudPaper>
            <MudPaper Class="@($"glass-panel stat-card {GetThemeClass()}")" Elevation="0">
                <div class="stat-value text-primary">@_totalPhotosCount</div>
                <div class="stat-label">Items</div>
            </MudPaper>
        </div>

        <!-- DESKTOP: tabs -->
        <div class="desktop-view">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="@($"glass-panel monitoring-tabs {GetThemeClass()}")" PanelClass="pa-4">

            <!-- Performance & History -->
            <MudTabPanel Text="Performance & Reports" Icon="@Icons.Material.Filled.Timeline">
                <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showFilters ? "filters-visible" : "")}")" Elevation="0">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                                   FullWidth="true"
                                   OnClick="@(() => _showFilters = !_showFilters)"
                                   Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                                   Style="@GetFilterButtonStyle()">
                            @(_showFilters ? "Hide Filters" : "Show Filters")
                        </MudButton>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="12" md="6">
                            <MudDateRangePicker Label="Date Range"
                                                @bind-DateRange="_dateRange"
                                                @bind-DateRange:after="ApplyReportFilters"
                                                Variant="Variant.Outlined"
                                                Dense="true"
                                                Margin="Margin.Dense"
                                                AnchorOrigin="Origin.BottomCenter"
                                                TransformOrigin="Origin.TopCenter" />
                        </MudItem>
                        <MudItem xs="12" sm="12" md="6">
                            <MudAutocomplete T="Store"
                                             Label="Store"
                                             Value="@(_stores.FirstOrDefault(s => s.Id == _selectedStoreId))"
                                             ValueChanged="@(s => { _selectedStoreId = s?.Id; _ = OnStoreChanged(); })"
                                             SearchFunc="@SearchStores"
                                             ToStringFunc="@(s => s == null ? "All Stores" : $"{s.StoreCode} - {s.StoreName}")"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="true"
                                             CoerceValue="false"
                                             Clearable="true"
                                             Placeholder="Search stores..."
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Class="rounded-lg" />
                        </MudItem>
                    </MudGrid>

                    <MudGrid>
                        <MudItem xs="12">
                                <div class="d-flex justify-space-between align-center px-1 filters-summary-row">
                                <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                    Showing @(_activityLogsFiltered.Count) of @(_activityLogs.Count) reports
                                </MudText>
                                <div class="action-buttons-container">
                                @if (HasActiveReportFilters())
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Secondary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Clear"
                                                   OnClick="ClearReportFilters"
                                                   Class="clear-filters-button">
                                            Clear Filters
                                        </MudButton>
                                    }
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @if (_activityLogsFiltered.Any())
                {
                    <div class="desktop-view">
                        <MudTable Items="_activityLogsFiltered" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Store</MudTh>
                                <MudTh>Started By</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Completed At</MudTh>
                                <MudTh>Progress</MudTh>
                                <MudTh Style="text-align: center;">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Date.ToString("MMM dd, yyyy")</MudTd>
                                <MudTd DataLabel="Store">@(context.Store?.StoreName ?? "---")</MudTd>
                                <MudTd DataLabel="Started By">@(context.StartedBy?.Fullname ?? "---")</MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="@GetActivityStatusColor(context)" Variant="Variant.Filled" Class="role-chip">
                                        @GetActivityStatusLabel(context)
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Completed At">@GetActivityCompletedAt(context)</MudTd>
                                <MudTd DataLabel="Progress">
                                    <div class="d-flex align-center gap-2">
                                        <MudProgressLinear Color="Color.Primary" Value="@GetCompletionProgress(context.Id)" Class="my-2" Style="width: 60px;" Rounded="true" />
                                        <MudText Typo="Typo.caption" Style="font-weight: 700;">@((int)GetCompletionProgress(context.Id))%</MudText>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="Action" Style="text-align: center;">
                                    <div class="d-flex justify-center gap-1">
                                        <MudTooltip Text="View Details">
                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Class="action-icon-circle action-btn-info" Size="Size.Small" OnClick="@(() => OpenActivityDetail(context))" />
                                        </MudTooltip>
                                        @if (IsActivityProtected(context))
                                        {
                                            <MudTooltip Text="Locked">
                                                <MudIconButton Icon="@Icons.Material.Filled.Lock" Class="action-icon-circle action-btn-default" Size="Size.Small" Disabled="true" />
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudTooltip Text="Delete Record">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Class="action-icon-circle action-btn-error" Size="Size.Small" OnClick="@(() => DeleteActivity(context))" />
                                            </MudTooltip>
                                        }
                                    </div>
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager />
                            </PagerContent>
                        </MudTable>
                    </div>

                    <div class="mobile-view">
                        @foreach (var activity in _activityLogsFiltered)
                        {
                            <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                                <div class="mobile-card-header">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@activity.Date.ToString("MMM dd, yyyy")</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetActivityStatusColor(activity)" Variant="Variant.Filled" Class="role-chip">
                                        @GetActivityStatusLabel(activity)
                                    </MudChip>
                                </div>
                                <div class="mobile-card-content">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Store</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@(activity.Store?.StoreName ?? "---")</MudText>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Started By</MudText>
                                            <MudText Typo="Typo.body2">@(activity.StartedBy?.Fullname ?? "---")</MudText>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Completed At</MudText>
                                            <MudText Typo="Typo.body2">@GetActivityCompletedAt(activity)</MudText>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <div class="d-flex align-center justify-space-between mb-1">
                                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Progress</MudText>
                                                <MudText Typo="Typo.caption" Style="font-weight: 700;">@((int)GetCompletionProgress(activity.Id))%</MudText>
                                            </div>
                                            <MudProgressLinear Color="Color.Primary" Value="@GetCompletionProgress(activity.Id)" Rounded="true" Size="Size.Small" />
                                        </MudItem>
                                    </MudGrid>
                                </div>
                                <div class="mobile-card-actions">
                                    <MudButton StartIcon="@Icons.Material.Filled.Visibility" Variant="Variant.Filled" OnClick="@(() => OpenActivityDetail(activity))" Class="action-pill-btn action-btn-info">
                                        Details
                                    </MudButton>
                                    @if (!IsActivityProtected(activity))
                                    {
                                        <MudButton StartIcon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" OnClick="@(() => DeleteActivity(activity))" Class="action-pill-btn action-btn-error">
                                            Delete
                                        </MudButton>
                                    }
                                </div>
                            </MudPaper>
                        }
                    </div>
                }
                else
                {
                    <div class="pa-12 text-center" style="opacity: 0.5;">
                        <MudIcon Icon="@Icons.Material.Filled.ReportOff" Size="Size.Large" Class="mb-2" />
                        <MudText>No activity reports found matching your criteria.</MudText>
                    </div>
                }
            </MudTabPanel>

            <!-- Photo Gallery -->
            <MudTabPanel Text="Photo Gallery" Icon="@Icons.Material.Filled.PhotoLibrary">
                <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showPhotoFilters ? "filters-visible" : "")}")" Elevation="0">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@(_showPhotoFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                               FullWidth="true"
                               OnClick="@(() => _showPhotoFilters = !_showPhotoFilters)"
                               Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                               Style="@GetFilterButtonStyle()">
                        @(_showPhotoFilters ? "Hide Filters" : "Show Filters")
                    </MudButton>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField T="string" @bind-Value="_photoSearchTerm" @bind-Value:after="FilterPhotos" Label="Search" Placeholder="Task or user..." Variant="Variant.Outlined" Margin="Margin.Dense" Class="rounded-lg" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="300" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudAutocomplete T="Store"
                                             Label="Store"
                                             Value="@(_stores.FirstOrDefault(s => s.Id == _photoStoreFilter))"
                                             ValueChanged="@(s => { _photoStoreFilter = s?.Id; FilterPhotos(); })"
                                             SearchFunc="@SearchStores"
                                             ToStringFunc="@(s => s == null ? "All Stores" : $"{s.StoreCode} - {s.StoreName}")"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="true"
                                             CoerceValue="false"
                                             Clearable="true"
                                             Placeholder="Search stores..."
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Class="rounded-lg" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="2">
                            <MudSelect T="int?" @bind-Value="_photoCategoryFilter" @bind-Value:after="FilterPhotos" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Class="rounded-lg">
                                <MudSelectItem Value="@((int?)null)">All Categories</MudSelectItem>
                                @foreach (var cat in _categories)
                                {
                                    <MudSelectItem Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="2">
                            <MudDateRangePicker Label="Date Range"
                                                @bind-DateRange="_photoDateRange"
                                                @bind-DateRange:after="FilterPhotos"
                                                Variant="Variant.Outlined"
                                                Dense="true"
                                                Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>

                    <MudGrid>
                        <MudItem xs="12">
                            <div class="d-flex justify-space-between align-center px-1 filters-summary-row">
                                <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                    Showing @_filteredPhotos.Count of @_photoTotalMatchingCount photos
                                </MudText>
                                <div class="action-buttons-container">
                                    @if (HasPhotoFilters())
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Secondary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Clear"
                                                   OnClick="ClearPhotoFilters"
                                                   Class="clear-filters-button">
                                            Clear Filters
                                        </MudButton>
                                    }
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @if (_filteredPhotos.Any())
                {
                    <div class="photo-grid">
                        @foreach (var photo in _filteredPhotos)
                        {
                            <div class="photo-item" @onclick="@(() => OpenPhotoDialog(photo))">
                                @if (photo.ImageData != null)
                                {
                                    <img src="@($"data:{photo.ImageMimeType};base64,{Convert.ToBase64String(photo.ImageData)}")" alt="Store Photo" />
                                }
                                <div class="photo-overlay">
                                    <div class="font-weight-bold">@(photo.Store?.StoreName ?? "Unknown Store")</div>
                                    <div style="opacity: 0.8;">@photo.UploadedAt.ToString("MMM dd, HH:mm")</div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (_photoTotalMatchingCount > _photoPageSize)
                    {
                        <div class="d-flex justify-center mt-6">
                            <MudPagination Color="Color.Primary" 
                                           Count="@((_photoTotalMatchingCount + _photoPageSize - 1) / _photoPageSize)" 
                                           Selected="@_photoCurrentPage" 
                                           SelectedChanged="OnPhotoPageChanged" 
                                           Variant="Variant.Filled"
                                           BoundaryCount="1"
                                           MiddleCount="3" />
                        </div>
                    }
                }
                else
                {
                    <div class="pa-12 text-center" style="opacity: 0.5;">
                        <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" Class="mb-2" />
                        <MudText>No photos found matching your criteria.</MudText>
                    </div>
                }
            </MudTabPanel>

            <!-- Analytics -->
            <MudTabPanel Text="Analytics" Icon="@Icons.Material.Filled.Assessment">
                <MudGrid>
                    <MudItem xs="12" md="6" Class="d-flex">
                        <MudPaper Class="@($"glass-panel pa-6 {GetThemeClass()} flex-grow-1")" Elevation="0" Style="border-radius: 16px !important; display: flex; flex-direction: column;">
                            <div class="d-flex justify-space-between align-center mb-4">
                                <MudText Typo="Typo.h6" Style="font-weight: 700;">Performance Breakdown</MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Current Selection</MudText>
                            </div>
                            <div class="d-flex flex-column gap-6 flex-grow-1">
                                @if (!_categoryPerformance.Any())
                                {
                                    <div class="d-flex flex-column align-center justify-center flex-grow-1" style="opacity: 0.5;">
                                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" Class="mb-2" />
                                        <MudText Typo="Typo.body2">No performance data yet.</MudText>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var cat in _categoryPerformance)
                                    {
                                        <div>
                                            <div class="d-flex justify-space-between mb-2">
                                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@cat.CategoryName</MudText>
                                                <MudText Typo="Typo.body2" Style="font-weight: 800;">@cat.CompletionRate%</MudText>
                                            </div>
                                            <MudProgressLinear Color="@GetCategoryColor(cat.CompletionRate)" Value="@cat.CompletionRate" Rounded="true" Size="Size.Medium" />
                                        </div>
                                    }
                                }
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex">
                    <MudPaper Class="@($"glass-panel pa-6 {GetThemeClass()} flex-grow-1")" Elevation="0" Style="border-radius: 16px !important; display: flex; flex-direction: column;">
                        <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Recent Achievements</MudText>
                        <div class="flex-grow-1">
                            <div class="d-flex flex-column gap-2">
                                <div class="activity-item">
                                    <div class="activity-icon" style="background: #f59e0b; color: #fff;">
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />
                                    </div>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                        @(_fullyCompletedStoresCount > 0
                                                                                ? $"{_fullyCompletedStoresCount} store{(_fullyCompletedStoresCount == 1 ? "" : "s")} fully completed all tasks today!"
                                                                                : _highPerformanceStoresCount > 0
                                                                                ? $"{_highPerformanceStoresCount} store{(_highPerformanceStoresCount == 1 ? "" : "s")} reached 90%+ completion today!"
                                                                                : "Aiming for 90% completion across all stores today.")
                                                                                                                                   </MudText>
                                                                                                                               </div>
                                                                                                                               <div class="activity-item">
                                                                                                                                   <div class="activity-icon" style="background: #22c55e; color: #fff;">
                                                                                                                                       <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" />
                                                                                                                                   </div>
                                                                                                                                   <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                        @(_activeStoresWithDataCount > 0
                                                                                ? $"{_activeStoresWithDataCount} stores have active reports today."
                                                                                : "Waiting for stores to start their activities.")
                                    </MudText>
                                </div>
                                <div class="activity-item">
                                    <div class="activity-icon" style="background: #0072cf; color: #fff;">
                                        <MudIcon Icon="@Icons.Material.Filled.Photo" Size="Size.Small" />
                                    </div>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@_totalPhotosCount photos captured across all stores.</MudText>
                                </div>
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

            <!-- Actvity Logs -->
            <MudTabPanel Text="Activity Logs" Icon="@Icons.Material.Filled.History">
                <MudGrid>
                    <MudItem xs="12">
                        <MudPaper Class="@($"glass-panel {GetThemeClass()}")" Elevation="0" Style="max-height: 500px; overflow-y: auto;">
                            <div class="pa-4 border-b activity-log-header">
                                <MudText Typo="Typo.h6" Style="font-weight: 700;">System Activity Log</MudText>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.DeleteSweep"
                                           OnClick="ClearActivityLogs"
                                           Size="Size.Small"
                                           Class="clear-log-btn">
                                    <span class="clear-log-btn-text">CLEAR LOG</span>
                                </MudButton>
                            </div>

                        @if (_recentActivities.Any())
                            {
                                @foreach (var activity in _recentActivities)
                                {
                                    <div class="activity-item">
                                        <div class="activity-icon" style="@GetActivityIconStyle(activity.Action); flex-shrink: 0;">
                                            <MudIcon Icon="@GetActivityIcon(activity.Action)" Size="Size.Small" />
                                        </div>
                                        <div class="activity-content" style="min-width: 0; word-break: break-word; overflow-wrap: anywhere;">
                                            <MudText Typo="Typo.body2" Style="font-weight: 600; word-break: break-word; overflow-wrap: anywhere;">
                                                @(activity.User?.Fullname ?? "System")
                                                <span style="font-weight: 400;">@GetActivityDescription(activity)</span>
                                            </MudText>
                                            <MudText Class="activity-time" Style="word-break: break-word; overflow-wrap: anywhere;">
                                                @GetRelativeTime(activity.Timestamp) • @activity.Timestamp.ToString("hh:mm tt") • @activity.Timestamp.ToString("MMM dd")@(activity.Store != null ? $" • {activity.Store.StoreName}" : "")@GetLocationInfo(activity)
                                            </MudText>
                                        </div>
                                    </div>
                                }

                                @* Load More Button *@
                                @if (_recentActivities.Count < _logTotalCount)
                                {
                                    <div class="d-flex justify-center pa-4">
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   OnClick="LoadMoreLogs"
                                                   Disabled="_loadingMoreLogs"
                                                   Class="modern-button">
                                            @if (_loadingMoreLogs)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                <span>Loading...</span>
                                            }
                                            else
                                            {
                                                <span>Load More (@(_logTotalCount - _recentActivities.Count) remaining)</span>
                                            }
                                        </MudButton>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="pa-8 text-center" style="opacity: 0.5;">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Class="mb-2" />
                                    <MudText>No recent activity found.</MudText>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
            <!-- Operational Issues -->
            <MudTabPanel Text="Operational Issues" Icon="@Icons.Material.Filled.ReportProblem">
                <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showIssueFilters ? "filters-visible" : "")}")" Elevation="0">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@(_showIssueFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                               FullWidth="true"
                               OnClick="@(() => _showIssueFilters = !_showIssueFilters)"
                               Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                               Style="@GetFilterButtonStyle()">
                        @(_showIssueFilters ? "Hide Filters" : "Show Filters")
                    </MudButton>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string"
                                          @bind-Value="_issueSearchTerm"
                                          @bind-Value:after="ApplyIssueFilters"
                                          Label="Search Issues"
                                          Placeholder="Category or description..."
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudAutocomplete T="Store"
                                             Label="Store"
                                             Value="@(_stores.FirstOrDefault(s => s.Id == _issueStoreFilter))"
                                             ValueChanged="@(s => { _issueStoreFilter = s?.Id; ApplyIssueFilters(); })"
                                             SearchFunc="@SearchStores"
                                             ToStringFunc="@(s => s == null ? "All Stores" : $"{s.StoreCode} - {s.StoreName}")"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="true"
                                             CoerceValue="false"
                                             Clearable="true"
                                             Placeholder="Search stores..."
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Class="rounded-lg" />
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudSelect T="string" @bind-Value="_issueStatusFilter" @bind-Value:after="ApplyIssueFilters" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                <MudSelectItem Value="@(string.Empty)">All Status</MudSelectItem>
                                <MudSelectItem Value="@("Open")">Open</MudSelectItem>
                                <MudSelectItem Value="@("Resolved")">Resolved</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudGrid>
                        <MudItem xs="12">
                            <div class="d-flex justify-space-between align-center px-1 filters-summary-row">
                                <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                    Showing @(_issuesFiltered.Count) of @(_issues.Count) issues
                                </MudText>
                                <div class="action-buttons-container">
                                    @if (HasIssueFilters())
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Secondary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Clear"
                                                   OnClick="ClearIssueFilters"
                                                   Class="clear-filters-button">
                                            Clear Filters
                                        </MudButton>
                                    }
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @if (_issuesFiltered.Any())
                {
                    <div class="desktop-view">
                        <MudTable Items="_issuesFiltered" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0" Class="glass-panel">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Store</MudTh>
                                <MudTh>Category</MudTh>
                                <MudTh>Reported By</MudTh>
                                <MudTh>Priority</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh Style="text-align: center;">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.ReportedAt.ToString("MMM dd, yyyy")</MudTd>
                                <MudTd DataLabel="Store">@(context.Store?.StoreName ?? "---")</MudTd>
                                <MudTd DataLabel="Category">@context.Title</MudTd>
                                <MudTd DataLabel="Reported By">@(context.ReportedBy?.Fullname ?? "---")</MudTd>
                                <MudTd DataLabel="Priority">
                                    <MudChip T="string" Size="Size.Small" Color="@GetIssuePriorityColor(context.Priority)" Variant="Variant.Filled">@context.Priority</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="@GetIssueStatusColor(context.Status)" Variant="Variant.Filled">@context.Status</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Action" Style="text-align: center;">
                                    <div class="d-flex justify-center gap-1">
                                        <MudTooltip Text="View Details">
                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Class="action-icon-circle action-btn-info" Size="Size.Small" OnClick="@(() => OpenIssueDetail(context))" />
                                        </MudTooltip>
                                        <MudTooltip Text="Delete Issue">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Class="action-icon-circle action-btn-error" Size="Size.Small" OnClick="@(() => DeleteIssue(context))" />
                                        </MudTooltip>
                                    </div>
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager />
                            </PagerContent>
                        </MudTable>
                    </div>

                    <div class="mobile-view">
                        @foreach (var issue in _issuesFiltered)
                        {
                            <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                                <div class="mobile-card-header">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@issue.ReportedAt.ToString("MMM dd")</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetIssueStatusColor(issue.Status)" Variant="Variant.Filled">
                                        @issue.Status
                                    </MudChip>
                                </div>
                                <div class="mobile-card-content">
                                    <div class="d-flex justify-space-between align-start">
                                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@issue.Title</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@GetIssuePriorityColor(issue.Priority)" Variant="Variant.Filled">@issue.Priority</MudChip>
                                    </div>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">Store: @(issue.Store?.StoreName)</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">By: @(issue.ReportedBy?.Fullname ?? "---")</MudText>
                                    <MudText Typo="Typo.body2" Class="mt-2" Style="word-break: break-word; overflow-wrap: anywhere;">@issue.Description</MudText>
                                </div>
                                <div class="mobile-card-actions">
                                    <MudButton StartIcon="@Icons.Material.Filled.Visibility" Variant="Variant.Filled" OnClick="@(() => OpenIssueDetail(issue))" Class="action-pill-btn action-btn-info">
                                        Details
                                    </MudButton>
                                    <MudButton StartIcon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" OnClick="@(() => DeleteIssue(issue))" Class="action-pill-btn action-btn-error">
                                        Delete
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                    </div>
                }
                else
                {
                    <div class="pa-12 text-center" style="opacity: 0.5;">
                        <MudIcon Icon="@Icons.Material.Filled.ReportOff" Size="Size.Large" Class="mb-2" />
                        <MudText>No operational issues found matching your criteria.</MudText>
                    </div>
                }
            </MudTabPanel>
        </MudTabs>
        </div>

        <!-- MOBILE: button nav + stacked content -->
        <div class="mobile-view">
            <div class="mobile-nav-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                <MudButton Variant="@(_activeSection == "activity" ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Timeline"
                           OnClick="@(() => _activeSection = "activity")"
                           FullWidth="true"
                           Style="@GetNavButtonStyle("activity")">
                    Performance
                </MudButton>
                <MudButton Variant="@(_activeSection == "photos" ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PhotoLibrary"
                           OnClick="@(() => _activeSection = "photos")"
                           FullWidth="true"
                           Style="@GetNavButtonStyle("photos")">
                    Photos
                </MudButton>
                <MudButton Variant="@(_activeSection == "analytics" ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Assessment"
                           OnClick="@(() => _activeSection = "analytics")"
                           FullWidth="true"
                           Style="@GetNavButtonStyle("analytics")">
                    Analytics
                </MudButton>
                <MudButton Variant="@(_activeSection == "logs" ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.History"
                           OnClick="@(() => _activeSection = "logs")"
                           FullWidth="true"
                           Style="@GetNavButtonStyle("logs")">
                    Activity Logs
                </MudButton>
                <MudButton Variant="@(_activeSection == "issues" ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ReportProblem"
                           OnClick="@(() => _activeSection = "issues")"
                           FullWidth="true"
                           Style="@($"grid-column: 1 / -1; {GetNavButtonStyle("issues")}")">
                    Operational Issues
                </MudButton>
            </div>

            <MudPaper Class="@($"glass-panel {GetThemeClass()}")" Elevation="0" Style="padding: 16px;">

                @if (_activeSection == "activity")
                {
                    <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showFilters ? "filters-visible" : "")}")" Elevation="0">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                                   FullWidth="true"
                                   OnClick="@(() => _showFilters = !_showFilters)"
                                   Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                                   Style="@GetFilterButtonStyle()">
                            @(_showFilters ? "Hide Filters" : "Show Filters")
                        </MudButton>
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudDateRangePicker Label="Date Range"
                                                    @bind-DateRange="_dateRange"
                                                    @bind-DateRange:after="ApplyReportFilters"
                                                    Variant="Variant.Outlined"
                                                    Dense="true"
                                                    Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudAutocomplete T="Store"
                                                 Label="Store"
                                                 Value="@(_stores.FirstOrDefault(s => s.Id == _selectedStoreId))"
                                                 ValueChanged="@(s => { _selectedStoreId = s?.Id; _ = OnStoreChanged(); })"
                                                 SearchFunc="@SearchStores"
                                                 ToStringFunc="@(s => s == null ? "All Stores" : $"{s.StoreCode} - {s.StoreName}")"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="true"
                                                 CoerceValue="false"
                                                 Clearable="true"
                                                 Placeholder="Search stores..."
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Class="rounded-lg" />
                            </MudItem>
                        </MudGrid>
                        <MudGrid>
                            <MudItem xs="12">
                                <div class="d-flex justify-space-between align-center px-1 filters-summary-row">
                                    <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                        Showing @(_activityLogsFiltered.Count) of @(_activityLogs.Count) reports
                                    </MudText>
                                    <div class="action-buttons-container">
                                        @if (HasActiveReportFilters())
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Clear"
                                                       OnClick="ClearReportFilters" Class="clear-filters-button">
                                                Clear Filters
                                            </MudButton>
                                        }
                                    </div>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    @if (_activityLogsFiltered.Any())
                    {
                        @foreach (var activity in _activityLogsFiltered)
                        {
                            <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                                <div class="mobile-card-header">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@activity.Date.ToString("MMM dd, yyyy")</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetActivityStatusColor(activity)" Variant="Variant.Filled" Class="role-chip">
                                        @GetActivityStatusLabel(activity)
                                    </MudChip>
                                </div>
                                <div class="mobile-card-content">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Store</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@(activity.Store?.StoreName ?? "---")</MudText>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Started By</MudText>
                                            <MudText Typo="Typo.body2">@(activity.StartedBy?.Fullname ?? "---")</MudText>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Completed At</MudText>
                                            <MudText Typo="Typo.body2">@GetActivityCompletedAt(activity)</MudText>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <div class="d-flex align-center justify-space-between mb-1">
                                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Progress</MudText>
                                                <MudText Typo="Typo.caption" Style="font-weight: 700;">@((int)GetCompletionProgress(activity.Id))%</MudText>
                                            </div>
                                            <MudProgressLinear Color="Color.Primary" Value="@GetCompletionProgress(activity.Id)" Rounded="true" Size="Size.Small" />
                                        </MudItem>
                                    </MudGrid>
                                </div>
                                <div class="mobile-card-actions">
                                    <MudButton StartIcon="@Icons.Material.Filled.Visibility" Variant="Variant.Filled"
                                               OnClick="@(() => OpenActivityDetail(activity))" Class="action-pill-btn action-btn-info">
                                        Details
                                    </MudButton>
                                    @if (!IsActivityProtected(activity))
                                    {
                                        <MudButton StartIcon="@Icons.Material.Filled.Delete" Variant="Variant.Filled"
                                                   OnClick="@(() => DeleteActivity(activity))" Class="action-pill-btn action-btn-error">
                                            Delete
                                        </MudButton>
                                    }
                                </div>
                            </MudPaper>
                        }
                    }
                    else
                    {
                        <div class="pa-12 text-center" style="opacity: 0.5;">
                            <MudIcon Icon="@Icons.Material.Filled.ReportOff" Size="Size.Large" Class="mb-2" />
                            <MudText>No activity reports found.</MudText>
                        </div>
                    }
                }

                else if (_activeSection == "photos")
                {
                    <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showPhotoFilters ? "filters-visible" : "")}")" Elevation="0">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@(_showPhotoFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                                   FullWidth="true"
                                   OnClick="@(() => _showPhotoFilters = !_showPhotoFilters)"
                                   Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                                   Style="@GetFilterButtonStyle()">
                            @(_showPhotoFilters ? "Hide Filters" : "Show Filters")
                        </MudButton>
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudTextField T="string" @bind-Value="_photoSearchTerm" @bind-Value:after="FilterPhotos"
                                              Label="Search" Placeholder="Task or user..." Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Class="rounded-lg" Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="300" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudAutocomplete T="Store" Label="Store"
                                                 Value="@(_stores.FirstOrDefault(s => s.Id == _photoStoreFilter))"
                                                 ValueChanged="@(s => { _photoStoreFilter = s?.Id; FilterPhotos(); })"
                                                 SearchFunc="@SearchStores"
                                                 ToStringFunc="@(s => s == null ? "All Stores" : $"{s.StoreCode} - {s.StoreName}")"
                                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="false"
                                                 Clearable="true" Placeholder="Search stores..."
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="rounded-lg" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudSelect T="int?" @bind-Value="_photoCategoryFilter" @bind-Value:after="FilterPhotos"
                                           Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Class="rounded-lg">
                                    <MudSelectItem Value="@((int?)null)">All</MudSelectItem>
                                    @foreach (var cat in _categories)
                                    {
                                        <MudSelectItem Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6">
                                <MudDateRangePicker Label="Date Range" @bind-DateRange="_photoDateRange"
                                                    @bind-DateRange:after="FilterPhotos"
                                                    Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                        <MudGrid>
                            <MudItem xs="12">
                                <div class="d-flex justify-space-between align-center px-1 mt-1 filters-summary-row">
                                    <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                        Showing @_filteredPhotos.Count of @_photoTotalMatchingCount photos
                                    </MudText>
                                    <div class="action-buttons-container">
                                        @if (HasPhotoFilters())
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Clear"
                                                       OnClick="ClearPhotoFilters" Class="clear-filters-button">
                                                Clear Filters
                                            </MudButton>
                                        }
                                    </div>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    @if (_filteredPhotos.Any())
                    {
                        <div class="photo-grid">
                            @foreach (var photo in _filteredPhotos)
                            {
                                <div class="photo-item" @onclick="@(() => OpenPhotoDialog(photo))">
                                    @if (photo.ImageData != null)
                                    {
                                        <img src="@($"data:{photo.ImageMimeType};base64,{Convert.ToBase64String(photo.ImageData)}")" alt="Store Photo" />
                                    }
                                    <div class="photo-overlay">
                                        <div class="font-weight-bold">@(photo.Store?.StoreName ?? "Unknown Store")</div>
                                        <div style="opacity: 0.8;">@photo.UploadedAt.ToString("MMM dd, HH:mm")</div>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (_photoTotalMatchingCount > _photoPageSize)
                        {
                            <div class="d-flex justify-center mt-4">
                                <MudPagination Color="Color.Primary"
                                               Count="@((_photoTotalMatchingCount + _photoPageSize - 1) / _photoPageSize)"
                                               Selected="@_photoCurrentPage"
                                               SelectedChanged="OnPhotoPageChanged"
                                               Variant="Variant.Filled" BoundaryCount="1" MiddleCount="3" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pa-12 text-center" style="opacity: 0.5;">
                            <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" Class="mb-2" />
                            <MudText>No photos found.</MudText>
                        </div>
                    }
                }

                else if (_activeSection == "analytics")
                {
                    <MudPaper Class="@($"glass-panel pa-4 mb-4 {GetThemeClass()}")" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Performance Breakdown</MudText>
                        @if (!_categoryPerformance.Any())
                        {
                            <div class="text-center pa-6" style="opacity: 0.5;">
                                <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.body2">No performance data yet.</MudText>
                            </div>
                        }
                        else
                        {
                            @foreach (var cat in _categoryPerformance)
                            {
                                <div class="mb-4">
                                    <div class="d-flex justify-space-between mb-1">
                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@cat.CategoryName</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight: 800;">@cat.CompletionRate%</MudText>
                                    </div>
                                    <MudProgressLinear Color="@GetCategoryColor(cat.CompletionRate)" Value="@cat.CompletionRate" Rounded="true" Size="Size.Medium" />
                                </div>
                            }
                        }
            </MudPaper>
            <MudPaper Class="@($"glass-panel pa-4 {GetThemeClass()}")" Elevation="0">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Recent Achievements</MudText>
                <div class="activity-item">
                    <div class="activity-icon" style="background: #f59e0b; color: #fff;">
                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />
                    </div>
                    <MudText Typo="Typo.body2" Style="font-weight: 600;">
                        @(_fullyCompletedStoresCount > 0
                                                ? $"{_fullyCompletedStoresCount} store{(_fullyCompletedStoresCount == 1 ? "" : "s")} fully completed all tasks today!"
                                                : _highPerformanceStoresCount > 0
                                                ? $"{_highPerformanceStoresCount} store{(_highPerformanceStoresCount == 1 ? "" : "s")} reached 90%+ completion today!"
                                                : "Aiming for 90% completion across all stores today.")
                                                                                                   </MudText>
                                                                                               </div>
                                                                                               <div class="activity-item">
                                                                                                   <div class="activity-icon" style="background: #22c55e; color: #fff;">
                                                                                                       <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" />
                                                                                                   </div>
                                                                                                   <MudText Typo="Typo.body2" Style="font-weight: 600;">
                        @(_activeStoresWithDataCount > 0
                                                ? $"{_activeStoresWithDataCount} stores have active reports today."
                                                : "Waiting for stores to start their activities.")
                    </MudText>
                </div>
                <div class="activity-item">
                    <div class="activity-icon" style="background: #0072cf; color: #fff;">
                        <MudIcon Icon="@Icons.Material.Filled.Photo" Size="Size.Small" />
                    </div>
                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@_totalPhotosCount photos captured across all stores.</MudText>
                </div>
            </MudPaper>
                        }

                else if (_activeSection == "logs")
                {
                    <MudPaper Class="@($"glass-panel {GetThemeClass()}")" Elevation="0" Style="max-height: 500px; overflow-y: auto;">
                        <div class="pa-4 activity-log-header" Style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <MudText Typo="Typo.h6" Style="font-weight: 700;">System Activity Log</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Error"
                                       OnClick="ClearActivityLogs" Size="Size.Small" Class="clear-log-btn">
                                <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small" />
                            </MudButton>
                        </div>
                        @if (_recentActivities.Any())
                        {
                            @foreach (var activity in _recentActivities)
                            {
                                <div class="activity-item">
                                    <div class="activity-icon" style="@GetActivityIconStyle(activity.Action); flex-shrink: 0;">
                                        <MudIcon Icon="@GetActivityIcon(activity.Action)" Size="Size.Small" />
                                    </div>
                                    <div class="activity-content">
                                        <MudText Typo="Typo.body2" Style="font-weight: 600; word-break: break-word; overflow-wrap: anywhere;">
                                            @(activity.User?.Fullname ?? "System")
                                            <span style="font-weight: 400;">@GetActivityDescription(activity)</span>
                                        </MudText>
                                        <MudText Class="activity-time" Style="word-break: break-word; overflow-wrap: anywhere;">
                                            @GetRelativeTime(activity.Timestamp) • @activity.Timestamp.ToString("hh:mm tt") • @activity.Timestamp.ToString("MMM dd")@(activity.Store != null ? $" • {activity.Store.StoreName}" : "")@GetLocationInfo(activity)
                                        </MudText>
                                    </div>
                                </div>
                            }
                            @if (_recentActivities.Count < _logTotalCount)
                            {
                                <div class="d-flex justify-center pa-4">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               OnClick="LoadMoreLogs" Disabled="_loadingMoreLogs" Class="modern-button">
                                        @if (_loadingMoreLogs)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                            <span>Loading...</span>
                                        }
                                        else
                                        {
                                            <span>Load More (@(_logTotalCount - _recentActivities.Count) remaining)</span>
                                        }
                                    </MudButton>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="pa-8 text-center" style="opacity: 0.5;">
                                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Class="mb-2" />
                                <MudText>No recent activity found.</MudText>
                            </div>
                        }
                    </MudPaper>
                }

                else if (_activeSection == "issues")
                {
                    <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showIssueFilters ? "filters-visible" : "")}")" Elevation="0">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@(_showIssueFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                                   FullWidth="true"
                                   OnClick="@(() => _showIssueFilters = !_showIssueFilters)"
                                   Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                                   Style="@GetFilterButtonStyle()">
                            @(_showIssueFilters ? "Hide Filters" : "Show Filters")
                        </MudButton>
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudTextField T="string" @bind-Value="_issueSearchTerm" @bind-Value:after="ApplyIssueFilters"
                                              Label="Search Issues" Placeholder="Category or description..."
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                            </MudItem>
                            <MudItem xs="8">
                                <MudAutocomplete T="Store" Label="Store"
                                                 Value="@(_stores.FirstOrDefault(s => s.Id == _issueStoreFilter))"
                                                 ValueChanged="@(s => { _issueStoreFilter = s?.Id; ApplyIssueFilters(); })"
                                                 SearchFunc="@SearchStores"
                                                 ToStringFunc="@(s => s == null ? "All Stores" : $"{s.StoreCode} - {s.StoreName}")"
                                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="false"
                                                 Clearable="true" Placeholder="Search stores..."
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="rounded-lg" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudSelect T="string" @bind-Value="_issueStatusFilter" @bind-Value:after="ApplyIssueFilters"
                                           Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                    <MudSelectItem Value="@(string.Empty)">All</MudSelectItem>
                                    <MudSelectItem Value="@("Open")">Open</MudSelectItem>
                                    <MudSelectItem Value="@("Resolved")">Resolved</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                        <MudGrid>
                            <MudItem xs="12">
                                <div class="d-flex justify-space-between align-center px-1 mt-1 filters-summary-row">
                                    <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                        Showing @(_issuesFiltered.Count) of @(_issues.Count) issues
                                    </MudText>
                                    <div class="action-buttons-container">
                                        @if (HasIssueFilters())
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Clear"
                                                       OnClick="ClearIssueFilters" Class="clear-filters-button">
                                                Clear Filters
                                            </MudButton>
                                        }
                                    </div>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    @if (_issuesFiltered.Any())
                    {
                        @foreach (var issue in _issuesFiltered)
                        {
                            <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                                <div class="mobile-card-header">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@issue.ReportedAt.ToString("MMM dd")</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetIssueStatusColor(issue.Status)" Variant="Variant.Filled">
                                        @issue.Status
                                    </MudChip>
                                </div>
                                <div class="mobile-card-content">
                                    <div class="d-flex justify-space-between align-start">
                                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@issue.Title</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@GetIssuePriorityColor(issue.Priority)" Variant="Variant.Filled">@issue.Priority</MudChip>
                                    </div>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">Store: @(issue.Store?.StoreName)</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">By: @(issue.ReportedBy?.Fullname ?? "---")</MudText>
                                    <MudText Typo="Typo.body2" Class="mt-2" Style="word-break: break-word; overflow-wrap: anywhere;">@issue.Description</MudText>
                                </div>
                                <div class="mobile-card-actions">
                                    <MudButton StartIcon="@Icons.Material.Filled.Visibility" Variant="Variant.Filled"
                                               OnClick="@(() => OpenIssueDetail(issue))" Class="action-pill-btn action-btn-info">
                                        Details
                                    </MudButton>
                                    <MudButton StartIcon="@Icons.Material.Filled.Delete" Variant="Variant.Filled"
                                               OnClick="@(() => DeleteIssue(issue))" Class="action-pill-btn action-btn-error">
                                        Delete
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                    }
                    else
                    {
                        <div class="pa-12 text-center" style="opacity: 0.5;">
                            <MudIcon Icon="@Icons.Material.Filled.ReportOff" Size="Size.Large" Class="mb-2" />
                            <MudText>No operational issues found.</MudText>
                        </div>
                    }
                }

            </MudPaper>
        </div>
    }
</div>

@code {
    private bool _initialized = false;

    // Dashboard Stats
    private int _taskCompletionRate = 0;
    private int _totalReports = 0;
    private int _activeOperations = 0;
    private int _totalPhotosCount = 0;
    private int _highPerformanceStoresCount = 0;
    private int _fullyCompletedStoresCount = 0;
    private int _activeStoresWithDataCount = 0;

    // Report Filters

    private int? _selectedStoreId;
    private DateRange? _dateRange;
    private string _exportFormat = "Excel";

    // Photo Gallery Filters
    private bool _showPhotoFilters = false;
    private string _photoSearchTerm = string.Empty;
    private int? _photoStoreFilter;
    private int? _photoCategoryFilter;
    private DateRange? _photoDateRange;

    // UI state
    private bool _showFilters = false;

    // Issue Filters
    private bool _showIssueFilters = false;
    private string _issueSearchTerm = string.Empty;
    private int? _issueStoreFilter;
    private string _issueStatusFilter = string.Empty;

    // Data Lists
    private List<Store> _stores = new();
    private List<Category> _categories = new();
    private List<User> _users = new();
    private List<StoreDailyActivity> _activityLogs = new();
    private List<StoreDailyActivity> _activityLogsFiltered = new();
    private List<ActivityLog> _recentActivities = new();
    private List<TaskPhoto> _allPhotos = new();
    private List<TaskPhoto> _filteredPhotos = new();
    private List<CategoryPerformanceModel> _categoryPerformance = new();
    private Dictionary<int, PDTActivityTracker.Components.Services.ActivityProgressHelper.ActivityProgressResult> _activityProgressCache = new();
    private List<Issue> _issues = new();
    private List<Issue> _issuesFiltered = new();

    private int _photoPageSize = 24;
