    private async Task LoadMoreLogs()
    {
        if (_loadingMoreLogs) return;
        _loadingMoreLogs = true;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var query = db.ActivityLogs
                .Include(a => a.User)
                .Include(a => a.Store)
                .AsNoTracking();

            if (_selectedStoreId.HasValue)
                query = query.Where(a => a.StoreId == _selectedStoreId.Value);

            _logCurrentPage++;

            var moreLogs = await query
                .OrderByDescending(a => a.Timestamp)
                .Skip((_logCurrentPage - 1) * _logPageSize)
                .Take(_logPageSize)
                .ToListAsync();

            _recentActivities.AddRange(moreLogs);

            var photoIds = moreLogs
                .Where(a => a.EntityType == "TaskPhoto" && a.EntityId.HasValue)
                .Select(a => a.EntityId!.Value).ToList();

            var progressIds = moreLogs
                .Where(a => a.EntityType == "TaskProgress" && a.EntityId.HasValue)
                .Select(a => a.EntityId!.Value).ToList();

            if (photoIds.Any())
            {
                var newPhotos = await db.TaskPhotos.AsNoTracking()
                    .Where(p => photoIds.Contains(p.Id))
                    .ToDictionaryAsync(p => p.Id);
                foreach (var kv in newPhotos) _linkedPhotos[kv.Key] = kv.Value;
            }

            if (progressIds.Any())
            {
                var newProgresses = await db.TaskProgresses
                    .Include(p => p.ChecklistItem)
                    .AsNoTracking()
                    .Where(p => progressIds.Contains(p.Id))
                    .ToDictionaryAsync(p => p.Id);
                foreach (var kv in newProgresses) _linkedProgresses[kv.Key] = kv.Value;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load more logs: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingMoreLogs = false;
            StateHasChanged();
        }
    }

    private async Task FilterPhotosAsync(bool resetPage = true)
    {
        if (resetPage)
        {
            _photoCurrentPage = 1;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var query = db.TaskPhotos.AsNoTracking()
            .Include(p => p.Category)
            .Include(p => p.Store)
            .Include(p => p.UploadedBy)
            .Include(p => p.ChecklistItem)
                .ThenInclude(c => c!.Category)
            .Include(p => p.StoreDailyActivity)
                .ThenInclude(s => s!.StartedBy)
            .AsQueryable();

        if (_selectedStoreId.HasValue)
        {
            query = query.Where(p => p.StoreId == _selectedStoreId.Value);
        }

        if (!string.IsNullOrWhiteSpace(_photoSearchTerm))
        {
            var term = _photoSearchTerm.ToLower();
            query = query.Where(p =>
                (p.Description != null && p.Description.ToLower().Contains(term)) ||
                (p.ChecklistItem != null && p.ChecklistItem.TaskName != null && p.ChecklistItem.TaskName.ToLower().Contains(term)) ||
                (p.ChecklistItem != null && p.ChecklistItem.Description != null && p.ChecklistItem.Description.ToLower().Contains(term)) ||
                (p.UploadedBy != null && p.UploadedBy.Fullname != null && p.UploadedBy.Fullname.ToLower().Contains(term)) ||
                (p.Store != null && p.Store.StoreName.ToLower().Contains(term))
            );
        }

        if (_photoStoreFilter.HasValue)
        {
            query = query.Where(p => p.StoreId == _photoStoreFilter.Value);
        }

        if (_photoCategoryFilter.HasValue)
        {
            query = query.Where(p => p.CategoryId == _photoCategoryFilter.Value);
        }

        if (_photoDateRange != null && _photoDateRange.Start.HasValue && _photoDateRange.End.HasValue)
        {
            var start = _photoDateRange.Start.Value.Date;
            var end = _photoDateRange.End.Value.Date.AddDays(1).AddSeconds(-1);
            query = query.Where(p => p.UploadedAt >= start && p.UploadedAt <= end);
        }

        _photoTotalMatchingCount = await query.CountAsync();

        _filteredPhotos = await query
            .OrderByDescending(p => p.UploadedAt)
            .Skip((_photoCurrentPage - 1) * _photoPageSize)
            .Take(_photoPageSize)
            .ToListAsync();

        StateHasChanged();
    }

