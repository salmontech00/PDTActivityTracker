    private Dictionary<int, TaskPhoto> _linkedPhotos = new();
    private Dictionary<int, TaskProgress> _linkedProgresses = new();

    private int? _checkInCategoryId;

    private string GetActivityDescription(ActivityLog activity)
    {
        if (activity.Action == "Login") return " checked in (Login)";

        bool isCheckInTask = false;
        if (activity.EntityType == "TaskPhoto" && activity.EntityId.HasValue && _linkedPhotos.TryGetValue(activity.EntityId.Value, out var photo))
        {
            isCheckInTask = photo.CategoryId == _checkInCategoryId;
        }
        else if (activity.EntityType == "TaskProgress" && activity.EntityId.HasValue && _linkedProgresses.TryGetValue(activity.EntityId.Value, out var prog))
        {
            isCheckInTask = prog.ChecklistItem?.CategoryId == _checkInCategoryId;
        }

        var taskName = GetTaskName(activity);

        return activity.Action switch
        {
            "TaskCompleted" => isCheckInTask ? " checked in (Task Completed)" : $" completed task: {taskName}",
            "PhotoUploaded" => isCheckInTask ? " checked in (Photo Uploaded)" : $" uploaded photo for {taskName}",
            "PhotoRemoved" => $" removed photo for {taskName}",
            "TaskReverted" => $" task became incomplete: {taskName}",
            "SessionReverted" => " daily session reverted to In-Progress",
            "Login" => " checked in",
            "IssueReported" => $" reported an issue: {activity.Details}",
            "Logout" => " logged out",
            _ => $" performed an action: {activity.Action}"
        };
    }

    private string GetTaskName(ActivityLog activity)
    {
        // 1. Try to get from linked TaskProgress (ChecklistItem already included)
        if (activity.EntityType == "TaskProgress" && activity.EntityId.HasValue && _linkedProgresses.TryGetValue(activity.EntityId.Value, out var prog))
        {
            if (prog.ChecklistItem != null)
            {
                return string.IsNullOrEmpty(prog.ChecklistItem.TaskName) ? prog.ChecklistItem.Description ?? "" : prog.ChecklistItem.TaskName;
            }
        }

        // 2. Try to get from linked TaskPhoto (need to fetch Category/ChecklistItem if we want precise names, but usually Details has it)

        // 3. Fallback to Details, removing legacy prefixes
        var details = activity.Details ?? "";
        details = details.Replace("Completed task: ", "")
                        .Replace("Uploaded photo for task: ", "")
                        .Replace("Removed photo for task: ", "")
                        .Replace("Task reverted to incomplete: ", "");

        return string.IsNullOrEmpty(details) ? "Unknown Task" : details;
    }

    private string GetLocationInfo(ActivityLog activity)
    {
        double? lat = null;
        double? lng = null;

        if (activity.EntityType == "TaskPhoto" && activity.EntityId.HasValue && _linkedPhotos.TryGetValue(activity.EntityId.Value, out var photo))
        {
            lat = photo.Latitude;
            lng = photo.Longitude;
        }
        else if (activity.EntityType == "TaskProgress" && activity.EntityId.HasValue && _linkedProgresses.TryGetValue(activity.EntityId.Value, out var prog))
        {
            lat = prog.Latitude;
            lng = prog.Longitude;
        }

        if (!lat.HasValue || !lng.HasValue) return "";

        string distanceText = "";
        if (activity.Store != null && activity.Store.GPSLatitude.HasValue && activity.Store.GPSLongitude.HasValue)
        {
            var distance = CalculateDistance(lat.Value, lng.Value, activity.Store.GPSLatitude.Value, activity.Store.GPSLongitude.Value);
            distanceText = distance < 1 ? $" • {(int)(distance * 1000)}m from store" : $" • {distance:F2}km from store";
        }

        return $" (Location: {lat:F4}, {lng:F4}{distanceText})";
    }

    private double CalculateDistance(double lat1, double lon1, double lat2, double lon2)
    {
        var R = 6371; // Radius of the earth in km
        var dLat = ToRadians(lat2 - lat1);
        var dLon = ToRadians(lon2 - lon1);
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                Math.Cos(ToRadians(lat1)) * Math.Cos(ToRadians(lat2)) *
                Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        var c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
        return R * c;
    }

    private double ToRadians(double deg) => deg * (Math.PI / 180);

    private string GetRelativeTime(DateTime timestamp)
    {
        var diff = DateTime.Now - timestamp;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return timestamp.ToString("MMM dd, yyyy");
    }

