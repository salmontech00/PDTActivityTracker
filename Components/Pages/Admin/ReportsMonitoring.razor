    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Load stores
        _stores = await db.Stores.Where(s => !s.IsDeleted).AsNoTracking().OrderBy(s => s.StoreName).ToListAsync();

        // Load categories
        _categories = await db.Categories.AsNoTracking().OrderBy(c => c.SortOrder).ToListAsync();

        // Load reports (StoreDailyActivity)
        var reportQuery = db.StoreDailyActivities
            .Include(a => a.StartedBy)
            .Include(a => a.Store)
            .AsNoTracking();

        if (_selectedStoreId.HasValue)
        {
            reportQuery = reportQuery.Where(a => a.StoreId == _selectedStoreId.Value);
        }

        _activityLogs = await reportQuery.OrderByDescending(a => a.Date).ToListAsync();
        ApplyReportFilters();

        // Cache progress for the current filtered list
        _activityProgressCache = await PDTActivityTracker.Components.Services.ActivityProgressHelper.CalculateProgressForActivitiesAsync(_activityLogsFiltered, db);

        // Load photos
        await FilterPhotosAsync(true);

        // AFTER:
        _checkInCategoryId = (await db.Categories.AsNoTracking()
            .FirstOrDefaultAsync(c => c.Name.ToLower() == "check in"))?.Id;

        var activityLogQuery = db.ActivityLogs
            .Include(a => a.User)
            .Include(a => a.Store)
            .AsNoTracking();

        if (_selectedStoreId.HasValue)
            activityLogQuery = activityLogQuery.Where(a => a.StoreId == _selectedStoreId.Value);

        _logTotalCount = await activityLogQuery.CountAsync();
        _logCurrentPage = 1;

        _recentActivities = await activityLogQuery
            .OrderByDescending(a => a.Timestamp)
            .Take(_logPageSize)
            .ToListAsync();

        var photoIds = _recentActivities
            .Where(a => a.EntityType == "TaskPhoto" && a.EntityId.HasValue)
            .Select(a => a.EntityId!.Value).ToList();

        var progressIds = _recentActivities
            .Where(a => a.EntityType == "TaskProgress" && a.EntityId.HasValue)
            .Select(a => a.EntityId!.Value).ToList();

        _linkedPhotos = photoIds.Any()
            ? await db.TaskPhotos.AsNoTracking()
                .Where(p => photoIds.Contains(p.Id))
                .ToDictionaryAsync(p => p.Id)
            : new();

        _linkedProgresses = progressIds.Any()
            ? await db.TaskProgresses
                .Include(p => p.ChecklistItem)
                .AsNoTracking()
                .Where(p => progressIds.Contains(p.Id))
                .ToDictionaryAsync(p => p.Id)
            : new();
        // Issues (all stores - Admin view)
        _issues = await db.Issues
            .AsNoTracking()
            .Include(i => i.Store)
            .Include(i => i.ReportedBy)
            .Include(i => i.ReviewedBy)
            .OrderByDescending(i => i.ReportedAt)
            .ToListAsync();

        ApplyIssueFilters();

        await CalculateStats();
    }

    private async Task CalculateStats()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        _totalReports = _activityLogs.Count;
        
        var photoCountQuery = db.TaskPhotos.AsQueryable();
        if (_selectedStoreId.HasValue)
        {
            photoCountQuery = photoCountQuery.Where(p => p.StoreId == _selectedStoreId.Value);
        }
        _totalPhotosCount = await photoCountQuery.CountAsync();

        // Active Operations (reports started today)
        var opsQuery = db.StoreDailyActivities.Where(a => a.Date.Date == DateTime.Today);
        if (_selectedStoreId.HasValue)
        {
            opsQuery = opsQuery.Where(a => a.StoreId == _selectedStoreId.Value);
        }
        _activeOperations = await opsQuery.CountAsync();

        // High performance stores (>= 90% today)
        var todayStats = _activityProgressCache.Where(kv =>
        {
            var activity = _activityLogs.FirstOrDefault(a => a.Id == kv.Key);
            return activity?.Date.Date == DateTime.Today;
        }).ToList();

        _highPerformanceStoresCount = todayStats.Count(kv => kv.Value.CompletionPercentage >= 90 && kv.Value.CompletionPercentage < 100);
        _fullyCompletedStoresCount = todayStats.Count(kv => kv.Value.CompletionPercentage >= 100);
        _activeStoresWithDataCount = todayStats.Count;

        // Avg Completion
        if (_activityProgressCache.Any())
        {
            _taskCompletionRate = (int)_activityProgressCache.Values.Average(v => v.CompletionPercentage);
        }
        else
        {
            _taskCompletionRate = 0;
        }

        // Performance Breakdown
        _categoryPerformance.Clear();

        // Optimize: Get all progress for relevant activities
        var relevantActivityIds = _activityLogsFiltered.Select(a => a.Id).ToList();
        var allProgress = await db.TaskProgresses
            .Include(p => p.ChecklistItem)
            .Where(p => relevantActivityIds.Contains(p.StoreDailyActivityId))
            .ToListAsync();

        foreach (var cat in _categories)
        {
            var catTasks = allProgress.Where(p => p.ChecklistItem?.CategoryId == cat.Id).ToList();
            if (catTasks.Any())
            {
                var rate = (double)catTasks.Count(p => p.IsCompleted) / catTasks.Count * 100;
                _categoryPerformance.Add(new CategoryPerformanceModel { CategoryName = cat.Name, CompletionRate = (int)rate });
            }
        }
    }

    private void ApplyReportFilters()
    {
        _activityLogsFiltered = _activityLogs;

        if (_dateRange != null && _dateRange.Start.HasValue && _dateRange.End.HasValue)
        {
            var startDate = _dateRange.Start.Value.Date;
            var endDate = _dateRange.End.Value.Date.AddDays(1).AddSeconds(-1);

            _activityLogsFiltered = _activityLogsFiltered
                .Where(a => a.Date >= startDate && a.Date <= endDate)
                .ToList();
        }
    }

