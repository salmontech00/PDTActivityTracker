                                    <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Default" Size="Size.Small" OnClick="@(() => ViewFullHistory(store))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Map" Color="Color.Default" Size="Size.Small" OnClick="@(() => ViewOnMap(store))" />
                                </div>
                                <div class="d-flex gap-1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Class="action-icon-circle action-btn-info" Size="Size.Small" OnClick="@(() => OpenEditStoreDialog(store))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Class="action-icon-circle action-btn-error" Size="Size.Small" OnClick="@(() => DeleteStore(store))" />
