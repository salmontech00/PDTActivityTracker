</div>

@code {
    private bool _initialized = false;
    private List<Store> _allStores = new();
    private List<Store> _filteredStores = new();
    private HashSet<Store> _selectedStores = new();
    private Dictionary<int, List<StoreAssignmentLog>> _storeLogs = new();
    private HashSet<Store> _expandedRows = new();

    private bool IsAllSelected() => _filteredStores.Any() && _selectedStores.Count >= _filteredStores.Count;

    private void HandleSelectAll(bool value)
    {
        if (value)
        {
            foreach (var s in _filteredStores) _selectedStores.Add(s);
        }
        else
        {
            _selectedStores.Clear();
        }
    }

    private string _searchTerm = "";
    private string _assignmentFilter = "All";
    private string _statusFilter = "All";
    private bool _isMapView = false;
    private Store? _focusedStoreOnMap = null;
    private bool _mapShouldFitBounds = true;
    private bool _showFilters = false;

    // ... existing initialization ...

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        try
        {
            await JSRuntime.InvokeVoidAsync("leafletMap.destroy");
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
            _initialized = true;
            StateHasChanged();
        }

        if (_isMapView)
        {
            await UpdateMap();
        }
    }

    private async Task OnViewToggled(bool isMapView)
    {
        _isMapView = isMapView;
        if (!_isMapView)
        {
            await JSRuntime.InvokeVoidAsync("leafletMap.destroy");
        }
        else
        {
            _mapShouldFitBounds = true;
        }
    }

    private async Task UpdateMap()
    {
        var mapData = _filteredStores.Select(s => new
        {
            gpsLatitude = s.GPSLatitude,
            gpsLongitude = s.GPSLongitude,
            storeName = s.StoreName,
            storeCode = s.StoreCode,
            status = s.Status,
            storeHeadId = s.StoreHeadId,
            storeHeadName = s.StoreHead?.Fullname,
            areaHeadName = s.AreaHead?.Fullname
        }).ToList();

        await JSRuntime.InvokeVoidAsync("leafletMap.initialize", "map", mapData, new { fitBounds = _mapShouldFitBounds });
        _mapShouldFitBounds = false;
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        _allStores = await db.Stores
            .Where(s => !s.IsDeleted)
            .Include(s => s.StoreHead)
            .Include(s => s.AreaHead)
            .OrderBy(s => s.StoreCode)
            .AsNoTracking()
            .ToListAsync();

        var logs = await db.StoreAssignmentLogs
            .Include(l => l.User)
            .AsNoTracking()
            .OrderByDescending(l => l.Timestamp)
            .ToListAsync();

        _storeLogs = logs.GroupBy(l => l.StoreId)
            .ToDictionary(g => g.Key, g => g.ToList());

        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        var query = _allStores.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            query = query.Where(s =>
                s.StoreName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                s.StoreCode.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                s.Location.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (_assignmentFilter != "All")
        {
            if (_assignmentFilter == "Assigned")
            {
                query = query.Where(s => s.StoreHeadId != null && s.AreaHeadId != null);
            }
            else
            {
                query = query.Where(s => s.StoreHeadId == null || s.AreaHeadId == null);
            }
        }

        if (_statusFilter != "All")
        {
            query = query.Where(s => s.Status == _statusFilter);
        }

        _filteredStores = query.ToList();

        if (_isMapView)
        {
            _mapShouldFitBounds = true;
            await UpdateMap();
        }
    }

    private async Task ClearFilters()
    {
        _searchTerm = string.Empty;
        _assignmentFilter = "All";
        _statusFilter = "All";
        await ApplyFilters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(_searchTerm) ||
               _assignmentFilter != "All" ||
               _statusFilter != "All";
    }

    private void OnThemeChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    private string GetTitleColor()
    {
        if (ThemeService == null) return "#0f172a";
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0f172a"
        };
    }

    private string GetStatusTextColor()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "text-dark" : "text-white";
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "border-radius: 12px;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? "color: #0072cf !important; background-color: #ffffff !important; border-radius: 12px; font-weight: bold;"
            : "border-radius: 12px; font-weight: bold;";
    }

    private string GetFilterButtonStyle()
    {
        if (ThemeService == null) return "";
        return ThemeService.CurrentTheme == ThemeMode.Lightest
            ? "color: #0072cf; border-color: #0072cf; border-radius: 12px;"
            : "color: #ffffff; border-color: #ffffff; border-radius: 12px; background-color: transparent !important;";
    }

    private string GetStatusChipClass(string status) => (status ?? "Active") switch
    {
        "Active" => "status-active",
        "Inactive" => "status-inactive",
        _ => "status-active"
    };

    private Color GetStatusColor(string status) => (status ?? "Active") switch
    {
        "Active" => Color.Success,
        "Inactive" => Color.Error,
        _ => Color.Success
    };

    private async Task<List<string>> ValidateDuplicateStore(string code, string name, int excludeId)
    {
        var errors = new List<string>();
        var codeMatch = code?.Trim() ?? string.Empty;
        var nameMatch = name?.Trim() ?? string.Empty;

        // Perform memory-safe validation against the locally loaded stores
        var codeDuplicate = _allStores.FirstOrDefault(s => s.Id != excludeId &&
            string.Equals(s.StoreCode?.Trim(), codeMatch, StringComparison.OrdinalIgnoreCase));
        
        var nameDuplicate = _allStores.FirstOrDefault(s => s.Id != excludeId &&
            string.Equals(s.StoreName?.Trim(), nameMatch, StringComparison.OrdinalIgnoreCase));

        if (codeDuplicate != null)
        {
            errors.Add($"Store Code '{codeMatch}' already exists.");
        }
        if (nameDuplicate != null)
        {
            errors.Add($"Store Name '{nameMatch}' already exists.");
        }

        // If local matches already found both errors, return early
        if (errors.Count == 2)
        {
            return errors;
        }

        // Secondary database check to prevent bypass in case local list is stale
        using var db = await DbFactory.CreateDbContextAsync();

        if (codeDuplicate == null)
        {
            var dbCodeDuplicate = await db.Stores.AsNoTracking().FirstOrDefaultAsync(s => s.Id != excludeId &&
                !s.IsDeleted && s.StoreCode.ToLower() == codeMatch.ToLower());
            if (dbCodeDuplicate != null)
            {
                errors.Add($"Store Code '{codeMatch}' already exists in database.");
            }
        }

        if (nameDuplicate == null)
        {
            var dbNameDuplicate = await db.Stores.AsNoTracking().FirstOrDefaultAsync(s => s.Id != excludeId &&
                !s.IsDeleted && s.StoreName.ToLower() == nameMatch.ToLower());
            if (dbNameDuplicate != null)
            {
                errors.Add($"Store Name '{nameMatch}' already exists in database.");
            }
        }

        return errors;
    }

    private async Task OpenAddStoreDialog()
    {
        var parameters = new DialogParameters 
        { 
            ["Store"] = new Store(),
            ["ValidateDuplicate"] = new Func<string, string, int, Task<List<string>>>(ValidateDuplicateStore)
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<AddEditStoreDialog>("Add Store", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task OpenEditStoreDialog(Store store)
    {
        var parameters = new DialogParameters 
        { 
            ["Store"] = store,
            ["ValidateDuplicate"] = new Func<string, string, int, Task<List<string>>>(ValidateDuplicateStore)
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<AddEditStoreDialog>("Edit Store", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task OpenAssignStoreHeadDialog(Store store)
    {
        if (store.Status == "Inactive")
        {
            Snackbar.Add("Cannot assign Store Head to an inactive store.", Severity.Warning);
            return;
        }
        var parameters = new DialogParameters { ["Store"] = store };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<AssignStoreHeadDialog>("Assign Store Head", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            var action = result.Data as string;
            var message = action == "Unassigned"
                ? "Store Head unassigned successfully!"
                : "Store Head assigned successfully!";
            Snackbar.Add(message, Severity.Success);
            await LoadData();
        }
    }

    private async Task OpenAssignAreaHeadDialog(Store store)
    {
        if (store.Status == "Inactive")
        {
            Snackbar.Add("Cannot assign Area Head to an inactive store.", Severity.Warning);
            return;
        }
        var parameters = new DialogParameters { ["PreSelectedStores"] = new List<Store> { store } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<AssignAreaHeadDialog>("Assign Area Head", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is AssignAreaHeadDialog.AreaHeadAssignmentResult assignmentResult)
        {
            var msg = "Area Head assignment updated successfully!";
            if (assignmentResult.HasAssigned && !assignmentResult.HasUnassigned)
                msg = "Area Head assigned successfully!";
            else if (!assignmentResult.HasAssigned && assignmentResult.HasUnassigned)
                msg = "Area Head unassigned successfully!";
            else if (!assignmentResult.HasAssigned && !assignmentResult.HasUnassigned)
                msg = "No changes made";

            if (msg != "No changes made")
            {
                Snackbar.Add(msg, Severity.Success);
            }
            await LoadData();
        }
    }

    private async Task OpenBulkActionsDialog()
    {
        var selectedList = _selectedStores.ToList();
        var parameters = new DialogParameters { ["SelectedStores"] = selectedList };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };

        var dialog = await DialogService.ShowAsync<BulkActionsDialog>("Bulk Actions", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is BulkActionsDialog.BulkActionResult actionResult)
        {
            if (actionResult.Action == "AssignAreaHead")
            {
                // Chain to Open Assign Area Head Dialog
                var activeSelectedStores = actionResult.Stores.Where(s => s.Status != "Inactive").ToList();
                var inactiveCount = actionResult.Stores.Count - activeSelectedStores.Count;
                if (inactiveCount > 0)
                {
                    Snackbar.Add($"{inactiveCount} inactive store(s) excluded from assignment.", Severity.Info);
                }
                if (!activeSelectedStores.Any())
                {
                    return;
                }
                var areaParams = new DialogParameters { ["PreSelectedStores"] = activeSelectedStores };
                var areaOptions = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
                var areaDialog = await DialogService.ShowAsync<AssignAreaHeadDialog>("Assign Area Head", areaParams, areaOptions);

                var areaResult = await areaDialog.Result;
                if (areaResult != null && !areaResult.Canceled && areaResult.Data is AssignAreaHeadDialog.AreaHeadAssignmentResult bulkResult)
                {
                    var msg = "Area Head assignment updated for selected stores";
                    if (bulkResult.HasAssigned && !bulkResult.HasUnassigned)
                        msg = "Area Head assigned to selected stores";
                    else if (!bulkResult.HasAssigned && bulkResult.HasUnassigned)
                        msg = "Area Head unassigned from selected stores";
                    else if (!bulkResult.HasAssigned && !bulkResult.HasUnassigned)
                        msg = "No changes made";

                    Snackbar.Add(msg, Severity.Success);
                    await LoadData();
                    _selectedStores.Clear();
                }
            }
            else if (actionResult.Action == "StatusChanged")
            {
                Snackbar.Add("Status updated successfully!", Severity.Success);
                await LoadData();
                _selectedStores.Clear();
            }
            else if (actionResult.Action == "Export")
            {
                Snackbar.Add("Export feature coming soon", Severity.Info);
            }
        }
    }

    private async Task OpenViewStoreDialog(Store store)
    {
        var parameters = new DialogParameters { ["StoreToView"] = store };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        await DialogService.ShowAsync<ViewStoreDialog>("Store Details", parameters, options);
    }

    private void ToggleDetails(Store store)
    {
        if (_expandedRows.Contains(store))
        {
            _expandedRows.Remove(store);
        }
        else
        {
            _expandedRows.Add(store);
        }
    }

    private async Task DeleteStore(Store store)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Are you sure you want to delete {store.StoreName} ({store.StoreCode})? Historical records will be preserved.",
            ["ButtonText"] = "Delete",
            ["Color"] = Color.Error
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Store", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var s = await db.Stores.FindAsync(store.Id);
            if (s != null)
            {
                s.IsDeleted = true;
                s.Status = "Deleted";
                s.StoreHeadId = null;
                s.AreaHeadId = null;
                await db.SaveChangesAsync();
                Snackbar.Add("Store deleted successfully!", Severity.Success);
                await LoadData();
            }
        }
    }

    private async Task ViewOnMap(Store store)
    {
        if (store.GPSLatitude == null || store.GPSLongitude == null)
        {
            Snackbar.Add("GPS coordinates not available for this store.", Severity.Warning);
            return;
        }

        // Start zoomed out to show all stores first
        _mapShouldFitBounds = true;
        _isMapView = true;
        StateHasChanged();

        // Wait for map to fully initialize at zoomed-out view
        await Task.Delay(400);

        // Now smoothly fly into the target store (animated zoom-in effect)
        try
        {
            await JSRuntime.InvokeVoidAsync("leafletMap.focusMarker", store.GPSLatitude, store.GPSLongitude, 19);
        }
        catch { }
    }

    private async Task ViewFullHistory(Store store)
    {
        var logs = _storeLogs.ContainsKey(store.Id) ? _storeLogs[store.Id] : new List<StoreAssignmentLog>();
        var parameters = new DialogParameters
        {
            ["Store"] = store,
            ["Logs"] = logs
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        await DialogService.ShowAsync<ViewStoreHistoryDialog>("Assignment History", parameters, options);
    }
}
