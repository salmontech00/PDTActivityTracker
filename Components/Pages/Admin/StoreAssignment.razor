@page "/admin/store-assignment"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@using PDTActivityTracker.Components.Pages.Dialogs
@inject IDialogService DialogService
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@implements IAsyncDisposable

<PageTitle>Stores Management</PageTitle>

<style>
    .store-container {
        padding: 1rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 16px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* TABLE STYLING */
    .mud-table {
        background: transparent !important;
    }

    .mud-table-head {
        background: rgba(0, 114, 207, 0.1);
    }

        .mud-table-head.lightest {
            background: rgba(0, 114, 207, 0.05);
        }

    .mud-table-cell {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        padding: 12px 16px !important;
    }

    .lightest .mud-table-cell {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .mud-table-row:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .lightest .mud-table-row:hover {
        background-color: rgba(0, 114, 207, 0.05) !important;
    }

    /* Fix for Pager/Footer alignment */
    .mud-table-pagination {
        background-color: transparent !important;
        border-top: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: inherit !important;
    }

    .lightest .mud-table-pagination {
        border-top: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    /* BUTTONS */
    .modern-button {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
    }

    .clear-filters-button.mud-button-root {
        font-weight: 700 !important;
        border-radius: 12px !important;
    }

    /* ROLE CHIPS */
    .role-chip {
        font-weight: 800 !important;
        border-radius: 12px !important;
        text-transform: uppercase !important;
        letter-spacing: 0.5px !important;
        font-size: 0.7rem !important;
    }

    .status-active {
        background-color: #10b981 !important;
        color: #ffffff !important;
        border: none !important;
    }

    .status-inactive {
        background-color: #ef4444 !important;
        color: #ffffff !important;
        border: none !important;
    }

    .lightest .role-chip {
        /* High opacity for lighter theme */
    }

    .button-group .modern-button.light {
        background-color: #ffffff !important;
        color: #0072cf !important;
    }

    /* Solid Action Buttons across all themes */
    .action-icon-circle.mud-button-root {
        width: 32px !important;
        height: 32px !important;
        min-width: unset !important;
        border-radius: 50% !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        color: #ffffff !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15) !important;
    }

        .action-icon-circle.mud-button-root:hover {
            transform: scale(1.15) !important;
            filter: brightness(1.1) !important;
        }

    /* Specific Action Button Colors (Consistent in all themes) */
    .action-btn-info {
        background-color: #0072cf !important;
    }

    .action-btn-error {
        background-color: #ef4444 !important;
    }

    .action-btn-default {
        background-color: #94a3b8 !important;
    }

    /* MOBILE CARDS */
    .mobile-card {
        margin-bottom: 16px;
        overflow: hidden;
    }

    .mobile-card-header {
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .lightest .mobile-card-header {
        border-bottom: 1px solid rgba(0, 114, 207, 0.1);
    }

    .mobile-card-content {
        padding: 16px;
    }

    .mobile-card-actions {
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        gap: 8px;
    }

    .lightest .mobile-card-actions {
        background: rgba(0, 114, 207, 0.03);
    }

    /* FILTER SECTION */
    .filter-section {
        padding: 16px;
        margin-bottom: 24px;
    }

        .filter-section .mud-input-root {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
        }

    .lightest .filter-section .mud-input-root {
        background: rgba(255, 255, 255, 0.8) !important;
    }

    .light .filter-section .mud-input-root {
        background: rgba(255, 255, 255, 0.1) !important;
    }

    .light .filter-section .mud-input-label,
    .light .filter-section .mud-input-adornment-start,
    .light .filter-section .mud-select-input,
    .light .filter-section .mud-input-slot {
        color: #ffffff !important;
    }

    .light .filter-section .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.5) !important;
    }

    .light .filter-section .mud-input-root:focus-within .mud-input-outlined-border {
        border-color: #ffffff !important;
    }

    .filter-toggle-button {
        display: none;
    }

    /* DESKTOP MAP STYLING */
    .glass-panel:has(#map) {
        padding: 8px !important;
        border-radius: 12px !important;
    }

    #map {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.1);
    }

    /* MAP LEGEND */
    .map-legend-overlay {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 1000;
        padding: 4px 12px;
        border-radius: 12px;
        backdrop-filter: blur(8px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        display: flex;
        flex-direction: row;
        gap: 16px;
        align-items: center;
        pointer-events: auto;
    }

        .map-legend-overlay.lightest {
            background: rgba(255, 255, 255, 0.85);
            border: 1px solid rgba(0, 114, 207, 0.2);
        }

        .map-legend-overlay.light {
            background: rgba(0, 114, 207, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .map-legend-overlay.dark {
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .legend-text {
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        white-space: nowrap;
    }

    /* SUMMARY CARDS ON MOBILE */
    @@media (max-width: 600px) {
        .summary-grid {
            margin: -8px !important;
            width: calc(100% + 16px) !important;
            margin-bottom: 8px !important;
        }

            .summary-grid > .mud-grid-item {
                padding: 8px !important;
            }

        .summary-card {
            padding: 10px 12px !important;
            min-height: 60px !important;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .summary-card .mud-typography-subtitle2 {
                font-size: 0.65rem !important;
                margin-bottom: -2px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .summary-card .mud-typography-h4 {
                font-size: 1.5rem !important;
                line-height: 1 !important;
            }
    }

    /* ULTRA-THIN SPACING FOR NARROW MOBILE (iPhone SE 375px) */
    @@media (max-width: 375px) {
        .summary-grid {
            margin: -4px !important;
            width: calc(100% + 8px) !important;
            margin-bottom: 4px !important;
        }

            .summary-grid > .mud-grid-item {
                padding: 4px !important;
            }

        .summary-card {
            padding: 8px 10px !important;
            min-height: 50px !important;
        }

            .summary-card .mud-typography-subtitle2 {
                font-size: 0.6rem !important;
            }

            .summary-card .mud-typography-h4 {
                font-size: 1.2rem !important;
            }
    }

    /* RESPONSIVE */
    @@media (max-width: 960px) {
        .filter-toggle-button {
            display: inline-flex !important;
        }

        .filter-section .mud-grid {
            display: none;
        }

        .filter-section.filters-visible .mud-grid {
            display: flex;
        }

        .desktop-view {
            display: none !important;
        }

        .mobile-view {
            display: block;
        }

        .page-header-row {
            flex-direction: column;
            gap: 16px;
            align-items: stretch;
            text-align: center;
            padding: 0;
            margin-bottom: 20px;
        }

        .page-title {
            display: none;
        }

        .button-group {
            flex-direction: row !important;
            width: 100%;
            justify-content: space-between;
        }

            .button-group .modern-button {
                flex: 1;
                font-size: 0.70rem !important;
            }

        .glass-panel:has(#map) {
            height: 555px !important;
        }
        /* Map Legend Full Width & Thinner */
        .map-legend-overlay {
            top: 14px;
            right: 14px;
            left: 14px;
            padding: 4px 12px;
            gap: 4px;
            justify-content: space-between;
            width: auto;
        }

        .legend-text {
            font-size: 0.55rem;
        }
        /* Hide zoom controls on mobile */
        .leaflet-control-zoom {
            display: none !important;
        }
    }

    @@media (min-width: 961px) {
        .desktop-view {
            display: block;
        }

        .mobile-view {
            display: none !important;
        }
    }

    @@media (max-width: 960px) {
        .clear-filters-button.mud-button-root {
            border-radius: 6px !important;
            height: 28px !important;
            font-size: 0.7rem !important;
            padding: 0 10px !important;
            min-width: unset !important;
        }

        .clear-filters-button .mud-button-label {
            white-space: nowrap !important;
            line-height: 1 !important;
            font-size: 0.7rem !important;
        }

        .clear-filters-button .mud-button-icon-start {
            font-size: 0.85rem !important;
            margin-inline-end: 3px !important;
            margin-inline-start: -2px !important;
        }

        .filter-info-text {
            font-size: 0.75rem !important;
            white-space: nowrap !important;
        }

        .action-buttons-container {
            flex-direction: column !important;
            align-items: flex-end !important;
            gap: 4px !important;
        }

        .filters-summary-row {
            align-items: flex-start !important;
        }
    }

    @@media (max-width: 375px) {
        .clear-filters-button.mud-button-root {
            border-radius: 4px !important;
            height: 22px !important;
            font-size: 0.6rem !important;
            padding: 0 6px !important;
            min-width: unset !important;
        }

        .clear-filters-button .mud-button-label {
            white-space: nowrap !important;
            line-height: 1 !important;
            font-size: 0.6rem !important;
        }

        .clear-filters-button .mud-button-icon-start {
            font-size: 0.8rem !important;
            margin-inline-end: 2px !important;
            margin-inline-start: -2px !important;
        }

        .filter-info-text {
            font-size: 0.65rem !important;
            white-space: nowrap !important;
        }

        .filters-summary-row {
            align-items: flex-start !important;
        }

        .action-buttons-container {
            flex-direction: column !important;
            align-items: flex-end !important;
            gap: 4px !important;
        }

            .action-buttons-container .clear-filters-button {
                order: 1 !important;
            }

            .action-buttons-container .mud-icon-button {
                order: 2 !important;
            }

        .button-group .modern-button {
            flex: 1;
            font-size: 0.55rem !important;
        }

        .map-legend-overlay {
            top: 12px;
            right: 12px;
            left: 12px;
            padding: 2px 8px;
            gap: 2px;
            justify-content: space-between;
            width: auto;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .legend-text {
            font-size: 0.5rem;
        }

        .glass-panel:has(#map) {
            height: 350px !important;
            padding: 8px !important;
            border-radius: 12px !important;
        }

        .mud-main-content {
            padding-bottom: 0px !important;
            padding-left: 0px !important;
            padding-right: 0px !important;
        }
    }

</style>

<div class="store-container">
    <div class="page-header-row">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Stores Management</MudText>

        <div class="button-group">
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Flaky"
                           OnClick="OpenBulkActionsDialog"
                           Class="@($"modern-button {GetThemeClass()}")"
                           Disabled="@(!_selectedStores.Any())"
                           Style="@GetButtonStyle()">
                    Bulk Actions (@_selectedStores.Count)
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Store"
                           OnClick="OpenAddStoreDialog"
                           Class="@($"modern-button {GetThemeClass()}")"
                           Style="@GetButtonStyle()">
                    ADD STORE
                </MudButton>
            </div>
        </div>
    </div>

    @if (!_initialized)
    {
        <div class="d-flex flex-column align-center justify-center py-10" style="opacity: 0.5;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-3" />
            <MudText Typo="Typo.h6">Loading Stores...</MudText>
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        <MudGrid Class="mb-4 summary-grid">
            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="@($"glass-panel summary-card pa-4 {GetThemeClass()}")" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Style="opacity: 0.7">Total Stores</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold">@_allStores.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="@($"glass-panel summary-card pa-4 {GetThemeClass()}")" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Style="opacity: 0.7">Assigned</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold text-success">@_allStores.Count(s => s.StoreHeadId != null && s.AreaHeadId != null)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="@($"glass-panel summary-card pa-4 {GetThemeClass()}")" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Style="opacity: 0.7">Unassigned</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold text-error">@_allStores.Count(s => s.StoreHeadId == null || s.AreaHeadId == null)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="@($"glass-panel summary-card pa-4 {GetThemeClass()}")" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Style="opacity: 0.7">Area Heads</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold text-info">@_allStores.Select(s => s.AreaHeadId).Distinct().Count(id => id != null)</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Filter Section -->
        <MudPaper Class="@($"glass-panel filter-section {GetThemeClass()} {(_showFilters ? "filters-visible" : "")}")" Elevation="0">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                       FullWidth="true"
                       OnClick="@(() => _showFilters = !_showFilters)"
                       Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                       Style="@GetFilterButtonStyle()">
                @(_showFilters ? "Hide Filters" : "Show Filters")
            </MudButton>

            <MudGrid Spacing="3" AlignItems="AlignItems.Center">
                <MudItem xs="12" sm="7">
                    <MudTextField @bind-Value="_searchTerm" Label="Search Stores" Placeholder="Search Store Name, Code, Location..."
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="rounded-lg"
                                  Immediate="true" TextChanged="ApplyFilters" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" Label="Assignment" Variant="Variant.Outlined" Margin="Margin.Dense"
                               @bind-Value="_assignmentFilter" SelectedValuesChanged="ApplyFilters">
                        <MudSelectItem Value="@("All")">All Assignments</MudSelectItem>
                        <MudSelectItem Value="@("Assigned")">Assigned (Both Heads)</MudSelectItem>
                        <MudSelectItem Value="@("Unassigned")">Unassigned (Missing Any)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudSelect T="string" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense"
                               @bind-Value="_statusFilter" SelectedValuesChanged="ApplyFilters">
                        <MudSelectItem Value="@("All")">All Status</MudSelectItem>
                        <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                        <MudSelectItem Value="@("Inactive")">Inactive</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <div class="d-flex align-center justify-space-between filters-summary-row">
                <div class="d-flex align-center">
                    <div class="mobile-view mr-3">
                        <div class="d-flex align-center">
                            <MudCheckBox T="bool" Value="@IsAllSelected()" ValueChanged="HandleSelectAll"
                                         Color="Color.Primary" Dense="true"
                                         Style="@($"color: {GetTitleColor()} !important;")" />
                        </div>
                    </div>
                    <MudText Typo="Typo.body2" Class="@($"{GetStatusTextColor()} font-weight-bold filter-info-text")" Style="opacity: 0.8;">
                        Showing @_filteredStores.Count of @_allStores.Count stores
                    </MudText>
                </div>
                <div class="d-flex align-center gap-2 action-buttons-container">
                    @if (HasActiveFilters())
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="ClearFilters"
                                   Class="modern-button clear-filters-button">
                            Clear Filters
                        </MudButton>
                    }
                    <MudToggleIconButton Toggled="_isMapView" ToggledChanged="OnViewToggled"
                                         Icon="@Icons.Material.Filled.Map" Color="Color.Default" Title="@(_isMapView ? "List View" : "Map View")" Size="Size.Small"
                                         ToggledIcon="@Icons.Material.Filled.List" ToggledColor="Color.Default"
                                         Style="background: #1565C0; color: #ffffff; border-radius: 10px; padding: 6px;" />
                </div>
            </div>
        </MudPaper>

        @if (_isMapView)
        {
            <MudPaper Class="@($"glass-panel pa-4 {GetThemeClass()}")" Elevation="0" Style="height: 600px; position: relative; overflow: hidden;">
                <div id="map" style="width: 100%; height: 100%; z-index: 1;"></div>

                <!-- Map Legend Overlay -->
                <div class="@($"map-legend-overlay {GetThemeClass()}")">
                    <div class="legend-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 21C16.5 17.5 19 14.1667 19 11C19 7.13401 15.866 4 12 4C8.13401 4 5 7.13401 5 11C5 14.1667 7.5 17.5 12 21Z" fill="#4caf50" stroke="#fff" stroke-width="1.5" />
                            <circle cx="12" cy="11" r="2.5" fill="#fff" />
                        </svg>
                        <MudText Class="legend-text" Style="@($"color: {GetTitleColor()}")">Assigned</MudText>
                    </div>
                    <div class="legend-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 21C16.5 17.5 19 14.1667 19 11C19 7.13401 15.866 4 12 4C8.13401 4 5 7.13401 5 11C5 14.1667 7.5 17.5 12 21Z" fill="#f44336" stroke="#fff" stroke-width="1.5" />
                            <circle cx="12" cy="11" r="2.5" fill="#fff" />
                        </svg>
                        <MudText Class="legend-text" Style="@($"color: {GetTitleColor()}")">Unassigned</MudText>
                    </div>
                </div>
            </MudPaper>
        }
        else
        {
            <!-- Desktop Table View -->
            <div class="desktop-view">
                <MudPaper Class="@($"glass-panel {GetThemeClass()}")" Elevation="0">
                    <MudTable Items="_filteredStores" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Class="mud-table-glass" MultiSelection="true" @bind-SelectedItems="_selectedStores"
                              SelectOnRowClick="false" @bind-ExpandedItems="_expandedRows">
                        <HeaderContent>
                            <MudTh>Store Code</MudTh>
                            <MudTh>Store Name</MudTh>
                            <MudTh>Location</MudTh>
                            <MudTh>Store Head</MudTh>
                            <MudTh>Area Head</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh Style="text-align: center;">Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Store Code">@context.StoreCode</MudTd>
                            <MudTd DataLabel="Store Name" Style="font-weight: 600;">@context.StoreName</MudTd>
                            <MudTd DataLabel="Location">@context.Location</MudTd>
                            <MudTd DataLabel="Store Head">
                                @if (context.StoreHead != null)
                                {
                                    <div class="d-flex flex-column">
                                        <span style="font-weight: 500">@context.StoreHead.Fullname</span>
                                        <MudLink OnClick="@(() => OpenAssignStoreHeadDialog(context))" Style="font-size: 11px;" Color="Color.Primary" Disabled="@(context.Status == "Inactive")">Change ▼</MudLink>
                                    </div>
                                }
                                else
                                {
