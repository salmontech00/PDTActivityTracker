                                                                                         Variant="Variant.Outlined"
                                                                                         Margin="Margin.Dense"
                                                                                         Disabled="@(IsSessionLocked() || IsAutoCompletedPreviousDay(progress, task))"
                                                                                         HideSpinButtons="true"
                                                                                         Class="manpower-input center-input" />
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex align-center gap-4">
                                                                <MudText Typo="Typo.body2">Expected: <b>@task.QuantityExpected</b></MudText>
                                                                <div style="width: 100px;">
                                                                    <MudNumericField T="int?"
                                                                                     Label="Actual"
                                                                                     Value="@progress.ActualQuantity"
                                                                                     ValueChanged="@((int? val) => { progress.ActualQuantity = val; _ = OnManpowerChanged(task, progress); })"
                                                                                     Variant="Variant.Outlined"
                                                                                     Margin="Margin.Dense"
                                                                                     HideSpinButtons="true"
                                                                                     Class="manpower-input center-input" />
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (task.IsRemarksRequired)
                                            {
                                                <div class="preview-remarks-container">
                                                    <MudTextField T="string"
                                                                  @bind-Value="progress.Remarks"
                                                                  Label="Remarks"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense"
                                                                  Dense="true"
                                                                  Placeholder="Enter remarks here..."
                                                                  Disabled="@(IsSessionLocked() || IsAutoCompletedPreviousDay(progress, task))"
                                                                  Class="rounded-lg"
                                                                  @bind-Value:after="@(() => OnRemarksChanged(task))" />
