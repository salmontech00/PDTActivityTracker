@page "/store-head/planner"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject UserStateService UserState
@inject IJSRuntime JSRuntime
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Activity Planner - @(_store?.StoreName ?? "Loading...")</PageTitle>


<style>
    .planner-container {
        padding: 1rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 16px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding: 0;
    }

    .button-group {
        display: flex;
        gap: 12px;
        padding: 0;
        margin: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* BUTTONS */
    .modern-button {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
    }

    .button-group .modern-button.light {
        background-color: #ffffff !important;
        color: #0072cf !important;
    }

    /* PREVIEW MODE */
    .preview-mode {
        max-width: 900px;
        margin: 0 auto;
        padding-bottom: 40px;
    }

    .modern-expansion-panels {
        background: transparent !important;
        box-shadow: none !important;
    }

    .modern-expansion-panel {
        background: rgba(255, 255, 255, 0.1) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 16px !important;
        margin-bottom: 16px !important;
        backdrop-filter: blur(10px);
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
    }

        .modern-expansion-panel::before {
            display: none !important;
        }

        .modern-expansion-panel.active {
            border-color: #0072cf !important;
            box-shadow: 0 10px 30px rgba(0, 114, 207, 0.15) !important;
        }

        .modern-expansion-panel.locked {
            opacity: 0.6;
            filter: grayscale(0.5);
            pointer-events: none;
        }

    .lightest .modern-expansion-panel {
        background: rgba(255, 255, 255, 0.45) !important;
        border: 1px solid rgba(0, 114, 207, 0.2) !important;
    }

        .lightest .modern-expansion-panel.active {
            border-color: #0072cf !important;
        }

    .preview-task-card {
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
        transition: all 0.2s ease;
    }

    .lightest .preview-task-card {
        background: rgba(0, 114, 207, 0.03) !important;
        border: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .preview-task-header {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        width: 100%;
    }

    .preview-header-content-group {
        display: flex;
        align-items: flex-start;
        flex-wrap: nowrap;
        gap: 8px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .preview-task-name-container {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding-top: 2px;
        flex: 0 0 auto;
    }

    .preview-description-row {
        display: flex;
        align-items: flex-start;
        gap: 4px;
        flex: 0 1 auto;
        min-width: 0;
    }

    .preview-upload-btn {
        border-radius: 8px !important;
        text-transform: none !important;
        font-weight: 600 !important;
        font-size: 0.75rem !important;
        flex: 0 0 auto;
        margin-left: auto;
    }

    .preview-remarks-container {
        margin-top: 8px;
        padding-left: 32px;
        width: 100%;
        max-width: 600px;
    }

    .manpower-input-container {
        margin-top: 8px;
        padding-left: 32px;
        width: 100%;
        max-width: 400px;
    }

    .manpower-input {
        max-width: 150px;
    }

    /* PHOTO GRID */
    .photo-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
        padding-left: 32px;
    }

    .photo-thumb-wrapper {
        position: relative;
        width: 56px;
        height: 56px;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.15);
        background: rgba(0,0,0,0.1);
    }

        .photo-thumb-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .photo-remove-btn {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: rgba(0,0,0,0.65);
        color: #fff;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        line-height: 1;
        padding: 0;
        transition: background 0.2s;
    }

        .photo-remove-btn:hover {
            background: rgba(220, 38, 38, 0.9);
        }

    .lightest .photo-thumb-wrapper {
        border: 1px solid rgba(0, 114, 207, 0.2);
        background: rgba(0,0,0,0.05);
    }

    /* CATEGORY CHIPS */
    .category-chip {
        font-weight: 800 !important;
        border-radius: 12px !important;
        background-color: #0072cf !important; /* Solid Admin Blue */
        color: #ffffff !important;
        border: none !important;
        text-transform: uppercase !important;
        letter-spacing: 0.5px !important;
    }

    .lightest .category-chip {
        background-color: #0072cf !important;
        color: #ffffff !important;
    }

    /* THEME SPECIFIC TEXT & ICON COLORS */
    .light .page-title, .dark .page-title,
    .light .category-icon,
    .light .preview-task-card .mud-typography, .dark .preview-task-card .mud-typography {
        color: #ffffff !important;
    }

    .lightest .page-title,
    .lightest .category-icon {
        color: #0f172a !important;
    }

    .lightest .category-icon {
        color: #0072cf !important;
    }

    /* RESPONSIVE */
    @@media (max-width: 600px) {
        .sub-title {
            font-size: 0.75rem !important;
            margin: 0px !important;
        }

        .info-row {
            flex-direction: column;
            gap: 0px !important;
            padding: 0px !important;
        }

        .preview-task-header {
            flex-wrap: wrap;
        }

        .preview-header-content-group {
            width: 100%;
            flex-wrap: wrap;
        }

        .preview-task-name-container {
            width: 100%;
        }

        .preview-description-row {
            width: 100%;
            padding-left: 0;
            margin-top: 8px;
            flex: 0 0 100%;
        }

        .preview-upload-btn {
            margin-left: 0 !important;
            margin-top: 12px;
            width: 100% !important;
        }

        .preview-remarks-container,
        .manpower-input-container {
            padding-left: 0;
            margin-top: 12px;
            width: 100%;
        }

        .center-input input {
            text-align: center;
            font-weight: 700;
        }

        .photo-grid {
            padding-left: 0;
        }
    }

    @@media (max-width: 960px) {
        .planner-container {
            padding: 1rem;
        }

        .page-header-row {
            flex-direction: column;
            gap: 16px;
            align-items: stretch;
            text-align: center;
            padding: 0;
            margin-bottom: 0px !important;
        }

        .page-title {
            display: block !important;
            font-size: 1.5rem !important;
            margin-bottom: 0px !important;
            padding-top: 0px !important;
            order: 2;
        }

        .button-group {
            flex-wrap: wrap;
            width: 100%;
            gap: 8px;
            order: 1;
        }

            .button-group .modern-button {
                font-size: 0.60rem !important;
                padding: 6px 0px !important;
            }
                /* First button (Back) takes full width */
                .button-group .modern-button:first-child {
                    flex: 0 0 100%;
                }
                /* Second button (Issue) and third button (Save) split the second row */
                .button-group .modern-button:nth-child(2),
                .button-group .modern-button:nth-child(3) {
                    flex: 1 1 calc(50% - 4px);
                }

        .complete-section-btn {
            width: 100%;
            padding: 10px !important;
            font-size: 0.9rem !important;
        }
    }

    @@media (max-width: 375px) {
        .mud-main-content {
            padding-bottom: 0px !important;
            padding-left: 0px !important;
            padding-right: 0px !important;
        }
    }

    /* COMPLETION BUTTON */
    .complete-section-btn {
        border-radius: 12px !important;
        padding: 12px 40px !important;
        font-weight: 700 !important;
        text-transform: none !important;
    }

    .info-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .frequency-filter-row {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 24px;
        overflow-x: auto;
        padding: 8px 4px;
        flex-wrap: nowrap;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
    }

    @@media (max-width: 480px) {
        .frequency-filter-row {
            justify-content: flex-start;
            padding-left: 12px;
            padding-right: 12px;
        }
    }
    /* EMPTY STATE */
    .empty-state-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        border-radius: 24px;
        text-align: center;
        transition: all 0.3s ease;
    }

    .empty-state-icon-wrapper {
        margin-bottom: 24px;
        padding: 24px;
        border-radius: 50%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .empty-state-title {
        font-weight: 800;
        letter-spacing: -0.5px;
        margin-bottom: 8px;
    }

    .empty-state-description {
        opacity: 0.9;
        max-width: 400px;
        margin: 12px auto 0 auto;
        line-height: 1.6;
    }

    .empty-state-button {
        margin-top: 32px !important;
        border-radius: 12px !important;
        font-weight: 800 !important;
        padding: 10px 32px !important;
    }

    @@media (max-width: 600px) {
        .empty-state-container {
            padding: 3rem 1.5rem;
            border-radius: 20px;
        }

        .empty-state-icon-wrapper {
            padding: 18px;
            margin-bottom: 20px;
        }

            .empty-state-icon-wrapper .mud-icon-root {
                font-size: 3rem !important;
            }

        .empty-state-title {
            font-size: 1.25rem !important;
        }

        .empty-state-description {
            font-size: 0.875rem !important;
            max-width: 100%;
        }

        .empty-state-button {
            width: auto !important;
            min-width: 180px;
            margin-top: 20px !important;
            padding: 6px 20px !important;
            font-size: 0.7rem !important;
            font-weight: 700 !important;
            letter-spacing: 0.5px;
        }
    }
</style>

<div class="planner-container @GetThemeClass()">
    <!-- HEADER -->
    <div class="page-header-row">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Activity Planner</MudText>

        <div class="button-group">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Map"
                       Href="/store-head/map"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                BACK TO MAP
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.ReportProblem"
                       OnClick="OpenIssueDialog"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                REPORT ISSUE
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="ConfirmSaveProgress"
                       Disabled="@IsSessionLocked()"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                SUBMIT PROGRESS
            </MudButton>
        </div>
    </div>

    <!-- INFO ROW -->
    <div class="info-row mb-2">
        <MudText Typo="Typo.subtitle1" Class="@($"sub-title {GetThemeClass()}")" Style="opacity: 0.7; text-align: center;">
            @(_store?.StoreName) • @(DateTime.Now.ToString("MMMM dd, yyyy"))
        </MudText>
        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small" Class="">
            @(_completedCount)/@(_totalTasksCount) TASKS
        </MudChip>
    </div>

    <!-- FREQUENCY FILTER -->
    <div class="frequency-filter-row">
        <MudChip T="string" Variant="@(_frequencyFilter == "All" ? Variant.Filled : Variant.Outlined)" Color="Color.Info" Size="Size.Small" OnClick="@(() => SetFrequencyFilter("All"))">ALL</MudChip>
        <MudChip T="string" Variant="@(_frequencyFilter == "Daily" ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" Size="Size.Small" OnClick="@(() => SetFrequencyFilter("Daily"))">DAILY</MudChip>
        <MudChip T="string" Variant="@(_frequencyFilter == "Weekly" ? Variant.Filled : Variant.Outlined)" Color="Color.Success" Size="Size.Small" OnClick="@(() => SetFrequencyFilter("Weekly"))">WEEKLY</MudChip>
        <MudChip T="string" Variant="@(_frequencyFilter == "Monthly" ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" Size="Size.Small" OnClick="@(() => SetFrequencyFilter("Monthly"))">MONTHLY</MudChip>
    </div>

    @if (_initialized)
    {
        <div class="preview-mode">
            @if (_totalTasksCount == 0)
            {
                <div class="empty-state-container glass-panel @GetThemeClass()" style="border: 2px dashed rgba(255, 255, 255, 0.2); background: rgba(0, 0, 0, 0.15);">
                    <div class="empty-state-icon-wrapper" style="background: rgba(255, 255, 255, 0.15);">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Style="@($"font-size: 4rem; transform: rotate(-10deg); color: {(GetThemeClass() == "lightest" ? "var(--mud-palette-info)" : "white")};")" />
                    </div>
                    <MudText Typo="Typo.h5" Class="@($"empty-state-title {(GetThemeClass() == "lightest" ? "text-dark" : "text-white")}")">No Tasks Scheduled</MudText>
                    <MudText Typo="Typo.body1" Class="@($"empty-state-description {(GetThemeClass() == "lightest" ? "text-dark" : "text-white")}")">
                        @(GetEmptyMessage())
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               OnClick="@(() => SetFrequencyFilter("All"))"
                               Class="empty-state-button modern-button"
                               Style="@(GetThemeClass() == "lightest" ? "" : "background-color: rgba(255,255,255,0.9) !important; color: #0072cf !important;")">
                        SHOW ALL AVAILABLE TASKS
                    </MudButton>
                </div>
            }
            else
            {
                <MudExpansionPanels MultiExpansion="true" Class="modern-expansion-panels">
                    @foreach (var category in _categories.OrderBy(c => c.SortOrder))
                    {
                        var isLocked = _categories
                            .Where(c => c.SortOrder < category.SortOrder)
                            .Where(c => _checklistItems.Any(t => t.CategoryId == c.Id && (_frequencyFilter == "All" || t.Frequency == _frequencyFilter)))
                            .Any(c => !CanCompleteCategory(c.Id));
                        var isActive = category.Id == _currentCategoryId;
                        var isCompleted = !isLocked && CanCompleteCategory(category.Id);
                        var itemsInCategory = _checklistItems
                        .Where(t => t.CategoryId == category.Id)
                        .Where(t => _frequencyFilter == "All" || t.Frequency == _frequencyFilter)
                        .OrderBy(t => t.SortOrder)
                        .ToList();

                        if (!itemsInCategory.Any()) continue;

                        <MudExpansionPanel Class="@($"modern-expansion-panel {(isActive ? "active" : "")} {(isLocked ? "locked" : "")}")"
                                           MaxHeight="600"
                                           IsInitiallyExpanded="@isActive">
                            <TitleContent>
                                <div class="d-flex align-center py-2">
                                    <MudIcon Icon="@category.Icon" Class="mr-3 category-icon" Color="@(isCompleted? Color.Success: (isActive ? Color.Primary : Color.Default))" />
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.h6" Style="font-weight: 700;">@category.Name</MudText>
                                        <MudText Typo="Typo.caption" Style="opacity: 0.6;">@(GetCategoryCompletionStatus(category.Id))</MudText>
                                    </div>
                                    <MudSpacer />
                                    @if (isLocked)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="opacity: 0.5;" Class="mr-2" />
                                    }
                                    else if (isCompleted)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                                    }
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="@($"category-chip {category.ColorClass}")">
                                        @itemsInCategory.Count() Tasks
                                    </MudChip>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                @{
                                    var lastSection = "";
                                    @for (int i = 0; i < itemsInCategory.Count; i++)
                                    {
                                        var task = itemsInCategory[i];
                                        var taskNumber = i + 1;
                                        var progress = GetTaskProgress(task.Id);

                                        // Section Header logic
                                        @if (task.Section != lastSection && !string.IsNullOrEmpty(task.Section))
                                        {
                                            <div class="mt-4 mb-2 px-2">
                                                <MudText Typo="Typo.subtitle2" Class="@(GetThemeClass() == "lightest" ? "text-dark" : "text-white")" Style="font-weight: 800; letter-spacing: 1px; text-transform: uppercase; font-size: 0.7rem; opacity: 0.6;">
                                                    @task.Section
                                                </MudText>
                                                <MudDivider Class="mt-1" Style="opacity: 0.1;" />
                                            </div>
                                            lastSection = task.Section;
                                        }
                                        else if (string.IsNullOrEmpty(task.Section))
                                        {
                                            lastSection = "";
                                        }

                                        <div class="preview-task-card">
                                            <div class="preview-task-header">
                                                <div class="preview-header-content-group">
                                                    <div class="preview-task-name-container">
                                                        <MudText Typo="Typo.body2" Class="opacity-50 mt-1" Style="min-width: 20px; font-weight: 700;">@taskNumber.</MudText>
                                                        <MudCheckBox T="bool"
                                                                     Value="@progress.IsCompleted"
                                                                     ValueChanged="@((bool val) => ToggleManualTask(task, progress, val))"
                                                                     Color="Color.Primary"
                                                                     Dense="true"
                                                                     Disabled="@(IsSessionLocked() || task.IsPhotoRequired || task.TaskType == "Manpower" || IsAutoCompletedPreviousDay(progress, task))"
                                                                     Class="pa-0" />

                                                        <div class="d-flex align-center flex-wrap gap-2">
                                                            @if (task.IsMandatory)
                                                            {
                                                                <span style="color: var(--mud-palette-error); font-weight: bold; font-size: 1.2rem; line-height: 1;">*</span>
                                                            }
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="py-0 px-2" Style="height: 18px; font-size: 0.6rem; font-weight: 700;">@task.Frequency</MudChip>
                                                            <MudText Typo="Typo.body1" Class="@(GetThemeClass() == "lightest" ? "text-dark" : "text-white")" Style="font-weight: 600;">
                                                                @FormatLongWords(task.TaskName)
                                                            </MudText>
                                                        </div>
                                                    </div>

                                                    @if (!string.IsNullOrEmpty(task.Description))
                                                    {
                                                        <div class="preview-description-row">
                                                            <MudText Typo="Typo.body2" Style="opacity: 0.7;">@FormatLongWords(task.Description)</MudText>
                                                        </div>
                                                    }
                                                </div>

                                                @if (task.IsPhotoRequired)
                                                {
                                                    @if (IsAutoCompletedPreviousDay(progress, task))
                                                    {
                                                        <div class="d-flex align-center gap-1">
                                                            <MudButton Variant="Variant.Filled"
                                                                       Size="Size.Small"
                                                                       Color="Color.Success"
                                                                       Disabled="true"
                                                                       Style="border-radius: 8px; font-weight: bold; opacity: 0.8;">
                                                                @GetRemainingDaysText(task, progress)
                                                            </MudButton>
                                                            <MudTooltip Text="Force manual task refresh">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                                                                               Variant="Variant.Filled"
                                                                               Color="Color.Error" 
                                                                               Size="Size.Small" 
                                                                               OnClick="@(() => ForceManualCompletion(task, progress))" />
                                                            </MudTooltip>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <MudButton Variant="Variant.Filled"
                                                                   StartIcon="@Icons.Material.Filled.PhotoCamera"
                                                                   Size="Size.Small"
                                                                   Color="Color.Primary"
                                                                   OnClick="@(() => CapturePhoto(task))"
                                                                   Class="preview-upload-btn"
                                                                   Disabled="@(IsSessionLocked() || (task.NumberOfPhotos > 0 && GetPhotoCount(task.Id) >= task.NumberOfPhotos))"
                                                                   Style="border-radius: 8px; font-weight: bold;">
                                                            CAPTURE (@(GetPhotoCount(task.Id))/@(task.NumberOfPhotos == 0 ? "∞" : task.NumberOfPhotos))
                                                        </MudButton>
                                                    }
                                                }
                                            </div>

                                            @if (task.TaskType == "Manpower" || task.TaskType == "Equipment")
                                            {
                                                <div class="manpower-input-container">
                                                    <div class="d-flex flex-column gap-3">
                                                        @if (task.TaskType == "Manpower")
                                                        {
                                                            var positions = GetManpowerPositions(task);
                                                            if (positions.Any())
                                                            {
                                                                <div class="mb-1">
                                                                    <MudText Typo="Typo.body2" Style="font-weight: 700; opacity: 0.9;">Manpower Breakdown:</MudText>
                                                                </div>
                                                                @for (int j = 0; j < positions.Count; j++)
                                                                {
                                                                    var pos = positions[j];
                                                                    var index = j;
                                                                    char label = (char)('a' + j);
                                                                    <div class="d-flex align-center gap-4 flex-wrap ml-2 mb-1">
                                                                        <div style="min-width: 140px; flex-grow: 1;">
                                                                            <MudText Typo="Typo.caption" Style="font-weight: 600; opacity: 0.8;">
                                                                                @label. @pos.Name
                                                                            </MudText>
                                                                        </div>
                                                                        <div class="d-flex align-center gap-2">
                                                                            <div style="width: 80px;">
                                                                                <MudNumericField T="int?"
