    private string FormatLongWords(string? text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        var words = text.Split(' ');
        for (int i = 0; i < words.Length; i++)
        {
            var word = words[i];
            if (word.Length > 12)
            {
                var sb = new System.Text.StringBuilder();
                for (int j = 0; j < word.Length; j++)
                {
                    sb.Append(word[j]);
                    if ((j + 1) % 10 == 0 && j < word.Length - 1)
                    {
                        sb.Append("\u200B");
                    }
                }
                words[i] = sb.ToString();
            }
        }
        return string.Join(" ", words);
    }

    private async Task OnManpowerChanged(ChecklistItem task, TaskProgress prog, int? positionIndex = null)
    {
        await CheckAndSyncTaskCompletion(task);
        await SaveCurrentProgress();
        await CheckAndAutoProgress();

        // Notification only for new disparities, not for initial setup or empty
        await ValidateManpower(task, prog, positionIndex);
    }

    private async Task OnRemarksChanged(ChecklistItem task)
    {
        await CheckAndSyncTaskCompletion(task);
        await SaveCurrentProgress();
        await CheckAndAutoProgress();
    }

    private async Task ValidateManpower(ChecklistItem task, TaskProgress prog, int? positionIndex = null)
    {
        if (task.TaskType != "Manpower") return;

        using var db = await DbFactory.CreateDbContextAsync();
        try
        {
            var positions = JsonSerializer.Deserialize<List<ManpowerPosition>>(task.Position ?? "[]") ?? new();
            var actuals = JsonSerializer.Deserialize<List<int?>>(prog.PositionActuals ?? "[]") ?? new();

            // Stricter check: only notify if a specific position was changed
            if (!positionIndex.HasValue) return;
            var pi = positionIndex.Value;
            if (pi < 0 || pi >= positions.Count) return;

            var areaHeadName = _store?.AreaHead?.Fullname ?? "Area Head";
            var taskLabel = (!string.IsNullOrWhiteSpace(task.TaskName) ? task.TaskName : task.Description) ?? "Manpower Task";

            var name = positions[pi].Name;
            var expected = GetPositionExpectedValue(prog, task, pi) ?? positions[pi].Count;
            var actual = pi < actuals.Count ? (actuals[pi] ?? 0) : 0;

            // Only alert if Actual is provided and less than expected
            if (actual > 0 && actual < expected)
            {
                int missing = expected - actual;
                var notification = new Notification
                {
                    UserId = _store?.AreaHeadId ?? 0,
                    Message = $"{_store?.StoreName}: {taskLabel} - {name} lacking {missing} staff",
                    Type = "Alert",
                    IsRead = false,
                    CreatedAt = DateTime.Now,
                    RelatedEntityId = StoreId,
                    RelatedEntityType = "Store"
                };

                if (notification.UserId > 0)
                {
                    db.Notifications.Add(notification);
                    await db.SaveChangesAsync();

                    Snackbar.Add($"Missing manpower reported for {taskLabel}. {areaHeadName} has been notified.", Severity.Warning);
                }
            }
            // Notify when manpower requirement is fully met (or exceeded)
            else if (actual > 0 && actual >= expected)
            {
                var notification = new Notification
                {
                    UserId = _store?.AreaHeadId ?? 0,
                    Message = $"{_store?.StoreName}: {taskLabel} - {name} manpower complete ({actual}/{expected})",
                    Type = "Info",
                    IsRead = false,
                    CreatedAt = DateTime.Now,
                    RelatedEntityId = StoreId,
                    RelatedEntityType = "Store"
                };

                if (notification.UserId > 0)
                {
                    db.Notifications.Add(notification);
                    await db.SaveChangesAsync();

                    Snackbar.Add($"Manpower confirmed complete for {taskLabel}.", Severity.Success);
                }
            }
        }
        catch { }
    }

    private bool IsTaskAssignedToStore(ChecklistItem task, int storeId)
    {
        // Only Manpower tasks have store-specific visibility logic
        if (task.TaskType != "Manpower") return true;

        if (string.IsNullOrWhiteSpace(task.SelectedStores)) return false;
        try
        {
            var ids = JsonSerializer.Deserialize<List<int>>(task.SelectedStores);
            return ids != null && ids.Contains(storeId);
        }
        catch { return false; }
    }

    private List<ManpowerPosition> GetManpowerPositions(ChecklistItem task)
    {
        if (task.TaskType != "Manpower" || string.IsNullOrWhiteSpace(task.Position))
            return new List<ManpowerPosition>();

        try
        {
            return JsonSerializer.Deserialize<List<ManpowerPosition>>(task.Position) ?? new List<ManpowerPosition>();
        }
        catch { return new List<ManpowerPosition>(); }
    }

    private int? GetPositionActualValue(TaskProgress prog, int index)
    {
        if (string.IsNullOrWhiteSpace(prog.PositionActuals)) return null;
        try
        {
            var actuals = JsonSerializer.Deserialize<List<int?>>(prog.PositionActuals);
            if (actuals != null && index >= 0 && index < actuals.Count)
            {
                return actuals[index];
            }
        }
        catch { }
        return null;
    }

    private int? GetPositionExpectedValue(TaskProgress prog, ChecklistItem task, int index)
    {
        // If progress has its own expected values, use them
        if (!string.IsNullOrWhiteSpace(prog.PositionExpected))
        {
            try
            {
                var expecteds = JsonSerializer.Deserialize<List<int?>>(prog.PositionExpected);
                if (expecteds != null && index >= 0 && index < expecteds.Count)
                {
                    return expecteds[index];
                }
            }
            catch { }
        }

        // Fallback to ChecklistItem default positions
        var positions = GetManpowerPositions(task);
        if (index >= 0 && index < positions.Count)
        {
            return positions[index].Count;
        }

        return null;
    }

    private async Task UpdatePositionExpected(ChecklistItem task, TaskProgress prog, int index, int? value)
    {
        List<int?> expecteds;
        var positions = GetManpowerPositions(task);

        if (string.IsNullOrWhiteSpace(prog.PositionExpected))
        {
            expecteds = positions.Select(p => (int?)p.Count).ToList();
        }
        else
        {
            try
            {
                expecteds = JsonSerializer.Deserialize<List<int?>>(prog.PositionExpected) ?? new List<int?>();
            }
            catch { expecteds = new List<int?>(); }
        }

        while (expecteds.Count <= index) expecteds.Add(null);
        expecteds[index] = value;

        prog.PositionExpected = JsonSerializer.Serialize(expecteds);
        await OnManpowerChanged(task, prog, index);
    }

    private int GetTotalExpectedValue(TaskProgress prog, ChecklistItem task)
    {
        if (!string.IsNullOrWhiteSpace(prog.PositionExpected))
        {
            try
            {
                var expecteds = JsonSerializer.Deserialize<List<int?>>(prog.PositionExpected);
                if (expecteds != null)
                {
                    return expecteds.Sum(a => a ?? 0);
                }
            }
            catch { }
        }
        return task.QuantityExpected ?? 0;
    }

    private async Task UpdatePositionActual(ChecklistItem task, TaskProgress prog, int index, int? value)
    {
        List<int?> actuals;
        if (string.IsNullOrWhiteSpace(prog.PositionActuals))
        {
            var positions = GetManpowerPositions(task);
            actuals = new List<int?>(new int?[positions.Count]);
        }
        else
        {
            try
            {
                actuals = JsonSerializer.Deserialize<List<int?>>(prog.PositionActuals) ?? new List<int?>();
            }
            catch { actuals = new List<int?>(); }
        }

        while (actuals.Count <= index) actuals.Add(null);
        actuals[index] = value;

        prog.PositionActuals = JsonSerializer.Serialize(actuals);

        // Update total ActualQuantity
        prog.ActualQuantity = actuals.Sum(a => a ?? 0);

        await OnManpowerChanged(task, prog, index);
    }
