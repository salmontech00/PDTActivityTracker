@page "/store-head/planner"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject UserStateService UserState
@inject IJSRuntime JSRuntime
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Activity Planner - @(_store?.StoreName ?? "Loading...")</PageTitle>


<style>
    .planner-container {
        padding: 1rem;
    }

    /* GLASS CONTAINER */
    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 16px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .glass-panel.lightest {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid #0072cf !important;
        }

        .glass-panel.light {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
        }

        .glass-panel.dark {
            background-color: rgba(30, 41, 59, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    /* PAGE HEADER */
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding: 0;
    }

    .button-group {
        display: flex;
        gap: 12px;
        padding: 0;
        margin: 0;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
    }

        .page-title.lightest {
            color: #0f172a;
        }

        .page-title.light {
            color: #ffffff;
        }

        .page-title.dark {
            color: #ffffff;
        }

    /* BUTTONS */
    .modern-button {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
    }

    .button-group .modern-button.light {
        background-color: #ffffff !important;
        color: #0072cf !important;
    }

    /* PREVIEW MODE */
    .preview-mode {
        max-width: 900px;
        margin: 0 auto;
        padding-bottom: 40px;
    }

    .modern-expansion-panels {
        background: transparent !important;
        box-shadow: none !important;
    }

    .modern-expansion-panel {
        background: rgba(255, 255, 255, 0.1) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 16px !important;
        margin-bottom: 16px !important;
        backdrop-filter: blur(10px);
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
    }

        .modern-expansion-panel::before {
            display: none !important;
        }

        .modern-expansion-panel.active {
            border-color: #0072cf !important;
            box-shadow: 0 10px 30px rgba(0, 114, 207, 0.15) !important;
        }

        .modern-expansion-panel.locked {
            opacity: 0.6;
            filter: grayscale(0.5);
            pointer-events: none;
        }

    .lightest .modern-expansion-panel {
        background: rgba(255, 255, 255, 0.45) !important;
        border: 1px solid rgba(0, 114, 207, 0.2) !important;
    }

        .lightest .modern-expansion-panel.active {
            border-color: #0072cf !important;
        }

    .preview-task-card {
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
        transition: all 0.2s ease;
    }

    .lightest .preview-task-card {
        background: rgba(0, 114, 207, 0.03) !important;
        border: 1px solid rgba(0, 114, 207, 0.1) !important;
    }

    .preview-task-header {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        width: 100%;
    }

    .preview-header-content-group {
        display: flex;
        align-items: flex-start;
        flex-wrap: nowrap;
        gap: 8px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .preview-task-name-container {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding-top: 2px;
        flex: 0 0 auto;
    }

    .preview-description-row {
        display: flex;
        align-items: flex-start;
        gap: 4px;
        flex: 0 1 auto;
        min-width: 0;
    }

    .preview-upload-btn {
        border-radius: 8px !important;
        text-transform: none !important;
        font-weight: 600 !important;
        font-size: 0.75rem !important;
        flex: 0 0 auto;
        margin-left: auto;
    }

    .preview-remarks-container {
        margin-top: 8px;
        padding-left: 32px;
        width: 100%;
        max-width: 600px;
    }

    .manpower-input-container {
        margin-top: 8px;
        padding-left: 32px;
        width: 100%;
        max-width: 400px;
    }

    .manpower-input {
        max-width: 150px;
    }

    /* PHOTO GRID */
    .photo-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
        padding-left: 32px;
    }

    .photo-thumb-wrapper {
        position: relative;
        width: 56px;
        height: 56px;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.15);
        background: rgba(0,0,0,0.1);
    }

        .photo-thumb-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .photo-remove-btn {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: rgba(0,0,0,0.65);
        color: #fff;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        line-height: 1;
        padding: 0;
        transition: background 0.2s;
    }

        .photo-remove-btn:hover {
            background: rgba(220, 38, 38, 0.9);
        }

    .lightest .photo-thumb-wrapper {
        border: 1px solid rgba(0, 114, 207, 0.2);
        background: rgba(0,0,0,0.05);
    }

    /* CATEGORY CHIPS */
    .category-chip {
        font-weight: 700 !important;
        border-radius: 12px !important;
        background-color: rgba(253, 212, 92, 0.1) !important;
        color: rgb(253, 212, 92) !important;
        border: 1px solid rgba(253, 212, 92, 0.3) !important;
    }

    .lightest .category-chip {
        background-color: rgba(0, 114, 207, 0.5) !important;
        color: rgb(253, 212, 92) !important;
        border: 1px solid rgba(253, 212, 92, 0.3) !important;
    }

    /* THEME SPECIFIC TEXT & ICON COLORS */
    .light .page-title, .dark .page-title,
    .light .category-icon,
    .light .preview-task-card .mud-typography, .dark .preview-task-card .mud-typography {
        color: #ffffff !important;
    }

    .lightest .page-title,
    .lightest .category-icon {
        color: #0f172a !important;
    }

    .lightest .category-icon {
        color: #0072cf !important;
    }

    /* RESPONSIVE */
    @@media (max-width: 600px) {
        .sub-title {
            font-size: 0.75rem !important;
            margin: 0px !important;
        }

        .info-row {
            flex-direction: column;
            gap: 0px !important;
            padding: 0px !important;
        }

        .preview-task-header {
            flex-wrap: wrap;
        }

        .preview-header-content-group {
            width: 100%;
            flex-wrap: wrap;
        }

        .preview-task-name-container {
            width: 100%;
        }

        .preview-description-row {
            width: 100%;
            padding-left: 0;
            margin-top: 8px;
            flex: 0 0 100%;
        }

        .preview-upload-btn {
            margin-left: 0 !important;
            margin-top: 12px;
            width: 100% !important;
        }

        .preview-remarks-container,
        .manpower-input-container {
            padding-left: 0;
            margin-top: 12px;
            width: 100%;
        }

        .center-input input {
            text-align: center;
            font-weight: 700;
        }

        .photo-grid {
            padding-left: 0;
        }
    }

    @@media (max-width: 960px) {
        .planner-container {
            padding: 1rem;
        }

        .page-header-row {
            flex-direction: column;
            gap: 16px;
            align-items: stretch;
            text-align: center;
            padding: 0;
            margin-bottom: 0px !important;
        }

        .page-title {
            display: block !important;
            font-size: 1.5rem !important;
            margin-bottom: 0px !important;
            padding-top: 0px !important;
            order: 2;
        }

        .button-group {
            flex-wrap: wrap;
            width: 100%;
            gap: 8px;
            order: 1;
        }

            .button-group .modern-button {
                font-size: 0.60rem !important;
                padding: 6px 0px !important;
            }
                /* First button (Back) takes full width */
                .button-group .modern-button:first-child {
                    flex: 0 0 100%;
                }
                /* Second button (Issue) and third button (Save) split the second row */
                .button-group .modern-button:nth-child(2),
                .button-group .modern-button:nth-child(3) {
                    flex: 1 1 calc(50% - 4px);
                }

        .complete-section-btn {
            width: 100%;
            padding: 10px !important;
            font-size: 0.9rem !important;
        }
    }

    @@media (max-width: 375px) {
        .mud-main-content {
            padding-bottom: 0px !important;
            padding-left: 0px !important;
            padding-right: 0px !important;
        }
    }

    /* COMPLETION BUTTON */
    .complete-section-btn {
        border-radius: 12px !important;
        padding: 12px 40px !important;
        font-weight: 700 !important;
        text-transform: none !important;
    }

    .info-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .frequency-filter-row {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 24px;
        overflow-x: auto;
        padding: 8px 4px;
        flex-wrap: nowrap;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
    }

    @@media (max-width: 480px) {
        .frequency-filter-row {
            justify-content: flex-start;
            padding-left: 12px;
            padding-right: 12px;
        }
    }
</style>

<div class="planner-container @GetThemeClass()">
    <!-- HEADER -->
    <div class="page-header-row">
        <MudText Typo="Typo.h4" Class="@($"page-title {GetThemeClass()}")">Activity Planner</MudText>

        <div class="button-group">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Map"
                       Href="/store-head/map"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                BACK TO MAP
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.ReportProblem"
                       OnClick="OpenIssueDialog"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                REPORT ISSUE
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveCurrentProgress"
                       Class="@($"modern-button {GetThemeClass()}")"
                       Style="@GetButtonStyle()">
                SAVE PROGRESS
            </MudButton>
        </div>
    </div>

    <!-- INFO ROW -->
    <div class="info-row mb-2">
        <MudText Typo="Typo.subtitle1" Class="@($"sub-title {GetThemeClass()}")" Style="opacity: 0.7; text-align: center;">
            @(_store?.StoreName) • @(DateTime.Now.ToString("MMMM dd, yyyy"))
        </MudText>
        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small" Class="">
            @(_completedCount)/@(_totalTasksCount) TASKS
        </MudChip>
    </div>

    <!-- FREQUENCY FILTER -->
    <div class="frequency-filter-row">
        <MudChip T="string" Variant="@(_frequencyFilter == "All" ? Variant.Filled : Variant.Outlined)" Color="Color.Info" Size="Size.Small" OnClick="@(() => SetFrequencyFilter("All"))">ALL</MudChip>
        <MudChip T="string" Variant="@(_frequencyFilter == "Daily" ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" Size="Size.Small" OnClick="@(() => SetFrequencyFilter("Daily"))">DAILY</MudChip>
        <MudChip T="string" Variant="@(_frequencyFilter == "Weekly" ? Variant.Filled : Variant.Outlined)" Color="Color.Success" Size="Size.Small" OnClick="@(() => SetFrequencyFilter("Weekly"))">WEEKLY</MudChip>
        <MudChip T="string" Variant="@(_frequencyFilter == "Monthly" ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" Size="Size.Small" OnClick="@(() => SetFrequencyFilter("Monthly"))">MONTHLY</MudChip>
    </div>

    @if (_initialized)
    {
        <!-- Preview Mode -->
        <div class="preview-mode">
            <MudExpansionPanels MultiExpansion="true" Class="modern-expansion-panels">
                @foreach (var category in _categories.OrderBy(c => c.SortOrder))
                {
                    var isLocked = category.SortOrder > _currentCategoryOrder || _categories.Any(c => c.SortOrder < category.SortOrder && !CanCompleteCategory(c.Id));
                    var isActive = category.Id == _currentCategoryId;
                    var isCompleted = category.SortOrder < _currentCategoryOrder && CanCompleteCategory(category.Id);
                    var itemsInCategory = _checklistItems
                    .Where(t => t.CategoryId == category.Id)
                    .Where(t => _frequencyFilter == "All" || t.Frequency == _frequencyFilter)
                    .OrderBy(t => t.SortOrder)
                    .ToList();

                    if (!itemsInCategory.Any() && _frequencyFilter != "All") continue;

                    <MudExpansionPanel Class="@($"modern-expansion-panel {(isActive ? "active" : "")} {(isLocked ? "locked" : "")}")"
                                       MaxHeight="600"
                                       IsInitiallyExpanded="@isActive">
                        <TitleContent>
                            <div class="d-flex align-center py-2">
                                <MudIcon Icon="@category.Icon" Class="mr-3 category-icon" Color="@(isCompleted? Color.Success: (isActive ? Color.Primary : Color.Default))" />
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.h6" Style="font-weight: 700;">@category.Name</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">@(GetCategoryCompletionStatus(category.Id))</MudText>
                                </div>
                                <MudSpacer />
                                @if (isLocked)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="opacity: 0.5;" Class="mr-2" />
                                }
                                else if (isCompleted)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                                }
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="@($"category-chip {category.ColorClass}")">
                                    @itemsInCategory.Count() Tasks
                                </MudChip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            @{
                                var regularTasks = itemsInCategory.Where(t => t.TaskType != "Manpower" && t.TaskType != "Equipment").ToList();
                                var gridTasks = itemsInCategory.Where(t => t.TaskType == "Manpower" || t.TaskType == "Equipment").ToList();
                            }

                            @if (regularTasks.Any())
                            {
                                var lastSection = "";
                                @for (int i = 0; i < regularTasks.Count; i++)
                                {
                                    var task = regularTasks[i];
                                    var taskNumber = i + 1;
                                    var progress = GetTaskProgress(task.Id);

                                    // Section Header
                                    @if (task.Section != lastSection && !string.IsNullOrEmpty(task.Section))
                                    {
                                        <div class="mt-4 mb-2 px-2">
                                            <MudText Typo="Typo.subtitle2" Class="@(GetThemeClass() == "lightest" ? "text-dark" : "text-white")" Style="font-weight: 800; letter-spacing: 1px; text-transform: uppercase; font-size: 0.7rem; opacity: 0.6;">
                                                @task.Section
                                            </MudText>
                                            <MudDivider Class="mt-1" Style="opacity: 0.1;" />
                                        </div>
                                        lastSection = task.Section;
                                    }
                                    else if (string.IsNullOrEmpty(task.Section))
                                    {
                                        lastSection = "";
                                    }

                                    <div class="preview-task-card">
                                        <div class="preview-task-header">
                                            <div class="preview-header-content-group">
                                                <div class="preview-task-name-container">
                                                    <MudText Typo="Typo.body2" Class="opacity-50 mt-1" Style="min-width: 20px; font-weight: 700;">@taskNumber.</MudText>
                                                    <MudCheckBox T="bool"
                                                                 Value="@progress.IsCompleted"
                                                                 Color="Color.Primary"
                                                                 Dense="true"
                                                                 Disabled="true"
                                                                 Class="pa-0" />

                                                    <div class="d-flex align-center flex-wrap gap-2">
                                                        @if (task.IsMandatory)
                                                        {
                                                            <span style="color: var(--mud-palette-error); font-weight: bold; font-size: 1.2rem; line-height: 1;">*</span>
                                                        }
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="py-0 px-2" Style="height: 18px; font-size: 0.6rem; font-weight: 700;">@task.Frequency</MudChip>
                                                        <MudText Typo="Typo.body1" Class="@(GetThemeClass() == "lightest" ? "text-dark" : "text-white")" Style="font-weight: 600;">
                                                            @task.TaskName
                                                        </MudText>
                                                    </div>
                                                </div>

                                                @if (!string.IsNullOrEmpty(task.Description))
                                                {
                                                    <div class="preview-description-row">
                                                        <MudText Typo="Typo.body2" Style="opacity: 0.7;">@task.Description</MudText>
                                                    </div>
                                                }
                                            </div>

                                            @if (task.IsPhotoRequired)
                                            {
                                                <MudButton Variant="Variant.Filled"
                                                           StartIcon="@Icons.Material.Filled.PhotoCamera"
                                                           Size="Size.Small"
                                                           Color="Color.Primary"
                                                           OnClick="@(() => CapturePhoto(task))"
                                                           Class="preview-upload-btn"
                                                           Disabled="@(task.NumberOfPhotos > 0 && GetPhotoCount(task.Id) >= task.NumberOfPhotos)"
                                                           Style="border-radius: 8px; font-weight: bold;">
                                                    CAPTURE (@(GetPhotoCount(task.Id))/@(task.NumberOfPhotos == 0 ? "∞" : task.NumberOfPhotos))
                                                </MudButton>
                                            }
                                        </div>

                                        @if (task.IsRemarksRequired)
                                        {
                                            <div class="preview-remarks-container">
                                                <MudTextField T="string"
                                                              @bind-Value="progress.Remarks"
                                                              Label="Remarks"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Dense="true"
                                                              Placeholder="Enter remarks here..."
                                                              Class="rounded-lg"
                                                              @bind-Value:after="@(() => OnRemarksChanged(task))" />
                                            </div>
                                        }

                                        @if (task.IsPhotoRequired && GetStoredPhotos(task.Id).Any())
                                        {
                                            <div class="photo-grid">
                                                @foreach (var photo in GetStoredPhotos(task.Id))
                                                {
                                                    <div class="photo-thumb-wrapper">
                                                        <img src="data:@photo.ImageMimeType;base64,@Convert.ToBase64String(photo.ImageData!)" />
                                                        <button class="photo-remove-btn" @onclick="@(() => RemovePhoto(photo))" title="Remove">✕</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }

                            @if (gridTasks.Any())
                            {
                                var gridGroups = gridTasks.GroupBy(t => t.TaskType).ToList();
                                foreach (var group in gridGroups)
                                {
                                    string headerText = group.Key == "Manpower" ? "MANPOWER TRACKING" : "EQUIPMENT TRACKING";
                                    string colName = group.Key == "Manpower" ? "POSITION" : "ITEM";

                                    <div class="mt-4 mb-2 px-2">
                                        <MudText Typo="Typo.subtitle2" Class="@(GetThemeClass() == "lightest" ? "text-dark" : "text-white")" Style="font-weight: 800; letter-spacing: 1px; text-transform: uppercase; font-size: 0.7rem; opacity: 0.6;">
                                            @headerText
                                        </MudText>
                                        <MudDivider Class="mt-1 mb-3" Style="opacity: 0.1;" />
                                    </div>

                                    <MudTable Items="@group" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0" Style="background: transparent;">
                                        <HeaderContent>
                                            <MudTh><MudText Typo="Typo.caption" Style="font-weight: 700; opacity: 0.6;">@colName</MudText></MudTh>
                                            <MudTh Style="width: 100px;"><MudText Typo="Typo.caption" Style="font-weight: 700; opacity: 0.6;">EXPECTED</MudText></MudTh>
                                            <MudTh Style="width: 120px; text-align: center;"><MudText Typo="Typo.caption" Style="font-weight: 700; opacity: 0.6;">ACTUAL</MudText></MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="task">
                                            <MudTd DataLabel="@colName">
                                                <div class="d-flex align-start gap-2">
                                                    @if (task.IsMandatory)
                                                    {
                                                        <span style="color: var(--mud-palette-error); font-weight: bold; font-size: 1.2rem; line-height: 1;">*</span>
                                                    }
                                                    <div>
                                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@(string.IsNullOrWhiteSpace(task.TaskName) ? task.Description : task.TaskName)</MudText>
                                                        @if (!string.IsNullOrWhiteSpace(task.TaskName) && !string.IsNullOrWhiteSpace(task.Description))
                                                        {
                                                            <MudText Typo="Typo.caption" Style="opacity: 0.7; display: block; line-height: 1.2; margin-top: 2px;">@task.Description</MudText>
                                                        }
                                                    </div>
                                                </div>
                                            </MudTd>
                                            <MudTd DataLabel="Expected">
                                                <MudText Typo="Typo.body2" Style="font-weight: 700;">@task.QuantityExpected</MudText>
                                            </MudTd>
                                            <MudTd DataLabel="Actual" Style="text-align: center;">
                                                <MudNumericField T="int?"
                                                                 Value="@GetTaskProgress(task.Id).ActualQuantity"
                                                                 ValueChanged="@((int? val) => { var p = GetTaskProgress(task.Id); p.ActualQuantity = val; _ = OnManpowerChanged(task, p); })"
                                                                 Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Class="manpower-input center-input" />
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-center justify-center py-20">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-4" />
            <MudText Typo="Typo.h6">Preparing Operation checklist...</MudText>
        </div>
    }
</div>

@code {
    private int StoreId { get; set; }


    private bool _initialized = false;
    private Store? _store;
    private List<Category> _categories = new();
    private List<ChecklistItem> _checklistItems = new();
    private StoreDailyActivity? _currentSession;
    private List<TaskProgress> _taskProgresses = new();
    private List<TaskPhoto> _loadedPhotos = new();

    private int _currentCategoryId;
    private int _currentCategoryOrder = 0;

    private string _frequencyFilter = "All";

    private int _completedCount = 0;
    private int _totalTasksCount = 0;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await UserState.InitializeAsync();

            if (UserState.Role != "Store Head" && UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo(UserState.LastValidPage ?? UserState.GetDashboardRoute(), forceLoad: true);
                return;
            }
            await UserState.SetLastValidPage(NavigationManager.Uri);

            await LoadData();
        }
    }

    private void OnThemeChanged() => StateHasChanged();

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "border-radius: 12px;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? "color: #0072cf !important; background-color: #ffffff !important; border-radius: 12px; font-weight: bold;"
            : "border-radius: 12px; font-weight: bold;";
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        StoreId = UserState.SelectedStoreId;

        if (StoreId == 0)
        {
            NavigationManager.NavigateTo("/store-head/map");
            return;
        }

        _store = await db.Stores.FirstOrDefaultAsync(s => s.Id == StoreId);
        if (_store == null)
        {
            NavigationManager.NavigateTo("/store-head/map");
            return;
        }


        _categories = await db.Categories.AsNoTracking().OrderBy(c => c.SortOrder).ToListAsync();
        _checklistItems = await db.ChecklistItems.AsNoTracking().ToListAsync();
        // Total count based on filter

        var today = DateTime.Today;
        _currentSession = await db.StoreDailyActivities
            .Include(s => s.CurrentCategory)
            .FirstOrDefaultAsync(s => s.StoreId == StoreId && s.Date == today && !s.IsCompleted);

        if (_currentSession == null)
        {
            _currentSession = new StoreDailyActivity
            {
                StoreId = StoreId,
                Date = today,
                CurrentCategoryId = _categories.First().Id,
                StartedById = UserState.UserId,
                IsCompleted = false
            };
            db.StoreDailyActivities.Add(_currentSession);
            await db.SaveChangesAsync();
        }

        _currentCategoryId = _currentSession.CurrentCategoryId;
        var currentCat = _categories.FirstOrDefault(c => c.Id == _currentCategoryId);
        _currentCategoryOrder = currentCat?.SortOrder ?? 0;

        _taskProgresses = await db.TaskProgresses
            .Where(tp => tp.StoreDailyActivityId == _currentSession!.Id)
            .ToListAsync();

        _loadedPhotos = await db.TaskPhotos
            .Where(p => p.StoreId == StoreId && p.UploadedAt >= today)
            .ToListAsync();

        // Load Persistence for Weekly/Monthly if needed
        await LoadPeriodProgress(db);

        foreach (var task in _checklistItems)
        {
            await CheckAndSyncTaskCompletion(task);
        }

        UpdateCompletedCount();
        _initialized = true;
        StateHasChanged();
    }

    private void SetFrequencyFilter(string freq)
    {
        _frequencyFilter = freq;
        UpdateCompletedCount();
        StateHasChanged();
    }

    private TaskProgress GetTaskProgress(int taskId)
    {
        var prog = _taskProgresses.FirstOrDefault(p => p.ChecklistItemId == taskId);
        if (prog == null)
        {
            prog = new TaskProgress
            {
                StoreDailyActivityId = _currentSession!.Id,
                ChecklistItemId = taskId,
                IsCompleted = false
            };
            _taskProgresses.Add(prog);
        }
        return prog;
    }

    private async Task CheckAndAutoProgress()
    {
        if (CanCompleteCategory(_currentCategoryId))
        {
            var currentCat = _categories.FirstOrDefault(c => c.Id == _currentCategoryId);
            if (currentCat != null)
            {
                await CompleteCategory(currentCat);
            }
        }
    }

    private async Task CheckAndSyncTaskCompletion(ChecklistItem task)
    {
        var prog = GetTaskProgress(task.Id);
        bool isNowCompleted = true;

        if (task.IsPhotoRequired)
        {
            var photoCount = GetPhotoCount(task.Id);
            if (task.NumberOfPhotos > 0)
            {
                if (photoCount < task.NumberOfPhotos) isNowCompleted = false;
            }
            else
            {
                if (photoCount == 0) isNowCompleted = false;
            }
        }

        if (isNowCompleted && task.TaskType == "Manpower" && !prog.ActualQuantity.HasValue)
        {
            isNowCompleted = false;
        }

        if (prog.IsCompleted && prog.CompletedAt.HasValue && prog.CompletedAt.Value.Date < DateTime.Today && task.Frequency != "Daily")
        {
            // Already completed in this period, don't auto-revert based on today's lack of input
            return;
        }

        if (prog.IsCompleted != isNowCompleted)
        {
            prog.IsCompleted = isNowCompleted;
            if (isNowCompleted)
            {
                prog.CompletedAt = DateTime.Now;
                var taskIdentifier = (string.IsNullOrEmpty(task.TaskName) ? task.Description : task.TaskName) ?? "Unknown Task";
                await CreateManualActivityLog("TaskCompleted", taskIdentifier, "TaskProgress", prog.Id > 0 ? prog.Id : null);
            }
            else
            {
                prog.CompletedAt = null;
                var taskIdentifier = (string.IsNullOrEmpty(task.TaskName) ? task.Description : task.TaskName) ?? "Unknown Task";
                await CreateManualActivityLog("TaskReverted", taskIdentifier, "TaskProgress", prog.Id > 0 ? prog.Id : null);

                // If the entire session was completed, revert it
                if (_currentSession != null && _currentSession.IsCompleted)
                {
                    await RevertSessionCompletion();
                }
            }
            UpdateCompletedCount();
        }
    }

    private async Task RevertSessionCompletion()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var session = await db.StoreDailyActivities.FindAsync(_currentSession!.Id);
            if (session != null && session.IsCompleted)
            {
                session.IsCompleted = false;
                session.CompletedAt = null;
                await db.SaveChangesAsync();

                _currentSession.IsCompleted = false;
                _currentSession.CompletedAt = null;

                await CreateManualActivityLog("SessionReverted", "Daily session reverted to in-progress due to task change.");
                Snackbar.Add("Daily session status reverted to In-Progress.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reverting session completion: {ex.Message}");
        }
    }

    private async Task CreateManualActivityLog(string action, string details, string? entityType = null, int? entityId = null)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var log = new ActivityLog
            {
                StoreId = StoreId,
                UserId = UserState.UserId,
                Action = action,
                Details = details,
                Timestamp = DateTime.Now,
                EntityType = entityType,
                EntityId = entityId
            };
            db.ActivityLogs.Add(log);
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating manual log: {ex.Message}");
        }
    }

    private void UpdateCompletedCount()
    {
        var filteredItems = _checklistItems
            .Where(t => _frequencyFilter == "All" || t.Frequency == _frequencyFilter)
            .ToList();

        _totalTasksCount = filteredItems.Count;
        _completedCount = filteredItems.Count(t => GetTaskProgress(t.Id).IsCompleted);
    }

    private async Task LoadPeriodProgress(PDTActivityTracker.Model.AppDbContext db)
    {
        var today = DateTime.Today;
        var startOfWeek = today.AddDays(-(int)today.DayOfWeek);
        var startOfMonth = new DateTime(today.Year, today.Month, 1);

        // Fetch Weekly tasks progress in current week
        var weeklyTasks = _checklistItems.Where(t => t.Frequency == "Weekly").Select(t => t.Id).ToList();
        if (weeklyTasks.Any())
        {
            var weeklyProgress = await db.TaskProgresses
                .Include(tp => tp.StoreDailyActivity)
                .Where(tp => weeklyTasks.Contains(tp.ChecklistItemId))
                .Where(tp => tp.StoreDailyActivity != null && tp.StoreDailyActivity.StoreId == StoreId && tp.StoreDailyActivity.Date >= startOfWeek)
                .Where(tp => tp.IsCompleted)
                .OrderByDescending(tp => tp.CompletedAt)
                .ToListAsync();

            foreach (var prog in weeklyProgress)
            {
                var currentProg = GetTaskProgress(prog.ChecklistItemId);
                if (!currentProg.IsCompleted)
                {
                    currentProg.IsCompleted = true;
                    currentProg.CompletedAt = prog.CompletedAt;
                    currentProg.Remarks = prog.Remarks;
                    currentProg.ActualQuantity = prog.ActualQuantity;
                }
            }
        }

        // Fetch Monthly tasks progress in current month
        var monthlyTasks = _checklistItems.Where(t => t.Frequency == "Monthly").Select(t => t.Id).ToList();
        if (monthlyTasks.Any())
        {
            var monthlyProgress = await db.TaskProgresses
                .Include(tp => tp.StoreDailyActivity)
                .Where(tp => monthlyTasks.Contains(tp.ChecklistItemId))
                .Where(tp => tp.StoreDailyActivity != null && tp.StoreDailyActivity.StoreId == StoreId && tp.StoreDailyActivity.Date >= startOfMonth)
                .Where(tp => tp.IsCompleted)
                .OrderByDescending(tp => tp.CompletedAt)
                .ToListAsync();

            foreach (var prog in monthlyProgress)
            {
                var currentProg = GetTaskProgress(prog.ChecklistItemId);
                if (!currentProg.IsCompleted)
                {
                    currentProg.IsCompleted = true;
                    currentProg.CompletedAt = prog.CompletedAt;
                    currentProg.Remarks = prog.Remarks;
                    currentProg.ActualQuantity = prog.ActualQuantity;
                }
            }
        }
    }

    private string GetCategoryCompletionStatus(int categoryId)
    {
        var categoryTasks = _checklistItems.Where(t => t.CategoryId == categoryId).ToList();
        var completed = _taskProgresses.Where(p => categoryTasks.Any(t => t.Id == p.ChecklistItemId) && p.IsCompleted).Count();
        return $"{completed}/{categoryTasks.Count} tasks completed";
    }

    private bool CanCompleteCategory(int categoryId)
    {
        var categoryTasks = _checklistItems.Where(t => t.CategoryId == categoryId).ToList();
        return categoryTasks.All(t => GetTaskProgress(t.Id).IsCompleted);
    }

    private async Task CompleteCategory(Category currentCat)
    {
        if (!CanCompleteCategory(currentCat.Id)) return;

        using var db = await DbFactory.CreateDbContextAsync();
        await SaveCurrentProgress();

        var nextCat = _categories.OrderBy(c => c.SortOrder).FirstOrDefault(c => c.SortOrder > currentCat.SortOrder);

        if (nextCat != null)
        {
            _currentCategoryId = nextCat.Id;
            _currentCategoryOrder = nextCat.SortOrder;

            var session = await db.StoreDailyActivities.FindAsync(_currentSession!.Id);
            if (session != null)
            {
                session.CurrentCategoryId = _currentCategoryId;
                await db.SaveChangesAsync();
            }

            Snackbar.Add($"{currentCat.Name} completed. Moving to {nextCat.Name}.", Severity.Success);
        }
        else
        {
            var session = await db.StoreDailyActivities.FindAsync(_currentSession!.Id);
            if (session != null)
            {
                session.IsCompleted = true;
                session.CompletedAt = DateTime.Now;
                await db.SaveChangesAsync();
            }

            Snackbar.Add("Daily operations completed successfully!", Severity.Success);
            NavigationManager.NavigateTo("/store-head/map");
        }

        StateHasChanged();
    }

    private async Task SaveCurrentProgress()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        foreach (var prog in _taskProgresses)
        {
            if (prog.Id == 0)
            {
                db.TaskProgresses.Add(prog);
            }
            else
            {
                db.Entry(prog).State = EntityState.Modified;
            }
        }

        await db.SaveChangesAsync();
        UserState.NotifyDashboardRefresh(); // Notify dashboard of changes
        Snackbar.Add("Progress saved.", Severity.Info);
    }

    private async Task CapturePhoto(ChecklistItem task)
    {
        var parameters = new DialogParameters { };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<PDTActivityTracker.Components.Pages.Dialogs.CameraCaptureDialog>("Take Photo", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: not null })
        {
            var (imageData, mimeType, lat, lng, timestamp) = ((byte[] imageData, string mimeType, double? lat, double? lng, DateTime? timestamp))result.Data;
            var photo = new TaskPhoto
            {
                StoreId = StoreId,
                StoreDailyActivityId = _currentSession!.Id,
                ChecklistItemId = task.Id,
                CategoryId = task.CategoryId,
                UploadedById = UserState.UserId,
                UploadedAt = DateTime.Now,
                CaptureTimestamp = timestamp ?? DateTime.Now,
                ImageData = imageData,
                ImageMimeType = mimeType,
                Latitude = lat ?? _store?.GPSLatitude,
                Longitude = lng ?? _store?.GPSLongitude,
                Description = $"GPS: {lat ?? _store?.GPSLatitude:F6}, {lng ?? _store?.GPSLongitude:F6} | Time: {timestamp ?? DateTime.Now:yyyy-MM-dd HH:mm:ss}"
            };

            using var db = await DbFactory.CreateDbContextAsync();
            db.TaskPhotos.Add(photo);
            await db.SaveChangesAsync();

            _loadedPhotos.Add(photo);
            await CheckAndSyncTaskCompletion(task);
            var taskIdentifier = (string.IsNullOrEmpty(task.TaskName) ? task.Description : task.TaskName) ?? "Unknown Task";
            await CreateManualActivityLog("PhotoUploaded", taskIdentifier, "TaskPhoto", photo.Id);
            await SaveCurrentProgress(); // Ensure progress status is saved
            await CheckAndAutoProgress();

            Snackbar.Add($"Photo captured and saved ({imageData.Length / 1024}KB)", Severity.Success);
            StateHasChanged();
        }
    }

    private async Task RemovePhoto(TaskPhoto photo)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.TaskPhotos.FindAsync(photo.Id);
            if (existing != null)
            {
                db.TaskPhotos.Remove(existing);
                await db.SaveChangesAsync();
            }
            _loadedPhotos.Remove(photo);

            var task = _checklistItems.FirstOrDefault(t => t.Id == photo.ChecklistItemId);
            if (task != null)
            {
                var taskIdentifier = (string.IsNullOrEmpty(task.TaskName) ? task.Description : task.TaskName) ?? "Unknown Task";
                await CreateManualActivityLog("PhotoRemoved", taskIdentifier, "TaskPhoto", photo.Id);
                await CheckAndSyncTaskCompletion(task);
                await SaveCurrentProgress(); // Ensure progress status is saved
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error removing photo: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenIssueDialog()
    {
        var parameters = new DialogParameters { ["StoreId"] = StoreId, ["UserId"] = UserState.UserId };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<PDTActivityTracker.Components.Pages.Dialogs.ReportIssueDialog>("Report Issue", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: ValueTuple<Issue, byte[], string> data })
        {
            var (issue, imageData, mimeType) = data;

            if (string.IsNullOrEmpty(issue.Title))
            {
                Snackbar.Add("Issue category is required.", Severity.Warning);
                return;
            }

            issue.ImageData = imageData;
            issue.ImageMimeType = mimeType;

            using var db = await DbFactory.CreateDbContextAsync();
            db.Issues.Add(issue);
            await db.SaveChangesAsync();

            var activity = new ActivityLog
            {
                StoreId = StoreId,
                UserId = UserState.UserId,
                Action = "IssueReported",
                EntityType = "Issue",
                EntityId = issue.Id,
                Details = $"Reported {issue.Title} with {issue.Priority} priority.",
                Timestamp = DateTime.Now
            };
            db.ActivityLogs.Add(activity);
            await db.SaveChangesAsync();

            var notification = new Notification
            {
                UserId = _store?.AreaHeadId ?? 0,
                Message = $"New Issue Reported: {issue.Title} at {_store?.StoreName}",
                Type = "Alert",
                IsRead = false,
                CreatedAt = DateTime.Now
            };
            if (notification.UserId > 0)
            {
                db.Notifications.Add(notification);
                await db.SaveChangesAsync();
            }

            Snackbar.Add("Issue report submitted successfully.", Severity.Success);
        }
    }

    private int GetPhotoCount(int taskId) => _loadedPhotos.Count(p => p.ChecklistItemId == taskId);

    private List<TaskPhoto> GetStoredPhotos(int taskId) => _loadedPhotos.Where(p => p.ChecklistItemId == taskId).ToList();

    private async Task OnManpowerChanged(ChecklistItem task, TaskProgress prog)
    {
        await ValidateManpower(task, prog);
        await CheckAndSyncTaskCompletion(task);
        await SaveCurrentProgress(); // Ensure progress status is saved
        await CheckAndAutoProgress();
    }

    private async Task OnRemarksChanged(ChecklistItem task)
    {
        await CheckAndSyncTaskCompletion(task);
        await SaveCurrentProgress();
        await CheckAndAutoProgress();
    }

    private async Task ValidateManpower(ChecklistItem task, TaskProgress prog)
    {
        if (prog.ActualQuantity.HasValue && prog.ActualQuantity < task.QuantityExpected)
        {
            string itemType = task.TaskType == "Equipment" ? "Equipment count" : "manpower";
            Snackbar.Add($"Low {itemType} reported for {task.TaskName}. Area Head has been notified.", Severity.Warning);

            using var db = await DbFactory.CreateDbContextAsync();
            var notification = new Notification
            {
                UserId = _store?.AreaHeadId ?? 0,
                Message = $"Low {itemType} alert: Store {_store?.StoreCode} reported {prog.ActualQuantity}/{task.QuantityExpected} for {task.TaskName}.",
                Type = "Alert",
                IsRead = false,
                CreatedAt = DateTime.Now
            };
            if (notification.UserId > 0)
            {
                db.Notifications.Add(notification);
                await db.SaveChangesAsync();
            }
        }
    }
}