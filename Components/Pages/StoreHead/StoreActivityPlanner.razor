    private async Task SaveCurrentProgress()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            foreach (var prog in _taskProgresses)
            {
                if (prog.Id == 0)
                {
                    db.TaskProgresses.Add(prog);
                }
                else
                {
                    db.Entry(prog).State = EntityState.Modified;
                }
            }

            await db.SaveChangesAsync();

            // Check if all tasks are completed — only fire notification on state transition (incomplete -> complete)
            try
            {
                var allCompleted = _checklistItems.All(t => GetTaskProgress(t.Id).IsCompleted);
                if (allCompleted && !_wasAllCompleted)
                {
                    // Remove old AllTasksCompleted log for today so we can re-insert fresh
                    var oldLog = await db.ActivityLogs
                        .Where(l => l.StoreId == StoreId
                            && l.Action == "AllTasksCompleted"
                            && l.Timestamp >= DateTime.Today)
                        .ToListAsync();
                    if (oldLog.Any())
                        db.ActivityLogs.RemoveRange(oldLog);

                    db.ActivityLogs.Add(new ActivityLog
                    {
                        StoreId = StoreId,
                        UserId = UserState.UserId,
                        Action = "AllTasksCompleted",
                        Details = $"{_store?.StoreName} has completed all assigned checklist tasks.",
                        Timestamp = DateTime.Now
                    });

                    if (_store?.AreaHeadId.HasValue == true && _store.AreaHeadId.Value > 0)
                    {
                        db.Notifications.Add(new Notification
                        {
                            UserId = _store.AreaHeadId.Value,
                            Message = $"{_store.StoreName} has completed all checklist tasks.",
                            Type = "Info",
                            IsRead = false,
                            CreatedAt = DateTime.Now,
                            RelatedEntityId = StoreId,
                            RelatedEntityType = "Store"
                        });
                    }
                    await db.SaveChangesAsync();
                }
                // Update tracked state
                _wasAllCompleted = allCompleted;
            }
            catch { }

            UserState.NotifyDashboardRefresh();
        }
        catch { }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SubmitAndLockProgress()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            foreach (var prog in _taskProgresses)
            {
                if (prog.Id == 0)
                {
                    db.TaskProgresses.Add(prog);
                }
                else
                {
                    db.Entry(prog).State = EntityState.Modified;
                }
            }

            // Mark session as completed and locked
            var session = await db.StoreDailyActivities.FindAsync(_currentSession!.Id);
            if (session != null)
            {
                session.IsCompleted = true;
                session.CompletedAt = DateTime.Now;
            }

            await db.SaveChangesAsync();

            // Notify Area Head of submission
            try
            {
                db.ActivityLogs.Add(new ActivityLog
                {
                    StoreId = StoreId,
                    UserId = UserState.UserId,
                    Action = "ProgressSubmitted",
                    Details = $"{_store?.StoreName} submitted and locked their progress.",
                    Timestamp = DateTime.Now
                });

                if (_store?.AreaHeadId.HasValue == true && _store.AreaHeadId.Value > 0)
                {
                    db.Notifications.Add(new Notification
                    {
                        UserId = _store.AreaHeadId.Value,
                        Message = $"{_store.StoreName} has submitted and locked progress.",
                        Type = "Info",
                        IsRead = false,
                        CreatedAt = DateTime.Now,
                        RelatedEntityId = StoreId,
                        RelatedEntityType = "Store"
                    });
                }
                await db.SaveChangesAsync();
            }
            catch { }

            UserState.NotifyDashboardRefresh();

            Snackbar.Add("Activity planner submitted and locked successfully!", Severity.Success);
            NavigationManager.NavigateTo("/store-head/map");
        }
        catch { }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CapturePhoto(ChecklistItem task)
    {
        var parameters = new DialogParameters { };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<PDTActivityTracker.Components.Pages.Dialogs.CameraCaptureDialog>("Take Photo", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: not null })
        {
            var (imageData, mimeType, lat, lng, timestamp) = ((byte[] imageData, string mimeType, double? lat, double? lng, DateTime? timestamp))result.Data;
            var photo = new TaskPhoto
            {
                StoreId = StoreId,
                StoreDailyActivityId = _currentSession!.Id,
                ChecklistItemId = task.Id,
                CategoryId = task.CategoryId,
                UploadedById = UserState.UserId,
                UploadedAt = DateTime.Now,
                CaptureTimestamp = timestamp ?? DateTime.Now,
                ImageData = imageData,
                ImageMimeType = mimeType,
                Latitude = lat ?? _store?.GPSLatitude,
                Longitude = lng ?? _store?.GPSLongitude,
                Description = $"GPS: {lat ?? _store?.GPSLatitude:F6}, {lng ?? _store?.GPSLongitude:F6} | Time: {timestamp ?? DateTime.Now:yyyy-MM-dd HH:mm:ss}"
            };

            using var db = await DbFactory.CreateDbContextAsync();
            db.TaskPhotos.Add(photo);
            await db.SaveChangesAsync();

            _loadedPhotos.Add(photo);
            await CheckAndSyncTaskCompletion(task);
            var taskIdentifier = (string.IsNullOrEmpty(task.TaskName) ? task.Description : task.TaskName) ?? "Unknown Task";
            await CreateManualActivityLog("PhotoUploaded", taskIdentifier, "TaskPhoto", photo.Id);
            await SaveCurrentProgress(); // Ensure progress status is saved
            await CheckAndAutoProgress();

            Snackbar.Add($"Photo captured and saved ({imageData.Length / 1024}KB)", Severity.Success);
            StateHasChanged();
        }
    }

    private async Task ToggleManualTask(ChecklistItem task, TaskProgress prog, bool newVal)
    {
        // Capture state before toggling
        bool wasComplete = _checklistItems.All(t => GetTaskProgress(t.Id).IsCompleted);
        bool oldVal = prog.IsCompleted;

        prog.IsCompleted = newVal;
        if (newVal)
        {
            prog.CompletedAt = DateTime.Now;
        }
        else
        {
            prog.CompletedAt = null;
        }

        await CheckAndSyncTaskCompletion(task);
        await SaveCurrentProgress();
        await CheckAndAutoProgress();

        if (oldVal != newVal)
        {
            var taskIdentifier = (string.IsNullOrEmpty(task.TaskName) ? task.Description : task.TaskName) ?? "Unknown Task";
            if (newVal)
            {
                await CreateManualActivityLog("TaskCompleted", taskIdentifier, "TaskProgress", prog.Id > 0 ? prog.Id : null);

                // Check if this is the very first task accomplished for the day
                int completedTodayBefore = _taskProgresses.Count(tp => tp.IsCompleted && tp.CompletedAt.HasValue && tp.CompletedAt.Value.Date == DateTime.Today && tp.ChecklistItemId != task.Id);
                if (completedTodayBefore == 0)
                {
                    if (_store?.AreaHeadId.HasValue == true && _store.AreaHeadId.Value > 0)
                    {
                        try
                        {
                            using var db = await DbFactory.CreateDbContextAsync();
                            db.Notifications.Add(new Notification
                            {
                                UserId = _store.AreaHeadId.Value,
                                Message = $"{_store.StoreName} has started their tasks today (First task accomplished: {taskIdentifier}).",
                                Type = "Info",
                                IsRead = false,
                                CreatedAt = DateTime.Now,
                                RelatedEntityId = StoreId,
                                RelatedEntityType = "Store"
                            });
                            await db.SaveChangesAsync();
                            UserState.NotifyDashboardRefresh();
                        }
                        catch { }
                    }
                }
            }
            else
            {
                await CreateManualActivityLog("TaskReverted", taskIdentifier, "TaskProgress", prog.Id > 0 ? prog.Id : null);

                // Check if all tasks are now incomplete (meaning the last completed task was reverted)
                int completedTodayNow = _taskProgresses.Count(tp => tp.IsCompleted && tp.CompletedAt.HasValue && tp.CompletedAt.Value.Date == DateTime.Today);
                if (completedTodayNow == 0)
                {
                    if (_store?.AreaHeadId.HasValue == true && _store.AreaHeadId.Value > 0)
                    {
                        try
                        {
                            using var db = await DbFactory.CreateDbContextAsync();
                            db.Notifications.Add(new Notification
                            {
                                UserId = _store.AreaHeadId.Value,
                                Message = $"{_store.StoreName} checklist progress has been reverted (no tasks completed yet).",
                                Type = "Warning",
                                IsRead = false,
                                CreatedAt = DateTime.Now,
                                RelatedEntityId = StoreId,
                                RelatedEntityType = "Store"
                            });
                            await db.SaveChangesAsync();
                            UserState.NotifyDashboardRefresh();
                        }
                        catch { }
                    }
                }
            }
        }

        // If unchecking caused a complete -> incomplete transition, notify Area Head
        bool nowComplete = _checklistItems.All(t => GetTaskProgress(t.Id).IsCompleted);
        if (wasComplete && !nowComplete && !newVal && _store?.AreaHeadId.HasValue == true && _store.AreaHeadId.Value > 0)
        {
            _wasAllCompleted = false; // Reset so re-completion fires a new notification
            try
            {
                using var db = await DbFactory.CreateDbContextAsync();
                db.Notifications.Add(new Notification
                {
                    UserId = _store.AreaHeadId.Value,
                    Message = $"{_store.StoreName} checklist is now incomplete (a task was unchecked).",
                    Type = "Warning",
                    IsRead = false,
                    CreatedAt = DateTime.Now,
                    RelatedEntityId = StoreId,
                    RelatedEntityType = "Store"
                });
                await db.SaveChangesAsync();
                UserState.NotifyDashboardRefresh();
            }
            catch { }
        }

        StateHasChanged();
    }

    private async Task RemovePhoto(TaskPhoto photo)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.TaskPhotos.FindAsync(photo.Id);
            if (existing != null)
            {
                db.TaskPhotos.Remove(existing);
                await db.SaveChangesAsync();
            }
            _loadedPhotos.Remove(photo);

            var task = _checklistItems.FirstOrDefault(t => t.Id == photo.ChecklistItemId);
            if (task != null)
            {
                var taskIdentifier = (string.IsNullOrEmpty(task.TaskName) ? task.Description : task.TaskName) ?? "Unknown Task";
                // Check if tasks WERE fully complete before this removal
                bool wasComplete = _checklistItems.All(t => GetTaskProgress(t.Id).IsCompleted);
                await CreateManualActivityLog("PhotoRemoved", taskIdentifier, "TaskPhoto", photo.Id);
                await CheckAndSyncTaskCompletion(task);
                await SaveCurrentProgress();

                // If removing photo made tasks go from complete -> incomplete, notify Area Head
                bool nowComplete = _checklistItems.All(t => GetTaskProgress(t.Id).IsCompleted);
                if (wasComplete && !nowComplete && _store?.AreaHeadId.HasValue == true && _store.AreaHeadId.Value > 0)
                {
                    _wasAllCompleted = false; // Reset so re-completion fires a new notification
                    try
                    {
                        using var dbNotif = await DbFactory.CreateDbContextAsync();
                        dbNotif.Notifications.Add(new Notification
                        {
                            UserId = _store.AreaHeadId.Value,
                            Message = $"{_store.StoreName} checklist is now incomplete (a photo was removed).",
                            Type = "Warning",
                            IsRead = false,
                            CreatedAt = DateTime.Now,
                            RelatedEntityId = StoreId,
                            RelatedEntityType = "Store"
                        });
                        await dbNotif.SaveChangesAsync();
                        UserState.NotifyDashboardRefresh();
                    }
                    catch { }
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error removing photo: {ex.Message}", Severity.Error);
        }
    }

