                                            }
                                        </div>
                                    }
                                }
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-center justify-center py-20">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-4" />
            <MudText Typo="Typo.h6">Preparing Operation checklist...</MudText>
        </div>
    }
</div>

@code {
    private int StoreId { get; set; }


    private bool _initialized = false;
    private Store? _store;
    private List<Category> _categories = new();
    private List<ChecklistItem> _checklistItems = new();
    private StoreDailyActivity? _currentSession;
    private List<TaskProgress> _taskProgresses = new();
    private List<TaskPhoto> _loadedPhotos = new();

    private bool IsAutoCompletedPreviousDay(TaskProgress prog, ChecklistItem task)
    {
        return prog.IsCompleted && 
               prog.CompletedAt.HasValue && 
               prog.CompletedAt.Value.Date < DateTime.Today && 
               (task.Frequency == "Weekly" || task.Frequency == "Monthly");
    }

    private string GetRemainingDaysText(ChecklistItem task, TaskProgress prog)
    {
        if (!prog.CompletedAt.HasValue) return "";
        var today = DateTime.Today;
        var completedDate = prog.CompletedAt.Value.Date;
        
        DateTime expirationDate;
        if (task.Frequency == "Weekly")
        {
            expirationDate = completedDate.AddDays(7);
        }
        else if (task.Frequency == "Monthly")
        {
            expirationDate = completedDate.AddMonths(1);
        }
        else
        {
            return "";
        }

        int daysLeft = (expirationDate - today).Days;
        
        if (daysLeft <= 1)
        {
            return "Available tomorrow";
        }
        
        // Example: "Available Jun 5"
        return $"Available {expirationDate:MMM d}";
    }

    private bool IsSessionLocked()
    {
        return _currentSession?.IsCompleted == true;
    }

    private async Task ForceManualCompletion(ChecklistItem task, TaskProgress prog)
    {
        prog.IsCompleted = false;
        prog.CompletedAt = null;
        await CheckAndSyncTaskCompletion(task);
        await SaveCurrentProgress();
        await CheckAndAutoProgress();
        StateHasChanged();
    }

    private int _currentCategoryId;
    private int _currentCategoryOrder = 0;

    private string _frequencyFilter = "All";

    private int _completedCount = 0;
    private int _totalTasksCount = 0;
    private bool _isSaving = false;
    // Tracks whether all tasks were complete the last time we checked — prevents duplicate notifications
    private bool _wasAllCompleted = false;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await UserState.InitializeAsync();

            if (UserState.Role != "Store Head" && UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo(UserState.LastValidPage ?? UserState.GetDashboardRoute(), forceLoad: true);
                return;
            }
            await UserState.SetLastValidPage(NavigationManager.Uri);

            await LoadData();
        }
    }

    private void OnThemeChanged() => StateHasChanged();

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "lightest" :
               ThemeService.CurrentTheme == ThemeMode.Dark ? "dark" : "light";
    }

    private string GetButtonStyle()
    {
        if (ThemeService == null) return "border-radius: 12px;";
        return ThemeService.CurrentTheme == ThemeMode.Light
            ? "color: #0072cf !important; background-color: #ffffff !important; border-radius: 12px; font-weight: bold;"
            : "border-radius: 12px; font-weight: bold;";
    }

    private string GetEmptyMessage()
    {
        return _frequencyFilter switch
        {
            "Daily" => "There are no daily operational tasks found for your store today.",
            "Weekly" => "No weekly maintenance or compliance tasks are scheduled for this period.",
            "Monthly" => "No monthly audits or inventory tasks have been assigned yet.",
            _ => "We couldn't find any tasks matching your criteria. Please contact your area head if you believe this is an error."
        };
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        StoreId = UserState.SelectedStoreId;

        if (StoreId == 0)
        {
            NavigationManager.NavigateTo("/store-head/map");
            return;
        }

        _store = await db.Stores
            .Where(s => !s.IsDeleted)
            .Include(s => s.AreaHead)
            .FirstOrDefaultAsync(s => s.Id == StoreId);
        if (_store == null)
        {
            NavigationManager.NavigateTo("/store-head/map");
            return;
        }


        _categories = await db.Categories.AsNoTracking().OrderBy(c => c.SortOrder).ToListAsync();
        var allItems = await db.ChecklistItems.Where(t => !t.IsDeleted).AsNoTracking().ToListAsync();
        _checklistItems = allItems.Where(t => IsTaskAssignedToStore(t, StoreId)).ToList();
        // Total count based on filter

        var today = DateTime.Today;
        _currentSession = await db.StoreDailyActivities
            .Include(s => s.CurrentCategory)
            .OrderByDescending(s => s.Id)
            .FirstOrDefaultAsync(s => s.StoreId == StoreId && s.Date == today);

        if (_currentSession == null)
        {
            // Re-fetch to minimize race condition
            _currentSession = await db.StoreDailyActivities
                .OrderByDescending(s => s.Id)
                .FirstOrDefaultAsync(s => s.StoreId == StoreId && s.Date == today);

            if (_currentSession == null)
            {
                _currentSession = new StoreDailyActivity
                {
                    StoreId = StoreId,
                    Date = today,
                    CurrentCategoryId = _categories.First().Id,
                    StartedById = UserState.UserId,
                    IsCompleted = false
                };
                db.StoreDailyActivities.Add(_currentSession);
                await db.SaveChangesAsync();
            }
        }

        _currentCategoryId = _currentSession.CurrentCategoryId;
        var currentCat = _categories.FirstOrDefault(c => c.Id == _currentCategoryId);

        while (currentCat != null && !_checklistItems.Any(t => t.CategoryId == currentCat.Id && (_frequencyFilter == "All" || t.Frequency == _frequencyFilter)))
        {
            currentCat = _categories.OrderBy(c => c.SortOrder).FirstOrDefault(c => c.SortOrder > currentCat.SortOrder && _checklistItems.Any(t => t.CategoryId == c.Id && (_frequencyFilter == "All" || t.Frequency == _frequencyFilter)));
            if (currentCat != null)
            {
                _currentCategoryId = currentCat.Id;
            }
        }

        _currentCategoryOrder = currentCat?.SortOrder ?? 0;

        _taskProgresses = await db.TaskProgresses
            .Where(tp => tp.StoreDailyActivityId == _currentSession!.Id)
            .ToListAsync();

        _loadedPhotos = await db.TaskPhotos
            .Where(p => p.StoreId == StoreId && p.UploadedAt >= today)
            .ToListAsync();

        foreach (var task in _checklistItems)
        {
            var prog = _taskProgresses.FirstOrDefault(p => p.ChecklistItemId == task.Id);
            if (prog == null)
            {
                prog = new TaskProgress
                {
                    StoreDailyActivityId = _currentSession!.Id,
                    ChecklistItemId = task.Id,
                    IsCompleted = false
                };
                _taskProgresses.Add(prog);
            }
            await CheckAndSyncTaskCompletion(task, true); // initialSync = true to skip DB saves during load
        }

        await LoadPeriodProgress(db);

        // Auto-advance category pointer if the current category is already completed (e.g., from weekly/monthly auto-fills)
        var activeCat = _categories.FirstOrDefault(c => c.Id == _currentCategoryId);
        bool categoryChanged = false;

        while (activeCat != null && CanCompleteCategory(activeCat.Id))
        {
            var nextCat = _categories.OrderBy(c => c.SortOrder).FirstOrDefault(c => c.SortOrder > activeCat.SortOrder && _checklistItems.Any(t => t.CategoryId == c.Id && (_frequencyFilter == "All" || t.Frequency == _frequencyFilter)));
            if (nextCat != null)
            {
                _currentCategoryId = nextCat.Id;
                _currentCategoryOrder = nextCat.SortOrder;
                activeCat = nextCat;
                categoryChanged = true;
            }
            else
            {
                break;
            }
        }

        if (categoryChanged)
        {
            var sessionToUpdate = await db.StoreDailyActivities.FindAsync(_currentSession!.Id);
            if (sessionToUpdate != null)
            {
                sessionToUpdate.CurrentCategoryId = _currentCategoryId;
                await db.SaveChangesAsync();
            }
        }

        UpdateCompletedCount();
        _initialized = true;
        StateHasChanged();
    }

    private void SetFrequencyFilter(string freq)
    {
        _frequencyFilter = freq;
        UpdateCompletedCount();
        StateHasChanged();
    }

    private TaskProgress GetTaskProgress(int taskId)
    {
        var prog = _taskProgresses.FirstOrDefault(p => p.ChecklistItemId == taskId);
        if (prog == null)
        {
            prog = new TaskProgress
            {
                StoreDailyActivityId = _currentSession!.Id,
                ChecklistItemId = taskId,
                IsCompleted = false
            };
            _taskProgresses.Add(prog);
        }
        return prog;
    }

    private async Task CheckAndAutoProgress()
    {
        if (CanCompleteCategory(_currentCategoryId))
        {
            var currentCat = _categories.FirstOrDefault(c => c.Id == _currentCategoryId);
            if (currentCat != null)
            {
                await CompleteCategory(currentCat);
            }
        }
    }

    private async Task CheckAndSyncTaskCompletion(ChecklistItem task, bool initialSync = false)
    {
        var prog = GetTaskProgress(task.Id);
        bool isNowCompleted = true;

        if (task.IsPhotoRequired)
        {
            var photoCount = GetPhotoCount(task.Id);
            if (task.NumberOfPhotos > 0)
            {
                if (photoCount < task.NumberOfPhotos) isNowCompleted = false;
            }
            else
            {
                if (photoCount == 0) isNowCompleted = false;
            }
        }
        else if (task.TaskType == "Manpower")
        {
            var positions = GetManpowerPositions(task);
            if (positions.Any())
            {
                if (string.IsNullOrWhiteSpace(prog.PositionActuals))
                {
                    isNowCompleted = false;
                }
                else
                {
                    try
                    {
                        var actuals = JsonSerializer.Deserialize<List<int?>>(prog.PositionActuals);
                        // All defined positions MUST have a value entered
                        if (actuals == null || actuals.Count < positions.Count || actuals.Take(positions.Count).Any(a => !a.HasValue))
                        {
                            isNowCompleted = false;
                        }
                    }
                    catch { isNowCompleted = false; }
                }
            }
            else if (!prog.ActualQuantity.HasValue)
            {
                isNowCompleted = false;
            }
        }
        else
        {
            // Regular task with no automated completion triggers
            // Preserves the manual check state
            isNowCompleted = prog.IsCompleted;
        }

        if (prog.IsCompleted && prog.CompletedAt.HasValue && prog.CompletedAt.Value.Date < DateTime.Today && task.Frequency != "Daily")
        {
            // Already completed in this period, don't auto-revert based on today's lack of input
            return;
        }

        if (prog.IsCompleted != isNowCompleted)
        {
            prog.IsCompleted = isNowCompleted;
            if (isNowCompleted)
            {
                prog.CompletedAt = DateTime.Now;
                var taskIdentifier = (string.IsNullOrEmpty(task.TaskName) ? task.Description : task.TaskName) ?? "Unknown Task";
                await CreateManualActivityLog("TaskCompleted", taskIdentifier, "TaskProgress", prog.Id > 0 ? prog.Id : null);

                // Check if this is the very first task accomplished for the day
                int completedTodayBefore = _taskProgresses.Count(tp => tp.IsCompleted && tp.CompletedAt.HasValue && tp.CompletedAt.Value.Date == DateTime.Today && tp.ChecklistItemId != task.Id);
                if (completedTodayBefore == 0)
                {
                    if (_store?.AreaHeadId.HasValue == true && _store.AreaHeadId.Value > 0)
                    {
                        try
                        {
                            using var db = await DbFactory.CreateDbContextAsync();
                            db.Notifications.Add(new Notification
                            {
                                UserId = _store.AreaHeadId.Value,
                                Message = $"{_store.StoreName} has started their tasks today (First task accomplished: {taskIdentifier}).",
                                Type = "Info",
                                IsRead = false,
                                CreatedAt = DateTime.Now,
                                RelatedEntityId = StoreId,
                                RelatedEntityType = "Store"
                            });
                            await db.SaveChangesAsync();
                            UserState.NotifyDashboardRefresh();
                        }
                        catch { }
                    }
                }
            }
            else
            {
                prog.CompletedAt = null;
                var taskIdentifier = (string.IsNullOrEmpty(task.TaskName) ? task.Description : task.TaskName) ?? "Unknown Task";
                if (!initialSync)
                {
                    await CreateManualActivityLog("TaskReverted", taskIdentifier, "TaskProgress", prog.Id > 0 ? prog.Id : null);

                    // Check if all tasks are now incomplete (meaning the last completed task was reverted)
                    int completedTodayNow = _taskProgresses.Count(tp => tp.IsCompleted && tp.CompletedAt.HasValue && tp.CompletedAt.Value.Date == DateTime.Today);
                    if (completedTodayNow == 0)
                    {
                        if (_store?.AreaHeadId.HasValue == true && _store.AreaHeadId.Value > 0)
                        {
                            try
                            {
                                using var db = await DbFactory.CreateDbContextAsync();
                                db.Notifications.Add(new Notification
                                {
                                    UserId = _store.AreaHeadId.Value,
                                    Message = $"{_store.StoreName} checklist progress has been reverted (no tasks completed yet).",
                                    Type = "Warning",
                                    IsRead = false,
                                    CreatedAt = DateTime.Now,
                                    RelatedEntityId = StoreId,
                                    RelatedEntityType = "Store"
                                });
                                await db.SaveChangesAsync();
                                UserState.NotifyDashboardRefresh();
                            }
                            catch { }
                        }
                    }
                }

                // If the entire session was completed, revert it
                if (_currentSession != null && _currentSession.IsCompleted)
                {
                    await RevertSessionCompletion();
                }

                // [FIX] Category Reversion Logic
                // If a task in a previous category becomes incomplete, move the active category pointer back
                if (!initialSync && _currentSession != null)
                {
                    var taskCat = _categories.FirstOrDefault(c => c.Id == task.CategoryId);
                    var currentCat = _categories.FirstOrDefault(c => c.Id == _currentCategoryId);
                    if (taskCat != null && currentCat != null && taskCat.SortOrder < currentCat.SortOrder)
                    {
                        _currentCategoryId = taskCat.Id;
                        _currentCategoryOrder = taskCat.SortOrder;

                        using var db = await DbFactory.CreateDbContextAsync();
                        var session = await db.StoreDailyActivities.FindAsync(_currentSession.Id);
                        if (session != null)
                        {
                            session.CurrentCategoryId = _currentCategoryId;
                            await db.SaveChangesAsync();
                        }
                    }
                }
            }
            UpdateCompletedCount();
        }
    }

    private async Task RevertSessionCompletion()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var session = await db.StoreDailyActivities.FindAsync(_currentSession!.Id);
            if (session != null && session.IsCompleted)
            {
                session.IsCompleted = false;
                session.CompletedAt = null;
                await db.SaveChangesAsync();

                _currentSession.IsCompleted = false;
                _currentSession.CompletedAt = null;

                await CreateManualActivityLog("SessionReverted", "Daily session reverted to in-progress due to task change.");
                Snackbar.Add("Daily session status reverted to In-Progress.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reverting session completion: {ex.Message}");
        }
    }

    private async Task CreateManualActivityLog(string action, string details, string? entityType = null, int? entityId = null)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var log = new ActivityLog
            {
                StoreId = StoreId,
                UserId = UserState.UserId,
                Action = action,
                Details = details,
                Timestamp = DateTime.Now,
                EntityType = entityType,
                EntityId = entityId
            };
            db.ActivityLogs.Add(log);
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating manual log: {ex.Message}");
        }
    }

    private void UpdateCompletedCount()
    {
        var filteredItems = _checklistItems
            .Where(t => _frequencyFilter == "All" || t.Frequency == _frequencyFilter)
            .ToList();

        _totalTasksCount = filteredItems.Count;

        int completedCount = 0;
        bool stopCounting = false;

        foreach (var category in _categories.OrderBy(c => c.SortOrder))
        {
            var catItems = filteredItems.Where(t => t.CategoryId == category.Id).ToList();
            if (!catItems.Any()) continue;

            if (stopCounting) break;

            int catCompleted = catItems.Count(t => GetTaskProgress(t.Id).IsCompleted);
            completedCount += catCompleted;

            if (catCompleted < catItems.Count)
            {
                stopCounting = true;
            }
        }

        _completedCount = completedCount;
    }

    private async Task LoadPeriodProgress(PDTActivityTracker.Model.AppDbContext db)
    {
        var today = DateTime.Today;

        // Fetch Weekly tasks progress in the last 7 days
        var weeklyTasks = _checklistItems.Where(t => t.Frequency == "Weekly").Select(t => t.Id).ToList();
        if (weeklyTasks.Any())
        {
            var sevenDaysAgo = today.AddDays(-7);
            var weeklyProgress = await db.TaskProgresses
                .Include(tp => tp.StoreDailyActivity)
                .Where(tp => weeklyTasks.Contains(tp.ChecklistItemId))
                .Where(tp => tp.StoreDailyActivity != null && tp.StoreDailyActivity.StoreId == StoreId && tp.StoreDailyActivity.Date >= sevenDaysAgo)
                .Where(tp => tp.IsCompleted && tp.CompletedAt != null)
                .OrderByDescending(tp => tp.CompletedAt)
                .ToListAsync();

            foreach (var taskId in weeklyTasks)
            {
                var mostRecent = weeklyProgress.FirstOrDefault(p => p.ChecklistItemId == taskId);
                if (mostRecent != null && mostRecent.CompletedAt.HasValue)
                {
                    if (mostRecent.CompletedAt.Value.Date.AddDays(7) > today)
                    {
                        var currentProg = GetTaskProgress(taskId);
                        if (!currentProg.IsCompleted)
                        {
                            currentProg.IsCompleted = true;
                            currentProg.CompletedAt = mostRecent.CompletedAt;
                            currentProg.Remarks = mostRecent.Remarks;
                            currentProg.ActualQuantity = mostRecent.ActualQuantity;
                        }
                    }
                }
            }
        }

        // Fetch Monthly tasks progress in the last 1 month
        var monthlyTasks = _checklistItems.Where(t => t.Frequency == "Monthly").Select(t => t.Id).ToList();
        if (monthlyTasks.Any())
        {
            var oneMonthAgo = today.AddMonths(-1);
            var monthlyProgress = await db.TaskProgresses
                .Include(tp => tp.StoreDailyActivity)
                .Where(tp => monthlyTasks.Contains(tp.ChecklistItemId))
                .Where(tp => tp.StoreDailyActivity != null && tp.StoreDailyActivity.StoreId == StoreId && tp.StoreDailyActivity.Date >= oneMonthAgo)
                .Where(tp => tp.IsCompleted && tp.CompletedAt != null)
                .OrderByDescending(tp => tp.CompletedAt)
                .ToListAsync();

            foreach (var taskId in monthlyTasks)
            {
                var mostRecent = monthlyProgress.FirstOrDefault(p => p.ChecklistItemId == taskId);
                if (mostRecent != null && mostRecent.CompletedAt.HasValue)
                {
                    if (mostRecent.CompletedAt.Value.Date.AddMonths(1) > today)
                    {
                        var currentProg = GetTaskProgress(taskId);
                        if (!currentProg.IsCompleted)
                        {
                            currentProg.IsCompleted = true;
                            currentProg.CompletedAt = mostRecent.CompletedAt;
                            currentProg.Remarks = mostRecent.Remarks;
                            currentProg.ActualQuantity = mostRecent.ActualQuantity;
                        }
                    }
                }
            }
        }
    }

    private string GetCategoryCompletionStatus(int categoryId)
    {
        var categoryTasks = _checklistItems.Where(t => t.CategoryId == categoryId && (_frequencyFilter == "All" || t.Frequency == _frequencyFilter)).ToList();
        var completed = _taskProgresses.Where(p => categoryTasks.Any(t => t.Id == p.ChecklistItemId) && p.IsCompleted).Count();
        return $"{completed}/{categoryTasks.Count} tasks completed";
    }

    private bool CanCompleteCategory(int categoryId)
    {
        var categoryTasks = _checklistItems.Where(t => t.CategoryId == categoryId && (_frequencyFilter == "All" || t.Frequency == _frequencyFilter)).ToList();
        if (!categoryTasks.Any()) return true;
        return categoryTasks.All(t => GetTaskProgress(t.Id).IsCompleted);
    }

    private async Task CompleteCategory(Category currentCat)
    {
        if (!CanCompleteCategory(currentCat.Id)) return;

        using var db = await DbFactory.CreateDbContextAsync();
        await SaveCurrentProgress();

        var nextCat = _categories.OrderBy(c => c.SortOrder).FirstOrDefault(c => c.SortOrder > currentCat.SortOrder && _checklistItems.Any(t => t.CategoryId == c.Id && (_frequencyFilter == "All" || t.Frequency == _frequencyFilter)));

        if (nextCat != null)
        {
            _currentCategoryId = nextCat.Id;
            _currentCategoryOrder = nextCat.SortOrder;

            var session = await db.StoreDailyActivities.FindAsync(_currentSession!.Id);
            if (session != null)
            {
                session.CurrentCategoryId = _currentCategoryId;
                await db.SaveChangesAsync();
            }

            Snackbar.Add($"{currentCat.Name} completed. Moving to {nextCat.Name}.", Severity.Success);
        }
        else
        {
            Snackbar.Add("All daily tasks completed successfully!", Severity.Success);
        }

        StateHasChanged();
    }

