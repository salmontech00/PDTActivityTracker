@page "/store-head/planner/{StoreId:int}"
@layout PDTActivityTracker.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using PDTActivityTracker.Components.Model
@using PDTActivityTracker.Components.Services
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@inject UserStateService UserState
@inject IJSRuntime JSRuntime
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Activity Planner - @(_store?.StoreName ?? "Loading...")</PageTitle>

<input type="file" id="cameraInput" accept="image/*" capture="camera" style="display: none;" @onchange="OnPhotoCaptured" />

<style>
    .planner-container {
        padding: 1.5rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .glass-panel {
        backdrop-filter: blur(15px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
    }

    .section-card {
        margin-bottom: 20px;
        overflow: hidden;
        border: 2px solid transparent;
    }

        .section-card.active {
            border-color: #0072cf;
            box-shadow: 0 10px 30px rgba(0, 114, 207, 0.15);
        }

        .section-card.locked {
            opacity: 0.6;
            filter: grayscale(0.5);
            pointer-events: none;
        }

    .section-header {
        padding: 16px 24px;
        display: flex;
        align-items: center;
        cursor: pointer;
        user-select: none;
    }

    .section-content {
        padding: 0 24px 24px 24px;
    }

    .task-item {
        padding: 16px;
        border-radius: 12px;
        margin-bottom: 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .lightest .task-item {
        background: rgba(0, 114, 207, 0.02);
        border: 1px solid rgba(0, 114, 207, 0.05);
    }

    .photo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 12px;
        margin-top: 8px;
    }

    .photo-box {
        aspect-ratio: 1;
        border-radius: 8px;
        background: rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1px dashed rgba(255,255,255,0.2);
    }

    /* THEME CLASSES */
    .lightest .glass-panel {
        background: rgba(255, 255, 255, 0.85);
        border-color: rgba(0, 114, 207, 0.1);
        color: #0f172a;
    }

    .light .glass-panel {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.3);
        color: white;
    }

    .dark .glass-panel {
        background: rgba(15, 23, 42, 0.8);
        border-color: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .manpower-input {
        max-width: 150px;
    }
</style>

<div class="planner-container">
    <!-- HEADER -->
    <div class="d-flex align-center justify-space-between mb-8">
        <div>
            <MudLink href="/store-head/dashboard" Class="d-flex align-center gap-2 mb-2" Style="text-decoration: none;">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                <MudText Typo="Typo.button">Back to Dashboard</MudText>
            </MudLink>
            <MudText Typo="Typo.h4" Style="font-weight: 800;">Activity Planner</MudText>
            <MudText Typo="Typo.subtitle1" Style="opacity: 0.7;">@(_store?.StoreName) • @(DateTime.Now.ToString("MMMM dd, yyyy"))</MudText>
        </div>
        <div class="text-right">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="px-6 py-4">
                @(_completedCount)/@(_totalTasksCount) TASKS
            </MudChip>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.ReportProblem"
                       OnClick="OpenIssueDialog"
                       Class="ml-4 rounded-xl px-6">REPORT ISSUE</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveCurrentProgress"
                       Class="ml-4 rounded-xl px-6">SAVE PROGRESS</MudButton>
        </div>
    </div>

    @if (_initialized)
    {
        @foreach (var category in _categories.OrderBy(c => c.SortOrder))
        {
            var isLocked = category.SortOrder > _currentCategoryOrder;
            var isActive = category.Id == _currentCategoryId;
            var isCompleted = category.SortOrder < _currentCategoryOrder;

            <MudPaper Class="@($"glass-panel section-card {GetThemeClass()} {(isActive ? "active" : "")} {(isLocked ? "locked" : "")}")" Elevation="0">
                <div class="section-header" OnClick="@(() => ToggleSection(category.Id))">
                    <MudIcon Icon="@category.Icon" Class="mr-4" Color="@(isCompleted? Color.Success: (isActive ? Color.Primary : Color.Default))" />
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">@category.Name</MudText>
                        <MudText Typo="Typo.caption" Style="opacity: 0.6;">@(GetCategoryCompletionStatus(category.Id))</MudText>
                    </div>
                    @if (isLocked)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="opacity: 0.5;" />
                    }
                    else if (isCompleted)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                    }
                    else
                    {
                        <MudIcon Icon="@(_expandedCategoryId == category.Id ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                    }
                </div>

                @if (_expandedCategoryId == category.Id)
                {
                    <div class="section-content">
                        <MudDivider Class="mb-4" Style="opacity: 0.1;" />
                        @{
                            var tasks = _checklistItems.Where(t => t.CategoryId == category.Id).OrderBy(t => t.SortOrder).ToList();
                            string lastSection = "";
                        }
                        @foreach (var task in tasks)
                        {
                            if (task.Section != lastSection && !string.IsNullOrEmpty(task.Section))
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-6 mb-2" Style="font-weight: 800; opacity: 0.5; letter-spacing: 1px; text-transform: uppercase;">@task.Section</MudText>
                                lastSection = task.Section;
                            }

                            var progress = GetTaskProgress(task.Id);

                            <div class="task-item glass-panel">
                                <div class="d-flex align-start gap-4">
                                    <MudCheckBox T="bool"
                                                 Value="@progress.IsCompleted"
                                                 ValueChanged="@((val) => OnTaskToggle(task, val))"
                                                 Color="Color.Primary"
                                                 Dense="true"
                                                 Class="pa-0 mt-1" />

                                    <div class="flex-grow-1">
                                        <div class="d-flex align-center gap-2 mb-1">
                                            @if (task.IsMandatory)
                                            {
                                                <MudText Color="Color.Error" Typo="Typo.body1" Style="font-weight: 900;">*</MudText>
                                            }
                                            <MudText Typo="Typo.body1" Style="font-weight: 600;">@task.TaskName</MudText>
                                        </div>
                                        @if (!string.IsNullOrEmpty(task.Description))
                                        {
                                            <MudText Typo="Typo.body2" Style="opacity: 0.7;">@task.Description</MudText>
                                        }

                                        @if (task.TaskType == "Manpower")
                                        {
                                            <div class="d-flex align-center gap-4 mt-4">
                                                <MudText Typo="Typo.body2">Expected: <b>@task.QuantityExpected</b></MudText>
                                                <MudNumericField T="int?"
                                                                 @bind-Value="progress.ActualQuantity"
                                                                 Label="Actual"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Class="manpower-input"
                                                                 @bind-Value:after="@(() => ValidateManpower(task, progress))" />
                                            </div>
                                        }

                                        @if (task.IsPhotoRequired)
                                        {
                                            <div class="mt-4">
                                                <MudButton Variant="Variant.Outlined"
                                                           StartIcon="@Icons.Material.Filled.PhotoCamera"
                                                           Size="Size.Small"
                                                           OnClick="@(() => CapturePhoto(task))"
                                                           Color="Color.Info"
                                                           Style="border-radius: 8px;">
                                                    Take Photo (@(GetPhotoCount(task.Id))/@(task.NumberOfPhotos == 0 ? "Any" : task.NumberOfPhotos))
                                                </MudButton>

                                                <div class="photo-grid">
                                                    @foreach (var photo in GetStoredPhotos(task.Id))
                                                    {
                                                        <div class="photo-box">
                                                            <img src="data:@photo.ImageMimeType;base64,@Convert.ToBase64String(photo.ImageData!)" style="width: 100%; height: 100%; object-fit: cover;" />
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (task.IsRemarksRequired)
                                        {
                                            <MudTextField T="string"
                                                          @bind-Value="progress.Remarks"
                                                          Label="Remarks"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Lines="2"
                                                          Class="mt-4 rounded-lg" />
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-end mt-6">
                            @if (isActive)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Large"
                                           Disabled="@(!CanCompleteCategory(category.Id))"
                                           OnClick="@(() => CompleteCategory(category))"
                                           Class="rounded-xl px-10">
                                    @(category.Name == "Check Out" ? "FINISH WORKDAY" : "COMPLETE SECTION")
                                </MudButton>
                            }
                        </div>
                    </div>
                }
            </MudPaper>
        }
    }
    else
    {
        <div class="d-flex flex-column align-center justify-center py-20">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-4" />
            <MudText Typo="Typo.h6">Preparing Operation checklist...</MudText>
        </div>
    }
</div>

@code {
    [Parameter] public int StoreId { get; set; }

    private bool _initialized = false;
    private Store? _store;
    private List<Category> _categories = new();
    private List<ChecklistItem> _checklistItems = new();
    private StoreDailyActivity? _currentSession;
    private List<TaskProgress> _taskProgresses = new();
    private List<TaskPhoto> _loadedPhotos = new();

    private int _currentCategoryId;
    private int _currentCategoryOrder = 0;
    private int? _expandedCategoryId;

    private int _completedCount = 0;
    private int _totalTasksCount = 0;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
        await LoadData();
    }

    private void OnThemeChanged() => StateHasChanged();

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        _store = await db.Stores.FirstOrDefaultAsync(s => s.Id == StoreId);
        if (_store == null)
        {
            NavigationManager.NavigateTo("/store-head/dashboard");
            return;
        }

        _categories = await db.Categories.AsNoTracking().OrderBy(c => c.SortOrder).ToListAsync();
        _checklistItems = await db.ChecklistItems.AsNoTracking().ToListAsync();
        _totalTasksCount = _checklistItems.Count;

        // Load or Create today's session
        var today = DateTime.Today;
        _currentSession = await db.StoreDailyActivities
            .Include(s => s.CurrentCategory)
            .FirstOrDefaultAsync(s => s.StoreId == StoreId && s.Date == today && !s.IsCompleted);

        if (_currentSession == null)
        {
            _currentSession = new StoreDailyActivity
            {
                StoreId = StoreId,
                Date = today,
                CurrentCategoryId = _categories.First().Id,
                StartedById = UserState.UserId,
                IsCompleted = false
            };
            db.StoreDailyActivities.Add(_currentSession);
            await db.SaveChangesAsync();
        }

        _currentCategoryId = _currentSession.CurrentCategoryId;
        var currentCat = _categories.FirstOrDefault(c => c.Id == _currentCategoryId);
        _currentCategoryOrder = currentCat?.SortOrder ?? 0;
        _expandedCategoryId = _currentCategoryId;

        // Load progress
        _taskProgresses = await db.TaskProgresses
            .Where(tp => tp.StoreDailyActivityId == _currentSession.Id)
            .ToListAsync();

        // Load photos
        _loadedPhotos = await db.TaskPhotos
            .Where(p => p.StoreId == StoreId && p.UploadedAt >= today)
            .ToListAsync();

        UpdateCompletedCount();
        _initialized = true;
        StateHasChanged();
    }

    private TaskProgress GetTaskProgress(int taskId)
    {
        var prog = _taskProgresses.FirstOrDefault(p => p.ChecklistItemId == taskId);
        if (prog == null)
        {
            prog = new TaskProgress
            {
                StoreDailyActivityId = _currentSession!.Id,
                ChecklistItemId = taskId,
                IsCompleted = false
            };
            _taskProgresses.Add(prog);
        }
        return prog;
    }

    private void OnTaskToggle(ChecklistItem task, bool val)
    {
        var prog = GetTaskProgress(task.Id);
        prog.IsCompleted = val;
        if (val) prog.CompletedAt = DateTime.Now;
        UpdateCompletedCount();
    }

    private void UpdateCompletedCount()
    {
        _completedCount = _taskProgresses.Count(p => p.IsCompleted);
    }

    private void ToggleSection(int categoryId)
    {
        var cat = _categories.FirstOrDefault(c => c.Id == categoryId);
        if (cat != null && cat.SortOrder <= _currentCategoryOrder)
        {
            if (_expandedCategoryId == categoryId)
                _expandedCategoryId = null;
            else
                _expandedCategoryId = categoryId;
        }
    }

    private string GetCategoryCompletionStatus(int categoryId)
    {
        var categoryTasks = _checklistItems.Where(t => t.CategoryId == categoryId).ToList();
        var completed = _taskProgresses.Where(p => categoryTasks.Any(t => t.Id == p.ChecklistItemId) && p.IsCompleted).Count();
        return $"{completed}/{categoryTasks.Count} tasks completed";
    }

    private bool CanCompleteCategory(int categoryId)
    {
        var categoryTasks = _checklistItems.Where(t => t.CategoryId == categoryId).ToList();
        foreach (var task in categoryTasks)
        {
            var prog = GetTaskProgress(task.Id);
            if (task.IsMandatory && !prog.IsCompleted) return false;
            if (task.IsPhotoRequired && task.NumberOfPhotos > 0)
            {
                var count = GetPhotoCount(task.Id);
                if (count < task.NumberOfPhotos) return false;
            }
        }
        return true;
    }

    private async Task CompleteCategory(Category currentCat)
    {
        if (!CanCompleteCategory(currentCat.Id)) return;

        using var db = await DbFactory.CreateDbContextAsync();

        // Save current progress before moving
        await SaveCurrentProgress();

        var nextCat = _categories.OrderBy(c => c.SortOrder).FirstOrDefault(c => c.SortOrder > currentCat.SortOrder);

        if (nextCat != null)
        {
            _currentCategoryId = nextCat.Id;
            _currentCategoryOrder = nextCat.SortOrder;
            _expandedCategoryId = nextCat.Id;

            var session = await db.StoreDailyActivities.FindAsync(_currentSession!.Id);
            if (session != null)
            {
                session.CurrentCategoryId = _currentCategoryId;
                await db.SaveChangesAsync();
            }

            Snackbar.Add($"{currentCat.Name} completed. Moving to {nextCat.Name}.", Severity.Success);
        }
        else
        {
            // Finish Workday
            var session = await db.StoreDailyActivities.FindAsync(_currentSession!.Id);
            if (session != null)
            {
                session.IsCompleted = true;
                session.CompletedAt = DateTime.Now;
                await db.SaveChangesAsync();
            }

            Snackbar.Add("Daily operations completed successfully!", Severity.Success);
            NavigationManager.NavigateTo("/store-head/dashboard");
        }

        StateHasChanged();
    }

    private async Task SaveCurrentProgress()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        foreach (var prog in _taskProgresses)
        {
            if (prog.Id == 0)
            {
                db.TaskProgresses.Add(prog);
            }
            else
            {
                db.Entry(prog).State = EntityState.Modified;
            }
        }

        await db.SaveChangesAsync();
        Snackbar.Add("Progress saved.", Severity.Info);
    }

    private ChecklistItem? _activePhotoTask;

    private async Task CapturePhoto(ChecklistItem task)
    {
        _activePhotoTask = task;
        await JSRuntime.InvokeVoidAsync("document.getElementById('cameraInput').click");
    }

    private async Task OnPhotoCaptured(ChangeEventArgs e)
    {
        if (_activePhotoTask == null) return;

        // Use browser's file API or simulated capture
        // For now, continuing with simulated capture but using the event trigger
        Snackbar.Add($"Synthesizing GPS and timestamp for {_activePhotoTask.TaskName}...", Severity.Info);

        double lat = _store?.GPSLatitude ?? 0;
        double lng = _store?.GPSLongitude ?? 0;

        var photoData = new byte[100]; // Ideally read from e.Value/stream
        var photo = new TaskPhoto
        {
            StoreId = StoreId,
            ChecklistItemId = _activePhotoTask.Id,
            CategoryId = _activePhotoTask.CategoryId,
            UploadedById = UserState.UserId,
            UploadedAt = DateTime.Now,
            ImageData = photoData,
            ImageMimeType = "image/jpeg",
            Description = $"GPS: {lat}, {lng} | Time: {DateTime.Now:HH:mm:ss}"
        };

        using var db = await DbFactory.CreateDbContextAsync();
        db.TaskPhotos.Add(photo);
        await db.SaveChangesAsync();

        _loadedPhotos.Add(photo);
        _activePhotoTask = null;
        StateHasChanged();
    }

    private async Task OpenIssueDialog()
    {
        var parameters = new DialogParameters { ["StoreId"] = StoreId, ["UserId"] = UserState.UserId };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<PDTActivityTracker.Components.Pages.Dialogs.ReportIssueDialog>("Report Issue", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is ValueTuple<Issue, byte[], string> data)
        {
            var (issue, imageData, mimeType) = data;

            using var db = await DbFactory.CreateDbContextAsync();
            db.Issues.Add(issue);
            await db.SaveChangesAsync();

            // Save the evidence photo as a TaskPhoto too but linked to the issue?
            // Existing TaskPhoto doesn't have IssueId. ActivityLog could link them.

            var activity = new ActivityLog
            {
                StoreId = StoreId,
                UserId = UserState.UserId,
                Action = "IssueReported",
                EntityType = "Issue",
                EntityId = issue.Id,
                Details = $"Reported {issue.Title} with {issue.Priority} priority.",
                Timestamp = DateTime.Now
            };
            db.ActivityLogs.Add(activity);
            await db.SaveChangesAsync();

            Snackbar.Add("Issue report submitted successfully.", Severity.Success);
        }
    }

    private int GetPhotoCount(int taskId) => _loadedPhotos.Count(p => p.ChecklistItemId == taskId);

    private List<TaskPhoto> GetStoredPhotos(int taskId) => _loadedPhotos.Where(p => p.ChecklistItemId == taskId).ToList();

    private async Task ValidateManpower(ChecklistItem task, TaskProgress prog)
    {
        if (prog.ActualQuantity.HasValue && prog.ActualQuantity < task.QuantityExpected)
        {
            Snackbar.Add($"Low manpower reported for {task.TaskName}. Area Head has been notified.", Severity.Warning);

            // Create Notification logic
            using var db = await DbFactory.CreateDbContextAsync();
            var notification = new Notification
            {
                UserId = _store?.AreaHeadId ?? 0,
                Message = $"Low manpower alert: Store {_store?.StoreCode} reported {prog.ActualQuantity}/{task.QuantityExpected} for {task.TaskName}.",
                Type = "Alert",
                IsRead = false,
                CreatedAt = DateTime.Now
            };
            if (notification.UserId > 0)
            {
                db.Notifications.Add(notification);
                await db.SaveChangesAsync();
            }
        }
    }

    private string GetThemeClass() => ThemeService.CurrentTheme switch
    {
        ThemeMode.Lightest => "lightest",
        ThemeMode.Light => "light",
        ThemeMode.Dark => "dark",
        _ => "lightest"
    };

    private string GetStatusTextColor() => ThemeService.CurrentTheme == ThemeMode.Lightest ? "text-dark" : "text-white";
}
