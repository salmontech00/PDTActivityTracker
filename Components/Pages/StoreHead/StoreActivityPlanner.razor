                                                                                                 Variant="Variant.Outlined"
                                                                                                 Margin="Margin.Dense"
                                                                                                 Disabled="@(IsSessionLocked() || IsAutoCompletedPreviousDay(progress, task))"
                                                                                                 HideSpinButtons="true"
                                                                                                 Class="manpower-input center-input" />
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                <div class="mt-2 pt-2 d-flex align-center gap-6" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                                                    <MudText Typo="Typo.caption" Style="font-weight: 700;">TOTAL EXPECTED: <b style="color: var(--mud-palette-primary);">@GetTotalExpectedValue(progress, task)</b></MudText>
                                                                    <MudText Typo="Typo.caption" Style="font-weight: 700;">TOTAL ACTUAL: <b style="color: var(--mud-palette-success);">@(progress.ActualQuantity ?? 0)</b></MudText>
