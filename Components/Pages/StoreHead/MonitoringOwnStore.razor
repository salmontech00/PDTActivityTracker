                                <div class="date-picker-mobile">
                                    <MudTextField T="string"
                                                  Label="Date Range"
                                                  Value="@GetFormattedDateRange(_dateRange)"
                                                  ReadOnly="true"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@Icons.Material.Filled.DateRange"
                                                  @onclick="@(() => OpenGlassRangeCalendarDialog(false))" />
                                </div>
                            </MudItem>
                        </MudGrid>
                        <MudGrid>
                            <MudItem xs="12">
                                <div class="d-flex justify-space-between align-center px-1 filters-summary-row">
                                    <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                        Showing @(_dailyActivities.Count) of @(_totalReportsCount) reports
                                    </MudText>
                                    <div class="action-buttons-container">
                                        @if (HasActiveReportFilters())
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Clear"
                                                       OnClick="ClearReportFilters" Class="clear-filters-button">
                                                Clear Filters
                                            </MudButton>
                                        }
                                    </div>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    @if (_dailyActivities.Any())
                    {
                        @foreach (var activity in GetPagedActivities())
                        {
                            <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                                <div class="mobile-card-header">
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@activity.Date.ToString("MMM dd, yyyy")</MudText>
                                        @if (activity.AreaHeadReviewedAt.HasValue)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled"
                                                     Icon="@Icons.Material.Filled.Verified" Style="margin: 0; margin-top: 4px;">Reviewed</MudChip>
                                        }
                                    </div>
                                    <MudChip T="string" Size="Size.Small" Color="@GetActivityStatusColor(activity)" Variant="Variant.Filled" Class="role-chip">
                                        @GetActivityStatusLabel(activity)
                                    </MudChip>
                                </div>
                                <div class="mobile-card-content">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Started By</MudText>
                                            <MudText Typo="Typo.body2" Style="word-break: break-word; overflow-wrap: anywhere;">@(activity.StartedBy?.Fullname ?? "---")</MudText>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Completed At</MudText>
                                            <MudText Typo="Typo.body2">@GetActivityCompletedAt(activity)</MudText>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <div class="d-flex align-center justify-space-between mb-1">
                                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Progress</MudText>
                                                <MudText Typo="Typo.caption" Style="font-weight: 700;">@((int)GetCompletionProgress(activity.Id))%</MudText>
                                            </div>
                                            <MudProgressLinear Color="Color.Primary" Value="@GetCompletionProgress(activity.Id)" Rounded="true" Size="Size.Small" />
                                        </MudItem>
                                        @if (!string.IsNullOrEmpty(activity.AreaHeadRemark))
                                        {
                                            <MudItem xs="12">
                                                <div class="mt-2 pa-2 rounded-lg" style="background: rgba(0, 114, 207, 0.05); border-left: 3px solid #0072cf;">
                                                    <MudText Typo="Typo.caption" Style="font-weight: 700; display: block;">AREA HEAD FEEDBACK</MudText>
                                                    <MudText Typo="Typo.caption" Class="d-block">@activity.AreaHeadRemark</MudText>
                                                </div>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </div>
                                <div class="mobile-card-actions">
                                    <MudButton StartIcon="@Icons.Material.Filled.Visibility"
                                               Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                                               OnClick="@(() => OpenActivityDetail(activity))"
                                               Class="action-btn-pill action-btn-info">
                                        Details
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                        @if (_dailyActivities.Count > _activityPageSize)
                        {
                            <div class="d-flex justify-center mt-4">
                                <MudPagination Color="Color.Primary"
                                               Count="@((_dailyActivities.Count + _activityPageSize - 1) / _activityPageSize)"
                                               Selected="@_activityCurrentPage"
                                               SelectedChanged="OnActivityPageChanged"
                                               Variant="Variant.Filled" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pa-12 text-center" style="opacity: 0.5;">
                            <MudIcon Icon="@Icons.Material.Filled.ReportOff" Size="Size.Large" Class="mb-2" />
                            <MudText>No activity reports found matching your criteria.</MudText>
                        </div>
                    }
                }
                else if (_activeSection == "photos")
                {
                    <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showPhotoFilters ? "filters-visible" : "")}")" Elevation="0">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@(_showPhotoFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                                   FullWidth="true"
                                   OnClick="@(() => _showPhotoFilters = !_showPhotoFilters)"
                                   Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                                   Style="@GetFilterButtonStyle()">
                            @(_showPhotoFilters ? "Hide Filters" : "Show Filters")
                        </MudButton>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="4" md="4">
                                <MudTextField T="string"
                                              @bind-Value="_photoSearchTerm"
                                              @bind-Value:after="() => _photoCurrentPage = 1"
                                              Label="Search" Placeholder="Task or user..."
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Class="rounded-lg" Immediate="true" DebounceInterval="300"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search" />
                            </MudItem>
                            <MudItem xs="12" sm="4" md="4">
                                <MudSelect T="int?" @bind-Value="_selectedCategoryId" @bind-Value:after="() => _photoCurrentPage = 1"
                                           Label="Filter by Category" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Class="rounded-lg" AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="@((int?)null)">All Categories</MudSelectItem>
                                    @foreach (var cat in _categories)
                                    {
                                        <MudSelectItem Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="4" md="4">
                                <div class="date-picker-desktop">
                                    <MudDateRangePicker Label="Date Range"
                                                        @bind-DateRange="_photoDateRange"
                                                        @bind-DateRange:after="() => _photoCurrentPage = 1"
                                                        Variant="Variant.Outlined" Margin="Margin.Dense"
                                                        AnchorOrigin="Origin.BottomCenter"
                                                        TransformOrigin="Origin.TopCenter" />
                                </div>
                                <div class="date-picker-mobile">
                                    <MudTextField T="string"
                                                  Label="Date Range"
                                                  Value="@GetFormattedDateRange(_photoDateRange)"
                                                  ReadOnly="true"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@Icons.Material.Filled.DateRange"
                                                  @onclick="@(() => OpenGlassRangeCalendarDialog(true))" />
                                </div>
                            </MudItem>
                        </MudGrid>
                        <MudGrid>
                            <MudItem xs="12">
                                <div class="d-flex justify-space-between align-center px-1 filters-summary-row">
                                    <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                        Showing @_filteredPhotos.Count of @_photoTotalMatchingCount photos
                                    </MudText>
                                    <div class="action-buttons-container">
                                        @if (!string.IsNullOrEmpty(_photoSearchTerm) || _selectedCategoryId != null || (_photoDateRange != null && _photoDateRange.Start.HasValue))
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Clear"
                                                       OnClick="ClearPhotoFilters" Class="clear-filters-button">
                                                Clear Filters
                                            </MudButton>
                                        }
                                    </div>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    @if (_filteredPhotos.Any())
                    {
                        <div class="photo-grid">
                            @foreach (var photo in _filteredPhotos)
                            {
                                <div class="photo-item" @onclick="@(() => OpenPhotoDialog(photo))">
                                    @if (photo.ImageData != null)
                                    {
                                        <img src="@($"data:{photo.ImageMimeType};base64,{Convert.ToBase64String(photo.ImageData)}")" alt="Store Photo" />
                                    }
                                    <div class="photo-overlay">
                                        <div class="font-weight-bold">@photo.Category?.Name</div>
                                        <div style="opacity: 0.8;">@photo.UploadedAt.ToString("MMM dd, HH:mm")</div>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (_photoTotalMatchingCount > _photoPageSize)
                        {
                            <div class="d-flex justify-center mt-6">
                                <MudPagination Color="Color.Primary"
                                               Count="@((_photoTotalMatchingCount + _photoPageSize - 1) / _photoPageSize)"
                                               Selected="@_photoCurrentPage"
                                               SelectedChanged="@(page => { _photoCurrentPage = page; StateHasChanged(); })"
                                               Variant="Variant.Filled"
                                               BoundaryCount="1"
                                               MiddleCount="3" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pa-12 text-center" style="opacity: 0.5;">
                            <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" Class="mb-2" />
                            <MudText>No photos found for this store.</MudText>
                        </div>
                    }
                }
                else if (_activeSection == "stats")
                {
                    <MudPaper Class="@($"glass-panel pa-4 mb-3 {GetThemeClass()}")" Elevation="0" Style="border-radius: 16px !important;">
                        <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Performance Breakdown</MudText>
                        @if (!_categoryPerformance.Any())
                        {
                            <div class="d-flex flex-column align-center justify-center py-6" style="opacity: 0.5;">
                                <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.body2">No performance data yet.</MudText>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-4">
                                @foreach (var cat in _categoryPerformance)
                                {
                                    <div>
                                        <div class="d-flex justify-space-between mb-2">
                                            <MudText Typo="Typo.body2" Style="font-weight: 600; min-width: 0; word-break: break-word; overflow-wrap: anywhere;">@cat.CategoryName</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 800; flex-shrink: 0; padding-left: 4px;">@cat.CompletionRate%</MudText>
                                        </div>
                                        <MudProgressLinear Color="@GetCategoryColor(cat.CompletionRate)" Value="@cat.CompletionRate" Rounded="true" Size="Size.Medium" />
                                    </div>
                                }
                            </div>
                        }
                    </MudPaper>

                    <MudPaper Class="@($"glass-panel pa-4 {GetThemeClass()}")" Elevation="0" Style="border-radius: 16px !important;">
                        <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Recent Achievements</MudText>
                        <div class="d-flex flex-column gap-2">
                            @if (_avgCompletionRate >= 90)
                            {
                                <div class="activity-item">
                                    <div class="activity-icon" style="background: #f59e0b; color: #fff;"><MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" /></div>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">Outstanding consistency this period!</MudText>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_topCategoryName) && _topCategoryRate > 0)
                            {
                                <div class="activity-item">
                                    <div class="activity-icon" style="background: #22c55e; color: #fff;"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /></div>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">Great job on @(_topCategoryName) tasks!</MudText>
                                </div>
                            }
                            <div class="activity-item">
                                <div class="activity-icon" style="background: #0072cf; color: #fff;"><MudIcon Icon="@Icons.Material.Filled.Photo" Size="Size.Small" /></div>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@_totalPhotos photos shared this period.</MudText>
                            </div>
                        </div>
                    </MudPaper>
                }
                else if (_activeSection == "issues")
                {
                    <MudPaper Class="@($"glass-panel filter-panel pb-2 pt-2 pr-3 pl-3 mb-4 {GetThemeClass()} {(_showIssueFilters ? "filters-visible" : "")}")" Elevation="0">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@(_showIssueFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                                   FullWidth="true"
                                   OnClick="@(() => _showIssueFilters = !_showIssueFilters)"
                                   Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                                   Style="@GetFilterButtonStyle()">
                            @(_showIssueFilters ? "Hide Filters" : "Show Filters")
                        </MudButton>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="8">
                                <MudTextField T="string"
                                              @bind-Value="_issueSearchTerm"
                                              @bind-Value:after="ApplyIssueFilters"
                                              Label="Search Issues" Placeholder="Category or description..."
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSelect T="string" @bind-Value="_issueStatusFilter" @bind-Value:after="ApplyIssueFilters"
                                           Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                    <MudSelectItem Value="@(string.Empty)">All Status</MudSelectItem>
                                    <MudSelectItem Value="@("Open")">Open</MudSelectItem>
                                    <MudSelectItem Value="@("Resolved")">Resolved</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                        <MudGrid>
                            <MudItem xs="12">
                                <div class="d-flex justify-space-between align-center px-1 filters-summary-row">
                                    <MudText Typo="Typo.body2" Style="opacity: 0.8;" Class="filter-info-text">
                                        Showing @(_myIssuesFiltered.Count) of @(_myIssues.Count) issues
                                    </MudText>
                                    <div class="action-buttons-container">
                                        @if (HasIssueFilters())
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Clear"
                                                       OnClick="ClearIssueFilters" Class="clear-filters-button">
                                                Clear Filters
                                            </MudButton>
                                        }
                                    </div>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    @if (_myIssuesFiltered.Any())
                    {
                        @foreach (var issue in GetPagedIssues())
                        {
                            <MudPaper Class="@($"glass-panel mobile-card {GetThemeClass()}")" Elevation="0">
                                <div class="mobile-card-header">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@issue.ReportedAt.ToString("MMM dd")</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(issue.Status)" Variant="Variant.Filled">
                                        @issue.Status
                                    </MudChip>
                                </div>
                                <div class="mobile-card-content">
                                    <div class="d-flex justify-space-between align-start">
                                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@issue.Title</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(issue.Priority)" Variant="Variant.Filled">@issue.Priority</MudChip>
                                    </div>
                                    <MudText Typo="Typo.body2" Class="mt-2" Style="word-break: break-word; overflow-wrap: anywhere;">@issue.Description</MudText>
                                    @if (!string.IsNullOrEmpty(issue.AreaHeadRemark))
                                    {
                                        <div class="mt-2 pa-2 rounded-lg" style="background: rgba(0, 114, 207, 0.05); border-left: 3px solid #0072cf;">
                                            <MudText Typo="Typo.caption" Style="font-weight: 700; display: block;">FEEDBACK</MudText>
                                            <MudText Typo="Typo.caption" Class="d-block" Style="word-break: break-word; overflow-wrap: anywhere;">@issue.AreaHeadRemark</MudText>
                                        </div>
                                    }
                                </div>
                                <div class="mobile-card-actions">
                                    <MudButton StartIcon="@Icons.Material.Filled.Visibility"
                                               Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                                               OnClick="@(() => OpenIssueDetail(issue))"
                                               Class="action-btn-pill action-btn-info">
                                        View Details
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                        @if (_myIssuesFiltered.Count > _issuePageSize)
                        {
                            <div class="d-flex justify-center mt-4">
                                <MudPagination Color="Color.Primary"
                                               Count="@((_myIssuesFiltered.Count + _issuePageSize - 1) / _issuePageSize)"
                                               Selected="@_issueCurrentPage"
                                               SelectedChanged="OnIssuePageChanged"
                                               Variant="Variant.Filled" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pa-12 text-center" style="opacity: 0.5;">
                            <MudIcon Icon="@Icons.Material.Filled.ReportOff" Size="Size.Large" Class="mb-2" />
                            <MudText>No operational issues found matching your criteria.</MudText>
                        </div>
                    }
                }

            </MudPaper>

        </div>
    }
</div>

@code {
    private string GetFormattedDateRange(DateRange? range)
    {
        if (range == null || range.Start == null || range.End == null)
            return "Select Date Range";
        return $"{range.Start.Value:M/d/yyyy} - {range.End.Value:M/d/yyyy}";
    }

    private async Task OpenGlassRangeCalendarDialog(bool isPhoto)
    {
        var currentRange = isPhoto ? _photoDateRange : _dateRange;
        var parameters = new DialogParameters<GlassDateRangeWrapperDialog>
        {
            { x => x.RangeStart, currentRange?.Start },
            { x => x.RangeEnd, currentRange?.End }
        };
        var options = new DialogOptions
        {
            NoHeader = true,
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<GlassDateRangeWrapperDialog>("", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is DateRange selectedRange)
        {
            if (isPhoto) { _photoDateRange = selectedRange; _photoCurrentPage = 1; }
            else { _dateRange = selectedRange; await ApplyReportFilters(); }
            StateHasChanged();
        }
        else if (result != null && !result.Canceled && result.Data == null)
        {
            if (isPhoto) { _photoDateRange = null; _photoCurrentPage = 1; }
            else { _dateRange = null; await ApplyReportFilters(); }
            StateHasChanged();
        }
    }

    private bool _isLoading = true;
    private Store? _myStore;
    private List<StoreDailyActivity> _dailyActivities = new();
    private List<StoreDailyActivity> _allDailyActivities = new();
    private List<TaskPhoto> _allPhotos = new();
    private int _photoPageSize = 24;
    private int _photoCurrentPage = 1;
    private List<TaskPhoto> _filteredPhotos => GetFilteredPhotos();
    private int _photoTotalMatchingCount => GetAllFilteredPhotos().Count;
    private DateRange? _photoDateRange = null;
    private List<Category> _categories = new();
    private int? _selectedCategoryId;
    private string _photoSearchTerm = "";
    private int _totalReportsCount = 0;
    private List<Issue> _myIssues = new();
    private List<Issue> _myIssuesFiltered = new();

    // Mobile section nav
    private string _activeSection = "activity";

    // Filter states
    private bool _showFilters = false;
    private bool _showPhotoFilters = false;
    private bool _showIssueFilters = false;
    private DateRange? _dateRange = null;
    private string _issueSearchTerm = string.Empty;
    private string _issueStatusFilter = string.Empty;

    // Stats
    private int _avgCompletionRate = 0;
    private int _totalReports = 0;
    private int _pendingChecks = 0;
    private int _totalPhotos = 0;
    private List<CategoryPerformanceModel> _categoryPerformance = new();
    private string _topCategoryName = "Opening";
    private int _topCategoryRate = 0;
    private Dictionary<int, PDTActivityTracker.Components.Services.ActivityProgressHelper.ActivityProgressResult> _activityProgressCache = new();

    private int _activityPageSize = 10;
    private int _activityCurrentPage = 1;

    private List<StoreDailyActivity> GetPagedActivities() =>
        _dailyActivities
            .Skip((_activityCurrentPage - 1) * _activityPageSize)
            .Take(_activityPageSize)
            .ToList();

    private void OnActivityPageChanged(int page)
    {
        _activityCurrentPage = page;
    }

    private int _issuePageSize = 10;
    private int _issueCurrentPage = 1;

    private List<Issue> GetPagedIssues() =>
        _myIssuesFiltered
            .Skip((_issueCurrentPage - 1) * _issuePageSize)
            .Take(_issuePageSize)
            .ToList();

    private void OnIssuePageChanged(int page)
    {
        _issueCurrentPage = page;
    }

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private string GetNavButtonStyle(string section)
    {
        var isActive = _activeSection == section;
        var isLightest = GetThemeClass() == "lightest";
        var baseStyle = "border-radius:12px; font-size:0.70rem; font-weight:600;";
        var colorStyle = !isActive && !isLightest ? " color:#ffffff; border-color:rgba(255,255,255,0.5);" : "";
        return baseStyle + colorStyle;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserState.InitializeAsync();

            if (UserState.Role != "Store Head" && UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo(UserState.LastValidPage ?? UserState.GetDashboardRoute(), forceLoad: true);
                return;
            }
            await UserState.SetLastValidPage(NavigationManager.Uri);

            await LoadData();
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        _myStore = await db.Stores.FirstOrDefaultAsync(s => s.StoreHeadId == UserState.UserId && !s.IsDeleted);
        if (_myStore == null) return;

        _categories = await db.Categories.OrderBy(c => c.SortOrder).ToListAsync();

        await LoadPhotos();
        await LoadMyIssues();
        await LoadReports();
    }

    private async Task LoadReports()
    {
        if (_myStore == null) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var query = db.StoreDailyActivities
            .Include(a => a.StartedBy)
            .Include(a => a.AreaHead)
            .Where(a => a.StoreId == _myStore.Id);

        _totalReportsCount = await db.StoreDailyActivities.CountAsync(a => a.StoreId == _myStore.Id);
        _allDailyActivities = await query.OrderByDescending(a => a.Date).ToListAsync();
        _totalReports = _allDailyActivities.Count;

        _activityProgressCache = await PDTActivityTracker.Components.Services.ActivityProgressHelper.CalculateProgressForActivitiesAsync(_allDailyActivities, db);

        await ApplyReportFilters();
    }

    private async Task ApplyReportFilters()
    {
        _activityCurrentPage = 1;
        _dailyActivities = _allDailyActivities;

        if (_dateRange != null && _dateRange.Start.HasValue && _dateRange.End.HasValue)
        {
            var startDate = _dateRange.Start.Value.Date;
            var endDate = _dateRange.End.Value.Date.AddDays(1).AddSeconds(-1);
            _dailyActivities = _dailyActivities
                .Where(a => a.Date >= startDate && a.Date <= endDate)
                .ToList();
        }

        await CalculateStats();
        StateHasChanged();
    }

    private async Task ClearReportFilters()
    {
        _dateRange = null;
        await ApplyReportFilters();
    }

    private List<TaskPhoto> GetAllFilteredPhotos()
    {
        var photos = _allPhotos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_photoSearchTerm))
        {
            var term = _photoSearchTerm.ToLower();
            photos = photos.Where(p =>
                (p.Description != null && p.Description.ToLower().Contains(term)) ||
                (p.ChecklistItem != null && p.ChecklistItem.TaskName != null && p.ChecklistItem.TaskName.ToLower().Contains(term)) ||
                (p.ChecklistItem != null && p.ChecklistItem.Description != null && p.ChecklistItem.Description.ToLower().Contains(term)) ||
                (p.UploadedBy != null && p.UploadedBy.Fullname != null && p.UploadedBy.Fullname.ToLower().Contains(term)) ||
                (p.Store != null && p.Store.StoreName.ToLower().Contains(term))
            );
        }

        if (_selectedCategoryId != null)
            photos = photos.Where(p => p.CategoryId == _selectedCategoryId);

        if (_photoDateRange != null && _photoDateRange.Start.HasValue && _photoDateRange.End.HasValue)
        {
            var startDate = _photoDateRange.Start.Value.Date;
            var endDate = _photoDateRange.End.Value.Date.AddDays(1).AddSeconds(-1);
            photos = photos.Where(p => p.UploadedAt >= startDate && p.UploadedAt <= endDate);
        }

        return photos.ToList();
    }

    private List<TaskPhoto> GetFilteredPhotos()
    {
        return GetAllFilteredPhotos()
            .Skip((_photoCurrentPage - 1) * _photoPageSize)
            .Take(_photoPageSize)
            .ToList();
    }

    private void ClearPhotoFilters()
    {
        _photoSearchTerm = "";
        _selectedCategoryId = null;
        _photoDateRange = null;
        _photoCurrentPage = 1;
    }

    private bool HasActiveReportFilters() => _dateRange != null && _dateRange.Start.HasValue;

    private async Task LoadPhotos()
    {
        if (_myStore == null) return;
        using var db = await DbFactory.CreateDbContextAsync();
        _allPhotos = await db.TaskPhotos
            .Include(p => p.Category)
            .Include(p => p.Store)
            .Include(p => p.UploadedBy)
            .Include(p => p.ChecklistItem)
                .ThenInclude(c => c!.Category)
            .Include(p => p.StoreDailyActivity)
                .ThenInclude(s => s!.StartedBy)
            .Where(p => p.StoreId == _myStore.Id)
            .OrderByDescending(p => p.UploadedAt)
            .ToListAsync();
        _totalPhotos = _allPhotos.Count;
    }

    private async Task CalculateStats()
    {
        if (_myStore == null) return;
        using var db = await DbFactory.CreateDbContextAsync();

        if (_dailyActivities.Any())
        {
            var filteredIds = _dailyActivities.Select(a => a.Id).ToList();
            var filteredValues = _activityProgressCache
                .Where(kvp => filteredIds.Contains(kvp.Key))
                .Select(kvp => kvp.Value.CompletionPercentage)
                .ToList();
            _avgCompletionRate = filteredValues.Any() ? (int)filteredValues.Average() : 0;
            _totalReports = _dailyActivities.Count;
        }
        else
        {
            _avgCompletionRate = 0;
            _totalReports = 0;
        }

        var today = DateTime.Today;
        var todayActivity = await db.StoreDailyActivities
            .OrderByDescending(a => a.Id)
            .FirstOrDefaultAsync(a => a.StoreId == _myStore.Id && a.Date.Date == today);

        int pending = 0;
        if (todayActivity != null)
            pending = await db.TaskProgresses.CountAsync(p => p.StoreDailyActivityId == todayActivity.Id && p.IsCompleted);
        _pendingChecks = pending;

        _totalPhotos = _filteredPhotos.Count;

        var filteredActivityIds = _dailyActivities.Select(a => a.Id).ToList();
        var allTaskProgress = await db.TaskProgresses
            .Include(p => p.ChecklistItem)
            .Where(p => filteredActivityIds.Contains(p.StoreDailyActivityId))
            .ToListAsync();

        var newCategoryPerformance = new List<CategoryPerformanceModel>();
        foreach (var cat in _categories)
        {
            var catTasks = allTaskProgress.Where(p => p.ChecklistItem?.CategoryId == cat.Id).ToList();
            if (catTasks.Any())
            {
                var rate = (double)catTasks.Count(p => p.IsCompleted) / catTasks.Count * 100;
                newCategoryPerformance.Add(new CategoryPerformanceModel { CategoryName = cat.Name, CompletionRate = (int)rate });
            }
        }

        _categoryPerformance = newCategoryPerformance;

        var topCat = _categoryPerformance.OrderByDescending(c => c.CompletionRate).FirstOrDefault();
        _topCategoryName = topCat?.CategoryName ?? "Opening";
        _topCategoryRate = topCat?.CompletionRate ?? 0;
    }

    private double GetCompletionProgress(int activityId)
    {
        return _activityProgressCache.TryGetValue(activityId, out var val) ? val.CompletionPercentage : 0;
    }

    private string GetActivityCompletedAt(StoreDailyActivity activity)
    {
        if (activity.CompletedAt.HasValue)
            return activity.CompletedAt.Value.ToString("hh:mm tt");
        if (_activityProgressCache.TryGetValue(activity.Id, out var val) && val.IsFullyCompleted && val.LastCategoryCompletedAt.HasValue)
            return val.LastCategoryCompletedAt.Value.ToString("hh:mm tt");
        return "-";
    }

    private async Task OpenActivityDetail(StoreDailyActivity activity)
    {
        var parameters = new DialogParameters { ["Activity"] = activity };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<ActivityDetailDialog>("Activity Details", parameters, options);
    }

    private async Task OpenPhotoDialog(TaskPhoto photo)
    {
        var parameters = new DialogParameters { ["Photo"] = photo };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<PhotoGalleryDialog>("Photo Detail", parameters, options);
    }

    private string GetThemeClass()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "lightest",
            ThemeMode.Light => "light",
            _ => "dark"
        };
    }

    private Color GetCategoryColor(int rate) => rate switch
    {
        >= 90 => Color.Success,
        >= 70 => Color.Info,
        >= 40 => Color.Warning,
        _ => Color.Error
    };

    private string GetActivityStatusLabel(StoreDailyActivity activity)
    {
        return _activityProgressCache.TryGetValue(activity.Id, out var val) ? val.StatusLabel : "Not Started";
    }

    private Color GetActivityStatusColor(StoreDailyActivity activity)
    {
        return _activityProgressCache.TryGetValue(activity.Id, out var val) && Enum.TryParse<Color>(val.StatusColor, out var color) ? color : Color.Default;
    }

    private async Task LoadMyIssues()
    {
        if (_myStore == null) return;
        using var db = await DbFactory.CreateDbContextAsync();
        _myIssues = await db.Issues
            .AsNoTracking()
            .Include(i => i.ReportedBy)
            .Include(i => i.ReviewedBy)
            .Where(i => i.StoreId == _myStore.Id)
            .OrderByDescending(i => i.ReportedAt)
            .ToListAsync();
        ApplyIssueFilters();
    }

    private void ApplyIssueFilters()
    {
        _issueCurrentPage = 1;
        var filtered = _myIssues.AsQueryable();

        if (!string.IsNullOrWhiteSpace(_issueSearchTerm))
        {
            var term = _issueSearchTerm.ToLower();
            filtered = filtered.Where(i =>
                (i.Title != null && i.Title.ToLower().Contains(term)) ||
                (i.Description != null && i.Description.ToLower().Contains(term)));
        }

        if (!string.IsNullOrWhiteSpace(_issueStatusFilter))
            filtered = filtered.Where(i => i.Status == _issueStatusFilter);

        _myIssuesFiltered = filtered.ToList();
        StateHasChanged();
    }

    private void ClearIssueFilters()
    {
        _issueSearchTerm = string.Empty;
        _issueStatusFilter = string.Empty;
        ApplyIssueFilters();
    }

    private bool HasIssueFilters() => !string.IsNullOrEmpty(_issueSearchTerm) || !string.IsNullOrEmpty(_issueStatusFilter);

    private async Task OpenIssueDetail(Issue issue)
    {
        var parameters = new DialogParameters
        {
            ["Issue"] = issue,
            ["IsAreaHead"] = false
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<IssueDetailDialog>("Issue Details", parameters, options);
    }

    private Color GetPriorityColor(string priority) => priority switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        "Low" => Color.Default,
        _ => Color.Default
    };

    private Color GetStatusColor(string status) => status switch
    {
        "Resolved" => Color.Success,
        "Open" => Color.Error,
        _ => Color.Warning
    };

    private string GetFilterButtonStyle()
    {
        if (ThemeService == null) return "";
        return ThemeService.CurrentTheme == ThemeMode.Lightest
            ? "color: #0072cf; border-color: #0072cf; border-radius: 12px;"
            : "color: #ffffff; border-color: #ffffff; border-radius: 12px; background-color: transparent !important;";
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    private class CategoryPerformanceModel
    {
        public string CategoryName { get; set; } = "";
        public int CompletionRate { get; set; }
    }
}
