                                   StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                                   FullWidth="true"
                                   OnClick="@(() => _showFilters = !_showFilters)"
                                   Class="@($"filter-toggle-button modern-button mb-2 {GetThemeClass()}")"
                                   Style="@GetFilterButtonStyle()">
                            @(_showFilters ? "Hide Filters" : "Show Filters")
                        </MudButton>
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <div class="date-picker-desktop">
                                    <MudDateRangePicker Label="Date Range"
                                                        @bind-DateRange="_dateRange"
                                                        @bind-DateRange:after="ApplyReportFilters"
                                                        Variant="Variant.Outlined" Margin="Margin.Dense"
                                                        AnchorOrigin="Origin.BottomCenter"
                                                        TransformOrigin="Origin.TopCenter" />
