                                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" Class="mt-2 rounded-lg" FullWidth="true">Continue</MudButton>
                            </ItemContent>
                        </MudTimelineItem>
                    </MudTimeline>
                </MudPaper>

                <!-- NOTIFICATIONS -->
                <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight: 700; opacity: 0.5; letter-spacing: 1px;">NOTIFICATIONS</MudText>
                <MudList T="string" Dense="true" Clickable="true" DisablePadding="true">
