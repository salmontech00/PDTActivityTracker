@code {
    private bool _isPanelOpen = false;
    private Store? _myStore;
    private List<Store> _stores = new();
    private static StoreHeadLanding? _instance;
    private bool _mapInitialized = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;
        _instance = this;
    }

    private void OnThemeChanged() => StateHasChanged();

    public async ValueTask DisposeAsync()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        _instance = null;
        try
        {
            await JSRuntime.InvokeVoidAsync("leafletMap.destroy");
            _mapInitialized = false;
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserState.InitializeAsync();
            await LoadData();
            // Small delay to ensure DOM is ready
            await Task.Delay(100);
            await InitializeMap();

            // Initial data is loaded, map will be initialized below
            StateHasChanged();
        }
        else if (!_mapInitialized && _stores.Any())
        {
            // Re-initialize if map was destroyed or not initialized
            await Task.Delay(100);
            await InitializeMap();
        }
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var userId = UserState.UserId;
        _stores = await db.Stores.AsNoTracking().ToListAsync();
        _myStore = _stores.FirstOrDefault(s => s.StoreHeadId == userId);
    }

    private async Task InitializeMap()
    {
        if (!_stores.Any()) return;

        var mapData = _stores.Select(s => new
        {
            id = s.Id,
            gpsLatitude = s.GPSLatitude,
            gpsLongitude = s.GPSLongitude,
            storeName = s.StoreName,
            storeCode = s.StoreCode,
            isMyStore = s.StoreHeadId == UserState.UserId
        }).ToList();

        try
        {
            // Destroy existing map first to ensure clean initialization
            await JSRuntime.InvokeVoidAsync("leafletMap.destroy");
            await Task.Delay(50);

            // Re-enable intelligent centering on reload with zoom control
            await JSRuntime.InvokeVoidAsync("leafletMap.initialize", "map", mapData, new { fitBounds = true, maxZoom = 8 });
            _mapInitialized = true;

            // Force map resize after initialization
            await Task.Delay(200);
            await JSRuntime.InvokeVoidAsync("eval", "if(window.leafletMap && mapInstance) { mapInstance.invalidateSize(); }");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Map initialization error: {ex.Message}");
            _mapInitialized = false;
        }
    }

    private async Task CenterOnStore(Store? store)
    {
        if (store?.GPSLatitude != null && store?.GPSLongitude != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("leafletMap.focusMarker", store.GPSLatitude.Value, store.GPSLongitude.Value, 16);
            }
            catch { }
        }
    }

    private int? _selectedStoreId;

    [JSInvokable("OnStorePinClicked")]
    public static void OnStorePinClicked(int storeId)
    {
        if (_instance != null)
        {
            _instance._selectedStoreId = storeId;
            _instance._isPanelOpen = true;
            _instance.StateHasChanged();

            // Trigger map resize after layout change
            _ = _instance.TriggerMapResize();
        }
    }

    private Store? GetSelectedStore()
    {
        if (!_selectedStoreId.HasValue) return null;
        return _stores.FirstOrDefault(s => s.Id == _selectedStoreId.Value);
    }

    private void ClosePanel()
    {
        _isPanelOpen = false;
        _selectedStoreId = null;
        _ = TriggerMapResize();
    }

    private async Task TriggerMapResize()
    {
        await Task.Delay(350); // Wait for CSS transitions (0.3s)
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "if(window.leafletMap && mapInstance) { mapInstance.invalidateSize(); }");

            // Re-center after resize to ensure the pin is in the middle of the new viewport
            var selectedStore = GetSelectedStore();
            if (selectedStore != null)
            {
                await CenterOnStore(selectedStore);
            }
        }
        catch { }
    }

    private void NavigateToPlanner()
    {
        if (_myStore != null)
        {
            NavigationManager.NavigateTo($"/store-head/planner/{_myStore.Id}");
        }
        else
        {
            Snackbar.Add("No store assigned to your account.", Severity.Error);
        }
    }

    private string GetThemeClass() => ThemeService.CurrentTheme switch
    {
        ThemeMode.Lightest => "lightest",
        ThemeMode.Light => "light",
        ThemeMode.Dark => "dark",
        _ => "lightest"
    };

    private string GetLegendTextColor() => ThemeService.CurrentTheme == ThemeMode.Lightest ? "#0f172a" : "#ffffff";

    private string GetCardStyle(string type)
    {
        var isLight = ThemeService.CurrentTheme == ThemeMode.Light || ThemeService.CurrentTheme == ThemeMode.Lightest;
        var bg = type == "success" ? (isLight ? "rgba(255, 255, 255, 0.15)" : "rgba(255, 255, 255, 0.15)")
                                   : (isLight ? "rgba(255, 255, 255, 0.15)" : "rgba(255, 255, 255, 0.15)");
        return $"background: {bg}; border: 1px solid {(type == "success" ? "rgba(255, 255, 255, 0.15)" : "rgba(255, 255, 255, 0.15)")};";
    }

    private string GetButtonStyle() => ThemeService.CurrentTheme == ThemeMode.Light ? "background-color: #ffffff !important; color: #0072cf !important;" : "";
}