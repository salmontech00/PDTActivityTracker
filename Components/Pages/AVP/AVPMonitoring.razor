                                        @if (!string.IsNullOrEmpty(metric.ImagePath))
                                        {
                                            <img src="@metric.ImagePath" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Style="color: white !important;" />
                                        }
                                    </MudAvatar>
                                    <MudText Style="font-weight: 600;">@metric.Name</MudText>
                                </div>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@GetStatusColorFromCompliance(metric.ComplianceRate)"
                                         Variant="Variant.Filled" Style="font-weight: 700;">
                                    @GetStatusLabelFromCompliance(metric.ComplianceRate)
                                </MudChip>
                            </div>
                            <div class="mobile-card-content">
                                <MudGrid Spacing="1">
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.caption" Style="opacity: 0.6;">Managed Stores</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@metric.TotalStores</MudText>
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.caption" Style="opacity: 0.6;">Active Today</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@metric.ActiveToday</MudText>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <div class="d-flex align-center justify-space-between mb-1">
                                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">Avg. Compliance</MudText>
                                            <MudText Typo="Typo.caption" Style="font-weight: 700;">@((int)metric.ComplianceRate)%</MudText>
                                        </div>
                                        <MudProgressLinear Color="@GetProgressColor(metric.ComplianceRate)" Value="@metric.ComplianceRate" Rounded="true" Size="Size.Small" />
                                    </MudItem>
                                </MudGrid>
                            </div>
                        </MudPaper>
                    }
                }
            </MudPaper>

        </div>
        }
</div>

@code {
    private bool _initialized = false;
    private int _avgProgress = 0;
    private int _activeOperations = 0;
    private bool _showFilters = false;
    private bool _showPhotoFilters = false;
    private string _activeSection = "activity";

    private List<StoreDailyActivity> _allActivities = new();
    private List<StoreDailyActivity> _filteredActivities = new();
    private List<TaskPhoto> _allPhotos = new();
    private List<TaskPhoto> _filteredPhotos = new();
    private int _totalPhotosCount = 0;
    private int _photoPageSize = 24;
    private int _photoCurrentPage = 1;
    private int _photoTotalMatchingCount = 0;
    private List<Store> _stores = new();
    private List<AreaHeadMetric> _areaHeadMetrics = new();
    private Store? _selectedStore;
    private Store? _photoStore;
    private string _photoSearchTerm = "";
    private int? _photoCategoryFilter;
    private List<Category> _categoriesList = new();
    private string _storeSearchString = "";
    private string? _selectedStatus;
    private string? _selectedReviewStatus;

    private DateRange _dateRange = new DateRange(DateTime.Today.AddDays(-30), DateTime.Today);
    private DateRange _photoDateRange = new DateRange(DateTime.Today.AddDays(-30), DateTime.Today);
    private Dictionary<int, PDTActivityTracker.Components.Services.ActivityProgressHelper.ActivityProgressResult> _progressCache = new();

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private string GetNavButtonStyle(string section)
    {
        var isActive = _activeSection == section;
        var isLightest = GetThemeClass() == "lightest";
        var baseStyle = "border-radius:12px; font-size:0.70rem; font-weight:600;";
        var colorStyle = !isActive && !isLightest ? " color:#ffffff; border-color:rgba(255,255,255,0.5);" : "";
        return baseStyle + colorStyle;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await UserState.InitializeAsync();
            if (UserState.Role != "AVP" && UserState.Role != "Admin")
            {
                NavigationManager.NavigateTo(UserState.LastValidPage ?? UserState.GetDashboardRoute(), forceLoad: true);
                return;
            }
            await UserState.SetLastValidPage(NavigationManager.Uri);

            await LoadData();
            _initialized = true;
            StateHasChanged();
        }
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        _stores = await db.Stores.Where(s => !s.IsDeleted).AsNoTracking()
            .Include(s => s.AreaHead)
            .Include(s => s.StoreHead)
            .ToListAsync();

        _categoriesList = await db.Categories.AsNoTracking().OrderBy(c => c.SortOrder).ToListAsync();

        _allActivities = await db.StoreDailyActivities.AsNoTracking()
            .Include(a => a.Store!).ThenInclude(s => s!.AreaHead!)
            .Include(a => a.StartedBy!)
            .OrderByDescending(a => a.Date)
            .ToListAsync();

        _totalPhotosCount = await db.TaskPhotos.CountAsync();

        var today = DateTime.Today;
        bool isMonday = today.DayOfWeek == DayOfWeek.Monday;
        bool isFirstOfMonth = today.Day == 1;

        var checklistItems = await db.ChecklistItems
            .AsNoTracking()
            .Where(i => i.Frequency == "Daily" ||
                        (i.Frequency == "Weekly" && isMonday) ||
                        (i.Frequency == "Monthly" && isFirstOfMonth))
            .ToListAsync();

        _progressCache = await PDTActivityTracker.Components.Services.ActivityProgressHelper.CalculateProgressForActivitiesAsync(_allActivities, db);

        // Calculate Area Head Metrics
        var areaHeads = await db.Users.AsNoTracking().Where(u => u.Role == "Area Head").ToListAsync();
        var todayActivities = _allActivities.Where(a => a.Date.Date == today).ToList();

        _areaHeadMetrics = new List<AreaHeadMetric>();
        foreach (var ah in areaHeads)
        {
            var ahStores = _stores.Where(s => s.AreaHeadId == ah.Id).ToList();
            var ahActive = todayActivities.Count(a => a.Store?.AreaHeadId == ah.Id);
            
            double ahProgressSum = 0;
            foreach (var store in ahStores)
            {
                var activity = todayActivities.OrderByDescending(a => a.Id).FirstOrDefault(a => a.StoreId == store.Id);
                if (activity != null && _progressCache.TryGetValue(activity.Id, out var p))
                {
                    ahProgressSum += p.CompletionPercentage;
                }
            }
            var compliance = ahStores.Count > 0 ? (int)(ahProgressSum / ahStores.Count) : 0;

            var imagePath = ah.ImageData != null && !string.IsNullOrEmpty(ah.ImageMimeType)
                ? $"data:{ah.ImageMimeType};base64,{Convert.ToBase64String(ah.ImageData)}"
                : null;

            _areaHeadMetrics.Add(new AreaHeadMetric
            {
                Name = ah.Fullname,
                ImagePath = imagePath,
                TotalStores = ahStores.Count,
                ActiveToday = ahActive,
                ComplianceRate = compliance
            });
        }

        var totalStoresCount = _stores.Count;
        _activeOperations = todayActivities.Select(a => a.StoreId).Distinct().Count();
        _avgProgress = _areaHeadMetrics.Any() ? (int)_areaHeadMetrics.Average(m => m.ComplianceRate) : 0;

        FilterData();
        await FilterPhotos();
    }

    private void FilterData()
    {
        _filteredActivities = _allActivities
            .Where(a => (_dateRange.Start == null || a.Date.Date >= _dateRange.Start.Value.Date) &&
                        (_dateRange.End == null || a.Date.Date <= _dateRange.End.Value.Date))
            .ToList();

        if (_selectedStore != null)
        {
            _filteredActivities = _filteredActivities.Where(a => a.StoreId == _selectedStore.Id).ToList();
        }

        if (!string.IsNullOrEmpty(_selectedStatus))
        {
            _filteredActivities = _filteredActivities.Where(a => GetStatusLabel(a) == _selectedStatus).ToList();
        }

        if (!string.IsNullOrEmpty(_selectedReviewStatus))
        {
            _filteredActivities = _filteredActivities.Where(a => 
                (_selectedReviewStatus == "Reviewed" && a.AreaHeadReviewedAt.HasValue) ||
                (_selectedReviewStatus == "Pending" && !a.AreaHeadReviewedAt.HasValue)).ToList();
        }
    }

    private bool HasActiveReportFilters() =>
        _dateRange.Start.HasValue || _dateRange.End.HasValue ||
        _selectedStore != null ||
        !string.IsNullOrEmpty(_selectedStatus) ||
        !string.IsNullOrEmpty(_selectedReviewStatus);

    private void ClearReportFilters()
    {
        _dateRange = new DateRange();
        _selectedStore = null;
        _selectedStatus = null;
        _selectedReviewStatus = null;
        FilterData();
    }

    private bool HasPhotoFilters() =>
        !string.IsNullOrEmpty(_photoSearchTerm) ||
        _photoStore != null ||
        _photoCategoryFilter != null ||
        _photoDateRange.Start.HasValue || _photoDateRange.End.HasValue;

    private async Task ClearPhotoFilters()
    {
        _photoSearchTerm = "";
        _photoStore = null;
        _photoCategoryFilter = null;
        _photoDateRange = new DateRange();
        await FilterPhotos(true);
    }

    private async Task FilterPhotos(bool resetPage = true)
    {
        if (resetPage)
        {
            _photoCurrentPage = 1;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var query = db.TaskPhotos.AsNoTracking()
            .Include(p => p.Category)
            .Include(p => p.UploadedBy)
            .Include(p => p.Store)
            .Include(p => p.ChecklistItem)
                .ThenInclude(c => c!.Category)
            .Include(p => p.StoreDailyActivity)
                .ThenInclude(s => s!.Store)
            .Include(p => p.StoreDailyActivity)
                .ThenInclude(s => s!.StartedBy)
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(_photoSearchTerm))
        {
            var term = _photoSearchTerm.ToLower();
            query = query.Where(p =>
                (p.Description != null && p.Description.ToLower().Contains(term)) ||
                (p.ChecklistItem != null && p.ChecklistItem.TaskName != null && p.ChecklistItem.TaskName.ToLower().Contains(term)) ||
                (p.ChecklistItem != null && p.ChecklistItem.Description != null && p.ChecklistItem.Description.ToLower().Contains(term)) ||
                (p.UploadedBy != null && p.UploadedBy.Fullname != null && p.UploadedBy.Fullname.ToLower().Contains(term)) ||
                (p.Store != null && p.Store.StoreName.ToLower().Contains(term))
            );
        }

        if (_photoStore != null)
            query = query.Where(p => p.StoreId == _photoStore.Id);

        if (_photoCategoryFilter.HasValue)
            query = query.Where(p => p.CategoryId == _photoCategoryFilter.Value);

        if (_photoDateRange.Start != null)
            query = query.Where(p => p.UploadedAt >= _photoDateRange.Start.Value);

        if (_photoDateRange.End != null)
            query = query.Where(p => p.UploadedAt <= _photoDateRange.End.Value.AddDays(1));

        _photoTotalMatchingCount = await query.CountAsync();

        _filteredPhotos = await query
            .OrderByDescending(p => p.UploadedAt)
            .Skip((_photoCurrentPage - 1) * _photoPageSize)
            .Take(_photoPageSize)
            .ToListAsync();
            
        StateHasChanged();
    }

    private Task<IEnumerable<Store>> SearchStores(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return Task.FromResult<IEnumerable<Store>>(_stores);
        return Task.FromResult(_stores.Where(x => x.StoreName.Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
                                 x.StoreCode.Contains(value, StringComparison.InvariantCultureIgnoreCase)));
    }

    private void OnStoreSelected(Store s)
    {
        _selectedStore = s;
        FilterData();
    }

    private async Task OnPhotoStoreSelected(Store s)
    {
        _photoStore = s;
        await FilterPhotos();
    }

    private async Task OnPhotoPageChanged(int newPage)
    {
        _photoCurrentPage = newPage;
        await FilterPhotos(resetPage: false);
    }

    private string GetStatusLabel(StoreDailyActivity a)
    {
        return _progressCache.TryGetValue(a.Id, out var val) ? val.StatusLabel : "Not Started";
    }
    
    private Color GetStatusColor(StoreDailyActivity a)
    {
        return _progressCache.TryGetValue(a.Id, out var val) && Enum.TryParse<Color>(val.StatusColor, out var color) ? color : Color.Default;
    }
    
    private double GetProgress(StoreDailyActivity a) => _progressCache.TryGetValue(a.Id, out var val) ? val.CompletionPercentage : 0;

    private string GetActivityCompletedAt(StoreDailyActivity activity)
    {
        if (activity.CompletedAt.HasValue)
            return activity.CompletedAt.Value.ToString("hh:mm tt");

        var cached = _progressCache.GetValueOrDefault(activity.Id);
        if (cached != null && cached.IsFullyCompleted && cached.LastCategoryCompletedAt.HasValue)
            return cached.LastCategoryCompletedAt.Value.ToString("hh:mm tt");

        return "-";
    }

    private string GetThemeClass() => ThemeService.CurrentTheme switch
    {
        ThemeMode.Lightest => "lightest",
        ThemeMode.Light => "light",
        ThemeMode.Dark => "dark",
        _ => "light"
    };

    private bool StoreQuickFilter(Store x) => SearchValues(x, _storeSearchString);

    private bool SearchValues(Store x, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (x.StoreName.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.StoreCode.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Location.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.StoreHead?.Fullname?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (x.AreaHead?.Fullname?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        return false;
    }

    private Color GetProgressColor(double value) => value switch
    {
        >= 90 => Color.Success,
        >= 70 => Color.Info,
        >= 50 => Color.Warning,
        _ => Color.Error
    };

    private Color GetStatusColorFromCompliance(double value) => value switch
    {
        >= 90 => Color.Success,
        >= 70 => Color.Info,
        _ => Color.Warning
    };

    private Color GetAvatarColor()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => Color.Primary,
            _ => Color.Inherit
        };
    }

    private string GetStatusLabelFromCompliance(double value) => value switch
    {
        >= 90 => "Excellent",
        >= 70 => "Target Met",
        _ => "Needs Focus"
    };

    public class AreaHeadMetric
    {
        public string Name { get; set; } = "";
        public string? ImagePath { get; set; }
        public int TotalStores { get; set; }
        public int ActiveToday { get; set; }
        public double ComplianceRate { get; set; }
    }

    private string GetHeaderButtonStyle() => ThemeService.CurrentTheme switch
    {
        ThemeMode.Lightest => "background: #0072cf; color: white;",
        ThemeMode.Light => "background: white; color: #0072cf; border: 1px solid rgba(255,255,255,0.3);",
        _ => "background: #0072cf; color: white;"
    };

    private async Task ViewDetails(StoreDailyActivity a)
    {
        var parameters = new DialogParameters { ["Activity"] = a };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<PDTActivityTracker.Components.Pages.Dialogs.ActivityDetailDialog>("Activity Details", parameters, options);
    }

    private async Task OpenPhotoDetails(TaskPhoto p)
    {
        var parameters = new DialogParameters { ["Photo"] = p };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<PDTActivityTracker.Components.Pages.Dialogs.PhotoGalleryDialog>("Photo Details", parameters, options);
    }

    private async Task OpenStoreDetails(Store s)
    {
        var parameters = new DialogParameters { ["StoreToView"] = s };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<PDTActivityTracker.Components.Pages.Dialogs.ViewStoreDialog>("Store Details", parameters, options);
    }

    private void ExportData()
    {
        Snackbar.Add("Feature coming soon...", Severity.Info);
    }

    private string GetFilterButtonStyle()
    {
        if (ThemeService == null) return "";
        return ThemeService.CurrentTheme == ThemeMode.Lightest
            ? "color: #0072cf; border-color: #0072cf; border-radius: 12px;"
            : "color: #ffffff; border-color: #ffffff; border-radius: 12px; background-color: transparent !important;";
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }
    private bool IsTaskAssignedToStore(ChecklistItem task, int storeId)
    {
        // Only Manpower tasks have store-specific visibility logic
        if (task.TaskType != "Manpower") return true;

        if (string.IsNullOrWhiteSpace(task.SelectedStores)) return false;
        try
        {
            var ids = JsonSerializer.Deserialize<List<int>>(task.SelectedStores);
            return ids != null && ids.Contains(storeId);
        }
        catch { return false; }
    }
