@using PDTActivityTracker.Components.Services
@inject UserStateService UserState
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@implements IDisposable

<style>
    .mud-navmenu .mud-nav-link.active {
        color: #0072cf !important;
        background-color: rgba(0, 114, 207, 0.1);
        font-weight: 600;
        border-right: 3px solid #0072cf;
    }

        .mud-navmenu .mud-nav-link.active .mud-icon-root {
            color: #0072cf !important;
        }

    .mud-nav-link:hover {
        background-color: rgba(0, 114, 207, 0.05);
    }

    .nav-section-header-v2 {
        padding: 16px 16px 8px 24px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.8;
    }
</style>

<MudNavMenu>
    @if (UserState.Role == "Admin")
    {
        <div class="nav-section-header-v2" style="color: @GetMenuHeaderColor();">Admin V2</div>

        <!-- Placeholder for V2 Dashboard if created later, or link to V1 -->
        <MudNavLink Href="/admin/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Dashboard">
            Dashboard
        </MudNavLink>

        <!-- V2 Users Link -->
        <MudNavLink Href="/admin/users" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.People">
            Manage Users
        </MudNavLink>

        <MudNavLink Href="/admin/students" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.School">
            Students
        </MudNavLink>
        <MudNavLink Href="/admin/subjects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.LibraryBooks">
            Subjects
        </MudNavLink>
        <MudNavLink Href="/admin/transactions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.ReceiptLong">
            Transactions
        </MudNavLink>
    }
    else if (UserState.Role == "Cashier")
    {
        <div class="nav-section-header-v2" style="color: @GetMenuHeaderColor();">Cashier</div>
        <MudNavLink Href="/cashier/students" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.School">
            Students
        </MudNavLink>
        <MudNavLink Href="/cashier/payments" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Payment">
            Payments
        </MudNavLink>
        <MudNavLink Href="/cashier/transactions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Receipt">
            Transactions
        </MudNavLink>
    }
    else
    {
        <div class="nav-section-header-v2" style="color: @GetMenuHeaderColor();">Faculty</div>
        <MudNavLink Href="/faculty/validate-exam-permit" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.VerifiedUser">
            Validate Permit
        </MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    private string GetMenuHeaderColor()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#64748b",
            ThemeMode.Light => "rgba(255,255,255,0.7)",
            ThemeMode.Dark => "#94a3b8",
            _ => "#64748b"
        };
    }
}
