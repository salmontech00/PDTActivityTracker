@using PDTActivityTracker.Components.Services
@inject UserStateService UserState
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@implements IDisposable

<style>
    .mud-navmenu .mud-nav-link.active {
        color: var(--nav-active-color, #0072cf) !important;
        background-color: var(--nav-active-bg, rgba(0, 114, 207, 0.1)) !important;
        font-weight: 700;
        border-right: 3px solid var(--nav-active-color, #0072cf);
    }

        .mud-navmenu .mud-nav-link.active .mud-icon-root {
            color: var(--nav-active-color, #0072cf) !important;
        }

    .mud-nav-link:hover {
        background-color: var(--nav-hover-bg, rgba(0, 114, 207, 0.05)) !important;
    }

    /* Theme-specific overrides */
    html.theme-light .mud-navmenu .mud-nav-link.active {
        --nav-active-color: #ffffff;
        --nav-active-bg: rgba(255, 255, 255, 0.15);
    }

    html.theme-light .mud-nav-link:hover {
        --nav-hover-bg: rgba(255, 255, 255, 0.1);
    }

    html.theme-dark .mud-navmenu .mud-nav-link.active {
        --nav-active-color: #0072cf;
        --nav-active-bg: rgba(0, 114, 207, 0.1);
    }

    .nav-section-header-v2 {
        padding: 16px 16px 8px 24px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.8;
        color: #64748b; /* Default/Lightest */
    }

    html.theme-light .nav-section-header-v2 {
        color: rgba(255, 255, 255, 0.7);
    }

    html.theme-dark .nav-section-header-v2 {
        color: #94a3b8;
    }

    @@media (max-width: 960px) {
        .nav-section-header-v2 {
            display: none !important;
        }
    }

    @@media (max-width: 960px) {
        .nav-section-header-v2 {
            display: none !important;
        }
    }
</style>

<MudNavMenu>
    <div class="nav-section-header-v2" style="color: @GetMenuColor()">Menu</div>
    @if (UserState.Role == "User")
    {
        <MudNavLink Href="/user/request-role" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.AdminPanelSettings">
            Request Role
        </MudNavLink>
    }

    @if (UserState.Role == "Admin")
    {
        <MudNavLink Href="/admin/reports-monitoring" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Assessment">
            Reports & Monitoring
        </MudNavLink>
        <MudNavLink Href="/admin/checklist" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.PlaylistAddCheck">
            Manage Activity Planner
        </MudNavLink>
        <MudNavLink Href="/admin/store-assignment" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Store">
            Manage Stores
        </MudNavLink>
    }

    @if (UserState.Role == "Store Head")
    {
        <MudNavLink Href="/store-head/map" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Map">
            Store Maps
        </MudNavLink>
        <MudNavLink Href="/store-head/monitoring" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Analytics">
            Reports & Monitoring
        </MudNavLink>
    }

    @if (UserState.Role == "Area Head")
    {
        <MudNavLink Href="/area-head/map" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Map">
            Store Maps
        </MudNavLink>
        <MudNavLink Href="/area-head/monitoring" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Assessment">
            Reports & Monitoring
        </MudNavLink>
    }

    @if (UserState.Role == "AVP")
    {
        <MudNavLink Href="/avp/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Dashboard">
            Dashboard Overview
        </MudNavLink>
        <MudNavLink Href="/avp/monitoring" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Assessment">
            Reports & Monitoring
        </MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        StateHasChanged();
    }

    private string GetMenuColor()
    {
        if (ThemeService == null) return "#64748b";
        return ThemeService.CurrentTheme == ThemeMode.Lightest ? "#64748b" : "rgba(255, 255, 255, 0.7)";
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }
}
