@using PDTActivityTracker.Components.Pages.Dialogs
@using Microsoft.EntityFrameworkCore
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject IDialogService DialogService
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@using PDTActivityTracker.Components.Services
@implements IDisposable

<style>
    .desktop-nav {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .desktop-drawer {
        display: block;
    }

    .mobile-menu-toggle {
        display: none;
    }

    .mobile-drawer {
    }

    .appbar-text {
        display: flex;
        align-items: center;
        gap: 0px;
    }

        .appbar-text img {
            width: 100px !important;
            height: 100px !important;
            object-fit: contain;
            margin: 0px !important;
            padding: 0px !important;
        }

        .appbar-text .mud-typography {
            font-weight: bold;
        }

    .mud-drawer .mud-nav-link.active {
        color: #0072cf !important;
    }

        .mud-drawer .mud-nav-link.active .mud-icon-root {
            color: #0072cf !important;
        }
    /* MINI LOGO STYLES */
    .logo-main-small {
        font-family: 'Inter', sans-serif;
        font-weight: 800;
        font-size: 1.87rem;
        line-height: 0.9;
        letter-spacing: -1px;
    }

    .logo-sub-small {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        line-height: 1;
        margin: 0px !important;
    }

    @@media (max-width: 600px) {
        .appbar-text {
            gap: 0px;
        }

            .appbar-text img {
                width: 70px !important;
                height: 70px !important;
            }

            .appbar-text .mud-typography {
                font-size: 0.95rem !important;
                font-weight: 600;
            }

        .desktop-nav {
            display: none !important;
        }

        .desktop-drawer {
            display: none !important;
        }

        .mobile-menu-toggle {
            display: flex !important;
            align-items: center;
            gap: 4px;
        }

        .mobile-drawer {
            max-width: 250px !important;
        }

        .user-profile-section {
            gap: 4px !important;
        }

            .user-profile-section img {
                width: 25px !important;
                height: 25px !important;
            }

            .user-profile-section .mud-typography {
                display: none !important;
            }

        .mud-appbar .mud-icon-button {
            padding: 8px !important;
        }

            .mud-appbar .mud-icon-button svg {
                width: 24px !important;
                height: 24px !important;
            }
        /* MINI LOGO STYLES */
        .logo-main-small {
            font-family: 'Inter', sans-serif;
            font-weight: 800;
            font-size: 1.4rem;
            line-height: 1;
            letter-spacing: -1px;
        }

        .logo-sub-small {
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: 0.6rem;
            letter-spacing: 0.15em;
            line-height: 1;
            margin: 0px !important;
        }
    }

    @@media (max-width: 375px) {
        /* MINI LOGO STYLES */
        .logo-main-small {
            font-family: 'Inter', sans-serif;
            font-weight: 800;
            font-size: 1.57rem;
            line-height: 1;
            letter-spacing: -1px;
        }

        .logo-sub-small {
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: 0.6rem;
            letter-spacing: 0.15em;
            line-height: 1;
            margin: 0px !important;
        }

        /* MAKE APPBAR ICONS SLIGHTLY LARGER ON NARROWEST SCREENS */
        .mud-appbar .mud-icon-button {
            padding: 10px !important;
        }

            .mud-appbar .mud-icon-button svg {
                width: 28px !important;
                height: 28px !important;
            }
    }

    /* GLASSMORPHISM STYLES */
    .admin-appbar-lightest {
        background-color: rgba(255, 255, 255, 0.15) !important;
        backdrop-filter: blur(15px);
        border-bottom: 1px solid #0072cf;
    }

    .admin-appbar-light {
        background-color: rgba(255, 255, 255, 0.15) !important;
        backdrop-filter: blur(15px);
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .admin-appbar-dark {
        background-color: rgba(30, 41, 59, 0.15) !important;
        backdrop-filter: blur(15px);
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    /* DRAWER STYLES */
    /* Target the drawer content specifically to apply the background */
    .admin-drawer-lightest .mud-drawer-content {
        background-color: rgba(255, 255, 255, 0.15) !important;
        backdrop-filter: blur(15px);
    }

    .desktop-drawer.admin-drawer-lightest .mud-drawer-content {
        border-right: 1px solid #0072cf;
    }

    .mobile-drawer.admin-drawer-lightest .mud-drawer-content {
        border-left: 1px solid #0072cf;
    }

    .admin-drawer-light .mud-drawer-content {
        background-color: rgba(255, 255, 255, 0.15) !important;
        backdrop-filter: blur(15px);
    }

    .desktop-drawer.admin-drawer-light .mud-drawer-content {
        border-right: 1px solid rgba(255,255,255,0.2);
    }

    .mobile-drawer.admin-drawer-light .mud-drawer-content {
        border-left: 1px solid rgba(255,255,255,0.2);
    }

    .admin-drawer-dark .mud-drawer-content {
        background-color: rgba(30, 41, 59, 0.15) !important;
        backdrop-filter: blur(15px);
    }

    .desktop-drawer.admin-drawer-dark .mud-drawer-content {
        border-right: 1px solid rgba(255,255,255,0.05);
    }

    .mobile-drawer.admin-drawer-dark .mud-drawer-content {
        border-left: 1px solid rgba(255,255,255,0.05);
    }

    .main-background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        z-index: -1;
        transition: all 0.5s ease;
    }

        .main-background.light {
            background-image: linear-gradient(135deg, rgba(0, 114, 207, 1), rgba(0, 71, 130, 0.3)), url('/BG/MainBG.png');
        }

        .main-background.dark {
            background-image: linear-gradient(135deg, rgba(15, 23, 42, 1), rgba(2, 6, 23, 0.3)), url('/BG/MainBG.png');
        }

        .main-background.lightest {
            background-image: linear-gradient(135deg, rgba(248, 250, 252, 1), rgba(226, 232, 240, 0.3)), url('/BG/MainBG.png');
        }

    .mud-layout {
        background: transparent !important;
    }

    /* MINI DRAWER AUTO HIDE SECTIONS & DIVIDERS (DESKTOP ONLY) */
    .desktop-drawer.mud-drawer--closed .nav-section-header-v2,
    .desktop-drawer.mud-drawer--closed .mud-divider {
        display: none !important;
    }

    /* COMPLETELY ISOLATE MOBILE VIEWS FROM DESKTOP MINI DRAWER MARGIN/PADDING SHIFTS */
    @@media (max-width: 959.98px) {
        .mud-main-content {
            padding-left: 16px !important;
            padding-right: 16px !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
        }
    }

</style>

@if (_isCheckingAuth)
{
    <MudThemeProvider Theme="@_theme" IsDarkMode="@(ThemeService.CurrentTheme == ThemeMode.Dark)" />
    <MudLayout>
        <MudMainContent>
            <div style="@GetLoadingContainerStyle()">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" Style="@GetLoadingSpinnerStyle()" />
            </div>
        </MudMainContent>
    </MudLayout>
}
else if (!_isAuthenticated)
{
    <!-- This will never show because we redirect -->
}
else
{
    <MudThemeProvider Theme="@_theme" IsDarkMode="@(ThemeService.CurrentTheme == ThemeMode.Dark)" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <div class="@GetBackgroundClass()"></div>
        <MudAppBar Elevation="1" Class="@GetAppBarClass()">
            <div class="desktop-nav">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="@((e) => DrawerToggle())" />
            </div>
            <div class="appbar-text">
                <img src="/logo/LCClogo.png"
                     alt="Logo" />
                <div class="d-flex flex-column justify-center ml-2">
                    <span class="logo-main-small" style="@GetLogoMainStyle()">SMR</span>
                    <span class="logo-sub-small" style="@GetLogoSubStyle()">ACTIVITY TRACKER</span>
                </div>
            </div>
            <MudSpacer />

            <div class="desktop-nav">
                <div class="d-flex align-center mr-2 user-profile-section" style="gap: 8px;">
                    <MudAvatar Size="Size.Small" Color="GetAvatarColor()" @onclick="OpenProfilePreviewDialog" Style="cursor: pointer;">
                        @if (!string.IsNullOrEmpty(_userImagePath))
                        {
                            <MudImage Src="@_userImagePath" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                        }
                    </MudAvatar>
                    <MudText Typo="Typo.subtitle2" @onclick="@(async () => await OpenUpdateAccountDialog())" Style="cursor: pointer;">@UserState.Username</MudText>
                </div>

                <MudIconButton Icon="@DarkLightModeButtonIcon"
                               Color="Color.Inherit"
                               OnClick="@DarkModeToggle" />
                <MudIconButton Icon="@Icons.Material.Outlined.Logout"
                               Color="Color.Inherit"
                               Edge="Edge.End"
                               OnClick="Logout" />
            </div>

            <div class="mobile-menu-toggle">
                <MudAvatar Size="Size.Small" Color="GetAvatarColor()" @onclick="OpenProfilePreviewDialog" Style="cursor: pointer;" Class="mr-1">
                    @if (!string.IsNullOrEmpty(_userImagePath))
                    {
                        <MudImage Src="@_userImagePath" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                    }
                </MudAvatar>

                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               OnClick="@ToggleMobileDrawer" />
            </div>
        </MudAppBar>

        <MudDrawer id="nav-drawer"
                   @bind-Open="_drawerOpen"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="2"
                   Variant="DrawerVariant.Mini"
                   Class="@($"desktop-drawer {GetDrawerClass()}")">
            <NavMenu />
            <MudDivider Class="my-2" />
            <MudNavMenu>
                @if (UserState.Role == "Admin")
                {
                    <MudNavGroup Title="Administration" Icon="@Icons.Material.Outlined.AdminPanelSettings" Expanded="false">
                        <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.People">
                            Manage Users
                        </MudNavLink>
                    <!--<MudNavLink Href="/admin/settings" Match="NavLinkMatch.All" Icon="Icons.Material.Outlined.Settings">
                            Settings
                         </MudNavLink>-->
                    </MudNavGroup>
                }
            </MudNavMenu>
        </MudDrawer>

        <MudDrawer @bind-Open="_mobileDrawerOpen"
                   Anchor="Anchor.Right"
                   Elevation="2"
                   Variant="DrawerVariant.Temporary"
                   Overlay="true"
                   Class="@($"mobile-drawer {GetDrawerClass()}")">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">Menu</MudText>
            </MudDrawerHeader>
            <MudNavMenu d-flex flex-column style="height: 100%;">
                <!-- Main Links placeholder if needed, NavMenu already has one -->
                <NavMenu />

                <MudSpacer />

                @if (UserState.Role == "Admin")
                {
                    <MudNavGroup Title="Administration" Icon="@Icons.Material.Outlined.AdminPanelSettings" Expanded="false">
                        <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.People" OnClick="@CloseMobileDrawer">
                            Manage Users
                        </MudNavLink>
                    <!--<MudNavLink Href="/admin/settings" Match="NavLinkMatch.All" Icon="Icons.Material.Outlined.Settings" OnClick="CloseMobileDrawer">
                            Settings
                        </MudNavLink>-->
                    </MudNavGroup>
                }

                <MudDivider Class="my-2" Style="border-color: var(--mud-palette-secondary); border-width: 1px;" />

                <MudNavLink OnClick="@(async () => { await OpenUpdateAccountDialog(); CloseMobileDrawer(); })" Icon="@Icons.Material.Outlined.ManageAccounts">
                    Update Account
                </MudNavLink>

                <MudNavLink OnClick="@DarkModeToggleAndClose"
                            Icon="@DarkLightModeButtonIcon">
                    Theme: @GetThemeModeName()
                </MudNavLink>

                <MudNavLink OnClick="@LogoutAndClose"
                            Icon="@Icons.Material.Outlined.Logout">
                    Sign Out
                </MudNavLink>
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent Class="pt-16 pa-4">
            @Body
        </MudMainContent>
    </MudLayout>

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
}

@code {
    private bool _drawerOpen = true;
    private bool _mobileDrawerOpen = false;
    private MudTheme? _theme = null;
    private bool _initialized = false;
    private bool _isCheckingAuth = true;
    private bool _isAuthenticated = false;
    private string? _userImagePath;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        SetTheme();
        ThemeService.OnThemeChanged += OnThemeChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileDrawerOpen = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;

            await ThemeService.InitializeAsync();
            SetTheme();

            var currentUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            if (currentUri.StartsWith("login"))
            {
                _isCheckingAuth = false;
                _isAuthenticated = false;
                StateHasChanged();
                return;
            }

            await UserState.InitializeAsync();

            if (!UserState.IsAuthenticated)
            {
                _isCheckingAuth = false;
                _isAuthenticated = false;
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            using var db = await DbFactory.CreateDbContextAsync();
            var currentUser = await db.Users.FirstOrDefaultAsync(u => u.Username == UserState.Username);

            if (currentUser == null)
            {
                await UserState.Logout();
                _isCheckingAuth = false;
                _isAuthenticated = false;
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            _userImagePath = currentUser.ImageData != null && !string.IsNullOrEmpty(currentUser.ImageMimeType)
                ? $"data:{currentUser.ImageMimeType};base64,{Convert.ToBase64String(currentUser.ImageData)}"
                : null;

            _isCheckingAuth = false;
            _isAuthenticated = true;
            StateHasChanged();
        }
    }

    private void OnThemeChanged()
    {
        SetTheme();
        StateHasChanged();
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task DarkModeToggle()
    {
        await ThemeService.CycleThemeAsync();
    }

    private async Task DarkModeToggleAndClose()
    {
        await ThemeService.CycleThemeAsync();
    }

    private string GetThemeModeName()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "Light",
            ThemeMode.Light => "Default",
            ThemeMode.Dark => "Dark",
            _ => "Light"
        };
    }

    private async Task Logout()
    {
        await UserState.Logout();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    private void ToggleMobileDrawer()
    {
        _mobileDrawerOpen = !_mobileDrawerOpen;
    }

    private void CloseMobileDrawer()
    {
        _mobileDrawerOpen = false;
    }

    private async Task LogoutAndClose()
    {
        CloseMobileDrawer();
        await Logout();
    }

    private Color GetAvatarColor()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => Color.Primary,
            _ => Color.Inherit
        };
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void SetTheme()
    {
        if (ThemeService.CurrentTheme == ThemeMode.Dark)
        {
            _theme = new MudTheme
            {
                PaletteDark = _darkPalette,
                LayoutProperties = new LayoutProperties()
            };
        }
        else
        {
            _theme = new MudTheme
            {
                PaletteLight = ThemeService.CurrentTheme == ThemeMode.Light ? _lightPalette : _lightestPalette,
                LayoutProperties = new LayoutProperties()
            };
        }
    }

    private string GetAppBarClass()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "admin-appbar-lightest",
            ThemeMode.Light => "admin-appbar-light",
            ThemeMode.Dark => "admin-appbar-dark",
            _ => "admin-appbar-lightest"
        };
    }

    private string GetDrawerClass()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "admin-drawer-lightest",
            ThemeMode.Light => "admin-drawer-light",
            ThemeMode.Dark => "admin-drawer-dark",
            _ => "admin-drawer-lightest"
        };
    }

    private string GetBackgroundClass()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "main-background lightest",
            ThemeMode.Light => "main-background light",
            ThemeMode.Dark => "main-background dark",
            _ => "main-background lightest"
        };
    }

    private string GetLogoMainStyle()
    {
        var color = ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0072cf",
            ThemeMode.Light => "#ffffff",
            ThemeMode.Dark => "#ffffff",
            _ => "#0072cf"
        };
        return $"color: {color};";
    }

    private string GetLogoSubStyle()
    {
        var color = ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "#0f172a",
            ThemeMode.Light => "#fdd45c",
            ThemeMode.Dark => "#0072cf",
            _ => "#0f172a"
        };
        return $"color: {color};";
    }

    private string GetLoadingContainerStyle()
    {
        var baseStyle = "display: flex; justify-content: center; align-items: center; height: 100vh;";
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => $"{baseStyle} background-color: #f8fafc;",
            ThemeMode.Light => $"{baseStyle} background-color: #0072cf;",
            ThemeMode.Dark => $"{baseStyle} background-color: #0f172a;",
            _ => $"{baseStyle} background-color: #f8fafc;"
        };
    }

    private string GetLoadingSpinnerStyle()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "color: #0072cf;",
            ThemeMode.Light => "color: #ffffff;",
            ThemeMode.Dark => "color: #0072cf;",
            _ => "color: #0072cf;"
        };
    }

    private readonly PaletteLight _lightestPalette = new()
    {
        Black = "#0f172a",
        AppbarText = "#0072cf",
        AppbarBackground = "#ffffff",
        DrawerBackground = "#ffffff",
        DrawerIcon = "#0072cf",
        DrawerText = "#0072cf",
        GrayLight = "#f1f5f9",
        GrayLighter = "#f8fafc",
        Background = "#ffffff",
        Surface = "#ffffff",
        TextPrimary = "#0f172a",
        TextSecondary = "#475569",
        Primary = "#0072cf",
        Info = "#0072cf",
        Success = "#10b981",
        Warning = "#f59e0b",
        Error = "#ef4444",
        LinesDefault = "#e2e8f0",
        TableLines = "#e2e8f0",
        Divider = "#e2e8f0"
    };

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#0072cf",
        Surface = "#9cc7f0",
        Black = "#ffffff",
        AppbarText = "#FFFFFF",
        AppbarBackground = "#0072cf",
        DrawerBackground = "#0072cf",
        DrawerIcon = "#ffffff",
        DrawerText = "#ffffff",
        ActionDefault = "#ffffff",
        LinesDefault = "rgba(255,255,255, 0.5)",
        Divider = "rgba(255,255,255, 0.2)",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
        Background = "#0072cf",
        TextPrimary = "#ffffff",
        TextSecondary = "#e2e8f0"
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#0072cf",
        Surface = "#1e293b",
        Background = "#0f172a",
        BackgroundGray = "#1e293b",
        AppbarText = "#e2e8f0",
        AppbarBackground = "rgba(15,23,42,0.8)",
        DrawerBackground = "#0f172a",
        ActionDefault = "#94a3b8",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#ffffff",
        TextSecondary = "#cbd5e1",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#cbd5e1",
        DrawerText = "#cbd5e1",
        GrayLight = "#334155",
        GrayLighter = "#1e293b",
        Info = "#0072cf",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#334155",
        TableLines = "#334155",
        Divider = "#334155",
        OverlayLight = "#1e293b80",
    };

    public string DarkLightModeButtonIcon => ThemeService.CurrentTheme switch
    {
        ThemeMode.Lightest => Icons.Material.Outlined.LightMode,
        ThemeMode.Light => Icons.Material.Outlined.DarkMode,
        ThemeMode.Dark => Icons.Material.Rounded.AutoMode,
        _ => Icons.Material.Outlined.LightMode
    };

    private IDialogReference? _updateDialogRef;

    private async Task OpenUpdateAccountDialog()
    {
        if (_updateDialogRef is not null)
        {
            _updateDialogRef.Close();
            _updateDialogRef = null;
            StateHasChanged();
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var currentUser = await db.Users.FirstOrDefaultAsync(u => u.Username == UserState.Username);

        if (currentUser is null)
            return;

        var parameters = new DialogParameters
        {
            { "UserToEdit", currentUser }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        _updateDialogRef = await DialogService.ShowAsync<UpdateAccountForm>("Update Account", parameters, options);
        var result = await _updateDialogRef.Result;

        _updateDialogRef = null;

        if (!(result?.Canceled ?? true))
        {
            using var dbRefresh = await DbFactory.CreateDbContextAsync();
            var updatedUser = await dbRefresh.Users.FirstOrDefaultAsync(u => u.Id == currentUser.Id);
            if (updatedUser != null)
            {
                await UserState.SetUsername(updatedUser.Username);

                _userImagePath = updatedUser.ImageData != null && !string.IsNullOrEmpty(updatedUser.ImageMimeType)
                    ? $"data:{updatedUser.ImageMimeType};base64,{Convert.ToBase64String(updatedUser.ImageData)}"
                    : null;

                StateHasChanged();
            }
        }

        StateHasChanged();
    }

    private async Task OpenProfilePreviewDialog()
    {
        var parameters = new DialogParameters
        {
            { "ImagePath", _userImagePath },
            { "Username", UserState.Username },
            { "Role", UserState.Role }
        };

        var options = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.ExtraSmall,
            NoHeader = true,
            Position = DialogPosition.Center,
            BackdropClick = true,
            FullWidth = false,
        };

        await DialogService.ShowAsync<UserProfilePreview>("", parameters, options);
    }
}