@using PDTActivityTracker.Components.Pages.Dialogs
@using Microsoft.EntityFrameworkCore
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject IDialogService DialogService
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@using PDTActivityTracker.Components.Services
@implements IDisposable

<style>
    .v2-appbar-lightest {
        background: rgba(255, 255, 255, 0.8) !important;
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.05) !important;
        color: #0f172a !important;
    }

    .v2-appbar-light {
        background: rgba(0, 114, 207, 0.8) !important;
        backdrop-filter: blur(12px);
        color: white !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
    }

    .v2-appbar-dark {
        background: rgba(30, 41, 59, 0.8) !important;
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: #f8fafc !important;
    }

    /* Branding & Header */
    .top-logo-section {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .logo-bg {
        background-color: #0072cf;
        padding: 6px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
    }

    .logo-img {
        width: 28px;
        height: 28px;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }

    .v2-drawer-title {
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: -0.025em;
        line-height: 1.2;
    }

    .logo-highlight {
        color: #0072cf;
    }

    html.theme-light .logo-highlight {
        color: #ffffff;
    }

    /* Loading Screen Theme Styling */
    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        transition: background-color 0.3s ease;
    }

    html.theme-lightest .loading-container {
        background-color: #f8fafc;
    }

    html.theme-light .loading-container {
        background-color: #0072cf;
    }

    html.theme-dark .loading-container {
        background-color: #0f172a;
    }

    /* Desktop Navigation */
    .desktop-nav {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .desktop-drawer {
        display: block;
    }

    .mobile-menu-toggle {
        display: none;
    }

    .mobile-drawer {
        display: none;
    }

    @@media (max-width: 600px) {
        .logo-bg {
            width: 32px;
            height: 32px;
            padding: 4px;
        }

        .logo-img {
            width: 22px;
            height: 22px;
        }

        .v2-drawer-title {
            font-size: 1rem;
        }

        .desktop-nav {
            display: none !important;
        }

        .desktop-drawer {
            display: none !important;
        }

        .mobile-menu-toggle {
            display: flex !important;
            align-items: center;
            gap: 4px;
        }

        .mobile-drawer {
            display: block !important;
            max-width: 250px !important;
        }
    }
</style>

@if (_isCheckingAuth)
{
    <MudLayout>
        <MudMainContent>
            <div class="loading-container">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="@(ThemeService.CurrentTheme == ThemeMode.Light ? Color.Surface : Color.Primary)" />
            </div>
        </MudMainContent>
    </MudLayout>
}
else
{
    <MudThemeProvider Theme="@_theme" IsDarkMode="@(ThemeService.CurrentTheme == ThemeMode.Dark)" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="0" Class="@GetAppBarClass()" Fixed="true">
            <div class="desktop-nav">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="@((e) => DrawerToggle())" />
            </div>

            <div class="top-logo-section mx-2">
                <div class="logo-bg">
                    <img src="/PITALOGO.png" class="logo-img" alt="Logo" />
                </div>
                <MudText Class="v2-drawer-title" Color="@GetDrawerTextColor()">SMR <span class="logo-highlight">Activity Tracker</span></MudText>
            </div>

            <MudSpacer />

            <div class="desktop-nav gap-4">
                @if (!string.IsNullOrEmpty(_userImagePath))
                {
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="cursor-pointer">
                        <ActivatorContent>
                            <div class="d-flex align-center cursor-pointer">
                                <MudAvatar Image="@_userImagePath" Size="Size.Medium" />
                                <div class="ml-3">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@UserState.Username</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.8;">@UserState.Role</MudText>
                                </div>
                            </div>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Icon="@Icons.Material.Outlined.Person" OnClick="OpenUpdateAccountDialog">Update Account</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.ZoomIn" OnClick="OpenProfilePreviewDialog">View Large Photo</MudMenuItem>
                            @if (UserState.Role == "Admin")
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.People" OnClick="@(() => NavigationManager.NavigateTo("/"))">Manage Users</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.Settings" OnClick="@(() => NavigationManager.NavigateTo("/admin/settings"))">Settings</MudMenuItem>
                            }
                            <MudDivider Class="my-2" />
                            <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="Logout" Color="Color.Error">Sign Out</MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                }

                <MudIconButton Icon="@DarkLightModeButtonIcon"
                               Color="Color.Inherit"
                               OnClick="@DarkModeToggle" />
            </div>

            <div class="mobile-menu-toggle">
                @if (!string.IsNullOrEmpty(_userImagePath))
                {
                    <MudAvatar Image="@_userImagePath" Size="Size.Small" @onclick="OpenProfilePreviewDialog" Style="cursor: pointer;" />
                }
                <MudIconButton Icon="@DarkLightModeButtonIcon"
                               Color="Color.Inherit"
                               OnClick="@DarkModeToggle" />
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               OnClick="@ToggleMobileDrawer" />
            </div>
        </MudAppBar>

        <!-- Desktop Drawer -->
        <MudDrawer @bind-Open="_drawerOpen"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="0"
                   Variant="DrawerVariant.Responsive"
                   Style="@GetDrawerStyle()"
                   Class="desktop-drawer">
            <NavMenu />
        </MudDrawer>

        <!-- Mobile Drawer -->
        <MudDrawer @bind-Open="_mobileDrawerOpen"
                   Anchor="Anchor.Right"
                   Elevation="2"
                   Variant="DrawerVariant.Temporary"
                   Class="mobile-drawer"
                   Style="@GetDrawerStyle()">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">MENU</MudText>
            </MudDrawerHeader>
            <div class="pa-2">
                <NavMenu />
                <MudDivider Class="my-4" />
                <MudNavLink OnClick="@(async () => { await OpenUpdateAccountDialog(); CloseMobileDrawer(); })"
                            Icon="@Icons.Material.Outlined.ManageAccounts">
                    Update Account
                </MudNavLink>
                @if (UserState.Role == "Admin")
                {
                    <MudNavLink OnClick="@(() => { NavigationManager.NavigateTo("/"); CloseMobileDrawer(); })"
                                Icon="@Icons.Material.Outlined.People">
                        Manage Users
                    </MudNavLink>
                    <MudNavLink OnClick="@(() => { NavigationManager.NavigateTo("/admin/settings"); CloseMobileDrawer(); })"
                                Icon="@Icons.Material.Outlined.Settings">
                        Settings
                    </MudNavLink>
                }
                <MudNavLink OnClick="@LogoutAndClose"
                            Icon="@Icons.Material.Outlined.Logout">
                    Sign Out
                </MudNavLink>
            </div>
        </MudDrawer>

        <MudMainContent Class="pt-16 pa-6" Style="@GetMainContentStyle()">
            @Body
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;
    private bool _mobileDrawerOpen = false;
    private MudTheme? _theme = null;
    private bool _initialized = false;
    private bool _isCheckingAuth = true;
    private string? _userImagePath;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        SetTheme();
        ThemeService.OnThemeChanged += OnThemeChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileDrawerOpen = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;

            await ThemeService.InitializeAsync();
            SetTheme();

            await UserState.InitializeAsync();

            if (!UserState.IsAuthenticated)
            {
                // Redirect to Login V2 if not authenticated
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            // Load user data
            using var db = await DbFactory.CreateDbContextAsync();
            var currentUser = await db.Users.FirstOrDefaultAsync(u => u.Username == UserState.Username);

            if (currentUser == null)
            {
                await UserState.Logout();
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            _userImagePath = currentUser.ImageData != null && !string.IsNullOrEmpty(currentUser.ImageMimeType)
                ? $"data:{currentUser.ImageMimeType};base64,{Convert.ToBase64String(currentUser.ImageData)}"
                : "/Uploads/UserImg.png";

            _isCheckingAuth = false;
            StateHasChanged();
        }
    }

    private void OnThemeChanged()
    {
        SetTheme();
        StateHasChanged();
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task DarkModeToggle()
    {
        await ThemeService.CycleThemeAsync();
    }

    private async Task Logout()
    {
        await UserState.Logout();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void ToggleMobileDrawer()
    {
        _mobileDrawerOpen = !_mobileDrawerOpen;
    }

    private void CloseMobileDrawer()
    {
        _mobileDrawerOpen = false;
    }

    private async Task LogoutAndClose()
    {
        CloseMobileDrawer();
        await Logout();
    }

    private void SetTheme()
    {
        if (ThemeService.CurrentTheme == ThemeMode.Dark)
        {
            _theme = new MudTheme
            {
                PaletteDark = _darkPalette,
                LayoutProperties = new LayoutProperties()
            };
        }
        else
        {
            _theme = new MudTheme
            {
                PaletteLight = ThemeService.CurrentTheme == ThemeMode.Light ? _lightPalette : _lightestPalette,
                LayoutProperties = new LayoutProperties()
            };
        }
    }

    private string GetAppBarClass()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "v2-appbar-lightest",
            ThemeMode.Light => "v2-appbar-light",
            ThemeMode.Dark => "v2-appbar-dark",
            _ => "v2-appbar-lightest"
        };
    }

    private string GetDrawerStyle()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Light => "background-color: #0072cf; color: white;",
            ThemeMode.Dark => "background-color: #1e293b;",
            _ => "background-color: #ffffff;"
        };
    }

    private Color GetDrawerTextColor()
    {
        return ThemeService.CurrentTheme == ThemeMode.Light ? Color.Surface : Color.Inherit;
    }

    private string GetMainContentStyle()
    {
        return ThemeService.CurrentTheme == ThemeMode.Dark ? "background-color: #0f172a;" : "background-color: #f8fafc;";
    }

    private string GetBtnTextStyle()
    {
        return ThemeService.CurrentTheme == ThemeMode.Light ? "color: #0072cf !important; font-weight: 600;" : "font-weight: 600;";
    }

    // Reuse palettes from LoginLayout for consistency
    private readonly PaletteLight _lightestPalette = new()
    {
        Black = "#0f172a",
        AppbarText = "#0072cf",
        AppbarBackground = "#ffffff",
        DrawerBackground = "#ffffff",
        DrawerIcon = "#0072cf",
        DrawerText = "#0072cf",
        GrayLight = "#f1f5f9",
        GrayLighter = "#f8fafc",
        Background = "#f8fafc",
        Surface = "#ffffff",
        TextPrimary = "#0f172a",
        TextSecondary = "#475569",
        Primary = "#0072cf", // Cerulean Blue
        Secondary = "#005bb5",
        Info = "#0072cf",
        Success = "#10b981",
        Warning = "#f59e0b",
        Error = "#ef4444",
        LinesDefault = "#0072cf",
        TableLines = "#0072cf",
        Divider = "#0072cf"
    };

    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#ffffff",
        AppbarText = "#ffffff",
        AppbarBackground = "#0072cf",
        DrawerBackground = "#0072cf",
        GrayLight = "#f1f5f9",
        GrayLighter = "#f8fafc",
        Background = "#0072cf", // Cerulean Blue Background
        Surface = "#0072cf",
        TextPrimary = "#ffffff",
        TextSecondary = "#e2e8f0",
        Primary = "#ffffff",
        ActionDefault = "#ffffff",
        DrawerIcon = "#ffffff",
        DrawerText = "#ffffff",
        ActionDisabled = "rgba(255,255,255,0.5)",
        Divider = "rgba(255,255,255,0.1)"
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#0072cf", // Cerulean Blue
        Surface = "#1e293b",
        Background = "#0f172a",
        BackgroundGray = "#1e293b",
        AppbarText = "#e2e8f0",
        AppbarBackground = "#1e293b",
        DrawerBackground = "#1e293b",
        ActionDefault = "#94a3b8",
        ActionDisabled = "#64748b",
        ActionDisabledBackground = "#334155",
        TextPrimary = "#f8fafc",
        TextSecondary = "#cbd5e1",
        TextDisabled = "#64748b",
        DrawerIcon = "#cbd5e1",
        DrawerText = "#cbd5e1",
        GrayLight = "#334155",
        GrayLighter = "#1e293b",
        Info = "#0072cf",
        Success = "#10b981",
        Warning = "#f59e0b",
        Error = "#ef4444",
        LinesDefault = "#334155",
        TableLines = "#334155",
        Divider = "#334155",
        OverlayLight = "#1e293b80",
    };

    public string DarkLightModeButtonIcon => ThemeService.CurrentTheme switch
    {
        ThemeMode.Lightest => Icons.Material.Outlined.LightMode,
        ThemeMode.Light => Icons.Material.Outlined.DarkMode,
        ThemeMode.Dark => Icons.Material.Rounded.AutoMode,
        _ => Icons.Material.Outlined.LightMode
    };

    private async Task OpenUpdateAccountDialog()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var currentUser = await db.Users.FirstOrDefaultAsync(u => u.Username == UserState.Username);

        if (currentUser is null) return;

        var parameters = new DialogParameters { { "UserToEdit", currentUser } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<UpdateAccountForm>("Update My Account", parameters, options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            // Refresh local user data if needed
            await UserState.InitializeAsync();
            StateHasChanged();
        }
    }

    private async Task OpenProfilePreviewDialog()
    {
        var parameters = new DialogParameters
        {
            { "ImagePath", _userImagePath },
            { "Username", UserState.Username },
            { "Role", UserState.Role }
        };

        var options = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Medium,
            NoHeader = true,
            Position = DialogPosition.Center,
            BackdropClick = true,
            FullWidth = false,
        };

        await DialogService.ShowAsync<UserProfilePreview>("", parameters, options);
    }
}
