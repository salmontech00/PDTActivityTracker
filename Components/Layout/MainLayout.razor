@using PDTActivityTracker.Components.Pages.Dialogs
@using Microsoft.EntityFrameworkCore
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject PDTActivityTracker.Components.Services.UserStateService UserState
@inject PDTActivityTracker.Components.Services.ThemeService ThemeService
@inject IDialogService DialogService
@inject IDbContextFactory<PDTActivityTracker.Model.AppDbContext> DbFactory
@using PDTActivityTracker.Components.Services
@implements IDisposable

<style>
    .desktop-nav {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .desktop-drawer {
        display: block;
    }

    .mobile-menu-toggle {
        display: none;
    }

    .mobile-drawer {
        display: none;
    }

    .appbar-text {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .appbar-text img {
            width: 40px !important;
            height: 40px !important;
            object-fit: contain;
            margin: 0px !important;
            background-color: #0072cf !important;
            border-radius: 5px !important;
            padding: 3px !important;
        }

        .appbar-text .mud-typography {
            font-weight: bold;
        }

    .mud-drawer .mud-nav-link.active {
        color: #0072cf !important;
    }

        .mud-drawer .mud-nav-link.active .mud-icon-root {
            color: #0072cf !important;
        }

    @@media (max-width: 600px) {
        .appbar-text

    {
        gap: 4px;
    }

    .appbar-text img {
        width: 30px !important;
        height: 30px !important;
    }

    .appbar-text .mud-typography {
        font-size: 0.95rem !important;
        font-weight: 600;
    }

    .desktop-nav {
        display: none !important;
    }

    .desktop-drawer {
        display: none !important;
    }

    .mobile-menu-toggle {
        display: flex !important;
        align-items: center;
        gap: 4px;
    }

    .mobile-drawer {
        display: block !important;
        max-width: 250px !important;
    }

    .user-profile-section {
        gap: 4px !important;
    }

        .user-profile-section img {
            width: 25px !important;
            height: 25px !important;
        }

        .user-profile-section .mud-typography {
            display: none !important;
        }

    .mud-appbar .mud-icon-button {
        padding: 8px !important;
    }

        .mud-appbar .mud-icon-button svg {
            width: 20px !important;
            height: 20px !important;
        }

    }</style>

@if (_isCheckingAuth)
{
    <MudLayout>
        <MudMainContent>
            <div style="display: flex; justify-content: center; align-items: center; height: 100vh; background-color: #0f172a; color: #0072cf;">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            </div>
        </MudMainContent>
    </MudLayout>
}
else if (!_isAuthenticated)
{
    <!-- This will never show because we redirect -->
}
else
{
    <MudThemeProvider Theme="@_theme" IsDarkMode="@(ThemeService.CurrentTheme == ThemeMode.Dark)" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="1" Class="@GetAppBarClass()">
            <div class="desktop-nav">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="@((e) => DrawerToggle())" />
            </div>
            <div class="appbar-text">
                <img src="/logo/LCClogo.png"
                     alt="Logo" />
                <MudText Typo="Typo.h5" Class="ml-1">SMR Activity Tracker</MudText>
            </div>
            <MudSpacer />

            <div class="desktop-nav">
                @if (!string.IsNullOrEmpty(_userImagePath))
                {
                    <div class="d-flex align-center mr-2 user-profile-section" style="gap: 8px;">
                        <img src="@_userImagePath"
                             alt="User Profile"
                             style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; cursor: pointer;"
                             @onclick="OpenProfilePreviewDialog" />
                        <MudText Typo="Typo.subtitle2">@UserState.Username</MudText>
                    </div>
                }

                <MudIconButton Icon="@DarkLightModeButtonIcon"
                               Color="Color.Inherit"
                               OnClick="@DarkModeToggle" />
                <MudIconButton Icon="@Icons.Material.Outlined.Logout"
                               Color="Color.Inherit"
                               Edge="Edge.End"
                               OnClick="Logout" />
            </div>

            <div class="mobile-menu-toggle">
                @if (!string.IsNullOrEmpty(_userImagePath))
                {
                    <img src="@_userImagePath"
                         alt="User Profile"
                         style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; cursor: pointer;"
                         @onclick="OpenProfilePreviewDialog" />
                }
                <MudIconButton Icon="@DarkLightModeButtonIcon"
                               Color="Color.Inherit"
                               OnClick="@DarkModeToggle" />
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               OnClick="@ToggleMobileDrawer" />
            </div>
        </MudAppBar>

        <MudDrawer id="nav-drawer"
                   @bind-Open="_drawerOpen"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="2"
                   Class="desktop-drawer">
            <NavMenu />
            <MudDivider Class="my-2" />
            <MudNavLink OnClick="@(async () => await OpenUpdateAccountDialog())"
                        Icon="@Icons.Material.Outlined.ManageAccounts">
                Update Account
            </MudNavLink>

            @if (UserState.Role == "Admin")
            {
                <MudNavLink Href="/admin/settings"
                            Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Outlined.Settings">
                    Settings
                </MudNavLink>
            }
        </MudDrawer>

        <MudDrawer @bind-Open="_mobileDrawerOpen"
                   Anchor="Anchor.Right"
                   Elevation="2"
                   Variant="DrawerVariant.Temporary"
                   Class="mobile-drawer">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">Menu</MudText>
            </MudDrawerHeader>
            <MudNavMenu>
                @if (UserState.Role == "Admin")
                {
                    <MudNavLink Href="/"
                                Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.People"
                                OnClick="@CloseMobileDrawer">
                        Manage Users
                    </MudNavLink>
                }
                else if (UserState.Role == "AVP" || UserState.Role == "Area Head" || UserState.Role == "Store Head")
                {
                    <MudNavLink Href="/"
                                Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Groups"
                                OnClick="@CloseMobileDrawer">
                        View Users
                    </MudNavLink>
                }

                <MudDivider Class="my-2" Style="border-color: var(--mud-palette-secondary); border-width: 1px;" />

                <MudNavLink OnClick="@(async () => { await OpenUpdateAccountDialog(); CloseMobileDrawer(); })"
                            Icon="@Icons.Material.Outlined.ManageAccounts">
                    Update Account
                </MudNavLink>

                @if (UserState.Role == "Admin")
                {
                    <MudNavLink Href="/admin/settings"
                                Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Outlined.Settings"
                                OnClick="@CloseMobileDrawer">
                        Settings
                    </MudNavLink>
                }

                <MudNavLink OnClick="@LogoutAndClose"
                            Icon="@Icons.Material.Outlined.Logout">
                    Sign Out
                </MudNavLink>
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent Class="pt-16 pa-4">
            @Body
        </MudMainContent>
    </MudLayout>

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
}

@code {
    private bool _drawerOpen = true;
    private bool _mobileDrawerOpen = false;
    private MudTheme? _theme = null;
    private bool _initialized = false;
    private bool _isCheckingAuth = true;
    private bool _isAuthenticated = false;
    private string? _userImagePath;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        SetTheme();
        ThemeService.OnThemeChanged += OnThemeChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileDrawerOpen = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;

            await ThemeService.InitializeAsync();
            SetTheme();

            var currentUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            if (currentUri.StartsWith("login"))
            {
                _isCheckingAuth = false;
                _isAuthenticated = false;
                StateHasChanged();
                return;
            }

            await UserState.InitializeAsync();

            if (!UserState.IsAuthenticated)
            {
                _isCheckingAuth = false;
                _isAuthenticated = false;
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            using var db = await DbFactory.CreateDbContextAsync();
            var currentUser = await db.Users.FirstOrDefaultAsync(u => u.Username == UserState.Username);

            if (currentUser == null)
            {
                await UserState.Logout();
                _isCheckingAuth = false;
                _isAuthenticated = false;
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            _userImagePath = currentUser.ImageData != null && !string.IsNullOrEmpty(currentUser.ImageMimeType)
                ? $"data:{currentUser.ImageMimeType};base64,{Convert.ToBase64String(currentUser.ImageData)}"
                : "/Uploads/UserImg.png";

            _isCheckingAuth = false;
            _isAuthenticated = true;
            StateHasChanged();
        }
    }

    private void OnThemeChanged()
    {
        SetTheme();
        StateHasChanged();
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task DarkModeToggle()
    {
        await ThemeService.CycleThemeAsync();
    }

    private async Task Logout()
    {
        await UserState.Logout();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    private void ToggleMobileDrawer()
    {
        _mobileDrawerOpen = !_mobileDrawerOpen;
    }

    private void CloseMobileDrawer()
    {
        _mobileDrawerOpen = false;
    }

    private async Task LogoutAndClose()
    {
        CloseMobileDrawer();
        await Logout();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void SetTheme()
    {
        if (ThemeService.CurrentTheme == ThemeMode.Dark)
        {
            _theme = new MudTheme
            {
                PaletteDark = _darkPalette,
                LayoutProperties = new LayoutProperties()
            };
        }
        else
        {
            _theme = new MudTheme
            {
                PaletteLight = ThemeService.CurrentTheme == ThemeMode.Light ? _lightPalette : _lightestPalette,
                LayoutProperties = new LayoutProperties()
            };
        }
    }

    private string GetAppBarClass()
    {
        return ThemeService.CurrentTheme switch
        {
            ThemeMode.Lightest => "admin-appbar-lightest",
            ThemeMode.Light => "admin-appbar-light",
            ThemeMode.Dark => "admin-appbar-dark",
            _ => "admin-appbar-lightest"
        };
    }

    private readonly PaletteLight _lightestPalette = new()
    {
        Black = "#0f172a",
        AppbarText = "#0072cf",
        AppbarBackground = "#ffffff",
        DrawerBackground = "#ffffff",
        DrawerIcon = "#0072cf",
        DrawerText = "#0072cf",
        GrayLight = "#f1f5f9",
        GrayLighter = "#f8fafc",
        Background = "#ffffff",
        Surface = "#ffffff",
        TextPrimary = "#0f172a",
        TextSecondary = "#475569",
        Primary = "#0072cf",
        Info = "#0072cf",
        Success = "#10b981",
        Warning = "#f59e0b",
        Error = "#ef4444",
        LinesDefault = "#e2e8f0",
        TableLines = "#e2e8f0",
        Divider = "#e2e8f0"
    };

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#0072cf",
        Black = "#ffffff",
        AppbarText = "#FFFFFF",
        AppbarBackground = "#0072cf",
        DrawerBackground = "#0072cf",
        DrawerIcon = "#ffffff",
        DrawerText = "#ffffff",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
        Background = "#0072cf",
        TextPrimary = "#ffffff",
        TextSecondary = "#e2e8f0"
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#0072cf",
        Surface = "#1e293b",
        Background = "#0f172a",
        BackgroundGray = "#1e293b",
        AppbarText = "#e2e8f0",
        AppbarBackground = "rgba(15,23,42,0.8)",
        DrawerBackground = "#0f172a",
        ActionDefault = "#94a3b8",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#ffffff",
        TextSecondary = "#cbd5e1",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#cbd5e1",
        DrawerText = "#cbd5e1",
        GrayLight = "#334155",
        GrayLighter = "#1e293b",
        Info = "#0072cf",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#334155",
        TableLines = "#334155",
        Divider = "#334155",
        OverlayLight = "#1e293b80",
    };

    public string DarkLightModeButtonIcon => ThemeService.CurrentTheme switch
    {
        ThemeMode.Lightest => Icons.Material.Outlined.LightMode,
        ThemeMode.Light => Icons.Material.Outlined.DarkMode,
        ThemeMode.Dark => Icons.Material.Rounded.AutoMode,
        _ => Icons.Material.Outlined.LightMode
    };

    private IDialogReference? _updateDialogRef;

    private async Task OpenUpdateAccountDialog()
    {
        if (_updateDialogRef is not null)
        {
            _updateDialogRef.Close();
            _updateDialogRef = null;
            StateHasChanged();
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var currentUser = await db.Users.FirstOrDefaultAsync(u => u.Username == UserState.Username);

        if (currentUser is null)
            return;

        var parameters = new DialogParameters
        {
            { "UserToEdit", currentUser }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        _updateDialogRef = await DialogService.ShowAsync<UpdateAccountForm>("Update Account", parameters, options);
        var result = await _updateDialogRef.Result;

        _updateDialogRef = null;

        if (!(result?.Canceled ?? true))
        {
            using var dbRefresh = await DbFactory.CreateDbContextAsync();
            var updatedUser = await dbRefresh.Users.FirstOrDefaultAsync(u => u.Id == currentUser.Id);
            if (updatedUser != null)
            {
                await UserState.SetUsername(updatedUser.Username);

                _userImagePath = updatedUser.ImageData != null && !string.IsNullOrEmpty(updatedUser.ImageMimeType)
                    ? $"data:{updatedUser.ImageMimeType};base64,{Convert.ToBase64String(updatedUser.ImageData)}"
                    : "/Uploads/UserImg.png";

                StateHasChanged();
            }
        }

        StateHasChanged();
    }

    private async Task OpenProfilePreviewDialog()
    {
        var parameters = new DialogParameters
        {
            { "ImagePath", _userImagePath },
            { "Username", UserState.Username },
            { "Role", UserState.Role }
        };

        var options = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.ExtraSmall,
            NoHeader = true,
            Position = DialogPosition.Center,
            BackdropClick = true,
            FullWidth = false,
        };

        await DialogService.ShowAsync<UserProfilePreview>("", parameters, options);
    }
}